 431:Generated_Source\PSoC5/ADC_DelSig.c **** *  None
 432:Generated_Source\PSoC5/ADC_DelSig.c **** *
 433:Generated_Source\PSoC5/ADC_DelSig.c **** *******************************************************************************/
 434:Generated_Source\PSoC5/ADC_DelSig.c **** void ADC_DelSig_SetBufferGain(uint8 gain) 
