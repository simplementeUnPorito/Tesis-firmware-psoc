 993:Generated_Source\PSoC5/ADC_DelSig.c ****         }
 994:Generated_Source\PSoC5/ADC_DelSig.c ****     #endif /* ADC_DelSig_CFG2_DEC_DIV */
 995:Generated_Source\PSoC5/ADC_DelSig.c **** 
 996:Generated_Source\PSoC5/ADC_DelSig.c ****     /* Subtract ADC offset */
