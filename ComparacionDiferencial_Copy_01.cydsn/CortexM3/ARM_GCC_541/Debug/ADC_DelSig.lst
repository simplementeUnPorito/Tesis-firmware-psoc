 966:Generated_Source\PSoC5/ADC_DelSig.c **** {
 967:Generated_Source\PSoC5/ADC_DelSig.c **** 
 968:Generated_Source\PSoC5/ADC_DelSig.c ****     int16 mVolts;
 969:Generated_Source\PSoC5/ADC_DelSig.c **** 
 970:Generated_Source\PSoC5/ADC_DelSig.c ****     /* Convert adcCounts to the right align if left option selected */
 971:Generated_Source\PSoC5/ADC_DelSig.c ****     #if(ADC_DelSig_CFG1_DEC_DIV != 0)
 972:Generated_Source\PSoC5/ADC_DelSig.c ****         if(ADC_DelSig_Config == ADC_DelSig_CFG1)
 973:Generated_Source\PSoC5/ADC_DelSig.c ****         {
 974:Generated_Source\PSoC5/ADC_DelSig.c ****             adcCounts /= ADC_DelSig_CFG1_DEC_DIV;
 975:Generated_Source\PSoC5/ADC_DelSig.c ****         }
 976:Generated_Source\PSoC5/ADC_DelSig.c ****     #endif /* ADC_DelSig_CFG1_DEC_DIV */
 977:Generated_Source\PSoC5/ADC_DelSig.c ****     #if((ADC_DelSig_CFG2_DEC_DIV != 0) && (ADC_DelSig_DEFAULT_NUM_CONFIGS > 1))
 978:Generated_Source\PSoC5/ADC_DelSig.c ****         if(ADC_DelSig_Config == ADC_DelSig_CFG2)
 979:Generated_Source\PSoC5/ADC_DelSig.c ****         {
