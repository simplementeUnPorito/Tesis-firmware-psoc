 987:Generated_Source\PSoC5/ADC_DelSig.c ****         }
 988:Generated_Source\PSoC5/ADC_DelSig.c ****     #endif /* ADC_DelSig_CFG2_DEC_DIV */
 989:Generated_Source\PSoC5/ADC_DelSig.c ****     #if((ADC_DelSig_CFG4_DEC_DIV != 0) && (ADC_DelSig_DEFAULT_NUM_CONFIGS > 3))
