 981:Generated_Source\PSoC5/ADC_DelSig.c ****         }
 982:Generated_Source\PSoC5/ADC_DelSig.c ****     #endif /* ADC_DelSig_CFG2_DEC_DIV */
 983:Generated_Source\PSoC5/ADC_DelSig.c ****     #if((ADC_DelSig_CFG3_DEC_DIV != 0) && (ADC_DelSig_DEFAULT_NUM_CONFIGS > 2))
 984:Generated_Source\PSoC5/ADC_DelSig.c ****         if(ADC_DelSig_Config == ADC_DelSig_CFG3)
 985:Generated_Source\PSoC5/ADC_DelSig.c ****         {
