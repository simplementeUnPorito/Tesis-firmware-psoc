dont_use_io iocell 1 0
dont_use_io iocell 1 1
dont_use_io iocell 1 3
set_location "\INA_Opamp:ABuf\" abufcell -1 -1 3
set_location "ClockBlock" clockblockcell -1 -1 0
set_location "\INA_PGA_p:SC\" sccell -1 -1 0
set_location "\INA_PGA_m:SC\" sccell -1 -1 1
set_io "INA_p(0)" iocell 0 2
# Note: port 15 is the logical name for port 8
set_io "INA_m(0)" iocell 15 1
set_io "INA_middle_p(0)" iocell 0 5
# Note: port 15 is the logical name for port 8
set_io "INA_middle_m(0)" iocell 15 3
set_io "INA_out(0)" iocell 3 7
set_io "Pin_5(0)" iocell 3 3
set_io "Pin_6(0)" iocell 3 2
