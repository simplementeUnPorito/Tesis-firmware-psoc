   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — PSoC5 simplificado
   3:main.c        **** *
   4:main.c        **** * Flujo de datos (todas las rutas por ISR):
   5:main.c        **** *
   6:main.c        **** *   isr_DelSig (1500 SPS, ADC_DelSig CFG1 18-bit ±6.144V):
   7:main.c        **** *     1. GetResult32() → g_ds  (lectura limpia el flag de la ISR)
   8:main.c        **** *     2. Escribe g_ds en Filter STAGEA → LSB dispara calculo DFB
   9:main.c        **** *     3. g_delsig_ready = 1
  10:main.c        **** *
  11:main.c        **** *   isr_Filter (conectado a Filter_DFB_DMA_Req_A en TopDesign):
  12:main.c        **** *     1. Lee Filter HOLDA (+0 latch+ack, +1, +2) → g_flt
  13:main.c        **** *        Leer HOLDA[0] desaserta DMA_Req_A (no necesita ClearPending)
  14:main.c        **** *     2. g_filter_ready = 1
  15:main.c        **** *
  16:main.c        **** *   isr_SAR (free-running, 12-bit ±1.024V, ~55 kSPS):
  17:main.c        **** *     1. GetResult16() → g_sar
  18:main.c        **** *     2. g_sar_ready = 1
  19:main.c        **** *
  20:main.c        **** *   isr_VDAC (Timer 24MHz, VDAC state machine):
  21:main.c        **** *     - Genera señal Ricker diferencial
  22:main.c        **** *     - Heartbeat cada ciclo (3000 muestras activas + 3000 pausa)
  23:main.c        **** *
  24:main.c        **** * Main loop: cuando g_delsig_ready && g_filter_ready && g_sar_ready → envia paquete.
  25:main.c        **** * Tasa efectiva = 1500 paquetes/s (cadenciada por el DelSig).
  26:main.c        **** *
  27:main.c        **** * Packet TX: [0xAA][0x00][sar_hi][sar_lo][ds2][ds1][ds0][flt2][flt1][flt0]
  28:main.c        **** *   sar = int16 big-endian
  29:main.c        **** *   ds  = int24 big-endian signed  (raw GetResult32, 18-bit en CFG1)
  30:main.c        **** *   flt = int24 big-endian signed  (salida DFB del sample anterior — 1 muestra delay causal)
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc8zNjUM.s 			page 2


  31:main.c        **** * Heartbeat: [0xAA][0x01][0x00 x8]
  32:main.c        **** *
  33:main.c        **** * CMD RX: [0xBB][0x03][freq_dh_hi][freq_dh_lo][cksum]
  34:main.c        **** *   cksum = 0xBB ^ 0x03 ^ hi ^ lo  →  PSoC responde 'K' / '!'
  35:main.c        **** *
  36:main.c        **** * NOTA TopDesign: isr_Filter debe conectarse a Filter_DFB_DMA_Req_A.
  37:main.c        **** *******************************************************************************/
  38:main.c        **** 
