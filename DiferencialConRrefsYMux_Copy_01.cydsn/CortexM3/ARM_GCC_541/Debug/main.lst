  27              		.file 1 "main.c"
   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Geofono diferencial: ADC_DelSig -> Filter DFB -> UART
   3:main.c        **** *
   4:main.c        **** * Protocolo TX (5 bytes por paquete, igual que DiferencialConRrefs_Copy_01_Copy_01):
   5:main.c        **** *   Data:      [0x56][0x00][b2][b1][b0]   int24 big-endian, DC removido por IIR
   6:main.c        **** *   Heartbeat: [0x56][0x01][0x00][0x00][0x00]
   7:main.c        **** *   Cfg-ADC:   [0x56][0x02][res][fsH][fsL]
   8:main.c        **** *   Cfg-PGA:   [0x56][0x03][code][vH][vL]
   9:main.c        **** *   VRef-St:   [0x56][0x04][vdac_p][vdac_n][0x01]
  10:main.c        **** *   AMUX-St:   [0x56][0x05][ch][0x00][0x00]    ch: 0=dif 1=CM+ 2=CM-
  11:main.c        **** *   VRef-Cfg:  [0x56][0x06][pVRef][nVRef][0x00]
  12:main.c        **** *
  13:main.c        **** * Comandos RX:
  14:main.c        **** *   0xA5            -> reenvía config completa
  15:main.c        **** *   0xA6 <code>     -> PGA_SetGain(code)
  16:main.c        **** *   0xA7 <ch>       -> AMux_FastSelect(ch)  ch: 0=dif 1=CM+ 2=CM-
  17:main.c        **** *   0xAA <pV> <nV>  -> setea VDAC_p = pV, VDAC_n = nV de inmediato
  18:main.c        **** *******************************************************************************/
  19:main.c        **** 
  20:main.c        **** #include "project.h"
  21:main.c        **** 
  22:main.c        **** #define ADC_VREF_HALFMV 6144u
  23:main.c        **** #define HB_PERIOD       3000u
  24:main.c        **** #define DC_SHIFT        14u
  25:main.c        **** 
