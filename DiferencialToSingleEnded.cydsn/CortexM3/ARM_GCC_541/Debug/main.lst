 112:main.c        **** }
 113:main.c        **** 
 114:main.c        **** static void send_config(void)
 115:main.c        **** {
 116:main.c        ****     uint8  cfg[5u];
 117:main.c        ****     uint16 fs_rep       = (uint16)ADC_CFG1_SRATE;
 118:main.c        ****     /* Derivado de ADC_CFG1_INPUT_RANGE_VALUE (float, ej. 2.5) → 2500 mV */
 119:main.c        ****     uint16 vref_halfmv  = (uint16)((float32)ADC_CFG1_INPUT_RANGE_VALUE * 1000.0f);
 120:main.c        **** 
 121:main.c        ****     cfg[0] = 0x56u; cfg[1] = 0x02u;
 122:main.c        ****     cfg[2] = (uint8)ADC_CFG1_RESOLUTION;
 123:main.c        ****     cfg[3] = (uint8)((fs_rep      >> 8u) & 0xFFu);
 124:main.c        ****     cfg[4] = (uint8)( fs_rep             & 0xFFu);
 125:main.c        ****     UART_PC_PutArray(cfg, 5u);
 126:main.c        **** 
 127:main.c        ****     cfg[1] = 0x03u;
 128:main.c        ****     cfg[2] = g_pga_code;
 129:main.c        ****     cfg[3] = (uint8)((vref_halfmv >> 8u) & 0xFFu);
 130:main.c        ****     cfg[4] = (uint8)( vref_halfmv        & 0xFFu);
 131:main.c        ****     UART_PC_PutArray(cfg, 5u);
 132:main.c        **** 
 133:main.c        ****     cfg[1] = 0x04u;
 134:main.c        ****     cfg[2] = g_pgavdac_code;
 135:main.c        ****     cfg[3] = g_vdac_val;
 136:main.c        ****     cfg[4] = 0x00u;
 137:main.c        ****     UART_PC_PutArray(cfg, 5u);
 138:main.c        **** }
 139:main.c        **** 
