  27              		.file 1 "main.c"
   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Geofono single-ended
   3:main.c        **** *
   4:main.c        **** * TX (5 bytes):
   5:main.c        **** *   Data:      [0x56][0x00][b2][b1][b0]
   6:main.c        **** *   Heartbeat: [0x56][0x01][pga_code][vdac_val][tx_mode]
   7:main.c        **** *   Cfg-ADC:   [0x56][0x02][res][fsH][fsL]
   8:main.c        **** *   Cfg-PGA:   [0x56][0x03][pga_code][vrefH][vrefL]
   9:main.c        **** *   Cfg-VREF:  [0x56][0x04][pgavdac_code][vdac_val][0x00]
  10:main.c        **** *   ACK:       [0x56][0x07][cmd][val][0x00]
  11:main.c        **** *
  12:main.c        **** * RX — 4 bytes con checksum XOR: [0xAB][cmd][param][cmd^param]
  13:main.c        **** *   0xAB 0xA5 0x00 0xA5  -> send_config()
  14:main.c        **** *   0xAB 0xA1 <en>   <cs>-> stream_enabled (0=off,1=on)
  15:main.c        **** *   0xAB 0xA6 <code> <cs>-> PGAgain_SetGain(code)   LED toggle
  16:main.c        **** *   0xAB 0xA8 <mode> <cs>-> tx_mode (0=crudo,1=flt)
  17:main.c        **** *   0xAB 0xA9 <code> <cs>-> PGAvdac_SetGain(code)   LED toggle
  18:main.c        **** *   0xAB 0xAA <v>    <cs>-> VDAC_SetValue(v)         LED toggle
  19:main.c        **** *
  20:main.c        **** * DEBUG:
  21:main.c        **** *   #define DEBUG 1  ->  rampa creciente en lugar de ADC
  22:main.c        **** *   #define DEBUG 0  ->  datos reales del ADC
  23:main.c        **** *******************************************************************************/
  24:main.c        **** 
  25:main.c        **** #include "project.h"
  26:main.c        **** 
  27:main.c        **** /* -------------------------------------------------------------------------- */
  28:main.c        **** #define DEBUG              0
  29:main.c        **** 
  30:main.c        **** /* ADC_CFG1_SRATE y ADC_CFG1_RESOLUTION vienen de ADC.h (generado).
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccT5T0la.s 			page 2


  31:main.c        ****  * ADC_CFG1_INPUT_RANGE_VALUE = 2.5 (float) → half-rango en mV = 2500.
  32:main.c        ****  * Se calcula en send_config() para no repetir el literal. */
  33:main.c        **** #define HB_PERIOD          1000u      /* heartbeat cada N muestras (~1 s a 1000 SPS) */
  34:main.c        **** #define DEBUG_PERIOD_US    1000u      /* DEBUG=1: rampa UART independiente del ADC */
  35:main.c        **** #define VDAC_INIT_VALUE    0x94u
  36:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz */
  37:main.c        **** 
  38:main.c        **** /* -------------------------------------------------------------------------- */
  39:main.c        **** static volatile int32 g_adc_raw      = 0;
  40:main.c        **** static volatile uint8 g_sample_ready = 0u;
  41:main.c        **** static volatile int32 g_flt          = 0;
  42:main.c        **** static volatile uint8 g_filter_ready = 0u;
  43:main.c        **** 
  44:main.c        **** static uint8 g_pga_code = PGAgain_DEFAULT_GAIN;
  45:main.c        **** static uint8 g_pgavdac_code = PGAvdac_DEFAULT_GAIN;
  46:main.c        **** static uint8 g_vdac_val = VDAC_INIT_VALUE;
  47:main.c        **** static uint8 tx_mode    = 0u;
  48:main.c        **** static uint8 stream_enabled = 0u;
  49:main.c        **** 
  50:main.c        **** /*
  51:main.c        ****  * Protocolo RX — 4 estados:
  52:main.c        ****  *   0: esperar 0xAB
  53:main.c        ****  *   1: esperar cmd  (0xA1 / 0xA5 / 0xA6 / 0xA8 / 0xA9 / 0xAA)
  54:main.c        ****  *   2: esperar param
  55:main.c        ****  *   3: esperar checksum (cmd ^ param) — si valido, ejecutar
  56:main.c        ****  *
  57:main.c        ****  * Fix watchdog: rx_watchdog_start/stop llaman isr_Timer_ClearPending()
  58:main.c        ****  * para evitar que una interrupcion pendiente reinicie rx_state justo
  59:main.c        ****  * despues de limpiar watchdog_rx, borrando el contexto del comando.
  60:main.c        ****  */
  61:main.c        **** static volatile uint8 rx_state    = 0u;
  62:main.c        **** static volatile uint8 rx_cmd      = 0u;
  63:main.c        **** static volatile uint8 rx_param    = 0u;
  64:main.c        **** static volatile uint8 watchdog_rx = 0u;
  65:main.c        **** 
