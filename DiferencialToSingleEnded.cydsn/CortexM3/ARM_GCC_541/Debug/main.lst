 111:main.c        **** }
 112:main.c        **** 
 113:main.c        **** static void send_config(void)
 114:main.c        **** {
 115:main.c        ****     uint8  cfg[5u];
 116:main.c        ****     uint16 fs_rep       = (uint16)ADC_CFG1_SRATE;
 117:main.c        ****     /* Derivado de ADC_CFG1_INPUT_RANGE_VALUE (float, ej. 2.5) → 2500 mV */
 118:main.c        ****     uint16 vref_halfmv  = (uint16)((float32)ADC_CFG1_INPUT_RANGE_VALUE * 1000.0f);
 119:main.c        **** 
 120:main.c        ****     cfg[0] = 0x56u; cfg[1] = 0x02u;
 121:main.c        ****     cfg[2] = (uint8)ADC_CFG1_RESOLUTION;
 122:main.c        ****     cfg[3] = (uint8)((fs_rep      >> 8u) & 0xFFu);
 123:main.c        ****     cfg[4] = (uint8)( fs_rep             & 0xFFu);
 124:main.c        ****     UART_PC_PutArray(cfg, 5u);
 125:main.c        **** 
 126:main.c        ****     cfg[1] = 0x03u;
 127:main.c        ****     cfg[2] = g_pga_code;
 128:main.c        ****     cfg[3] = (uint8)((vref_halfmv >> 8u) & 0xFFu);
 129:main.c        ****     cfg[4] = (uint8)( vref_halfmv        & 0xFFu);
 130:main.c        ****     UART_PC_PutArray(cfg, 5u);
 131:main.c        **** 
 132:main.c        ****     cfg[1] = 0x04u;
 133:main.c        ****     cfg[2] = g_pgavdac_code;
 134:main.c        ****     cfg[3] = g_vdac_val;
 135:main.c        ****     cfg[4] = 0x00u;
 136:main.c        ****     UART_PC_PutArray(cfg, 5u);
 137:main.c        **** }
 138:main.c        **** 
 139:main.c        **** static void send_ack(uint8 cmd, uint8 val)
 140:main.c        **** {
 141:main.c        ****     uint8 ack[5u] = {0x56u, 0x07u, cmd, val, 0x00u};
 142:main.c        ****     UART_PC_PutArray(ack, 5u);
 143:main.c        **** }
