zero <=  ('0') ;

tmpOE__SEo_net_0 <=  ('1') ;

Net_1864 <= (not \UART_PC:BUART:txn\);

\UART_PC:BUART:counter_load_not\ <= ((not \UART_PC:BUART:tx_bitclk_enable_pre\ and \UART_PC:BUART:tx_state_2\)
