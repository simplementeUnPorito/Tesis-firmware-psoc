  27              		.file 1 "main.c"
   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Geofono diferencial: ADC_DelSig -> Filter DFB -> UART
   3:main.c        **** *
   4:main.c        **** * Protocolo TX (5 bytes por paquete):
   5:main.c        **** *   Data:    [0x56][0x00][b2][b1][b0]    int24 big-endian, DC removido por IIR
   6:main.c        **** *   HB:      [0x56][0x01][0][0][0]
   7:main.c        **** *   Cfg-ADC: [0x56][0x02][res][fsH][fsL]
   8:main.c        **** *   Cfg-PGA: [0x56][0x03][code][vH][vL]
   9:main.c        **** *   VRef-St: [0x56][0x04][vdac_p][vdac_n][0x01]
  10:main.c        **** *   VRef-Cfg:[0x56][0x06][pVRef][nVRef][0x00]
  11:main.c        **** *
  12:main.c        **** * Comandos RX:
  13:main.c        **** *   0xA5            → reenvía config completa
  14:main.c        **** *   0xA6 <code>     → PGA_SetGain(code)
  15:main.c        **** *   0xAA <pV> <nV>  → setea VDAC_p = pV, VDAC_n = nV de inmediato
  16:main.c        **** *
  17:main.c        **** * Los VDACs se setean directamente — sin servo, sin búsqueda, sin locking.
  18:main.c        **** * El usuario elige los valores óptimos observando el osciloscopio y el promedio
  19:main.c        **** * DC que MATLAB muestra en tiempo real.
  20:main.c        **** *******************************************************************************/
  21:main.c        **** 
