  27              		.file 1 "main.c"
   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Geofono diferencial: ADC_DelSig -> Filter DFB -> FIR Notch -> UART
   3:main.c        **** *
   4:main.c        **** * Flujo de datos (ISR-driven):
   5:main.c        **** *
   6:main.c        **** *   isr_DelSig  (EOC del ADC_DelSig, ~1500 SPS):
   7:main.c        **** *     1. GetResult32() -> escribe directo en Filter STAGEA via Filter_Write24
   8:main.c        **** *
   9:main.c        **** *   isr_Filter  (Filter_DFB_DMA_Req_A — salida canal A lista en HOLDA):
  10:main.c        **** *     1. Filter_Read24(CHANNEL_A) -> g_flt
  11:main.c        **** *     2. g_filter_ready = 1
  12:main.c        **** *
  13:main.c        **** *   Main loop:
  14:main.c        **** *     - Lee g_flt, aplica FIR notch software
  15:main.c        **** *     - Envia paquete de 5 bytes por UART_PC a 460800 bps
  16:main.c        **** *     - Heartbeat cada 3000 muestras (~2 s a 1500 SPS)
  17:main.c        **** *
  18:main.c        **** * Protocolo TX (5 bytes):
  19:main.c        **** *   Data:      [0x56][0x00][notch2][notch1][notch0]
  20:main.c        **** *   Heartbeat: [0x56][0x01][0x00  ][0x00  ][0x00  ]
  21:main.c        **** *   notch = int24 big-endian signed (salida FIR notch sobre la salida DFB)
  22:main.c        **** *
  23:main.c        **** * NOTA TopDesign: isr_Filter debe conectarse a Filter_DFB_DMA_Req_A.
  24:main.c        **** *******************************************************************************/
  25:main.c        **** 
  26:main.c        **** #include "project.h"
  27:main.c        **** #include "coeficientes_notch.h"
  28:main.c        **** 
  29:main.c        **** /*
  30:main.c        ****  * DEBUG = 1: envia rampa 0,1,2,3... en vez de datos reales.
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc8rwDdc.s 			page 2


  31:main.c        ****  *   - Si MATLAB muestra una rampa suave → byte order y alineacion correctos.
  32:main.c        ****  *   - Si la rampa esta scrambled → algun byte esta en orden incorrecto.
  33:main.c        ****  *   - La rampa sube de 0 a 16777215 (0xFFFFFF) y vuelve a 0.
  34:main.c        ****  * DEBUG = 0: operacion normal (notch FIR sobre DFB).
  35:main.c        ****  */
  36:main.c        **** #define DEBUG 0
