   6:filter_coeffs.c **** /* Si esto frena la compilacion, FILTER_FIR_NTAPS (filter_coeffs.h) quedo
   7:filter_coeffs.c ****  * desincronizado del "Number of Taps" configurado en el customizer del
   8:filter_coeffs.c ****  * componente Filter (TopDesign) -- Filter_FIR_A_SIZE lo refleja siempre que
   9:filter_coeffs.c ****  * se haga "Generate Application". Arreglar ANTES de tocar el arreglo de
  10:filter_coeffs.c ****  * abajo: cargar un N de taps distinto al microcodigo real del DFB corrompe
  11:filter_coeffs.c ****  * la RAM de coeficientes. */
  12:filter_coeffs.c **** #if FILTER_FIR_NTAPS != (Filter_FIR_A_SIZE / 4u)
  13:filter_coeffs.c **** #error "FILTER_FIR_NTAPS (filter_coeffs.h) debe ser igual a Filter_FIR_A_SIZE/4 (Filter.h, generado
  14:filter_coeffs.c **** #endif
  15:filter_coeffs.c **** 
