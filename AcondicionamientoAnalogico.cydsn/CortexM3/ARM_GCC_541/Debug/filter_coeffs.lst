 282              	.L9:
  23:filter_coeffs.c ****     }
  24:filter_coeffs.c **** 
  25:filter_coeffs.c ****     /* Power on DFB antes de tocar las RAMs */
  26:filter_coeffs.c ****     Filter_PM_ACT_CFG_REG |= Filter_PM_ACT_MSK;
  27:filter_coeffs.c **** 
  28:filter_coeffs.c ****     /* Apagar el run bit para escribir, y restaurarlo al final al estado que
  29:filter_coeffs.c ****      * tenia antes -- el snippet de referencia de Cypress lo apaga y nunca lo
  30:filter_coeffs.c ****      * vuelve a prender, lo que frena el filtro para siempre si se llama
  31:filter_coeffs.c ****      * mientras esta en uso (p.ej. el stream filtrado de captura). */
  32:filter_coeffs.c ****     wasRunning = Filter_CR_REG & Filter_RUN_MASK;
  33:filter_coeffs.c ****     Filter_CR_REG &= (uint8)~Filter_RUN_MASK;
  34:filter_coeffs.c **** 
  35:filter_coeffs.c ****     /* Habilitar las RAMs del DFB en el bus */
  36:filter_coeffs.c ****     Filter_RAM_EN_REG = Filter_RAM_DIR_BUS;
  37:filter_coeffs.c ****     Filter_RAM_DIR_REG = Filter_RAM_DIR_BUS;
  38:filter_coeffs.c **** 
  39:filter_coeffs.c ****     /* Limpiar la linea de retardo (Data RAM A): coeficientes nuevos no deben
  40:filter_coeffs.c ****      * mezclarse con historial de muestras del diseño anterior. */
  41:filter_coeffs.c ****     (void)memcpy(Filter_DA_RAM, Filter_data_a, Filter_DA_RAM_SIZE);
  42:filter_coeffs.c **** 
  43:filter_coeffs.c ****     /* Cargar los coeficientes nuevos en Data RAM B (Canal A, offset 0 --
  44:filter_coeffs.c ****      * unico canal usado, Canal B esta Disabled en TopDesign). */
  45:filter_coeffs.c ****     for (i = 0u; i < ntaps; i++) {
  46:filter_coeffs.c ****         uint32 raw = (uint32)coeffs_q23[i] & 0x00FFFFFFUL;
  47:filter_coeffs.c ****         ((uint8 *)Filter_DB_RAM)[(i * 4u) + 0u] = (uint8)(raw & 0xFFu);
  48:filter_coeffs.c ****         ((uint8 *)Filter_DB_RAM)[(i * 4u) + 1u] = (uint8)((raw >> 8u) & 0xFFu);
  49:filter_coeffs.c ****         ((uint8 *)Filter_DB_RAM)[(i * 4u) + 2u] = (uint8)((raw >> 16u) & 0xFFu);
  50:filter_coeffs.c ****         ((uint8 *)Filter_DB_RAM)[(i * 4u) + 3u] = 0x00u;
  51:filter_coeffs.c ****     }
  52:filter_coeffs.c **** 
  53:filter_coeffs.c ****     /* Sacar las RAMs del bus */
  54:filter_coeffs.c ****     Filter_RAM_DIR_REG = Filter_RAM_DIR_DFB;
  55:filter_coeffs.c **** 
  56:filter_coeffs.c ****     /* Limpiar interrupciones pendientes (bits [2..0] son solo lectura) */
  57:filter_coeffs.c ****     Filter_SR_REG = 0xF8u;
  58:filter_coeffs.c **** 
  59:filter_coeffs.c ****     if (wasRunning) {
  60:filter_coeffs.c ****         Filter_CR_REG |= Filter_RUN_MASK;
  61:filter_coeffs.c ****     }
  62:filter_coeffs.c **** 
  63:filter_coeffs.c ****     return 1u;
  64:filter_coeffs.c **** }
