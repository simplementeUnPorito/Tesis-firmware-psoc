  76:fatfs/ff.c    **** #define NS_LFN		0x02	/* Force to create LFN entry */
  77:fatfs/ff.c    **** #define NS_LAST		0x04	/* Last segment */
  78:fatfs/ff.c    **** #define NS_BODY		0x08	/* Lower case flag (body) */
