1331:fatfs/ff.c    **** 
1332:fatfs/ff.c    **** 
1333:fatfs/ff.c    **** 	clst -= 2;	/* The first bit in the bitmap corresponds to cluster #2 */
1334:fatfs/ff.c    **** 	if (clst >= fs->n_fatent - 2) clst = 0;
