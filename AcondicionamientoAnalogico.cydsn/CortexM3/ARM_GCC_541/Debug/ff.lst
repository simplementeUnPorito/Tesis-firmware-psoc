4361:fatfs/ff.c    **** 
4362:fatfs/ff.c    **** FRESULT f_chdir (
4363:fatfs/ff.c    **** 	const TCHAR* path	/* Pointer to the directory path */
4364:fatfs/ff.c    **** )
4365:fatfs/ff.c    **** {
4366:fatfs/ff.c    **** 	FRESULT res;
4367:fatfs/ff.c    **** 	DIR dj;
4368:fatfs/ff.c    **** 	FATFS *fs;
4369:fatfs/ff.c    **** 	DEF_NAMEBUFF
4370:fatfs/ff.c    **** 
4371:fatfs/ff.c    **** 
4372:fatfs/ff.c    **** 	res = mount_volume(&path, &fs, 0);	/* Get logical drive and mount the volume if needed */
4373:fatfs/ff.c    **** 	if (res == FR_OK) {
4374:fatfs/ff.c    **** 		dj.obj.fs = fs;
4375:fatfs/ff.c    **** 		INIT_NAMEBUFF(fs);
4376:fatfs/ff.c    **** 		res = follow_path(&dj, path);		/* Follow the path */
4377:fatfs/ff.c    **** 		if (res == FR_OK) {					/* Follow completed */
4378:fatfs/ff.c    **** 			if (dj.fn[NSFLAG] & NS_NONAME) {	/* Is it the start directory itself? */
4379:fatfs/ff.c    **** #if FF_FS_EXFAT
4380:fatfs/ff.c    **** 				if (fs->fs_type == FS_EXFAT) {
4381:fatfs/ff.c    **** 					memcpy(&fs->xcwds, &fs->xcwds2, sizeof fs->xcwds);
4382:fatfs/ff.c    **** 				}
4383:fatfs/ff.c    **** #endif
4384:fatfs/ff.c    **** 				fs->cdir = dj.obj.sclust;
