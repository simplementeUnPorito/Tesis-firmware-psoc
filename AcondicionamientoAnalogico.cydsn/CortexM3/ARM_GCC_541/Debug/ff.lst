  69:fatfs/ff.c    **** #define AM_MASK		0x3F	/* Mask of defined bits in FAT */
  70:fatfs/ff.c    **** #define AM_MASKX	0x37	/* Mask of defined bits in exFAT */
  71:fatfs/ff.c    **** 
