4340:fatfs/ff.c    **** FRESULT f_chdrive (
4341:fatfs/ff.c    **** 	const TCHAR* path		/* Drive number to set */
4342:fatfs/ff.c    **** )
4343:fatfs/ff.c    **** {
4344:fatfs/ff.c    **** 	int vol;
4345:fatfs/ff.c    **** 
4346:fatfs/ff.c    **** 
4347:fatfs/ff.c    **** 	/* Get logical drive number */
