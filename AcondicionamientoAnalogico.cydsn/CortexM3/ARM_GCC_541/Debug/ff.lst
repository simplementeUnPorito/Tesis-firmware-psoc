1349:fatfs/ff.c    **** 				}
1350:fatfs/ff.c    **** 				if (val == clst) return 0;	/* All cluster scanned? */
1351:fatfs/ff.c    **** 			} while (bm != 0);
1352:fatfs/ff.c    **** 			bm = 1;
1353:fatfs/ff.c    **** 		} while (++i < SS(fs));
