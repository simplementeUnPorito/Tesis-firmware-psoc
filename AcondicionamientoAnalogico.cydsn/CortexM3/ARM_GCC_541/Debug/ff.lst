  60:fatfs/ff.c    **** /* Additional file access control and file status flags for internal use */
  61:fatfs/ff.c    **** #define FA_SEEKEND	0x20	/* Seek to end of the file on file open */
  62:fatfs/ff.c    **** #define FA_MODIFIED	0x40	/* File has been modified */
  63:fatfs/ff.c    **** #define FA_DIRTY	0x80	/* FIL.buf[] needs to be written-back */
  64:fatfs/ff.c    **** 
  65:fatfs/ff.c    **** 
