1321:fatfs/ff.c    **** 
1322:fatfs/ff.c    **** static DWORD find_bitmap (	/* 0:Not found, 2..:Cluster block found, 0xFFFFFFFF:Disk error */
1323:fatfs/ff.c    **** 	FATFS* fs,	/* Filesystem object */
1324:fatfs/ff.c    **** 	DWORD clst,	/* Cluster number to scan from */
1325:fatfs/ff.c    **** 	DWORD ncl	/* Number of contiguous clusters to find (1..) */
1326:fatfs/ff.c    **** )
1327:fatfs/ff.c    **** {
1328:fatfs/ff.c    **** 	BYTE bm, bv;
1329:fatfs/ff.c    **** 	UINT i;
