 118:Generated_Source\PSoC5/OPAadder.c **** void OPAadder_Stop(void) 
 119:Generated_Source\PSoC5/OPAadder.c **** {
 120:Generated_Source\PSoC5/OPAadder.c ****     /* Disable power to buffer in active mode template */
 121:Generated_Source\PSoC5/OPAadder.c ****     OPAadder_PM_ACT_CFG_REG &= (uint8)(~OPAadder_ACT_PWR_EN);
 122:Generated_Source\PSoC5/OPAadder.c **** 
