 128:Generated_Source\PSoC5/OPAadder.c ****     {
 129:Generated_Source\PSoC5/OPAadder.c ****         OPAadder_PUMP_CR1_REG &= (uint8)(~(OPAadder_PUMP_CR1_CLKSEL | OPAadder_PUMP_CR1_FORCE));
