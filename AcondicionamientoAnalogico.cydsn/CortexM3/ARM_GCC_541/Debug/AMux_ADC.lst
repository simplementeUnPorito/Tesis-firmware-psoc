  69:Generated_Source\PSoC5/AMux_ADC.c **** void AMux_ADC_Select(uint8 channel) 
  70:Generated_Source\PSoC5/AMux_ADC.c **** {
  71:Generated_Source\PSoC5/AMux_ADC.c ****     AMux_ADC_DisconnectAll();        /* Disconnect all previous connections */
  72:Generated_Source\PSoC5/AMux_ADC.c ****     AMux_ADC_Connect(channel);       /* Make the given selection */
  73:Generated_Source\PSoC5/AMux_ADC.c ****     AMux_ADC_lastChannel = channel;  /* Update last channel */
  74:Generated_Source\PSoC5/AMux_ADC.c **** }
