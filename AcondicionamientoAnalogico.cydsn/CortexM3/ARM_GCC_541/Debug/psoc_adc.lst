   1:psoc_adc.c    **** #include "psoc_adc.h"
   2:psoc_adc.c    **** 
   3:psoc_adc.c    **** static volatile int32 g_psoc_adc_isr_counts = 0;
   4:psoc_adc.c    **** static volatile uint8 g_psoc_adc_isr_ready = 0u;
   5:psoc_adc.c    **** 
   6:psoc_adc.c    **** /* Config activa pedida por el host (ADC_CF_2V5 | ADC_CF_0V512 |
   7:psoc_adc.c    ****  * ADC_CF_1V024 | ADC_CF_0V625). */
   8:psoc_adc.c    **** static uint8 g_psoc_adc_config = ADC_CF_2V5;
   9:psoc_adc.c    **** /* Override de calibración: fuerza 2V5 sin perder la elección del usuario. */
  10:psoc_adc.c    **** static uint8 g_psoc_adc_cal_force_2v5 = 0u;
  11:psoc_adc.c    **** /* Factor de decimación con promedio (1 = sin decimar). */
  12:psoc_adc.c    **** static uint8 g_psoc_adc_decimation = 1u;
  13:psoc_adc.c    **** 
  14:psoc_adc.c    **** int32 psoc_adc_counts_right_aligned(int32 adc_counts)
  15:psoc_adc.c    **** {
 1078              		.loc 1 15 0
 1079              		.cfi_startproc
 1080              		@ args = 0, pretend = 0, frame = 0
 1081              		@ frame_needed = 0, uses_anonymous_args = 0
 1082              		@ link register save eliminated.
 1083              	.LVL0:
  16:psoc_adc.c    ****     /* Solo ADC_CF_2V5 es left-aligned (ALIGNMENT=1, DEC_DIV=32); las demás
  17:psoc_adc.c    ****      * configs entregan counts right-aligned (DEC_DIV=0). Se consulta
  18:psoc_adc.c    ****      * ADC_Config (variable del componente, mantenida por
