 472:Generated_Source\PSoC5/CyLib.c ****     nextFreq = (freq == CY_IMO_FREQ_USB) ? CY_IMO_FREQ_24MHZ : freq;
 473:Generated_Source\PSoC5/CyLib.c **** 
