1304:Generated_Source\PSoC5/CyLib.c **** *******************************************************************************/
1305:Generated_Source\PSoC5/CyLib.c **** uint8 CyXTAL_ReadStatus(void) 
1306:Generated_Source\PSoC5/CyLib.c **** {
