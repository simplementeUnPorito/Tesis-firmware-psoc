 773:Generated_Source\PSoC5/CyLib.c **** *******************************************************************************/
 774:Generated_Source\PSoC5/CyLib.c **** void CyBusClk_SetDivider(uint16 divider) 
 775:Generated_Source\PSoC5/CyLib.c **** {
