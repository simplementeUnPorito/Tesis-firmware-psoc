 215:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****             }
 216:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****             else
 217:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****             {
