 206:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****         {
 207:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****             /* Moving to/from SSS requires correct ordering to prevent halting the clock    */
 208:Generated_Source\PSoC5/ADC_Ext_CP_Clk.c ****             if (oldDivider == 0u)
