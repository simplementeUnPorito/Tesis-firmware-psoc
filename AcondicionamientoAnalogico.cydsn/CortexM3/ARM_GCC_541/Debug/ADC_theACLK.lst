 226:Generated_Source\PSoC5/ADC_theACLK.c **** 			
 227:Generated_Source\PSoC5/ADC_theACLK.c ****             if (enabled != 0u)
 228:Generated_Source\PSoC5/ADC_theACLK.c ****             {
 229:Generated_Source\PSoC5/ADC_theACLK.c ****                 CLK_DIST_LD = 0x00u;
