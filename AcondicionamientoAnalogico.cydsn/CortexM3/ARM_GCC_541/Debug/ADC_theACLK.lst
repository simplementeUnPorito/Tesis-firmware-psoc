 212:Generated_Source\PSoC5/ADC_theACLK.c ****                 /* divider is ignored while SSS is set.                                     */
 213:Generated_Source\PSoC5/ADC_theACLK.c ****                 CY_SET_REG16(ADC_theACLK_DIV_PTR, clkDivider);
