 664:Generated_Source\PSoC5/SPI.c **** *
 665:Generated_Source\PSoC5/SPI.c **** *******************************************************************************/
 666:Generated_Source\PSoC5/SPI.c **** uint8 SPI_GetRxBufferSize(void) 
 667:Generated_Source\PSoC5/SPI.c **** {
