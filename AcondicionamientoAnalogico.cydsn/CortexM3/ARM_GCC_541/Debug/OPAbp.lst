 118:Generated_Source\PSoC5/OPAbp.c **** void OPAbp_Stop(void) 
 119:Generated_Source\PSoC5/OPAbp.c **** {
 120:Generated_Source\PSoC5/OPAbp.c ****     /* Disable power to buffer in active mode template */
 121:Generated_Source\PSoC5/OPAbp.c ****     OPAbp_PM_ACT_CFG_REG &= (uint8)(~OPAbp_ACT_PWR_EN);
 122:Generated_Source\PSoC5/OPAbp.c **** 
