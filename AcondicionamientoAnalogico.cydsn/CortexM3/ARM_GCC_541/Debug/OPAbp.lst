 128:Generated_Source\PSoC5/OPAbp.c ****     {
 129:Generated_Source\PSoC5/OPAbp.c ****         OPAbp_PUMP_CR1_REG &= (uint8)(~(OPAbp_PUMP_CR1_CLKSEL | OPAbp_PUMP_CR1_FORCE));
