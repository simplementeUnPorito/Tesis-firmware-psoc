 3681              		.file 1 "main.c"
   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Firmware PSoC unificado para geófono (GEO) y martillo (HAMMER).
   3:main.c        **** *
   4:main.c        **** * El hardware del TopDesign determina automáticamente el modo de compilación:
   5:main.c        **** *   Si el proyecto tiene PGAgain  → PSOC_HW_CLASS = GEO
   6:main.c        **** *   Si el proyecto tiene PGA      → PSOC_HW_CLASS = HAMMER
   7:main.c        **** * No hay que cambiar nada en este archivo al cambiar de proyecto.
   8:main.c        **** *
   9:main.c        **** * ────────────────────────────────�
  10:main.c        **** *  GEO — componentes TopDesign:
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccxU6pRr.s 			page 275


  11:main.c        **** *    UART, ADC, AMux_ADC, VDAC_ref_*, PGAgain, OPAref, PGAp,
  12:main.c        **** *    PGAn, LPF_1, LPF_2, OPAbp, OPAadder, OPAlp, Timer, LED, isr_*.
  13:main.c        **** *
  14:main.c        **** *  HAMMER — componentes TopDesign (simplificado en "Precambios", ya sin
  15:main.c        **** *  etapa de referencia de entrada separada):
  16:main.c        **** *    UART, ADC, AMux_ADC, VDAC_PGA, VDAC_LP,
  17:main.c        **** *    PGA, Opa_ref_PGA, Opa_LP, LPF_ADC, Timer, LED.
  18:main.c        **** * ────────────────────────────────�
  19:main.c        **** *
  20:main.c        **** * Cadena: MATLAB → maestro → esclavo (ESP-NOW) → PSoC (UART).
  21:main.c        **** * El PSoC muestrea N lotes de 30 muestras RAW, los guarda en RAM
  22:main.c        **** * sin UART durante la ventana crítica, y recién después los envía al ESP.
  23:main.c        **** * El arranque del muestreo es por el pin digital SYNC_IN (lo maneja el ESP).
  24:main.c        **** *
  25:main.c        **** * TX UART — frame de datos RAW (95 bytes):
  26:main.c        **** *   [0xAB][n=30][seq_lo][seq_hi] + 30×3 bytes (raw LE: b0,b1,b2) + [crc XOR]
  27:main.c        **** *
  28:main.c        **** * RX UART — comandos con checksum XOR:
  29:main.c        **** *   1 param : [0xAB][cmd][param][cmd^param]
  30:main.c        **** *       0xA5 status/probe   0xA6 set PGA (0-8)       0xA9 legacy ACK
  31:main.c        **** *       0xAA legacy ACK     0xB1 arm (espera SYNC)   0xB3 debug rampa (0/1)
  32:main.c        **** *       0xB4 start-now      0xB5 calibrar refs       0xC1 pong
  33:main.c        **** *   2 param : [0xAB][0xA3][n_lo][n_hi][0xA3^n_lo^n_hi]   (set N lotes)
  34:main.c        **** *
  35:main.c        **** * Detección PSoC ↔ ESP:
  36:main.c        **** *   PSoC → ESP : [0xAB][0xC0][0x00][0xC0]             (ping)
  37:main.c        **** *   ESP  → PSoC: [0xAB][0xC1][0x00][0xC1]             (pong)
  38:main.c        **** *   PSoC → ESP : [0xAB][0xC2][cmd][val][0xC2^cmd^val]  (config ACK)
  39:main.c        **** *******************************************************************************/
  40:main.c        **** 
  41:main.c        **** #include "project.h"
  42:main.c        **** #include "psoc_hw.h"
  43:main.c        **** #include "psoc_adc.h"
  44:main.c        **** #include "calibration.h"
  45:main.c        **** #include "psoc_nv.h"
  46:main.c        **** #include "LED.h"
  47:main.c        **** #include "DMA_DelSig_RAM_dma.h"
  48:main.c        **** #include "DMA_Filter_RAM_dma.h"
  49:main.c        **** #include "DMA_DelSig_Filter_dma.h"
  50:main.c        **** #include "Filter.h"
  51:main.c        **** #include "Filter_PVT.h"
  52:main.c        **** #include "Reg_Select.h"
  53:main.c        **** #include "filter_coeffs.h"
  54:main.c        **** #include "FIR_adquisition.h"
  55:main.c        **** #include "psoc_debug.h"
  56:main.c        **** /* -------------------------------------------------------------------------- */
  57:main.c        **** #define LEGACY_VDAC_SHADOW_INIT 0x9Cu
  58:main.c        **** /* FILTER_FIR_NTAPS vive en filter_coeffs.h (unica fuente de verdad,
  59:main.c        ****  * compartida con calibration.c). */
  60:main.c        **** #define FILTER_GROUP_DELAY ((FILTER_FIR_NTAPS - 1u) / 2u)   /* 63 muestras */
  61:main.c        **** 
  62:main.c        **** #ifndef PSOC_LOAD_NV_CAL_ON_BOOT
  63:main.c        **** #define PSOC_LOAD_NV_CAL_ON_BOOT 1u
  64:main.c        **** #endif
  65:main.c        **** #define TIMER_TICK_MS      10u
  66:main.c        **** #define TIMEOUT_COUNTS     1000u    /* 10 ms @ 100 kHz — tick de sistema */
  67:main.c        **** 
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccxU6pRr.s 			page 276


  68:main.c        **** #define BATCH_SAMPLES      30u
  69:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  70:main.c        **** #define SAMPLE_BYTES       3u
  71:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  72:main.c        **** 
  73:main.c        **** #ifndef PSOC_CAPTURE_MAX_BATCHES
  74:main.c        **** #define PSOC_CAPTURE_MAX_BATCHES 512u
  75:main.c        **** #endif
  76:main.c        **** 
  77:main.c        **** #define PING_PERIOD_MS     700u
  78:main.c        **** #define PING_OFF_MS        100u
  79:main.c        **** #define IDLE_PING_MS       1000u
  80:main.c        **** #define COMM_WINDOW_MS     500u
  81:main.c        **** #define COMM_BLINK_MS      200u  /* medio-período del parpadeo del LED (~2.5 Hz, visible) */
  82:main.c        **** 
  83:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  84:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  85:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  86:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  87:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  88:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
  89:main.c        **** #define CONNECT_BLINK_TICKS   MS_TO_TICKS(80u)
  90:main.c        **** 
  91:main.c        **** /* Titilar LED (identificación de nodo): parpadeo NO bloqueante servido por
  92:main.c        ****  * service_comm_led sobre el tick del Timer (ILO 100 kHz → 10 ms). Al recibir
  93:main.c        ****  * PSOC_CMD_BLINK_LED se carga g_comm_countdown con esta ventana; el LED titila
  94:main.c        ****  * y luego vuelve a su reposo (encendido fijo). No usa delays ni bloquea. */
  95:main.c        **** #define IDENTIFY_BLINK_WINDOW_MS  8000u
  96:main.c        **** #define IDENTIFY_BLINK_TICKS      MS_TO_TICKS(IDENTIFY_BLINK_WINDOW_MS)
  97:main.c        **** 
  98:main.c        **** #ifndef PSOC_DIAG_ENABLE
  99:main.c        **** #define PSOC_DIAG_ENABLE      1
 100:main.c        **** #endif
