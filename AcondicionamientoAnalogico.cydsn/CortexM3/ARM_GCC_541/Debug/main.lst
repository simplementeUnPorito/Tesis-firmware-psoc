 485:main.c        **** /* Selecciona, vía Reg_Select, qué resultado final usan los DMA *_RAM y si cada
 486:main.c        ****  * camino corre en Single (1 muestra/disparo) o Lote (DMA_LOTE_SAMPLES/disparo).
 487:main.c        ****  * La exclusión Single/Lote y raw/Filter la imponen las compuertas del TopDesign;
 488:main.c        ****  * acá solo se escribe el bit pattern que las gobierna (control_0/1/2). */
 489:main.c        **** static void dma_route_select(uint8 use_filter, uint8 raw_lote, uint8 filt_lote)
 490:main.c        **** {
 491:main.c        ****     uint8 reg = 0u;
 492:main.c        ****     if (use_filter) { reg |= 0x02u; }   /* control_1 */
 493:main.c        ****     if (filt_lote)  { reg |= 0x01u; }   /* control_0 */
 494:main.c        ****     if (raw_lote)   { reg |= 0x04u; }   /* control_2 */
 495:main.c        ****     g_raw_route_lote = raw_lote ? 1u : 0u;
 496:main.c        ****     Reg_Select_Write(reg);
 497:main.c        **** }
 498:main.c        **** 
 499:main.c        **** /* Re-arma DMA_DelSig_RAM_Lote a un estado limpio (offset cero) antes de
 500:main.c        ****  * seleccionarlo. Si el canal se deselecciona a mitad de lote, su cuenta
 501:main.c        ****  * interna (burstcount_remain) queda parcialmente avanzada — CyDmaChSetInitialTd
 502:main.c        ****  * no resetea esa cuenta viva por sí solo (ver CyDmac.c), así que hace falta
 503:main.c        ****  * un ciclo disable → re-set TD inicial → re-enable. Solo debe llamarse
 504:main.c        ****  * mientras el canal está deseleccionado (sin DRQs entrantes). */
 505:main.c        **** static void dma_raw_lote_rearm(void)
 506:main.c        **** {
 507:main.c        ****     CyDmaChDisable(DMA_DelSig_RAM_Lote_DmaHandle);
 508:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_Lote_DmaHandle, g_td_raw_lote);
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccjGoaFI.s 			page 292


 509:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_Lote_DmaHandle, 1u);
 510:main.c        **** }
