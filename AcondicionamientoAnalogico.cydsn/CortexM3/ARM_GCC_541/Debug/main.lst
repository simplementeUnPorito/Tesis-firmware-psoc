 571:main.c        **** static void uart_send_capture_batch(uint16 batchIndex)
 572:main.c        **** {
 573:main.c        ****     uint8  frame[FRAME_BYTES];
 574:main.c        ****     uint8 *p;
 575:main.c        ****     uint16 i;
 576:main.c        ****     uint16 pos;
 577:main.c        ****     uint8  crc = 0u;
 578:main.c        **** 
 579:main.c        ****     frame[0] = 0xABu;
 580:main.c        ****     frame[1] = (uint8)BATCH_SAMPLES;
 581:main.c        ****     frame[2] = (uint8)( g_seq        & 0xFFu);
 582:main.c        ****     frame[3] = (uint8)((g_seq >> 8u) & 0xFFu);
 583:main.c        **** 
 584:main.c        ****     p = &frame[4];
 585:main.c        ****     for (i = 0u; i < BATCH_SAMPLES; i++, p += 3u)
 586:main.c        ****     {
 587:main.c        ****         pos  = (uint16)(i * SAMPLE_BYTES);
 588:main.c        ****         p[0] = g_capture_raw[batchIndex][pos];
 589:main.c        ****         p[1] = g_capture_raw[batchIndex][pos + 1u];
 590:main.c        ****         p[2] = g_capture_raw[batchIndex][pos + 2u];
 591:main.c        ****     }
 592:main.c        **** 
 593:main.c        ****     for (i = 0u; i < (FRAME_BYTES - 1u); i++) { crc ^= frame[i]; }
 594:main.c        ****     frame[FRAME_BYTES - 1u] = crc;
 595:main.c        **** 
