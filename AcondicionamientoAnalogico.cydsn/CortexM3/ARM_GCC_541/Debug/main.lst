1508:main.c        ****     g_decim_acc = 0;
1509:main.c        ****     g_decim_n = 0u;
1510:main.c        ****     capture_store_decoded(dst, val);
1511:main.c        ****     dst += SAMPLE_BYTES;
1512:main.c        ****     g_capture_wr = dst;
