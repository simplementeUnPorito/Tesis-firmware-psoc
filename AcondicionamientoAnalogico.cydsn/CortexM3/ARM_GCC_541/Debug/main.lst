1352:main.c        ****     if (progress_ms == 0u) { progress_ms = 1u; }
1353:main.c        ****     if (watchdog_ms == 0u) { watchdog_ms = progress_ms; }
1354:main.c        ****     g_cal_progress_due = 0u;
1355:main.c        ****     g_cal_watchdog_due = 0u;
1356:main.c        ****     g_cal_progress_period_ms = progress_ms;
1357:main.c        ****     g_cal_watchdog_remaining_ms = watchdog_ms;
1358:main.c        ****     g_cal_timer_active = 1u;
1359:main.c        ****     g_idle_ping_due = 0u;
1360:main.c        ****     g_idle_ping_armed = 0u;
1361:main.c        ****     g_boot_ping_due = 0u;
1362:main.c        ****     timer1_arm_ms(progress_ms, TIMER1_MODE_CAL_TICK);
1363:main.c        ****     CyExitCriticalSection(saved);
1364:main.c        **** }
1365:main.c        **** 
