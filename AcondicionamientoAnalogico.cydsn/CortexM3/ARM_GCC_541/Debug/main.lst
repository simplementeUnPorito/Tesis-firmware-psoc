 945:main.c        **** static void tx1_bitbang_byte(uint8 value)
 946:main.c        **** {
 947:main.c        ****     uint8 i;
 948:main.c        **** 
 949:main.c        ****     tx1_manual_write(0u);
 950:main.c        ****     CyDelayUs(9u);
 951:main.c        ****     for (i = 0u; i < 8u; i++) {
 952:main.c        ****         tx1_manual_write((value >> i) & 0x01u);
