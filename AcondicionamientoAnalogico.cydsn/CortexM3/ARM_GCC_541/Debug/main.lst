 716:main.c        **** static void wait_for_esp(void)
 717:main.c        **** {
 718:main.c        ****     uint32 nextPing  = timer_now_ticks();
 719:main.c        ****     uint32 pingStart = nextPing;
 720:main.c        **** 
 721:main.c        ****     led_write(1u);
 722:main.c        ****     uart_send_diag(PSOC_EVT_WAIT_ESP, 0u);
 723:main.c        ****     while (!g_esp_connected)
 724:main.c        ****     {
 725:main.c        ****         uint32 now;
 726:main.c        ****         (void)service_button_calibration();
 727:main.c        ****         service_runtime();
 728:main.c        ****         now = timer_now_ticks();
 729:main.c        **** 
 730:main.c        ****         if (ticks_due(now, nextPing)) {
 731:main.c        ****             uart_send_ping();
 732:main.c        ****             pingStart = now;
 733:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 734:main.c        ****             led_write(1u);
 735:main.c        ****         }
 736:main.c        **** 
 737:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 738:main.c        ****             led_write(0u);
 739:main.c        ****         } else {
 740:main.c        ****             led_write(1u);
 741:main.c        ****         }
 742:main.c        ****     }
 743:main.c        **** }
