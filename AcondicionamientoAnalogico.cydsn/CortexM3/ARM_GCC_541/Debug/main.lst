 559:main.c        **** static void uart_send_capture_batch(uint16 batchIndex)
 560:main.c        **** {
 561:main.c        ****     uint8  frame[FRAME_BYTES];
 562:main.c        ****     uint8 *p;
 563:main.c        ****     uint16 i;
 564:main.c        ****     uint16 pos;
 565:main.c        ****     uint8  crc = 0u;
 566:main.c        **** 
 567:main.c        ****     frame[0] = 0xABu;
 568:main.c        ****     frame[1] = (uint8)BATCH_SAMPLES;
 569:main.c        ****     frame[2] = (uint8)( g_seq        & 0xFFu);
 570:main.c        ****     frame[3] = (uint8)((g_seq >> 8u) & 0xFFu);
 571:main.c        **** 
 572:main.c        ****     p = &frame[4];
 573:main.c        ****     for (i = 0u; i < BATCH_SAMPLES; i++, p += 3u)
 574:main.c        ****     {
 575:main.c        ****         pos  = (uint16)(i * SAMPLE_BYTES);
 576:main.c        ****         p[0] = g_capture_raw[batchIndex][pos];
 577:main.c        ****         p[1] = g_capture_raw[batchIndex][pos + 1u];
 578:main.c        ****         p[2] = g_capture_raw[batchIndex][pos + 2u];
 579:main.c        ****     }
 580:main.c        **** 
 581:main.c        ****     for (i = 0u; i < (FRAME_BYTES - 1u); i++) { crc ^= frame[i]; }
 582:main.c        ****     frame[FRAME_BYTES - 1u] = crc;
 583:main.c        **** 
