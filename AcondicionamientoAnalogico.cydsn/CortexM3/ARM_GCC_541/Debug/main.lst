 934:main.c        **** static void tx1_bitbang_byte(uint8 value)
 935:main.c        **** {
 936:main.c        ****     uint8 i;
 937:main.c        **** 
 938:main.c        ****     tx1_manual_write(0u);
 939:main.c        ****     CyDelayUs(9u);
 940:main.c        ****     for (i = 0u; i < 8u; i++) {
 941:main.c        ****         tx1_manual_write((value >> i) & 0x01u);
 942:main.c        ****         CyDelayUs(9u);
 943:main.c        ****     }
 944:main.c        ****     tx1_manual_write(1u);
 945:main.c        ****     CyDelayUs(9u);
 946:main.c        **** }
