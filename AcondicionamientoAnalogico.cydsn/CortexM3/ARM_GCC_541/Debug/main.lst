1060:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
1061:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
1062:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
1063:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
1064:main.c        ****  *                     cuando control_0=1
1065:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
1066:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
1067:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
1068:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
1069:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
1070:main.c        **** static void dma_adc_init(void)
1071:main.c        **** {
1072:main.c        ****     uint8 td;
1073:main.c        **** 
1074:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
1075:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
1076:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1077:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
1078:main.c        ****     td = CyDmaTdAllocate();
1079:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1080:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1081:main.c        ****     CyDmaTdSetAddress(td,
1082:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1083:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1084:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1085:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
1086:main.c        **** 
1087:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1088:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1089:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1090:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1091:main.c        ****     td = CyDmaTdAllocate();
1092:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1093:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1094:main.c        ****     CyDmaTdSetAddress(td,
1095:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1096:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1097:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
1098:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
1099:main.c        **** 
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccVZ3PTC.s 			page 395


1100:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
1101:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
1102:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
