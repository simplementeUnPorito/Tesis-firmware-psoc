 164:main.c        **** /* Telemetria de calibracion: envia el valor medido (counts, signo incluido)
 165:main.c        ****  * de la etapa como dos eventos PSOC_EVT_CAL_STAGE_MEAS (HI luego LO de un
 166:main.c        ****  * int16 saturado). target_counts=0 => este valor es directamente el error;
 167:main.c        ****  * ~0 confirma offset corregido, ~+-32767 indica saturacion/formato. */
 168:main.c        **** static void uart_send_cal_stage_meas(int32 value)
 169:main.c        **** {
 170:main.c        ****     uint16 u;
 171:main.c        ****     if (value > 32767L) { value = 32767L; }
 172:main.c        ****     if (value < -32768L) { value = -32768L; }
