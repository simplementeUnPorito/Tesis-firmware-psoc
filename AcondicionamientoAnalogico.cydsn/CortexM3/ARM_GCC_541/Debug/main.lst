 901:main.c        **** static void wait_for_esp(void)
 902:main.c        **** {
 903:main.c        ****     uint32 nextPing  = timer_now_ticks();
 904:main.c        ****     uint32 pingStart = nextPing;
 905:main.c        **** 
 906:main.c        ****     led_write(1u);
 907:main.c        ****     uart_send_diag(PSOC_EVT_WAIT_ESP, 0u);
 908:main.c        ****     while (!g_esp_connected)
 909:main.c        ****     {
 910:main.c        ****         uint32 now;
 911:main.c        ****         (void)service_button_calibration();
 912:main.c        ****         service_runtime();
 913:main.c        ****         now = timer_now_ticks();
 914:main.c        **** 
 915:main.c        ****         if (ticks_due(now, nextPing)) {
 916:main.c        ****             uart_send_ping();
 917:main.c        ****             pingStart = now;
 918:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 919:main.c        ****             led_write(1u);
 920:main.c        ****         }
 921:main.c        **** 
 922:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 923:main.c        ****             led_write(0u);
 924:main.c        ****         } else {
 925:main.c        ****             led_write(1u);
 926:main.c        ****         }
 927:main.c        ****     }
 928:main.c        **** }
