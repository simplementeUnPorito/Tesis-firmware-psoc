 596:main.c        ****         p[2] = g_capture_raw[batchIndex][pos + 2u];
 597:main.c        ****     }
 598:main.c        **** 
 599:main.c        ****     for (i = 0u; i < (FRAME_BYTES - 1u); i++) { crc ^= frame[i]; }
