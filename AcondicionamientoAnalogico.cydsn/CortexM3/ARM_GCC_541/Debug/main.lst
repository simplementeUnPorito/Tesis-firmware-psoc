 169:main.c        **** static void uart_send_cfg_ack(uint8 cmd, uint8 val)
 170:main.c        **** {
 171:main.c        ****     uint8 frame[5u];
 172:main.c        ****     frame[0] = 0xABu;
 173:main.c        ****     frame[1] = PSOC_CMD_CFG_ACK;
 174:main.c        ****     frame[2] = cmd;
 175:main.c        ****     frame[3] = val;
 176:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 177:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 178:main.c        **** }
 179:main.c        **** 
 180:main.c        **** static void uart_send_fs_report(void)
 181:main.c        **** {
 182:main.c        ****     uint8 fs_lo = (uint8)((uint16)ADC_DEFAULT_SRATE & 0xFFu);
 183:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
