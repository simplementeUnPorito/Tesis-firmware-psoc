 163:main.c        **** static void uart_send_diag(uint8 event, uint8 value)
 164:main.c        **** {
 165:main.c        **** #if PSOC_DIAG_ENABLE
 166:main.c        ****     uint8 state = g_state;
 167:main.c        ****     uint8 frame[6u];
 168:main.c        ****     frame[0] = 0xABu;
 169:main.c        ****     frame[1] = PSOC_CMD_DIAG_EVT;
 170:main.c        ****     frame[2] = event;
 171:main.c        ****     frame[3] = value;
 172:main.c        ****     frame[4] = state;
 173:main.c        ****     frame[5] = (uint8)(PSOC_CMD_DIAG_EVT ^ event ^ value ^ state);
 174:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 175:main.c        **** #else
 176:main.c        ****     (void)event;
 177:main.c        ****     (void)value;
 178:main.c        **** #endif
 179:main.c        **** }
