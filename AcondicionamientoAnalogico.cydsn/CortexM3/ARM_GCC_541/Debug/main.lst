1538:main.c        **** /* Variantes ring para captura a SD: mismos decode/decimación que las
1539:main.c        ****  * versiones RAM-only, pero escriben por contador monotónico con wrap y
1540:main.c        ****  * detección de overrun en vez de puntero lineal. Instaladas SOLO cuando
1541:main.c        ****  * g_sd_cap_active=1 — las versiones clásicas quedan intactas. */
1542:main.c        **** static void sd_ring_store(int32 val)
1543:main.c        **** {
1544:main.c        ****     volatile uint8 *dst;
1545:main.c        ****     uint32 written = g_sd_ring_samples;
1546:main.c        **** 
1547:main.c        ****     if (written >= g_sd_target_samples) {
1548:main.c        ****         return;
1549:main.c        ****     }
1550:main.c        ****     if ((written - g_sd_ring_drained) >= SD_RING_SAMPLES) {
1551:main.c        ****         /* Ring lleno: la SD no drenó a tiempo. Se descarta la muestra y se
1552:main.c        ****          * reporta al final (PSOC_EVT_SD_ERROR bit1). */
1553:main.c        ****         g_sd_drop_samples++;
1554:main.c        ****         g_capture_done = 1u;
1555:main.c        ****         return;
1556:main.c        ****     }
1557:main.c        ****     dst = g_capture_raw + ((written % SD_RING_SAMPLES) * (uint32)SAMPLE_BYTES);
1558:main.c        ****     /* El archivo es independiente de la config ADC activa: guarda siempre el
1559:main.c        ****      * mismo int24 right-aligned que se transmite por UART. */
1560:main.c        ****     val = psoc_adc_counts_right_aligned(val);
1561:main.c        ****     capture_store_decoded(dst, val);
1562:main.c        ****     written++;
1563:main.c        ****     g_sd_ring_samples = written;
1564:main.c        ****     if (written >= g_sd_target_samples) {
1565:main.c        ****         g_capture_done = 1u;
1566:main.c        ****     }
1567:main.c        **** }
