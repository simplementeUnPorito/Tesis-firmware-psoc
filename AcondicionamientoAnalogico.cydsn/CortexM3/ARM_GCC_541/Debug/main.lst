 187:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
 188:main.c        ****     uint8 frame[5u];
 189:main.c        ****     frame[0] = 0xABu;
 190:main.c        ****     frame[1] = PSOC_CMD_FS_REPORT;
 191:main.c        ****     frame[2] = fs_lo;
 192:main.c        ****     frame[3] = fs_hi;
 193:main.c        ****     frame[4] = (uint8)(PSOC_CMD_FS_REPORT ^ fs_lo ^ fs_hi);
 194:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 195:main.c        **** }
