1577:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
1578:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo en ruta raw
1579:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
1580:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
1581:main.c        ****  *                     en ruta filtrada
1582:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
1583:main.c        ****  * Cual DRQ recibe el trigger real lo decide superMaquina desde cfg/ctrl; el
1584:main.c        ****  * ARM solo configura la ruta con dma_route_select(). DMA_Filter_RAM solo
1585:main.c        ****  * produce datos cuando el Filter esta siendo alimentado. */
1586:main.c        **** static void dma_adc_init(void)
1587:main.c        **** {
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccXIIflq.s 			page 586


1588:main.c        ****     uint8 td;
