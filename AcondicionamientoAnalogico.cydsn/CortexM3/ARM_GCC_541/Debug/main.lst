  48:main.c        **** #include "DMA_Filter_RAM_dma.h"
  49:main.c        **** #include "DMA_DelSig_Filter_dma.h"
  50:main.c        **** #include "Filter.h"
  51:main.c        **** #include "Filter_PVT.h"
  52:main.c        **** #include "Reg_Select.h"
  53:main.c        **** #include "filter_coeffs.h"
  54:main.c        **** #include "FIR_adquisition.h"
  55:main.c        **** #include "psoc_debug.h"
  56:main.c        **** /* -------------------------------------------------------------------------- */
  57:main.c        **** #define LEGACY_VDAC_SHADOW_INIT 0x9Cu
  58:main.c        **** /* FILTER_FIR_NTAPS vive en filter_coeffs.h (unica fuente de verdad,
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccvlhEPW.s 			page 260


  59:main.c        ****  * compartida con calibration.c). */
  60:main.c        **** #define FILTER_GROUP_DELAY ((FILTER_FIR_NTAPS - 1u) / 2u)   /* 63 muestras */
  61:main.c        **** 
  62:main.c        **** #ifndef PSOC_LOAD_NV_CAL_ON_BOOT
  63:main.c        **** #define PSOC_LOAD_NV_CAL_ON_BOOT 0u
  64:main.c        **** #endif
  65:main.c        **** #define TIMER_TICK_MS      10u
  66:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema */
  67:main.c        **** 
  68:main.c        **** #define BATCH_SAMPLES      30u
  69:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  70:main.c        **** #define SAMPLE_BYTES       3u
  71:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  72:main.c        **** 
  73:main.c        **** #ifndef PSOC_CAPTURE_MAX_BATCHES
  74:main.c        **** #define PSOC_CAPTURE_MAX_BATCHES 512u
