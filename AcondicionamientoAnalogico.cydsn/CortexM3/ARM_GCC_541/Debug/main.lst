 903:main.c        **** static void wait_for_esp(void)
 904:main.c        **** {
 905:main.c        ****     uint32 nextPing  = timer_now_ticks();
 906:main.c        ****     uint32 pingStart = nextPing;
 907:main.c        **** 
 908:main.c        ****     led_write(1u);
 909:main.c        ****     uart_send_diag(PSOC_EVT_WAIT_ESP, 0u);
 910:main.c        ****     while (!g_esp_connected)
 911:main.c        ****     {
 912:main.c        ****         uint32 now;
 913:main.c        ****         (void)service_button_calibration();
 914:main.c        ****         service_runtime();
 915:main.c        ****         now = timer_now_ticks();
 916:main.c        **** 
 917:main.c        ****         if (ticks_due(now, nextPing)) {
 918:main.c        ****             uart_send_ping();
 919:main.c        ****             pingStart = now;
 920:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 921:main.c        ****             led_write(1u);
 922:main.c        ****         }
 923:main.c        **** 
 924:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 925:main.c        ****             led_write(0u);
 926:main.c        ****         } else {
 927:main.c        ****             led_write(1u);
 928:main.c        ****         }
 929:main.c        ****     }
 930:main.c        **** }
