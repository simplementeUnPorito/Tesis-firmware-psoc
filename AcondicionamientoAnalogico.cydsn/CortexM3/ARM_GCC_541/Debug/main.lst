 169:main.c        ****     frame[3] = val;
 170:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 171:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 172:main.c        **** }
