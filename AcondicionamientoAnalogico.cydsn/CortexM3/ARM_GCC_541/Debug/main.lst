 174:main.c        **** static void uart_send_fs_report(void)
 175:main.c        **** {
 176:main.c        ****     uint8 fs_lo = (uint8)((uint16)ADC_DEFAULT_SRATE & 0xFFu);
 177:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
 178:main.c        ****     uint8 frame[5u];
 179:main.c        ****     frame[0] = 0xABu;
 180:main.c        ****     frame[1] = PSOC_CMD_FS_REPORT;
 181:main.c        ****     frame[2] = fs_lo;
 182:main.c        ****     frame[3] = fs_hi;
 183:main.c        ****     frame[4] = (uint8)(PSOC_CMD_FS_REPORT ^ fs_lo ^ fs_hi);
 184:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 185:main.c        **** }
