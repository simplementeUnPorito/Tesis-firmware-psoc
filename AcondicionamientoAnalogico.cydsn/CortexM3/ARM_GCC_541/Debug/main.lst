 437:main.c        **** static uint16 timer_take_chunk(volatile uint32 *remaining_counts)
 438:main.c        **** {
 439:main.c        ****     uint32 remaining = *remaining_counts;
 440:main.c        ****     uint16 chunk;
 441:main.c        **** 
