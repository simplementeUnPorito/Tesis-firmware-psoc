 927:main.c        **** static void service_comm_led(uint32 now)
 928:main.c        **** {
 929:main.c        ****     static uint32 lastTick   = 0u;
 930:main.c        ****     static uint32 blinkTicks = 0u;
 931:main.c        ****     uint32 elapsed;
 932:main.c        **** 
 933:main.c        ****     if (g_state == PSOC_SAMPLING) {
 934:main.c        ****         lastTick = now;
 935:main.c        ****         return;
 936:main.c        ****     }
 937:main.c        **** 
 938:main.c        ****     if (lastTick == 0u) { lastTick = now; return; }
 939:main.c        **** 
 940:main.c        ****     elapsed = now - lastTick;
 941:main.c        ****     if (elapsed == 0u) { return; }
 942:main.c        ****     lastTick = now;
 943:main.c        **** 
 944:main.c        ****     if (g_comm_countdown > elapsed) {
 945:main.c        ****         g_comm_countdown -= elapsed;
 946:main.c        ****     } else {
 947:main.c        ****         g_comm_countdown = 0u;
 948:main.c        ****     }
 949:main.c        **** 
 950:main.c        ****     if (g_comm_countdown > 0u) {
 951:main.c        ****         blinkTicks += elapsed;
 952:main.c        ****         if (blinkTicks >= COMM_BLINK_TICKS) {
 953:main.c        ****             blinkTicks = 0u;
 954:main.c        ****             led_toggle();
 955:main.c        ****         }
 956:main.c        ****     } else {
 957:main.c        ****         led_write(1u);
 958:main.c        ****         blinkTicks = 0u;
 959:main.c        ****     }
 960:main.c        **** }
