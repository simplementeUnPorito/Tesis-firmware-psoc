1347:main.c        **** /* Tick de calibracion sobre Timer_1: progreso periodico + watchdog global.
1348:main.c        ****  * Nunca concurre con los pings (los callers detienen idle/boot ping antes). */
1349:main.c        **** void psoc_cal_timer_start(uint32 progress_ms, uint32 watchdog_ms)
1350:main.c        **** {
