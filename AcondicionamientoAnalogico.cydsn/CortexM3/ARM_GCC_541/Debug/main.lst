 848:main.c        ****             uart_send_ping();
 849:main.c        ****             pingStart = now;
 850:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 851:main.c        ****             led_write(1u);
 852:main.c        ****         }
 853:main.c        **** 
 854:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 855:main.c        ****             led_write(0u);
