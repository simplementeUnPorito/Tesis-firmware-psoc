   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Firmware PSoC unificado para geófono (GEO) y martillo (HAMMER).
   3:main.c        **** *
   4:main.c        **** * El hardware del TopDesign determina automáticamente el modo de compilación:
   5:main.c        **** *   Si el proyecto tiene PGAgain  → CLASS = GEO    (geófono diferencial)
   6:main.c        **** *   Si el proyecto tiene PGA      → CLASS = HAMMER  (martillo piezoeléctrico)
   7:main.c        **** * No hay que cambiar nada en este archivo al cambiar de proyecto.
   8:main.c        **** *
   9:main.c        **** * ────────────────────────────────�
  10:main.c        **** *  GEO — componentes TopDesign:
  11:main.c        **** *    UART, ADC, VDAC, PGAgain, PGAvdac, OPAref, PGAp, PGAn, LPF_1, LPF_2,
  12:main.c        **** *    OPAbp, OPAadder, OPAlp, Timer, LED, isr_DelSig, isr_Timer, isr_SyncIn.
  13:main.c        **** *
  14:main.c        **** *  HAMMER — componentes TopDesign:
  15:main.c        **** *    UART, ADC, VDAC, PGA, PGA_ref, Opa_ref, LPF_ADC, LPF_ref,
  16:main.c        **** *    Timer, LED, isr_DelSig, isr_Timer, isr_SyncIn.
  17:main.c        **** * ────────────────────────────────�
  18:main.c        **** *
  19:main.c        **** * Cadena: MATLAB → maestro → esclavo (ESP-NOW) → PSoC (UART).
  20:main.c        **** * El PSoC muestrea N lotes de 30 muestras RAW, los guarda en RAM
  21:main.c        **** * sin UART durante la ventana crítica, y recién después los envía al ESP.
  22:main.c        **** * El arranque del muestreo es por el pin digital SYNC_IN (lo maneja el ESP).
  23:main.c        **** *
  24:main.c        **** * TX UART — frame de datos RAW (95 bytes):
  25:main.c        **** *   [0xAB][n=30][seq_lo][seq_hi] + 30×3 bytes (raw LE: b0,b1,b2) + [crc XOR]
  26:main.c        **** *
  27:main.c        **** * RX UART — comandos con checksum XOR:
  28:main.c        **** *   1 param : [0xAB][cmd][param][cmd^param]
  29:main.c        **** *       0xA5 status/probe   0xA6 set PGAgain (0-8)   0xA9 set PGAvdac (0-8)
  30:main.c        **** *       0xAA set VDAC       0xB1 arm (espera SYNC)   0xB3 debug rampa (0/1)
  31:main.c        **** *       0xB4 start-now      0xC1 pong
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccXizWSb.s 			page 2


  32:main.c        **** *   2 param : [0xAB][0xA3][n_lo][n_hi][0xA3^n_lo^n_hi]   (set N lotes)
  33:main.c        **** *
  34:main.c        **** * Detección PSoC ↔ ESP:
  35:main.c        **** *   PSoC → ESP : [0xAB][0xC0][0x00][0xC0]             (ping)
  36:main.c        **** *   ESP  → PSoC: [0xAB][0xC1][0x00][0xC1]             (pong)
  37:main.c        **** *   PSoC → ESP : [0xAB][0xC2][cmd][val][0xC2^cmd^val]  (config ACK)
  38:main.c        **** *******************************************************************************/
  39:main.c        **** 
  40:main.c        **** #include "project.h"
  41:main.c        **** 
  42:main.c        **** /* ── Auto-detección de hardware por los componentes del TopDesign ─────────
  43:main.c        **** #define GEO    0
  44:main.c        **** #define HAMMER 1
  45:main.c        **** 
  46:main.c        **** #if defined(PGAgain_DEFAULT_GAIN)
  47:main.c        ****   #define CLASS GEO
  48:main.c        **** #elif defined(PGA_DEFAULT_GAIN)
  49:main.c        ****   #define CLASS HAMMER
  50:main.c        **** #else
  51:main.c        ****   #error "Hardware no reconocido: el TopDesign debe tener PGAgain (GEO) o PGA (HAMMER)."
  52:main.c        **** #endif
  53:main.c        **** 
  54:main.c        **** /* -------------------------------------------------------------------------- */
  55:main.c        **** #define VDAC_INIT_VALUE    0x94u
  56:main.c        **** #define TIMER_TICK_MS      10u
  57:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema */
  58:main.c        **** 
  59:main.c        **** #define BATCH_SAMPLES      30u
  60:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  61:main.c        **** #define SAMPLE_BYTES       3u
  62:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  63:main.c        **** 
  64:main.c        **** #ifndef PSOC_CAPTURE_MAX_BATCHES
  65:main.c        **** #define PSOC_CAPTURE_MAX_BATCHES 512u
  66:main.c        **** #endif
  67:main.c        **** 
  68:main.c        **** #define PSOC_IDLE          0u
  69:main.c        **** #define PSOC_ARMED         1u
  70:main.c        **** #define PSOC_SAMPLING      2u
  71:main.c        **** 
  72:main.c        **** #define PSOC_CMD_PING      0xC0u
  73:main.c        **** #define PSOC_CMD_PONG      0xC1u
  74:main.c        **** #define PSOC_CMD_CFG_ACK   0xC2u
  75:main.c        **** 
  76:main.c        **** #define PING_PERIOD_MS     700u
  77:main.c        **** #define PING_OFF_MS        100u
  78:main.c        **** #define IDLE_PING_MS       1000u
  79:main.c        **** #define COMM_WINDOW_MS     500u
  80:main.c        **** #define COMM_BLINK_MS       50u
  81:main.c        **** 
  82:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  83:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  84:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  85:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  86:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  87:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
  88:main.c        **** #define CONNECT_BLINK_TICKS   MS_TO_TICKS(80u)
