 922:main.c        **** static int32 sign_extend_bits(uint32 value, uint8 bits)
 923:main.c        **** {
 924:main.c        ****     uint32 sign;
 925:main.c        ****     uint32 mask;
 926:main.c        **** 
 927:main.c        ****     if (bits == 0u || bits >= 32u) {
 928:main.c        ****         return (int32)value;
 929:main.c        ****     }
 930:main.c        ****     sign = (uint32)1u << (bits - 1u);
 931:main.c        ****     mask = (sign << 1u) - 1u;
 932:main.c        ****     value &= mask;
 933:main.c        ****     return (value & sign) ? (int32)(value | ~mask) : (int32)value;
 934:main.c        **** }
 935:main.c        **** 
 936:main.c        **** /* Reconstruye int32 signed a partir de una palabra DMA LE de 24 bits. */
 937:main.c        **** static int32 dma_buf_to_i24(const volatile uint8 *buf)
 938:main.c        **** {
 939:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
 940:main.c        ****     return sign_extend_bits(u, 24u);
 941:main.c        **** }
