 942:main.c        **** 
 943:main.c        **** /* El ADC raw puede venir right-aligned (config 2), donde el bit de signo real
 944:main.c        ****  * es resolution-1. La salida del DFB sigue usando dma_buf_to_i24(). */
 945:main.c        **** static int32 dma_buf_to_adc_counts(const volatile uint8 *buf)
 946:main.c        **** {
 947:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
 948:main.c        **** 
 949:main.c        **** #if (ADC_DEFAULT_NUM_CONFIGS > 1)
 950:main.c        **** #if (ADC_CF_0V512_ALIGNMENT == 0u)
 951:main.c        ****     if (ADC_Config == ADC_CF_0V512) {
 952:main.c        ****         return sign_extend_bits(u, (uint8)ADC_CF_0V512_RESOLUTION);
 953:main.c        ****     }
 954:main.c        **** #endif
 955:main.c        **** #endif
 956:main.c        **** 
 957:main.c        ****     return sign_extend_bits(u, 24u);
 958:main.c        **** }
