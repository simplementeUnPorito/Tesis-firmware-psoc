  86:main.c        **** #define isr_Timer_1_Disable()             (*(isr_Timer_1_INTC_CLR_EN) = isr_Timer_1__INTC_MASK)
  87:main.c        **** #define isr_Timer_1_ClearPending()        (*(isr_Timer_1_INTC_CLR_PD) = isr_Timer_1__INTC_MASK)
  88:main.c        **** #else
