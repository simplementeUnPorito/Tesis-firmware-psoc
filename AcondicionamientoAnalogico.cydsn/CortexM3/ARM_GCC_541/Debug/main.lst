 125:main.c        **** /* Buffers destino DMA — 3 bytes LE (24 bits signed) por muestra */
 126:main.c        **** static volatile uint8  g_dma_raw_buf[3]   = {0u, 0u, 0u};
 127:main.c        **** static volatile uint8  g_dma_filt_buf[3]  = {0u, 0u, 0u};
