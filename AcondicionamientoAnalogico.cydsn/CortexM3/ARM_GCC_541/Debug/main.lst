   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Firmware PSoC unificado para geófono (GEO) y martillo (HAMMER).
   3:main.c        **** *
   4:main.c        **** * El hardware del TopDesign determina automáticamente el modo de compilación:
   5:main.c        **** *   Si el proyecto tiene PGAgain  → PSOC_HW_CLASS = GEO
   6:main.c        **** *   Si el proyecto tiene PGA      → PSOC_HW_CLASS = HAMMER
   7:main.c        **** * No hay que cambiar nada en este archivo al cambiar de proyecto.
   8:main.c        **** *
   9:main.c        **** * ────────────────────────────────�
  10:main.c        **** *  GEO — componentes TopDesign:
  11:main.c        **** *    UART, ADC, AMux_ADC, VDAC_ref_*, PGAgain, OPAref, PGAp,
  12:main.c        **** *    PGAn, LPF_1, LPF_2, OPAbp, OPAadder, OPAlp, Timer, LED, isr_*.
  13:main.c        **** *
  14:main.c        **** *  HAMMER — componentes TopDesign:
  15:main.c        **** *    UART, ADC, AMux_ADC, VDAC_ref_IN, VDAC_PGA, VDAC_LP,
  16:main.c        **** *    PGA, Opa_ref_IN, Opa_ref_PGA, Opa_LP, LPF_ADC, LPF_ref, Timer, LED.
  17:main.c        **** * ────────────────────────────────�
  18:main.c        **** *
  19:main.c        **** * Cadena: MATLAB → maestro → esclavo (ESP-NOW) → PSoC (UART).
  20:main.c        **** * El PSoC muestrea N lotes de 30 muestras RAW, los guarda en RAM
  21:main.c        **** * sin UART durante la ventana crítica, y recién después los envía al ESP.
  22:main.c        **** * El arranque del muestreo es por el pin digital SYNC_IN (lo maneja el ESP).
  23:main.c        **** *
  24:main.c        **** * TX UART — frame de datos RAW (95 bytes):
  25:main.c        **** *   [0xAB][n=30][seq_lo][seq_hi] + 30×3 bytes (raw LE: b0,b1,b2) + [crc XOR]
  26:main.c        **** *
  27:main.c        **** * RX UART — comandos con checksum XOR:
  28:main.c        **** *   1 param : [0xAB][cmd][param][cmd^param]
  29:main.c        **** *       0xA5 status/probe   0xA6 set PGA (0-8)       0xA9 legacy ACK
  30:main.c        **** *       0xAA legacy ACK     0xB1 arm (espera SYNC)   0xB3 debug rampa (0/1)
  31:main.c        **** *       0xB4 start-now      0xB5 calibrar refs       0xC1 pong
  32:main.c        **** *   2 param : [0xAB][0xA3][n_lo][n_hi][0xA3^n_lo^n_hi]   (set N lotes)
  33:main.c        **** *
  34:main.c        **** * Detección PSoC ↔ ESP:
  35:main.c        **** *   PSoC → ESP : [0xAB][0xC0][0x00][0xC0]             (ping)
  36:main.c        **** *   ESP  → PSoC: [0xAB][0xC1][0x00][0xC1]             (pong)
  37:main.c        **** *   PSoC → ESP : [0xAB][0xC2][cmd][val][0xC2^cmd^val]  (config ACK)
  38:main.c        **** *******************************************************************************/
  39:main.c        **** 
  40:main.c        **** #include "project.h"
ARM GAS  C:\Users\elias\AppData\Local\Temp\cczO1h9Y.s 			page 188


  41:main.c        **** #include "psoc_hw.h"
  42:main.c        **** #include "psoc_adc.h"
  43:main.c        **** #include "calibration.h"
  44:main.c        **** #include "LED.h"
  45:main.c        **** /* -------------------------------------------------------------------------- */
  46:main.c        **** #define LEGACY_VDAC_SHADOW_INIT 0x9Cu
  47:main.c        **** #define TIMER_TICK_MS      10u
  48:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema */
  49:main.c        **** 
  50:main.c        **** #define BATCH_SAMPLES      30u
  51:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  52:main.c        **** #define SAMPLE_BYTES       3u
  53:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  54:main.c        **** 
  55:main.c        **** #ifndef PSOC_CAPTURE_MAX_BATCHES
  56:main.c        **** #define PSOC_CAPTURE_MAX_BATCHES 512u
  57:main.c        **** #endif
  58:main.c        **** 
  59:main.c        **** #define PING_PERIOD_MS     700u
  60:main.c        **** #define PING_OFF_MS        100u
  61:main.c        **** #define IDLE_PING_MS       1000u
  62:main.c        **** #define COMM_WINDOW_MS     500u
  63:main.c        **** #define COMM_BLINK_MS       50u
  64:main.c        **** 
  65:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  66:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  67:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  68:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  69:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  70:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
  71:main.c        **** #define CONNECT_BLINK_TICKS   MS_TO_TICKS(80u)
  72:main.c        **** 
  73:main.c        **** #ifndef PSOC_DIAG_ENABLE
  74:main.c        **** #define PSOC_DIAG_ENABLE      1
  75:main.c        **** #endif
  76:main.c        **** 
  77:main.c        **** #ifndef PSOC_DEBUG_LED
  78:main.c        **** #define PSOC_DEBUG_LED        1
  79:main.c        **** #endif
  80:main.c        **** 
