  50:main.c        **** #include "Filter.h"
  51:main.c        **** #include "Filter_PVT.h"
  52:main.c        **** #include "Reg_Select.h"
  53:main.c        **** #include "filter_coeffs.h"
  54:main.c        **** #include "FIR_adquisition.h"
  55:main.c        **** #include "psoc_debug.h"
  56:main.c        **** /* -------------------------------------------------------------------------- */
  57:main.c        **** #define LEGACY_VDAC_SHADOW_INIT 0x9Cu
  58:main.c        **** /* FILTER_FIR_NTAPS vive en filter_coeffs.h (unica fuente de verdad,
  59:main.c        ****  * compartida con calibration.c). */
  60:main.c        **** #define FILTER_GROUP_DELAY ((FILTER_FIR_NTAPS - 1u) / 2u)   /* 63 muestras */
  61:main.c        **** #define TIMER_TICK_MS      10u
  62:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema */
  63:main.c        **** 
  64:main.c        **** #define BATCH_SAMPLES      30u
  65:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  66:main.c        **** #define SAMPLE_BYTES       3u
  67:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  68:main.c        **** 
  69:main.c        **** #ifndef PSOC_CAPTURE_MAX_BATCHES
  70:main.c        **** #define PSOC_CAPTURE_MAX_BATCHES 512u
  71:main.c        **** #endif
  72:main.c        **** 
  73:main.c        **** #define PING_PERIOD_MS     700u
  74:main.c        **** #define PING_OFF_MS        100u
  75:main.c        **** #define IDLE_PING_MS       1000u
  76:main.c        **** #define COMM_WINDOW_MS     500u
  77:main.c        **** #define COMM_BLINK_MS       50u
  78:main.c        **** 
  79:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  80:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  81:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  82:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  83:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  84:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccBW9QwS.s 			page 251


