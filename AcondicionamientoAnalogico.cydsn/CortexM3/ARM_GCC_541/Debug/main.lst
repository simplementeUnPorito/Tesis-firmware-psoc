 139:main.c        **** static void uart_send_cfg_ack(uint8 cmd, uint8 val)
 140:main.c        **** {
 141:main.c        ****     uint8 frame[5u];
 142:main.c        ****     frame[0] = 0xABu;
 143:main.c        ****     frame[1] = PSOC_CMD_CFG_ACK;
 144:main.c        ****     frame[2] = cmd;
 145:main.c        ****     frame[3] = val;
 146:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 147:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 148:main.c        **** }
