 172:main.c        **** static void uart_send_cfg_ack(uint8 cmd, uint8 val)
 173:main.c        **** {
 174:main.c        ****     uint8 frame[5u];
 175:main.c        ****     frame[0] = 0xABu;
 176:main.c        ****     frame[1] = PSOC_CMD_CFG_ACK;
 177:main.c        ****     frame[2] = cmd;
 178:main.c        ****     frame[3] = val;
 179:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 180:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 181:main.c        **** }
 182:main.c        **** 
 183:main.c        **** static void uart_send_fs_report(void)
 184:main.c        **** {
 185:main.c        ****     uint8 fs_lo = (uint8)((uint16)ADC_DEFAULT_SRATE & 0xFFu);
 186:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
 187:main.c        ****     uint8 frame[5u];
 188:main.c        ****     frame[0] = 0xABu;
 189:main.c        ****     frame[1] = PSOC_CMD_FS_REPORT;
 190:main.c        ****     frame[2] = fs_lo;
 191:main.c        ****     frame[3] = fs_hi;
 192:main.c        ****     frame[4] = (uint8)(PSOC_CMD_FS_REPORT ^ fs_lo ^ fs_hi);
 193:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 194:main.c        **** }
 195:main.c        **** 
 196:main.c        **** static void uart_send_diag(uint8 event, uint8 value)
 197:main.c        **** {
 198:main.c        **** #if PSOC_DIAG_ENABLE
 199:main.c        ****     uint8 state = g_state;
 200:main.c        ****     uint8 frame[6u];
 201:main.c        ****     frame[0] = 0xABu;
 202:main.c        ****     frame[1] = PSOC_CMD_DIAG_EVT;
 203:main.c        ****     frame[2] = event;
 204:main.c        ****     frame[3] = value;
 205:main.c        ****     frame[4] = state;
 206:main.c        ****     frame[5] = (uint8)(PSOC_CMD_DIAG_EVT ^ event ^ value ^ state);
 207:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 208:main.c        **** #else
 209:main.c        ****     (void)event;
 210:main.c        ****     (void)value;
 211:main.c        **** #endif
 212:main.c        **** }
