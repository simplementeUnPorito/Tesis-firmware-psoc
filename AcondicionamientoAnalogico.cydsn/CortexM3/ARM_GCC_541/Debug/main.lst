 922:main.c        **** static int32 sign_extend_bits(uint32 value, uint8 bits)
 923:main.c        **** {
 924:main.c        ****     uint32 sign;
 925:main.c        ****     uint32 mask;
 926:main.c        **** 
 927:main.c        ****     if (bits == 0u || bits >= 32u) {
 928:main.c        ****         return (int32)value;
 929:main.c        ****     }
 930:main.c        ****     sign = (uint32)1u << (bits - 1u);
 931:main.c        ****     mask = (sign << 1u) - 1u;
 932:main.c        ****     value &= mask;
 933:main.c        ****     return (value & sign) ? (int32)(value | ~mask) : (int32)value;
 934:main.c        **** }
 935:main.c        **** 
 936:main.c        **** /* Reconstruye int32 signed a partir de una palabra DMA LE de 24 bits. */
 937:main.c        **** static int32 dma_buf_to_i24(const volatile uint8 *buf)
 938:main.c        **** {
 939:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
 940:main.c        ****     return sign_extend_bits(u, 24u);
 941:main.c        **** }
 942:main.c        **** 
 943:main.c        **** /* El ADC raw puede venir right-aligned (configs 2/3/4: CF_0V512, CF_1V024,
 944:main.c        ****  * CF_0V625), donde el bit de signo real es resolution-1. Solo CF_2V5 es
 945:main.c        ****  * left-aligned (Bit-23 OVF Protected) y ya viene sign-extendido en 24 bits.
 946:main.c        ****  * La salida del DFB sigue usando dma_buf_to_i24(). */
 947:main.c        **** static int32 dma_buf_to_adc_counts(const volatile uint8 *buf)
 948:main.c        **** {
 949:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
 950:main.c        **** 
 951:main.c        **** #if (ADC_DEFAULT_NUM_CONFIGS > 1)
 952:main.c        **** #if (ADC_CF_0V512_ALIGNMENT == 0u)
 953:main.c        ****     if (ADC_Config != ADC_CF_2V5) {
 954:main.c        ****         return sign_extend_bits(u, (uint8)ADC_CF_0V512_RESOLUTION);
 955:main.c        ****     }
 956:main.c        **** #endif
 957:main.c        **** #endif
 958:main.c        **** 
 959:main.c        ****     return sign_extend_bits(u, 24u);
 960:main.c        **** }
 961:main.c        **** 
