 890:main.c        **** static void wait_for_esp(void)
 891:main.c        **** {
 892:main.c        ****     uint32 nextPing  = timer_now_ticks();
 893:main.c        ****     uint32 pingStart = nextPing;
 894:main.c        **** 
 895:main.c        ****     led_write(1u);
 896:main.c        ****     uart_send_diag(PSOC_EVT_WAIT_ESP, 0u);
 897:main.c        ****     while (!g_esp_connected)
 898:main.c        ****     {
 899:main.c        ****         uint32 now;
 900:main.c        ****         (void)service_button_calibration();
 901:main.c        ****         service_runtime();
 902:main.c        ****         now = timer_now_ticks();
 903:main.c        **** 
 904:main.c        ****         if (ticks_due(now, nextPing)) {
 905:main.c        ****             uart_send_ping();
 906:main.c        ****             pingStart = now;
 907:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 908:main.c        ****             led_write(1u);
 909:main.c        ****         }
 910:main.c        **** 
 911:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 912:main.c        ****             led_write(0u);
 913:main.c        ****         } else {
 914:main.c        ****             led_write(1u);
 915:main.c        ****         }
 916:main.c        ****     }
 917:main.c        **** }
