 132:main.c        **** /* Buffer plano de captura: N lotes x 30 muestras x 3 bytes. El hot path de la
 133:main.c        ****  * ISR solo copia 3 bytes al puntero de escritura; el alineado de counts se
 134:main.c        ****  * difiere al volcado UART (uart_send_capture_batch). */
 135:main.c        **** static volatile uint8  g_capture_raw[(uint32)PSOC_CAPTURE_MAX_BATCHES * CAPTURE_BATCH_BYTES];
 136:main.c        **** static volatile uint8 * volatile g_capture_wr  = g_capture_raw;
