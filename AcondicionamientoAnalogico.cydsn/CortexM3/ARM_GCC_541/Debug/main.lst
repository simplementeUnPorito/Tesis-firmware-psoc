 893:main.c        ****             uart_send_ping();
 894:main.c        ****             pingStart = now;
 895:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 896:main.c        ****             led_write(1u);
 897:main.c        ****         }
 898:main.c        **** 
 899:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 900:main.c        ****             led_write(0u);
 901:main.c        ****         } else {
 902:main.c        ****             led_write(1u);
 903:main.c        ****         }
 904:main.c        ****     }
 905:main.c        **** }
