 967:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
ARM GAS  C:\Users\elias\AppData\Local\Temp\cccaHnOL.s 			page 371


 968:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
 969:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
 970:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
 971:main.c        ****  *                     cuando control_0=1
 972:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
 973:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
 974:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
 975:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
 976:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
 977:main.c        **** static void dma_adc_init(void)
 978:main.c        **** {
 979:main.c        ****     uint8 td;
 980:main.c        **** 
 981:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
 982:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
 983:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
 984:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
 985:main.c        ****     td = CyDmaTdAllocate();
 986:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
 987:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_DST_ADR);
 988:main.c        ****     CyDmaTdSetAddress(td,
 989:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
