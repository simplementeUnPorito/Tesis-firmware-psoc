1060:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
1061:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
1062:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
1063:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
1064:main.c        ****  *                     cuando control_0=1
1065:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
1066:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
1067:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
1068:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
1069:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
1070:main.c        **** static void dma_adc_init(void)
1071:main.c        **** {
1072:main.c        ****     uint8 td;
1073:main.c        **** 
