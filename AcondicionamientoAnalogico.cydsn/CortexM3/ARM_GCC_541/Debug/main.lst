 580:main.c        **** static void service_comm_led(uint32 now)
 581:main.c        **** {
 582:main.c        ****     static uint32 lastTick   = 0u;
 583:main.c        ****     static uint32 blinkTicks = 0u;
 584:main.c        ****     uint32 elapsed;
 585:main.c        **** 
 586:main.c        ****     if (g_state == PSOC_SAMPLING) {
 587:main.c        ****         lastTick = now;
 588:main.c        ****         return;
 589:main.c        ****     }
 590:main.c        **** 
