 739:main.c        **** 
 740:main.c        ****     psoc_adc_note_isr_filtered_sample(filt);
 741:main.c        **** 
 742:main.c        ****     if (g_fir_discard > 0u) { g_fir_discard--; return; }  /* descarte retardo grupo FIR */
 743:main.c        ****     if (g_stream_mode == 0u) { return; }                   /* modo RAW: no capturar filtrado */
 744:main.c        **** 
 745:main.c        ****     if (g_state == PSOC_SAMPLING && g_capture_done == 0u &&
 746:main.c        ****         g_batches_captured < capture_target_batches() &&
 747:main.c        ****         g_batch_fill < BATCH_SAMPLES)
 748:main.c        ****     {
 749:main.c        ****         uint16 pos = (uint16)(g_batch_fill * SAMPLE_BYTES);
 750:main.c        ****         g_capture_raw[g_batches_captured][pos]      = (uint8)( filt        & 0xFFu);
 751:main.c        ****         g_capture_raw[g_batches_captured][pos + 1u] = (uint8)((filt >>  8u) & 0xFFu);
 752:main.c        ****         g_capture_raw[g_batches_captured][pos + 2u] = (uint8)((filt >> 16u) & 0xFFu);
 753:main.c        ****         g_batch_fill++;
 754:main.c        ****         if (g_batch_fill >= BATCH_SAMPLES)
 755:main.c        ****         {
 756:main.c        ****             g_batch_fill = 0u;
 757:main.c        ****             g_batches_captured++;
 758:main.c        ****             if (g_batches_captured >= capture_target_batches()) {
 759:main.c        ****                 g_capture_done = 1u;
 760:main.c        ****             }
 761:main.c        ****         }
 762:main.c        ****     }
 763:main.c        **** }
