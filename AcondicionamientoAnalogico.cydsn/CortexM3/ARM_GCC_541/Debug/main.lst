2272:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
2273:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
2274:main.c        **** 
2275:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
2276:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
