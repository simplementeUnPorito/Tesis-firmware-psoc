1667:main.c        **** static void uart_send_capture_batch(uint16 batchIndex)
1668:main.c        **** {
1669:main.c        ****     uint8  frame[FRAME_BYTES];
1670:main.c        ****     uint8 *p;
1671:main.c        ****     const volatile uint8 *src;
1672:main.c        ****     uint16 i;
1673:main.c        ****     uint8  crc = 0u;
1674:main.c        **** 
1675:main.c        ****     frame[0] = 0xABu;
1676:main.c        ****     frame[1] = (uint8)BATCH_SAMPLES;
1677:main.c        ****     frame[2] = (uint8)( g_seq        & 0xFFu);
1678:main.c        ****     frame[3] = (uint8)((g_seq >> 8u) & 0xFFu);
1679:main.c        **** 
1680:main.c        ****     /* La ISR guarda los 3 bytes crudos del DMA sin procesar; el alineado a
1681:main.c        ****      * counts (division por DEC_DIV) se hace acá, fuera de la ventana crítica
1682:main.c        ****      * de muestreo. La rampa debug va tal cual (g_capture_align=0). */
1683:main.c        ****     src = &g_capture_raw[(uint32)batchIndex * CAPTURE_BATCH_BYTES];
1684:main.c        ****     p = &frame[4];
