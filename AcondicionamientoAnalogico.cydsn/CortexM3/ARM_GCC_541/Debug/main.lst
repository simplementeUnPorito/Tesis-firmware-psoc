 224:main.c        **** static void psoc_enter_sampling(uint8 debugMode)
 225:main.c        **** {
 226:main.c        ****     uint8 saved;
 227:main.c        ****     uint16 target = capture_target_batches();
 228:main.c        ****     ADC_StopConvert();
 229:main.c        ****     timer_stop_quiet();
 230:main.c        ****     saved = CyEnterCriticalSection();
 231:main.c        ****     g_debug_psoc = debugMode ? 1u : 0u;
 232:main.c        ****     capture_reset_locked();
 233:main.c        ****     g_state = PSOC_SAMPLING;
 234:main.c        ****     CyExitCriticalSection(saved);
 235:main.c        ****     uart_send_diag(PSOC_EVT_SAMPLING_START, diag_u16_sat(target));
 236:main.c        ****     ADC_StartConvert();
 237:main.c        **** }
