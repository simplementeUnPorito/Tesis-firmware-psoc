 264:main.c        ****         if (g_batch_fill >= BATCH_SAMPLES)
 265:main.c        ****         {
 266:main.c        ****             g_batch_fill = 0u;
 267:main.c        ****             g_batches_captured++;
 268:main.c        ****             if (g_batches_captured >= capture_target_batches()) {
 269:main.c        ****                 g_capture_done = 1u;
 270:main.c        ****             }
 271:main.c        ****         }
 272:main.c        ****     }
