 989:main.c        **** 
 990:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
 991:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
 992:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
 993:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
 994:main.c        ****  *                     cuando control_0=1
 995:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
 996:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
 997:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
 998:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
 999:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
1000:main.c        **** static void dma_adc_init(void)
1001:main.c        **** {
1002:main.c        ****     uint8 td;
1003:main.c        **** 
1004:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
1005:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
1006:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1007:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
1008:main.c        ****     td = CyDmaTdAllocate();
1009:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1010:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1011:main.c        ****     CyDmaTdSetAddress(td,
1012:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1013:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1014:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1015:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccFnF8Kd.s 			page 371


1016:main.c        **** 
1017:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1018:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1019:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1020:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1021:main.c        ****     td = CyDmaTdAllocate();
1022:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1023:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1024:main.c        ****     CyDmaTdSetAddress(td,
1025:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1026:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1027:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
