1321:main.c        ****      * de la corrida sin tener que multiplicar por el factor a mano acá.
1322:main.c        ****      * A 2604 S/s sin decimar: 30 muestras/lote ≈ 11.52 ms/lote. */
1323:main.c        ****     return ((uint32)batches * (uint32)BATCH_SAMPLES * 1000u) /
1324:main.c        ****            (uint32)psoc_adc_effective_fs_hz();
