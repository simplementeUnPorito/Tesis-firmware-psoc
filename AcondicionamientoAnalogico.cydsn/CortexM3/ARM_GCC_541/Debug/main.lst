 237:main.c        **** CY_ISR(isr_DelSigReady)
 238:main.c        **** {
 239:main.c        ****     g_adc_raw = adc_counts_right_aligned(ADC_GetResult32());
 240:main.c        **** 
 241:main.c        ****     if (g_state == PSOC_SAMPLING && g_capture_done == 0u &&
 242:main.c        ****         g_batches_captured < capture_target_batches() &&
 243:main.c        ****         g_batch_fill < BATCH_SAMPLES)
 244:main.c        ****     {
