 304:main.c        **** /* Reconstruye int32 signed a partir de 3 bytes LE (24 bits, extensión de signo) */
 305:main.c        **** static int32 dma_buf_to_i24(const volatile uint8 *buf)
 306:main.c        **** {
 307:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
 308:main.c        ****     return (u & 0x00800000UL) ? (int32)(u | 0xFF000000UL) : (int32)u;
 309:main.c        **** }
