 441:main.c        **** static uint8 ticks_due(uint32 now, uint32 due)
 442:main.c        **** {
 443:main.c        ****     return ((int32)(now - due) >= 0) ? 1u : 0u;
 444:main.c        **** }
 445:main.c        **** 
 446:main.c        **** /* Selecciona, vía Reg_Select, qué resultado final usan los DMA *_RAM y si cada
 447:main.c        ****  * camino corre en Single (1 muestra/disparo) o Lote (DMA_LOTE_SAMPLES/disparo).
 448:main.c        ****  * La exclusión Single/Lote y raw/Filter la imponen las compuertas del TopDesign;
 449:main.c        ****  * acá solo se escribe el bit pattern que las gobierna (control_0/1/2). */
 450:main.c        **** static void dma_route_select(uint8 use_filter, uint8 raw_lote, uint8 filt_lote)
 451:main.c        **** {
 452:main.c        ****     uint8 reg = 0u;
 453:main.c        ****     if (use_filter) { reg |= 0x02u; }   /* control_1 */
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccDv9S45.s 			page 276


 454:main.c        ****     if (filt_lote)  { reg |= 0x01u; }   /* control_0 */
 455:main.c        ****     if (raw_lote)   { reg |= 0x04u; }   /* control_2 */
 456:main.c        ****     Reg_Select_Write(reg);
 457:main.c        **** }
 458:main.c        **** 
 459:main.c        **** static void PGAgain_Set(uint8 code)
 460:main.c        **** {
 461:main.c        ****     if (code <= 8u) {
 462:main.c        ****         g_pga_code = code;
 463:main.c        ****         psoc_hw_set_pga(code);
 464:main.c        ****     }
 465:main.c        **** }
 466:main.c        **** 
