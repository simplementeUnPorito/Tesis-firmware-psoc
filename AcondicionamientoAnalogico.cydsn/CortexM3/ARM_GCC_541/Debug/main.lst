2468:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccjcdjEY.s 			page 848


2469:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo en ruta raw
2470:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
2471:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
2472:main.c        ****  *                     en ruta filtrada
2473:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
2474:main.c        ****  * Cual DRQ recibe el trigger real lo decide superMaquina desde cfg/ctrl; el
2475:main.c        ****  * ARM solo configura la ruta con dma_route_select(). DMA_Filter_RAM solo
2476:main.c        ****  * produce datos cuando el Filter esta siendo alimentado. */
2477:main.c        **** static void dma_adc_init(void)
2478:main.c        **** {
2479:main.c        ****     uint8 td;
2480:main.c        **** 
2481:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
2482:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
2483:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
2484:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
2485:main.c        ****     td = CyDmaTdAllocate();
2486:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
2487:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
2488:main.c        ****     CyDmaTdSetAddress(td,
2489:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
2490:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
2491:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
2492:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
2493:main.c        **** 
2494:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
2495:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
2496:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
2497:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
2498:main.c        ****     td = CyDmaTdAllocate();
2499:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
2500:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
2501:main.c        ****     CyDmaTdSetAddress(td,
2502:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
2503:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
2504:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
2505:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
2506:main.c        **** 
2507:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
2508:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
2509:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
2510:main.c        ****         HI16((uint32)(void *)g_dma_filt_buf));
2511:main.c        ****     td = CyDmaTdAllocate();
2512:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
2513:main.c        ****         DMA_Filter_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
2514:main.c        ****     CyDmaTdSetAddress(td,
2515:main.c        ****         LO16((uint32)Filter_HOLDA_PTR),
2516:main.c        ****         LO16((uint32)(void *)g_dma_filt_buf));
2517:main.c        ****     CyDmaChSetInitialTd(DMA_Filter_RAM_DmaHandle, td);
2518:main.c        ****     CyDmaChEnable(DMA_Filter_RAM_DmaHandle, 1u);
2519:main.c        **** 
2520:main.c        ****     /* Ruta por defecto: raw, igual al comportamiento previo al mux. */
2521:main.c        ****     dma_route_select(0u);
2522:main.c        **** }
