 593:main.c        ****     elapsed = now - lastTick;
 594:main.c        ****     if (elapsed == 0u) { return; }
 595:main.c        ****     lastTick = now;
 596:main.c        **** 
 597:main.c        ****     if (g_comm_countdown > elapsed) {
 598:main.c        ****         g_comm_countdown -= elapsed;
 599:main.c        ****     } else {
 600:main.c        ****         g_comm_countdown = 0u;
 601:main.c        ****     }
 602:main.c        **** 
