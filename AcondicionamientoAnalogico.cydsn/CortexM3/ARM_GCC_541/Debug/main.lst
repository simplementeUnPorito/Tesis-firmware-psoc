 237:main.c        **** CY_ISR(isr_DelSigReady)
 238:main.c        **** {
 239:main.c        ****     g_adc_raw = adc_counts_right_aligned(ADC_GetResult32());
 240:main.c        **** 
 241:main.c        ****     if (g_state == PSOC_SAMPLING && g_capture_done == 0u &&
 242:main.c        ****         g_batches_captured < capture_target_batches() &&
 243:main.c        ****         g_batch_fill < BATCH_SAMPLES)
 244:main.c        ****     {
 245:main.c        ****         uint16 pos = (uint16)(g_batch_fill * SAMPLE_BYTES);
 246:main.c        ****         int32 val = g_debug_psoc ? (int32)(g_dbg_cnt++ & 0x00FFFFFFu) : g_adc_raw;
 247:main.c        ****         g_capture_raw[g_batches_captured][pos]      = (uint8)( val        & 0xFFu);
 248:main.c        ****         g_capture_raw[g_batches_captured][pos + 1u] = (uint8)((val >>  8u) & 0xFFu);
 249:main.c        ****         g_capture_raw[g_batches_captured][pos + 2u] = (uint8)((val >> 16u) & 0xFFu);
