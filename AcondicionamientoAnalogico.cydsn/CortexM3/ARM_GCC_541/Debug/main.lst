2761:main.c        **** /* Recuperación tras el breaker de tormenta de IRQ: re-inicializa el bloque
2762:main.c        ****  * (Enable deja propagar cualquier clear latcheado, doble lectura de status,
2763:main.c        ****  * pend limpio) y restaura el estado software del modo que estaba en vuelo
2764:main.c        ****  * para que ninguna espera quede huérfana. */
2765:main.c        **** static void timer_storm_recover(void)
2766:main.c        **** {
2767:main.c        ****     uint8 mask;
2768:main.c        ****     uint8 saved;
2769:main.c        **** 
2770:main.c        ****     if (g_timer_storm == 0u) { return; }
2771:main.c        ****     saved = CyEnterCriticalSection();
2772:main.c        ****     mask = g_timer_storm;
2773:main.c        ****     g_timer_storm = 0u;
2774:main.c        ****     CyExitCriticalSection(saved);
2775:main.c        **** 
2776:main.c        ****     if (mask & 0x01u) {
2777:main.c        ****         Timer_Enable();
2778:main.c        ****         (void)Timer_ReadStatusRegister();
2779:main.c        ****         Timer_Stop();
2780:main.c        ****         (void)Timer_ReadStatusRegister();
2781:main.c        ****         isr_Timer_ClearPending();
2782:main.c        ****         if (rx_state != 0u) {
2783:main.c        ****             watchdog_rx = 1u;   /* resincroniza el parser a mano */
2784:main.c        ****         }
2785:main.c        ****         uart_send_diag(PSOC_EVT_TIMER_STORM, 0u);
2786:main.c        ****     }
2787:main.c        ****     if (mask & 0x02u) {
2788:main.c        ****         uint8 mode;
2789:main.c        ****         Timer_1_Enable();
2790:main.c        ****         (void)Timer_1_ReadStatusRegister();
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccMCP8G3.s 			page 1044


2791:main.c        ****         Timer_1_Stop();
2792:main.c        ****         (void)Timer_1_ReadStatusRegister();
2793:main.c        ****         isr_Timer_1_ClearPending();
2794:main.c        ****         saved = CyEnterCriticalSection();
2795:main.c        ****         mode = g_timer1_mode;
2796:main.c        ****         g_timer1_mode = TIMER1_MODE_NONE;
2797:main.c        ****         g_timer1_remaining_counts = 0u;
2798:main.c        ****         if (mode == TIMER1_MODE_BOOT_PING) {
2799:main.c        ****             g_boot_ping_due = 1u;
2800:main.c        ****         } else if (mode == TIMER1_MODE_IDLE_PING) {
2801:main.c        ****             g_idle_ping_due = 1u;
2802:main.c        ****             g_idle_ping_armed = 0u;
2803:main.c        ****         }
2804:main.c        ****         CyExitCriticalSection(saved);
2805:main.c        ****         if (mode == TIMER1_MODE_CAL_TICK && g_cal_timer_active) {
2806:main.c        ****             /* Reproduce la cadena del tick de calibración. */
2807:main.c        ****             g_cal_progress_due = 1u;
2808:main.c        ****             timer1_arm_ms(g_cal_progress_period_ms, TIMER1_MODE_CAL_TICK);
2809:main.c        ****         }
2810:main.c        ****         uart_send_diag(PSOC_EVT_TIMER_STORM, 1u);
2811:main.c        ****     }
2812:main.c        ****     if (mask & 0x04u) {
2813:main.c        ****         uint8 mode;
2814:main.c        ****         Timer_2_Enable();
2815:main.c        ****         (void)Timer_2_ReadStatusRegister();
2816:main.c        ****         Timer_2_Stop();
2817:main.c        ****         (void)Timer_2_ReadStatusRegister();
2818:main.c        ****         isr_Timer_2_ClearPending();
2819:main.c        ****         saved = CyEnterCriticalSection();
2820:main.c        ****         mode = g_timer2_mode;
2821:main.c        ****         g_timer2_mode = TIMER2_MODE_NONE;
2822:main.c        ****         g_timer2_remaining_counts = 0u;
2823:main.c        ****         if (mode == TIMER2_MODE_BOOT_LED_OFF) {
2824:main.c        ****             g_boot_led_off_due = 1u;
2825:main.c        ****         } else if (mode == TIMER2_MODE_WAIT) {
2826:main.c        ****             g_timer2_wait_done = 1u;
2827:main.c        ****         } else if (mode == TIMER2_MODE_COMM_BLINK) {
2828:main.c        ****             g_comm_blink_due = 1u;
2829:main.c        ****         }
2830:main.c        ****         CyExitCriticalSection(saved);
2831:main.c        ****         uart_send_diag(PSOC_EVT_TIMER_STORM, 2u);
2832:main.c        ****     }
2833:main.c        ****     if (mask & 0x08u) {
2834:main.c        ****         Timer_3_Enable();
2835:main.c        ****         (void)Timer_3_ReadStatusRegister();
2836:main.c        ****         Timer_3_Stop();
2837:main.c        ****         (void)Timer_3_ReadStatusRegister();
2838:main.c        ****         isr_Timer_3_ClearPending();
2839:main.c        ****         g_timer3_remaining_counts = 0u;
2840:main.c        ****         if (g_state == PSOC_SAMPLING && g_capture_done == 0u) {
2841:main.c        ****             capture_watchdog_arm();   /* re-arma la ventana completa */
2842:main.c        ****         }
2843:main.c        ****         uart_send_diag(PSOC_EVT_TIMER_STORM, 3u);
2844:main.c        ****     }
