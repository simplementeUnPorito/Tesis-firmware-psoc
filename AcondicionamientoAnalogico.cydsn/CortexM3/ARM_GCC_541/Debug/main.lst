1100:main.c        **** /* Lotes extra a pedirle a superMaquina en captura filtrada armada, para que
1101:main.c        ****  * tras descartar las 63 muestras de retardo de grupo el buffer igual reciba
1102:main.c        ****  * los 30*N puntos pedidos: ceil(63/30) = 3. */
1103:main.c        **** #define CAPTURE_FILTER_EXTRA_BATCHES \
1104:main.c        ****     ((uint16)((FILTER_GROUP_DELAY + BATCH_SAMPLES - 1u) / BATCH_SAMPLES))
1105:main.c        **** 
1106:main.c        **** static void psoc_arm(void)
1107:main.c        **** {
1108:main.c        ****     uint8 saved;
1109:main.c        ****     uint8 source;
1110:main.c        ****     uint16 stored_target = capture_target_batches();
1111:main.c        ****     uint16 hw_target;
1112:main.c        ****     uint16 discard = 0u;
1113:main.c        **** 
1114:main.c        ****     psoc_prepare_capture_path();
1115:main.c        ****     source = capture_engine_source_from_stream(g_stream_mode);
1116:main.c        ****     hw_target = stored_target;
1117:main.c        ****     if (source == CE_CFG_SRC_FILTER || source == CE_CFG_SRC_COMBINED) {
1118:main.c        ****         /* Ruta filtrada armada: superMaquina mantiene el FIR alimentado en
1119:main.c        ****          * ARMED (historia caliente) y el ARM descarta las primeras 63 salidas
1120:main.c        ****          * tras el sync; asi la primera muestra almacenada corresponde al
1121:main.c        ****          * instante del sync, alineada con la ruta raw. El objetivo del
1122:main.c        ****          * hardware se extiende para cubrir el descarte. */
1123:main.c        ****         discard = FILTER_GROUP_DELAY;
1124:main.c        ****         if (stored_target > (uint16)(PSOC_CAPTURE_MAX_BATCHES - CAPTURE_FILTER_EXTRA_BATCHES)) {
1125:main.c        ****             stored_target = (uint16)(PSOC_CAPTURE_MAX_BATCHES - CAPTURE_FILTER_EXTRA_BATCHES);
1126:main.c        ****             uart_send_diag(PSOC_EVT_CAPTURE_CLAMPED, diag_u16_sat(capture_target_batches()));
1127:main.c        ****         }
1128:main.c        ****         hw_target = (uint16)(stored_target + CAPTURE_FILTER_EXTRA_BATCHES);
1129:main.c        ****     }
1130:main.c        **** #if PSOC_RAMP_DEBUG_ENABLE
1131:main.c        ****     g_capture_align = (source == CE_CFG_SRC_DEBUG) ? 0u : 1u;
1132:main.c        **** #else
1133:main.c        ****     g_capture_align = 1u;
1134:main.c        **** #endif
1135:main.c        ****     saved = CyEnterCriticalSection();
1136:main.c        ****     capture_reset_locked(stored_target);
1137:main.c        ****     g_fir_discard = discard;
1138:main.c        ****     g_state = PSOC_ARMED;
1139:main.c        ****     CyExitCriticalSection(saved);
1140:main.c        ****     capture_engine_configure_target(hw_target);
1141:main.c        ****     capture_engine_set_source(source);
1142:main.c        ****     g_sm_capture_handler = capture_handler_for_source(source);
1143:main.c        ****     g_sm_sample_handler = sm_sample_armed_wait;
1144:main.c        ****     capture_engine_set_enabled(1u, 1u);
1145:main.c        ****     capture_engine_clear_flags();
1146:main.c        ****     capture_engine_pulse(CE_CTRL_ARM);
1147:main.c        ****     ADC_StartConvert();
1148:main.c        ****     uart_send_diag(PSOC_EVT_ARMED, diag_u16_sat(g_n_batches));
1149:main.c        **** }
