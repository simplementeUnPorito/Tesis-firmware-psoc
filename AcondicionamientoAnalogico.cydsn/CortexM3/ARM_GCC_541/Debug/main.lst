 414:main.c        **** static uint16 timer_take_chunk(volatile uint32 *remaining_counts)
 415:main.c        **** {
 416:main.c        ****     uint32 remaining = *remaining_counts;
 417:main.c        ****     uint16 chunk;
 418:main.c        **** 
 419:main.c        ****     if (remaining == 0u) {
 420:main.c        ****         return 0u;
 421:main.c        ****     }
 422:main.c        ****     if (remaining > TIMER_MAX_COUNTS) {
 423:main.c        ****         chunk = (uint16)TIMER_MAX_COUNTS;
 424:main.c        ****         *remaining_counts = remaining - TIMER_MAX_COUNTS;
 425:main.c        ****     } else {
 426:main.c        ****         chunk = (uint16)remaining;
 427:main.c        ****         *remaining_counts = 0u;
 428:main.c        ****     }
 429:main.c        ****     return chunk;
 430:main.c        **** }
