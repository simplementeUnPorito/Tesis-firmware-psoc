 150:main.c        **** static void uart_send_fs_report(void)
 151:main.c        **** {
 152:main.c        ****     uint8 fs_lo = (uint8)((uint16)ADC_DEFAULT_SRATE & 0xFFu);
 153:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
 154:main.c        ****     uint8 frame[5u];
 155:main.c        ****     frame[0] = 0xABu;
 156:main.c        ****     frame[1] = PSOC_CMD_FS_REPORT;
 157:main.c        ****     frame[2] = fs_lo;
 158:main.c        ****     frame[3] = fs_hi;
 159:main.c        ****     frame[4] = (uint8)(PSOC_CMD_FS_REPORT ^ fs_lo ^ fs_hi);
 160:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 161:main.c        **** }
