2247:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
2248:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo en ruta raw
2249:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
2250:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
2251:main.c        ****  *                     en ruta filtrada
2252:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
2253:main.c        ****  * Cual DRQ recibe el trigger real lo decide superMaquina desde cfg/ctrl; el
2254:main.c        ****  * ARM solo configura la ruta con dma_route_select(). DMA_Filter_RAM solo
2255:main.c        ****  * produce datos cuando el Filter esta siendo alimentado. */
2256:main.c        **** static void dma_adc_init(void)
2257:main.c        **** {
2258:main.c        ****     uint8 td;
2259:main.c        **** 
2260:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
