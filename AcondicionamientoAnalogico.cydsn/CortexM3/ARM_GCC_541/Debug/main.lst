1369:main.c        **** /* ── Trampas de robustez ───────────────────────
1370:main.c        ****  * 1) isr_SyncIn: calibration.c la deshabilita/rehabilita alrededor de una
1371:main.c        ****  *    corrida (cal_async_complete). Con PSOC_SUPERMAQUINA_OWNS_SYNC_IRQ el
1372:main.c        ****  *    vector nunca se instalaba, así que ese re-enable dejaba la NVIC apuntando
1373:main.c        ****  *    a IntDefaultHandler (while(1)): el siguiente flanco de SYNC_IN congelaba
1374:main.c        ****  *    el equipo. Se instala SIEMPRE un vector seguro.
1375:main.c        ****  * 2) Cualquier IRQ que siga apuntando a IntDefaultHandler se re-vector a un
1376:main.c        ****  *    trap que reporta el número de IRQ por UART (EVT 0x7E) y la deshabilita,
1377:main.c        ****  *    en vez de colgar el firmware.
1378:main.c        ****  * 3) HardFault (EVT 0x7F) queda en loop parpadeando el LED rápido. */
1379:main.c        **** static void led_write(uint8 value);
