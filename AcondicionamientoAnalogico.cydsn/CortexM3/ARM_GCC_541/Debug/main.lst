 173:main.c        ****     frame[4] = state;
 174:main.c        ****     frame[5] = (uint8)(PSOC_CMD_DIAG_EVT ^ event ^ value ^ state);
 175:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 176:main.c        **** #else
 177:main.c        ****     (void)event;
 178:main.c        ****     (void)value;
 179:main.c        **** #endif
 180:main.c        **** }
