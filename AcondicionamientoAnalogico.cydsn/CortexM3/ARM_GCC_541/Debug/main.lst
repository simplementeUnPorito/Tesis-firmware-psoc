1006:main.c        **** static int32 sign_extend_bits(uint32 value, uint8 bits)
1007:main.c        **** {
1008:main.c        ****     uint32 sign;
1009:main.c        ****     uint32 mask;
1010:main.c        **** 
1011:main.c        ****     if (bits == 0u || bits >= 32u) {
1012:main.c        ****         return (int32)value;
1013:main.c        ****     }
1014:main.c        ****     sign = (uint32)1u << (bits - 1u);
1015:main.c        ****     mask = (sign << 1u) - 1u;
1016:main.c        ****     value &= mask;
1017:main.c        ****     return (value & sign) ? (int32)(value | ~mask) : (int32)value;
1018:main.c        **** }
1019:main.c        **** 
1020:main.c        **** /* Reconstruye int32 signed a partir de una palabra DMA LE de 24 bits. */
1021:main.c        **** static int32 dma_buf_to_i24(const volatile uint8 *buf)
1022:main.c        **** {
1023:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
1024:main.c        ****     return sign_extend_bits(u, 24u);
1025:main.c        **** }
1026:main.c        **** 
1027:main.c        **** /* El ADC raw puede venir right-aligned (configs 2/3/4: CF_0V512, CF_1V024,
1028:main.c        ****  * CF_0V625), donde el bit de signo real es resolution-1. Solo CF_2V5 es
1029:main.c        ****  * left-aligned (Bit-23 OVF Protected) y ya viene sign-extendido en 24 bits.
1030:main.c        ****  * La salida del DFB sigue usando dma_buf_to_i24(). */
1031:main.c        **** static int32 dma_buf_to_adc_counts(const volatile uint8 *buf)
1032:main.c        **** {
1033:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
1034:main.c        **** 
1035:main.c        **** #if (ADC_DEFAULT_NUM_CONFIGS > 1)
1036:main.c        **** #if (ADC_CF_0V512_ALIGNMENT == 0u)
1037:main.c        ****     if (ADC_Config != ADC_CF_2V5) {
1038:main.c        ****         return sign_extend_bits(u, (uint8)ADC_CF_0V512_RESOLUTION);
1039:main.c        ****     }
1040:main.c        **** #endif
1041:main.c        **** #endif
1042:main.c        **** 
1043:main.c        ****     return sign_extend_bits(u, 24u);
1044:main.c        **** }
