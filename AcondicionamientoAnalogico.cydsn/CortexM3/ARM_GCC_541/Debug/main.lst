 849:main.c        ****     static uint32 blinkTicks = 0u;
 850:main.c        ****     uint32 elapsed;
 851:main.c        **** 
 852:main.c        ****     if (g_state == PSOC_SAMPLING) {
 853:main.c        ****         lastTick = now;
 854:main.c        ****         return;
 855:main.c        ****     }
 856:main.c        **** 
 857:main.c        ****     if (lastTick == 0u) { lastTick = now; return; }
 858:main.c        **** 
 859:main.c        ****     elapsed = now - lastTick;
 860:main.c        ****     if (elapsed == 0u) { return; }
 861:main.c        ****     lastTick = now;
 862:main.c        **** 
 863:main.c        ****     if (g_comm_countdown > elapsed) {
 864:main.c        ****         g_comm_countdown -= elapsed;
 865:main.c        ****     } else {
 866:main.c        ****         g_comm_countdown = 0u;
 867:main.c        ****     }
 868:main.c        **** 
