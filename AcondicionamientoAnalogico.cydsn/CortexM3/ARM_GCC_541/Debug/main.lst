 824:main.c        **** /* ── Watchdog de captura (Timer_3, dedicado) ──
 825:main.c        ****  * Si superMaquina nunca llega a DONE (p.ej. ADC detenido, DMA sin disparos),
 826:main.c        ****  * el equipo antes quedaba mudo para siempre. Ahora el ARM se despierta al
 827:main.c        ****  * vencer la duracion nominal + margen y aborta con diagnostico. Al tener
 828:main.c        ****  * timer propio no compite con LED/esperas de Timer_2. */
 829:main.c        **** static uint32 capture_expected_ms(uint16 batches)
 830:main.c        **** {
 831:main.c        ****     /* 30 muestras/lote a 1020 S/s ≈ 29.4 ms por lote (512 lotes ≈ 15.06 s). */
 832:main.c        ****     return ((uint32)batches * (uint32)BATCH_SAMPLES * 1000u) /
 833:main.c        ****            (uint32)psoc_adc_effective_fs_hz();
 834:main.c        **** }
 835:main.c        **** 
 836:main.c        **** static void capture_watchdog_arm(void)
 837:main.c        **** {
 838:main.c        ****     uint32 ms = capture_expected_ms(capture_target_batches());
 839:main.c        ****     g_capture_wd_due = 0u;
 840:main.c        ****     timer3_arm_ms(ms + (ms >> 1u) + CAPTURE_WD_MARGIN_MS);
 841:main.c        **** }
 842:main.c        **** 
 843:main.c        **** static void capture_watchdog_stop(void)
 844:main.c        **** {
 845:main.c        ****     timer3_stop_quiet();
 846:main.c        ****     g_capture_wd_due = 0u;
 847:main.c        **** }
