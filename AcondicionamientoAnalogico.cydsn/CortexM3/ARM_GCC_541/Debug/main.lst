 173:main.c        **** static void uart_send_cfg_ack(uint8 cmd, uint8 val)
 174:main.c        **** {
 175:main.c        ****     uint8 frame[5u];
 176:main.c        ****     frame[0] = 0xABu;
 177:main.c        ****     frame[1] = PSOC_CMD_CFG_ACK;
 178:main.c        ****     frame[2] = cmd;
 179:main.c        ****     frame[3] = val;
 180:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 181:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 182:main.c        **** }
