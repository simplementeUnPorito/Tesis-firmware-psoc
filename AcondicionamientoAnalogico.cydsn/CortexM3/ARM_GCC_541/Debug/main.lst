1591:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
1592:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1593:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
1594:main.c        ****     td = CyDmaTdAllocate();
1595:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1596:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1597:main.c        ****     CyDmaTdSetAddress(td,
1598:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1599:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1600:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1601:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
1602:main.c        **** 
1603:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1604:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1605:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1606:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1607:main.c        ****     td = CyDmaTdAllocate();
1608:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1609:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1610:main.c        ****     CyDmaTdSetAddress(td,
1611:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1612:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1613:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
1614:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
1615:main.c        **** 
1616:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
1617:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
1618:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
1619:main.c        ****         HI16((uint32)(void *)g_dma_filt_buf));
1620:main.c        ****     td = CyDmaTdAllocate();
1621:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1622:main.c        ****         DMA_Filter_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1623:main.c        ****     CyDmaTdSetAddress(td,
1624:main.c        ****         LO16((uint32)Filter_HOLDA_PTR),
1625:main.c        ****         LO16((uint32)(void *)g_dma_filt_buf));
1626:main.c        ****     CyDmaChSetInitialTd(DMA_Filter_RAM_DmaHandle, td);
1627:main.c        ****     CyDmaChEnable(DMA_Filter_RAM_DmaHandle, 1u);
1628:main.c        **** 
