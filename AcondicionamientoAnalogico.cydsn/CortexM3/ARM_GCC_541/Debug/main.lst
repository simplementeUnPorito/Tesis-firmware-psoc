 510:main.c        ****     g_batches_captured = 0u;
 511:main.c        ****     g_capture_done = 0u;
 512:main.c        ****     psoc_calibration_servo_abort();
 513:main.c        ****     /* La ruta del DMA (raw vs Filter) y el AMux los gobierna cal_pi_stage_begin
 514:main.c        ****      * (calibration.c) por etapa -- no hace falta forzar nada aca. */
 515:main.c        ****     uart_send_diag(PSOC_EVT_BOOT, PSOC_HW_CLASS);
