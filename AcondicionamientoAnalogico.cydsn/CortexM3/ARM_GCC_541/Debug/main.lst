 903:main.c        **** /* ── Watchdog de captura (Timer_3, dedicado) ──
 904:main.c        ****  * Si superMaquina nunca llega a DONE (p.ej. ADC detenido, DMA sin disparos),
 905:main.c        ****  * el equipo antes quedaba mudo para siempre. Ahora el ARM se despierta al
 906:main.c        ****  * vencer la duracion nominal + margen y aborta con diagnostico. Al tener
 907:main.c        ****  * timer propio no compite con LED/esperas de Timer_2. */
 908:main.c        **** static uint32 capture_expected_ms(uint16 batches)
 909:main.c        **** {
 910:main.c        ****     /* `batches` son lotes DECIMADOS (almacenados); psoc_adc_effective_fs_hz()
 911:main.c        ****      * ya refleja 2929/factor, así que esta cuenta da el tiempo real de pared
 912:main.c        ****      * de la corrida sin tener que multiplicar por el factor a mano acá.
 913:main.c        ****      * A 2929 S/s sin decimar: 30 muestras/lote ≈ 10.24 ms/lote. */
 914:main.c        ****     return ((uint32)batches * (uint32)BATCH_SAMPLES * 1000u) /
 915:main.c        ****            (uint32)psoc_adc_effective_fs_hz();
 916:main.c        **** }
 917:main.c        **** 
