 154:main.c        ****     uint8 fs_hi = (uint8)(((uint16)ADC_DEFAULT_SRATE >> 8u) & 0xFFu);
 155:main.c        ****     uint8 frame[5u];
 156:main.c        ****     frame[0] = 0xABu;
 157:main.c        ****     frame[1] = PSOC_CMD_FS_REPORT;
 158:main.c        ****     frame[2] = fs_lo;
 159:main.c        ****     frame[3] = fs_hi;
 160:main.c        ****     frame[4] = (uint8)(PSOC_CMD_FS_REPORT ^ fs_lo ^ fs_hi);
 161:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
