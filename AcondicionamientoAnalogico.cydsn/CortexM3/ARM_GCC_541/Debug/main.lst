  74:main.c        **** #define TIMER_ILO_COUNTS_PER_MS 100u     /* Timers fixed @ 100 kHz. */
  75:main.c        **** #define TIMER_MAX_COUNTS        60000UL  /* margen bajo 0xFFFF para rearmar FF one-shot */
  76:main.c        **** #define UART_RX_TIMEOUT_MS      10u
  77:main.c        **** #define TIMEOUT_COUNTS          (UART_RX_TIMEOUT_MS * TIMER_ILO_COUNTS_PER_MS)
  78:main.c        **** 
