3091:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
3092:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo en ruta raw
3093:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
3094:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
3095:main.c        ****  *                     en ruta filtrada
3096:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
3097:main.c        ****  * Cual DRQ recibe el trigger real lo decide superMaquina desde cfg/ctrl; el
3098:main.c        ****  * ARM solo configura la ruta con dma_route_select(). DMA_Filter_RAM solo
3099:main.c        ****  * produce datos cuando el Filter esta siendo alimentado. */
3100:main.c        **** static void dma_adc_init(void)
3101:main.c        **** {
3102:main.c        ****     uint8 td;
3103:main.c        **** 
3104:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
3105:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
3106:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
3107:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
3108:main.c        ****     td = CyDmaTdAllocate();
3109:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
3110:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
3111:main.c        ****     CyDmaTdSetAddress(td,
3112:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
3113:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
3114:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
3115:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
3116:main.c        **** 
3117:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
3118:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
3119:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
3120:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
3121:main.c        ****     td = CyDmaTdAllocate();
3122:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
3123:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
3124:main.c        ****     CyDmaTdSetAddress(td,
3125:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
3126:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
3127:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
3128:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
3129:main.c        **** 
3130:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
3131:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
3132:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
3133:main.c        ****         HI16((uint32)(void *)g_dma_filt_buf));
3134:main.c        ****     td = CyDmaTdAllocate();
3135:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
3136:main.c        ****         DMA_Filter_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
3137:main.c        ****     CyDmaTdSetAddress(td,
3138:main.c        ****         LO16((uint32)Filter_HOLDA_PTR),
3139:main.c        ****         LO16((uint32)(void *)g_dma_filt_buf));
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccMCP8G3.s 			page 1148


3140:main.c        ****     CyDmaChSetInitialTd(DMA_Filter_RAM_DmaHandle, td);
3141:main.c        ****     CyDmaChEnable(DMA_Filter_RAM_DmaHandle, 1u);
3142:main.c        **** 
3143:main.c        ****     /* Ruta por defecto: raw, igual al comportamiento previo al mux. */
3144:main.c        ****     dma_route_select(0u);
3145:main.c        **** }
