  57:main.c        **** #define FILTER_GROUP_DELAY ((FILTER_FIR_NTAPS - 1u) / 2u)   /* 63 muestras */
  58:main.c        **** #define TIMER_TICK_MS      10u
  59:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema */
  60:main.c        **** 
  61:main.c        **** #define BATCH_SAMPLES      30u
  62:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  63:main.c        **** #define SAMPLE_BYTES       3u
  64:main.c        **** #define CAPTURE_BATCH_BYTES (BATCH_SAMPLES * SAMPLE_BYTES)
  65:main.c        **** 
