  76:main.c        **** 
  77:main.c        **** #define PING_PERIOD_MS     700u
  78:main.c        **** #define PING_OFF_MS        100u
  79:main.c        **** #define IDLE_PING_MS       1000u
  80:main.c        **** #define COMM_WINDOW_MS     500u
  81:main.c        **** #define COMM_BLINK_MS       50u
  82:main.c        **** 
  83:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  84:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  85:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  86:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  87:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  88:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
  89:main.c        **** #define CONNECT_BLINK_TICKS   MS_TO_TICKS(80u)
  90:main.c        **** 
