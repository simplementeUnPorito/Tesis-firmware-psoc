1707:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
1708:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo en ruta raw
1709:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
1710:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
1711:main.c        ****  *                     en ruta filtrada
1712:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
1713:main.c        ****  * Cual DRQ recibe el trigger real lo decide superMaquina desde cfg/ctrl; el
1714:main.c        ****  * ARM solo configura la ruta con dma_route_select(). DMA_Filter_RAM solo
1715:main.c        ****  * produce datos cuando el Filter esta siendo alimentado. */
1716:main.c        **** static void dma_adc_init(void)
1717:main.c        **** {
1718:main.c        ****     uint8 td;
1719:main.c        **** 
1720:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
1721:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
1722:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1723:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
1724:main.c        ****     td = CyDmaTdAllocate();
1725:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1726:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1727:main.c        ****     CyDmaTdSetAddress(td,
1728:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1729:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1730:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1731:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
1732:main.c        **** 
1733:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1734:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1735:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1736:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1737:main.c        ****     td = CyDmaTdAllocate();
1738:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1739:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1740:main.c        ****     CyDmaTdSetAddress(td,
1741:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1742:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1743:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
1744:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
1745:main.c        **** 
1746:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
1747:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
1748:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
1749:main.c        ****         HI16((uint32)(void *)g_dma_filt_buf));
1750:main.c        ****     td = CyDmaTdAllocate();
1751:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1752:main.c        ****         DMA_Filter_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1753:main.c        ****     CyDmaTdSetAddress(td,
1754:main.c        ****         LO16((uint32)Filter_HOLDA_PTR),
1755:main.c        ****         LO16((uint32)(void *)g_dma_filt_buf));
1756:main.c        ****     CyDmaChSetInitialTd(DMA_Filter_RAM_DmaHandle, td);
1757:main.c        ****     CyDmaChEnable(DMA_Filter_RAM_DmaHandle, 1u);
1758:main.c        **** 
