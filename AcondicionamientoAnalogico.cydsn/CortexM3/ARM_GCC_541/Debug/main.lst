 983:main.c        ****         now = timer_now_ticks();
 984:main.c        **** 
 985:main.c        ****         if (ticks_due(now, nextPing)) {
 986:main.c        ****             uart_send_ping();
 987:main.c        ****             pingStart = now;
 988:main.c        ****             nextPing  = now + PING_PERIOD_TICKS;
 989:main.c        ****             led_write(1u);
 990:main.c        ****         }
 991:main.c        **** 
 992:main.c        ****         if ((now - pingStart) >= (PING_PERIOD_TICKS - PING_OFF_TICKS)) {
 993:main.c        ****             led_write(0u);
 994:main.c        ****         } else {
 995:main.c        ****             led_write(1u);
 996:main.c        ****         }
 997:main.c        ****     }
 998:main.c        **** }
