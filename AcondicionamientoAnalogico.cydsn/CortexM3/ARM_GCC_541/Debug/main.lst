1688:main.c        ****             int32 val = psoc_adc_counts_right_aligned(
1689:main.c        ****                 g_capture_adc_raw ? dma_buf_to_adc_counts(src) : dma_buf_to_i24(src));
1690:main.c        ****             p[0] = (uint8)( val         & 0xFFu);
1691:main.c        ****             p[1] = (uint8)((val >>  8u) & 0xFFu);
1692:main.c        ****             p[2] = (uint8)((val >> 16u) & 0xFFu);
1693:main.c        ****         } else {
1694:main.c        ****             p[0] = src[0];
1695:main.c        ****             p[1] = src[1];
1696:main.c        ****             p[2] = src[2];
1697:main.c        ****         }
1698:main.c        ****     }
1699:main.c        **** 
1700:main.c        ****     for (i = 0u; i < (FRAME_BYTES - 1u); i++) { crc ^= frame[i]; }
1701:main.c        ****     frame[FRAME_BYTES - 1u] = crc;
1702:main.c        **** 
1703:main.c        ****     g_seq++;
1704:main.c        ****     UART_PutArray(frame, FRAME_BYTES);
1705:main.c        **** }
