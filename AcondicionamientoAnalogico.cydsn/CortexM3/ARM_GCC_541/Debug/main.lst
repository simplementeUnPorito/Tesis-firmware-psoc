1468:main.c        **** /* ── Handlers de muestra de superMaquina ─────────────────�
1469:main.c        ****  * El IRQ único de superMaquina llega una vez por muestra aceptada. Para no
1470:main.c        ****  * decidir el modo en cada interrupción, el trabajo por muestra se resuelve
1471:main.c        ****  * con un puntero a función que se fija al cambiar de modo:
1472:main.c        ****  *   captura raw/filtrada : copiar 3 bytes crudos al puntero de escritura
1473:main.c        ****  *                          (el alineado se difiere al volcado UART).
1474:main.c        ****  *   captura debug        : rampa sintética paceada por el ADC real.
1475:main.c        ****  *   bypass calibración   : alinear y publicar la muestra para calibration.c.
1476:main.c        ****  *   armed-wait           : primer IRQ tras el sync — bookkeeping de la
1477:main.c        ****  *                          transición ARMED→SAMPLING y cambio al handler de
1478:main.c        ****  *                          captura elegido al armar.
1479:main.c        ****  */
1480:main.c        **** typedef void (*sm_sample_handler_t)(void);
1481:main.c        **** 
1482:main.c        **** static void sm_sample_noop(void)
1483:main.c        **** {
1484:main.c        **** }
1485:main.c        **** 
1486:main.c        **** /* Empaqueta un valor ya decodificado/promediado de vuelta en 3 bytes LE
1487:main.c        ****  * (mismo formato que la palabra cruda del DMA, 24 bits). El volcado UART
1488:main.c        ****  * (uart_send_capture_batch) lo vuelve a decodificar con
1489:main.c        ****  * dma_buf_to_adc_counts()/dma_buf_to_i24() exactamente igual que una
1490:main.c        ****  * muestra sin decimar — round-trip transparente, sin tocar esa ruta. */
1491:main.c        **** static void capture_store_decoded(volatile uint8 *dst, int32 val)
1492:main.c        **** {
1493:main.c        ****     dst[0] = (uint8)( val         & 0xFFu);
1494:main.c        ****     dst[1] = (uint8)((val >>  8u) & 0xFFu);
1495:main.c        ****     dst[2] = (uint8)((val >> 16u) & 0xFFu);
1496:main.c        **** }
