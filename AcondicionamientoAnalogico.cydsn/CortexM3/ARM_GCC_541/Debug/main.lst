1428:main.c        **** static int32 sign_extend_bits(uint32 value, uint8 bits)
1429:main.c        **** {
1430:main.c        ****     uint32 sign;
1431:main.c        ****     uint32 mask;
1432:main.c        **** 
1433:main.c        ****     if (bits == 0u || bits >= 32u) {
1434:main.c        ****         return (int32)value;
1435:main.c        ****     }
1436:main.c        ****     sign = (uint32)1u << (bits - 1u);
1437:main.c        ****     mask = (sign << 1u) - 1u;
1438:main.c        ****     value &= mask;
1439:main.c        ****     return (value & sign) ? (int32)(value | ~mask) : (int32)value;
1440:main.c        **** }
1441:main.c        **** 
1442:main.c        **** /* Reconstruye int32 signed a partir de una palabra DMA LE de 24 bits. */
1443:main.c        **** static int32 dma_buf_to_i24(const volatile uint8 *buf)
1444:main.c        **** {
1445:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
1446:main.c        ****     return sign_extend_bits(u, 24u);
1447:main.c        **** }
1448:main.c        **** 
1449:main.c        **** /* El ADC raw puede venir right-aligned (configs 2/3/4: CF_0V512, CF_1V024,
1450:main.c        ****  * CF_0V625), donde el bit de signo real es resolution-1. Solo CF_2V5 es
1451:main.c        ****  * left-aligned (Bit-23 OVF Protected) y ya viene sign-extendido en 24 bits.
1452:main.c        ****  * La salida del DFB sigue usando dma_buf_to_i24(). */
1453:main.c        **** static int32 dma_buf_to_adc_counts(const volatile uint8 *buf)
1454:main.c        **** {
1455:main.c        ****     uint32 u = (uint32)buf[0] | ((uint32)buf[1] << 8u) | ((uint32)buf[2] << 16u);
1456:main.c        **** 
1457:main.c        **** #if (ADC_DEFAULT_NUM_CONFIGS > 1)
1458:main.c        **** #if (ADC_CF_0V512_ALIGNMENT == 0u)
1459:main.c        ****     if (ADC_Config != ADC_CF_2V5) {
1460:main.c        ****         return sign_extend_bits(u, (uint8)ADC_CF_0V512_RESOLUTION);
1461:main.c        ****     }
1462:main.c        **** #endif
1463:main.c        **** #endif
1464:main.c        **** 
1465:main.c        ****     return sign_extend_bits(u, 24u);
1466:main.c        **** }
