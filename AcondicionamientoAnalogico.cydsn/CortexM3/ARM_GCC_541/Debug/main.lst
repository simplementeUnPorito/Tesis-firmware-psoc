 979:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
 980:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
 981:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
 982:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
 983:main.c        ****  *                     cuando control_0=1
 984:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
 985:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
 986:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
 987:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccHUE4um.s 			page 371


 988:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
 989:main.c        **** static void dma_adc_init(void)
 990:main.c        **** {
 991:main.c        ****     uint8 td;
 992:main.c        **** 
 993:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
 994:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
 995:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
 996:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
 997:main.c        ****     td = CyDmaTdAllocate();
 998:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
 999:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1000:main.c        ****     CyDmaTdSetAddress(td,
1001:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1002:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1003:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1004:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
1005:main.c        **** 
1006:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1007:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1008:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1009:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1010:main.c        ****     td = CyDmaTdAllocate();
1011:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1012:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1013:main.c        ****     CyDmaTdSetAddress(td,
1014:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1015:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1016:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
1017:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
1018:main.c        **** 
1019:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
1020:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
1021:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
