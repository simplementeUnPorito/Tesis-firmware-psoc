 983:main.c        **** /* Inicializa los tres canales DMA (TopDesign consolidado, sin Single/Lote):
 984:main.c        ****  *   DMA_DelSig_RAM    ADC → RAM (g_dma_raw_buf), activo cuando control_0=0
 985:main.c        ****  *   DMA_Filter_RAM    Filter (HOLDA, Canal A) → RAM (g_dma_filt_buf)
 986:main.c        ****  *   DMA_DelSig_Filter ADC → Filter_STAGEA (siempre activo, sin ISR), activo
 987:main.c        ****  *                     cuando control_0=1
 988:main.c        ****  * Todos los TD son circulares (nextTd == mismo TD): cada canal recicla solo.
 989:main.c        ****  * Cuál de DMA_DelSig_RAM/DMA_DelSig_Filter recibe el trigger real lo decide
 990:main.c        ****  * la logica combinacional del TopDesign gobernada por Reg_Select
 991:main.c        ****  * (control_0), no el software -- ver dma_route_select(). DMA_Filter_RAM solo
 992:main.c        ****  * produce datos cuando el Filter esta siendo alimentado (control_0=1). */
 993:main.c        **** static void dma_adc_init(void)
 994:main.c        **** {
 995:main.c        ****     uint8 td;
 996:main.c        **** 
 997:main.c        ****     /* ── Raw: ADC DelSig → g_dma_raw_buf (3 bytes/disparo) ───────────
 998:main.c        ****     DMA_DelSig_RAM_DmaInitialize(3u, 1u,
 999:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1000:main.c        ****         HI16((uint32)(void *)g_dma_raw_buf));
1001:main.c        ****     td = CyDmaTdAllocate();
1002:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1003:main.c        ****         DMA_DelSig_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1004:main.c        ****     CyDmaTdSetAddress(td,
1005:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1006:main.c        ****         LO16((uint32)(void *)g_dma_raw_buf));
1007:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_RAM_DmaHandle, td);
1008:main.c        ****     CyDmaChEnable(DMA_DelSig_RAM_DmaHandle, 1u);
1009:main.c        **** 
1010:main.c        ****     /* ── Filter input: ADC DelSig → Filter_STAGEA (siempre activo, sin ISR) ── */
1011:main.c        ****     DMA_DelSig_Filter_DmaInitialize(3u, 1u,
1012:main.c        ****         HI16((uint32)ADC_DEC_SAMP_PTR),
1013:main.c        ****         HI16((uint32)Filter_STAGEA_PTR));
1014:main.c        ****     td = CyDmaTdAllocate();
1015:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1016:main.c        ****         DMA_DelSig_Filter__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1017:main.c        ****     CyDmaTdSetAddress(td,
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccjg0HL4.s 			page 369


1018:main.c        ****         LO16((uint32)ADC_DEC_SAMP_PTR),
1019:main.c        ****         LO16((uint32)Filter_STAGEA_PTR));
1020:main.c        ****     CyDmaChSetInitialTd(DMA_DelSig_Filter_DmaHandle, td);
1021:main.c        ****     CyDmaChEnable(DMA_DelSig_Filter_DmaHandle, 1u);
1022:main.c        **** 
1023:main.c        ****     /* ── Filter output: Filter_HOLDA → g_dma_filt_buf (3 bytes/disparo) ──── */
1024:main.c        ****     DMA_Filter_RAM_DmaInitialize(3u, 1u,
1025:main.c        ****         HI16((uint32)Filter_HOLDA_PTR),
1026:main.c        ****         HI16((uint32)(void *)g_dma_filt_buf));
1027:main.c        ****     td = CyDmaTdAllocate();
1028:main.c        ****     CyDmaTdSetConfiguration(td, 3u, td,
1029:main.c        ****         DMA_Filter_RAM__TD_TERMOUT_EN | TD_INC_SRC_ADR | TD_INC_DST_ADR);
1030:main.c        ****     CyDmaTdSetAddress(td,
1031:main.c        ****         LO16((uint32)Filter_HOLDA_PTR),
1032:main.c        ****         LO16((uint32)(void *)g_dma_filt_buf));
1033:main.c        ****     CyDmaChSetInitialTd(DMA_Filter_RAM_DmaHandle, td);
1034:main.c        ****     CyDmaChEnable(DMA_Filter_RAM_DmaHandle, 1u);
1035:main.c        **** 
1036:main.c        ****     /* Ruta por defecto: raw (control_0=0) — igual al comportamiento previo al mux. */
1037:main.c        ****     dma_route_select(0u);
1038:main.c        **** }
