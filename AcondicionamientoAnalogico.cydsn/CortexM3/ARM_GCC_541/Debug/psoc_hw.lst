 307:psoc_hw.c     ****     }
 308:psoc_hw.c     ****     if (r1 != SD_R1_IDLE) {
 309:psoc_hw.c     ****         goto done;   /* sin tarjeta (o no responde): present=0 */
 310:psoc_hw.c     ****     }
 311:psoc_hw.c     **** 
 312:psoc_hw.c     ****     r1 = sd_cmd(8u, 0x000001AAu, 0x87u);
 313:psoc_hw.c     ****     if (r1 == SD_R1_IDLE) {
 314:psoc_hw.c     ****         /* SD v2: leer R7 y verificar echo del patrón. */
