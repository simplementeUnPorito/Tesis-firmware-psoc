 327:psoc_hw.c     ****         }
 328:psoc_hw.c     ****         if (r1 != 0x00u) {
 329:psoc_hw.c     ****             goto done;
 330:psoc_hw.c     ****         }
 331:psoc_hw.c     ****         r1 = sd_cmd(58u, 0u, 0xFFu);
 332:psoc_hw.c     ****         if (r1 != 0x00u) {
 333:psoc_hw.c     ****             goto done;
 334:psoc_hw.c     ****         }
 335:psoc_hw.c     ****         for (i = 0u; i < 4u; i++) {
 336:psoc_hw.c     ****             ocr[i] = sd_xfer(0xFFu);
 337:psoc_hw.c     ****         }
