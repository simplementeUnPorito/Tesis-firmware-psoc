 213:psoc_hw.c     **** static uint8 sd_acmd(uint8 cmd, uint32 arg)
 214:psoc_hw.c     **** {
 215:psoc_hw.c     ****     uint8 r1 = sd_cmd(55u, 0u, 0xFFu);
 216:psoc_hw.c     ****     if (r1 > SD_R1_IDLE) {
 217:psoc_hw.c     ****         return r1;
 218:psoc_hw.c     ****     }
 219:psoc_hw.c     ****     return sd_cmd(cmd, arg, 0xFFu);
 220:psoc_hw.c     **** }
