 222:psoc_hw.c     **** /* Lee uno de los registros de 16 bytes (CMD9=CSD). Debe llamarse con CS bajo. */
 223:psoc_hw.c     **** static uint8 sd_read_register(uint8 cmd, uint8 *dst)
 224:psoc_hw.c     **** {
 225:psoc_hw.c     ****     uint16 guard;
 226:psoc_hw.c     ****     uint8 token = 0xFFu;
 227:psoc_hw.c     ****     uint8 i;
 228:psoc_hw.c     **** 
 229:psoc_hw.c     ****     if (sd_cmd(cmd, 0u, 0xFFu) != 0x00u) {
 230:psoc_hw.c     ****         return 0u;
 231:psoc_hw.c     ****     }
 232:psoc_hw.c     ****     for (guard = 0u; guard < 15000u; guard++) {
 233:psoc_hw.c     ****         token = sd_xfer(0xFFu);
 234:psoc_hw.c     ****         if (token != 0xFFu) {
 235:psoc_hw.c     ****             break;
 236:psoc_hw.c     ****         }
 237:psoc_hw.c     ****     }
 238:psoc_hw.c     ****     if (token != SD_TOKEN_START) {
 239:psoc_hw.c     ****         return 0u;
 240:psoc_hw.c     ****     }
 241:psoc_hw.c     ****     for (i = 0u; i < 16u; i++) {
 242:psoc_hw.c     ****         dst[i] = sd_xfer(0xFFu);
 243:psoc_hw.c     ****     }
 244:psoc_hw.c     ****     (void)sd_xfer(0xFFu);
 245:psoc_hw.c     ****     (void)sd_xfer(0xFFu);
 246:psoc_hw.c     ****     return 1u;
 247:psoc_hw.c     **** }
 248:psoc_hw.c     **** 
 249:psoc_hw.c     **** static uint32 sd_sector_count_from_csd(const uint8 *csd)
 250:psoc_hw.c     **** {
 251:psoc_hw.c     ****     if ((csd[0] & 0xC0u) == 0x40u) {
 252:psoc_hw.c     ****         uint32 c_size = ((uint32)(csd[7] & 0x3Fu) << 16u) |
 253:psoc_hw.c     ****                         ((uint32)csd[8] << 8u) | (uint32)csd[9];
 254:psoc_hw.c     ****         return (c_size + 1u) * 1024u;
 255:psoc_hw.c     ****     } else {
 256:psoc_hw.c     ****         uint32 c_size = ((uint32)(csd[6] & 0x03u) << 10u) |
 257:psoc_hw.c     ****                         ((uint32)csd[7] << 2u) |
 258:psoc_hw.c     ****                         ((uint32)(csd[8] >> 6u) & 0x03u);
 259:psoc_hw.c     ****         uint8 c_mult = (uint8)(((csd[9] & 0x03u) << 1u) |
 260:psoc_hw.c     ****                                ((csd[10] >> 7u) & 0x01u));
 261:psoc_hw.c     ****         uint8 read_bl_len = (uint8)(csd[5] & 0x0Fu);
 262:psoc_hw.c     ****         uint64 bytes = ((uint64)c_size + 1u) << ((uint8)c_mult + 2u + read_bl_len);
 263:psoc_hw.c     ****         return (uint32)(bytes / (uint64)SD_BLOCK_BYTES);
 264:psoc_hw.c     ****     }
 265:psoc_hw.c     **** }
 266:psoc_hw.c     **** 
 267:psoc_hw.c     **** /* Dirección efectiva del bloque según el tipo (SDHC direcciona por bloque,
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccLITyKv.s 			page 150


 268:psoc_hw.c     ****  * SDSC por byte). */
 269:psoc_hw.c     **** static uint32 sd_block_addr(uint32 lba)
 270:psoc_hw.c     **** {
 271:psoc_hw.c     ****     return (g_sd_type == SD_TYPE_SDHC) ? lba : (lba << 9u);
 272:psoc_hw.c     **** }
