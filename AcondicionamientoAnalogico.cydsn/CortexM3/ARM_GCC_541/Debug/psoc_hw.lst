 362:psoc_hw.c     ****             g_sd_type = SD_TYPE_NONE;
 363:psoc_hw.c     ****             goto done;
 364:psoc_hw.c     ****         }
 365:psoc_hw.c     ****     }
 366:psoc_hw.c     ****     if (!sd_read_register(9u, g_sd_scratch)) {
 367:psoc_hw.c     ****         g_sd_type = SD_TYPE_NONE;
 368:psoc_hw.c     ****         goto done;
 369:psoc_hw.c     ****     }
 370:psoc_hw.c     ****     g_sd_sector_count = sd_sector_count_from_csd(g_sd_scratch);
