 274:psoc_hw.c     **** uint8 sd_spi_init(void)
 275:psoc_hw.c     **** {
 276:psoc_hw.c     ****     uint8 r1;
 277:psoc_hw.c     ****     uint8 i;
 278:psoc_hw.c     ****     uint8 ocr[4];
 279:psoc_hw.c     ****     uint16 tries;
 280:psoc_hw.c     ****     uint8 ok = 0u;
 281:psoc_hw.c     **** 
 282:psoc_hw.c     ****     g_sd_type = SD_TYPE_NONE;
 283:psoc_hw.c     ****     g_sd_selftest_ok = 0u;
 284:psoc_hw.c     ****     g_sd_sector_count = 0u;
 285:psoc_hw.c     **** 
 286:psoc_hw.c     ****     if (!g_sd_spi_started) {
 287:psoc_hw.c     ****         sd_cs_detach_dsi();
 288:psoc_hw.c     ****         SPI_Start();
 289:psoc_hw.c     ****         g_sd_spi_started = 1u;
 290:psoc_hw.c     ****     }
 291:psoc_hw.c     **** 
 292:psoc_hw.c     ****     sd_clock_slow();
 293:psoc_hw.c     ****     SPI_ClearFIFO();
 294:psoc_hw.c     ****     sd_cs_write(1u);
 295:psoc_hw.c     ****     /* >=74 clocks con CS alto para entrar a modo SPI nativo. */
 296:psoc_hw.c     ****     for (i = 0u; i < 12u; i++) {
 297:psoc_hw.c     ****         (void)sd_xfer(0xFFu);
 298:psoc_hw.c     ****     }
 299:psoc_hw.c     **** 
 300:psoc_hw.c     ****     sd_cs_write(0u);
 301:psoc_hw.c     ****     r1 = 0xFFu;
 302:psoc_hw.c     ****     for (i = 0u; i < SD_CMD_RETRY; i++) {
 303:psoc_hw.c     ****         r1 = sd_cmd(0u, 0u, 0x95u);
 304:psoc_hw.c     ****         if (r1 == SD_R1_IDLE) {
 305:psoc_hw.c     ****             break;
 306:psoc_hw.c     ****         }
 307:psoc_hw.c     ****     }
 308:psoc_hw.c     ****     if (r1 != SD_R1_IDLE) {
 309:psoc_hw.c     ****         goto done;   /* sin tarjeta (o no responde): present=0 */
 310:psoc_hw.c     ****     }
 311:psoc_hw.c     **** 
 312:psoc_hw.c     ****     r1 = sd_cmd(8u, 0x000001AAu, 0x87u);
 313:psoc_hw.c     ****     if (r1 == SD_R1_IDLE) {
 314:psoc_hw.c     ****         /* SD v2: leer R7 y verificar echo del patrón. */
 315:psoc_hw.c     ****         for (i = 0u; i < 4u; i++) {
 316:psoc_hw.c     ****             ocr[i] = sd_xfer(0xFFu);
 317:psoc_hw.c     ****         }
 318:psoc_hw.c     ****         if ((ocr[2] != 0x01u) || (ocr[3] != 0xAAu)) {
 319:psoc_hw.c     ****             goto done;
 320:psoc_hw.c     ****         }
 321:psoc_hw.c     ****         for (tries = 0u; tries < 1000u; tries++) {
 322:psoc_hw.c     ****             r1 = sd_acmd(41u, 0x40000000u);   /* HCS=1 */
 323:psoc_hw.c     ****             if (r1 == 0x00u) {
 324:psoc_hw.c     ****                 break;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccLITyKv.s 			page 151


 325:psoc_hw.c     ****             }
 326:psoc_hw.c     ****             CyDelay(1u);
 327:psoc_hw.c     ****         }
 328:psoc_hw.c     ****         if (r1 != 0x00u) {
 329:psoc_hw.c     ****             goto done;
 330:psoc_hw.c     ****         }
 331:psoc_hw.c     ****         r1 = sd_cmd(58u, 0u, 0xFFu);
 332:psoc_hw.c     ****         if (r1 != 0x00u) {
 333:psoc_hw.c     ****             goto done;
 334:psoc_hw.c     ****         }
 335:psoc_hw.c     ****         for (i = 0u; i < 4u; i++) {
 336:psoc_hw.c     ****             ocr[i] = sd_xfer(0xFFu);
 337:psoc_hw.c     ****         }
 338:psoc_hw.c     ****         g_sd_type = ((ocr[0] & 0x40u) != 0u) ? SD_TYPE_SDHC : SD_TYPE_SD2;
 339:psoc_hw.c     ****     } else {
 340:psoc_hw.c     ****         /* SD v1 (o MMC): ACMD41 sin HCS, fallback CMD1. */
 341:psoc_hw.c     ****         for (tries = 0u; tries < 1000u; tries++) {
 342:psoc_hw.c     ****             r1 = sd_acmd(41u, 0u);
 343:psoc_hw.c     ****             if (r1 == 0x00u) {
 344:psoc_hw.c     ****                 break;
 345:psoc_hw.c     ****             }
 346:psoc_hw.c     ****             if (r1 > SD_R1_IDLE) {
 347:psoc_hw.c     ****                 r1 = sd_cmd(1u, 0u, 0xFFu);
 348:psoc_hw.c     ****                 if (r1 == 0x00u) {
 349:psoc_hw.c     ****                     break;
 350:psoc_hw.c     ****                 }
 351:psoc_hw.c     ****             }
 352:psoc_hw.c     ****             CyDelay(1u);
 353:psoc_hw.c     ****         }
 354:psoc_hw.c     ****         if (r1 != 0x00u) {
 355:psoc_hw.c     ****             goto done;
 356:psoc_hw.c     ****         }
 357:psoc_hw.c     ****         g_sd_type = SD_TYPE_SD1;
 358:psoc_hw.c     ****     }
 359:psoc_hw.c     **** 
 360:psoc_hw.c     ****     if (g_sd_type != SD_TYPE_SDHC) {
 361:psoc_hw.c     ****         if (sd_cmd(16u, (uint32)SD_BLOCK_BYTES, 0xFFu) != 0x00u) {
 362:psoc_hw.c     ****             g_sd_type = SD_TYPE_NONE;
 363:psoc_hw.c     ****             goto done;
 364:psoc_hw.c     ****         }
 365:psoc_hw.c     ****     }
 366:psoc_hw.c     ****     if (!sd_read_register(9u, g_sd_scratch)) {
 367:psoc_hw.c     ****         g_sd_type = SD_TYPE_NONE;
 368:psoc_hw.c     ****         goto done;
 369:psoc_hw.c     ****     }
 370:psoc_hw.c     ****     g_sd_sector_count = sd_sector_count_from_csd(g_sd_scratch);
 371:psoc_hw.c     ****     if (g_sd_sector_count == 0u) {
 372:psoc_hw.c     ****         g_sd_type = SD_TYPE_NONE;
 373:psoc_hw.c     ****         goto done;
 374:psoc_hw.c     ****     }
 375:psoc_hw.c     ****     ok = 1u;
 376:psoc_hw.c     **** 
 377:psoc_hw.c     **** done:
 378:psoc_hw.c     ****     sd_cs_write(1u);
 379:psoc_hw.c     ****     (void)sd_xfer(0xFFu);
 380:psoc_hw.c     ****     sd_clock_fast();
 381:psoc_hw.c     ****     return ok;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccLITyKv.s 			page 152


 382:psoc_hw.c     **** }
