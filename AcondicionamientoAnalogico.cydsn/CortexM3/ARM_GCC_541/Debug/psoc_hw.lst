  92:psoc_hw.c     **** /* ==========================================================================
  93:psoc_hw.c     ****  * Driver SD modo SPI (declaraciones en sd_spi.h — implementado acá para no
  94:psoc_hw.c     ****  * registrar un .c nuevo en el .cyprj). Verificado contra el netlist elaborado:
  95:psoc_hw.c     ****  * BSPIM ModeCPHA=0, ModePOL=0, ShiftDir=MSB-first, 8 bits — SPI modo 0, el que
  96:psoc_hw.c     ****  * exige la SD. SPI_IntClock nominal 2 MHz (bitrate 1 Mbps); para el init se
  97:psoc_hw.c     ****  * baja por divisor a ~375 kHz (187.5 kbps < 400 kHz de la spec) y se restaura.
  98:psoc_hw.c     ****  * ========================================================================== */
  99:psoc_hw.c     **** 
 100:psoc_hw.c     **** #define SD_CMD_RETRY        8u
 101:psoc_hw.c     **** #define SD_R1_IDLE          0x01u
 102:psoc_hw.c     **** #define SD_TOKEN_START      0xFEu
 103:psoc_hw.c     **** /* Divisor de SPI_IntClock para el init lento: 24 MHz / 64 = 375 kHz de clock
 104:psoc_hw.c     ****  * interno -> 187.5 kbps en el bus. */
 105:psoc_hw.c     **** #define SD_INIT_CLK_DIVIDER 64u
 106:psoc_hw.c     **** 
 107:psoc_hw.c     **** static uint8  g_sd_type          = SD_TYPE_NONE;
 108:psoc_hw.c     **** static uint8  g_sd_selftest_ok   = 0u;
 109:psoc_hw.c     **** static uint8  g_sd_spi_started   = 0u;
 110:psoc_hw.c     **** static uint16 g_sd_fast_divider  = 0u;
 111:psoc_hw.c     **** static uint32 g_sd_sector_count  = 0u;
 112:psoc_hw.c     **** static uint8  g_sd_scratch[SD_BLOCK_BYTES];
 113:psoc_hw.c     **** 
 114:psoc_hw.c     **** /* CS (P2.3) quedó ruteado al `ss` de hardware del BSPIM, que deassertea entre
 115:psoc_hw.c     ****  * bytes. Se lo desengancha del DSI con el bypass del puerto (patrón calcado de
 116:psoc_hw.c     ****  * tx1_gpio_detach_dsi) para manejarlo por software durante toda la transacción. */
 117:psoc_hw.c     **** static void sd_cs_detach_dsi(void)
 118:psoc_hw.c     **** {
 119:psoc_hw.c     ****     reg8 *outSel0 = (reg8 *)SPIp__PRTDSI__OUT_SEL0;
 120:psoc_hw.c     ****     reg8 *outSel1 = (reg8 *)SPIp__PRTDSI__OUT_SEL1;
 121:psoc_hw.c     ****     reg8 *oeSel0  = (reg8 *)SPIp__PRTDSI__OE_SEL0;
 122:psoc_hw.c     ****     reg8 *oeSel1  = (reg8 *)SPIp__PRTDSI__OE_SEL1;
 123:psoc_hw.c     ****     reg8 *byp     = (reg8 *)SPIp__BYP;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccMmCeUh.s 			page 137


 124:psoc_hw.c     ****     reg8 *dr      = (reg8 *)SPIp__DR;
 125:psoc_hw.c     ****     uint8 saved   = CyEnterCriticalSection();
 126:psoc_hw.c     **** 
 127:psoc_hw.c     ****     /* DR alto ANTES del bypass para que el pin no glitchee a 0 al cambiar de
 128:psoc_hw.c     ****      * fuente (la SD interpreta CS bajo como selección). */
 129:psoc_hw.c     ****     *dr      |= SPIp__CS__MASK;
 130:psoc_hw.c     ****     *outSel0 &= (uint8)~SPIp__CS__MASK;
 131:psoc_hw.c     ****     *outSel1 &= (uint8)~SPIp__CS__MASK;
 132:psoc_hw.c     ****     *oeSel0  &= (uint8)~SPIp__CS__MASK;
 133:psoc_hw.c     ****     *oeSel1  &= (uint8)~SPIp__CS__MASK;
 134:psoc_hw.c     ****     *byp     |= SPIp__CS__MASK;
 135:psoc_hw.c     ****     CyExitCriticalSection(saved);
 136:psoc_hw.c     ****     CyPins_SetPinDriveMode(SPIp_CS, CY_PINS_DM_STRONG);
 137:psoc_hw.c     **** }
 138:psoc_hw.c     **** 
 139:psoc_hw.c     **** static void sd_cs_write(uint8 value)
 140:psoc_hw.c     **** {
 141:psoc_hw.c     ****     reg8 *dr = (reg8 *)SPIp__DR;
 142:psoc_hw.c     ****     uint8 saved = CyEnterCriticalSection();
 143:psoc_hw.c     ****     if (value) {
 144:psoc_hw.c     ****         *dr |= SPIp__CS__MASK;
 145:psoc_hw.c     ****     } else {
 146:psoc_hw.c     ****         *dr &= (uint8)~SPIp__CS__MASK;
 147:psoc_hw.c     ****     }
 148:psoc_hw.c     ****     CyExitCriticalSection(saved);
 149:psoc_hw.c     **** }
 150:psoc_hw.c     **** 
 151:psoc_hw.c     **** /* Un byte full-duplex. Lazo acotado: a 187.5 kbps un byte tarda ~43 us; el
 152:psoc_hw.c     ****  * guard de 60000 vueltas es órdenes de magnitud más que eso y evita colgar el
 153:psoc_hw.c     ****  * main loop si el clock/SPI quedara en un estado imposible. */
 154:psoc_hw.c     **** static uint8 sd_xfer(uint8 v)
 155:psoc_hw.c     **** {
 156:psoc_hw.c     ****     uint16 guard = 60000u;
 157:psoc_hw.c     ****     SPI_WriteTxData(v);
 158:psoc_hw.c     ****     while (0u == (SPI_ReadRxStatus() & SPI_STS_RX_FIFO_NOT_EMPTY)) {
 159:psoc_hw.c     ****         if (--guard == 0u) {
 160:psoc_hw.c     ****             return 0xFFu;
 161:psoc_hw.c     ****         }
 162:psoc_hw.c     ****     }
 163:psoc_hw.c     ****     return SPI_ReadRxData();
 164:psoc_hw.c     **** }
 165:psoc_hw.c     **** 
 166:psoc_hw.c     **** static void sd_clock_slow(void)
 167:psoc_hw.c     **** {
 168:psoc_hw.c     ****     g_sd_fast_divider = (uint16)(SPI_IntClock_GetDividerRegister() + 1u);
 169:psoc_hw.c     ****     SPI_IntClock_SetDividerValue(SD_INIT_CLK_DIVIDER);
 170:psoc_hw.c     **** }
 171:psoc_hw.c     **** 
 172:psoc_hw.c     **** static void sd_clock_fast(void)
 173:psoc_hw.c     **** {
 174:psoc_hw.c     ****     if (g_sd_fast_divider != 0u) {
 175:psoc_hw.c     ****         SPI_IntClock_SetDividerValue(g_sd_fast_divider);
 176:psoc_hw.c     ****     }
 177:psoc_hw.c     **** }
 178:psoc_hw.c     **** 
 179:psoc_hw.c     **** /* Espera a que la tarjeta suelte la línea de busy (responde 0xFF). */
 180:psoc_hw.c     **** static uint8 sd_wait_ready(uint32 max_bytes)
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccMmCeUh.s 			page 138


 181:psoc_hw.c     **** {
 182:psoc_hw.c     ****     while (max_bytes-- != 0u) {
 183:psoc_hw.c     ****         if (sd_xfer(0xFFu) == 0xFFu) {
 184:psoc_hw.c     ****             return 1u;
 185:psoc_hw.c     ****         }
 186:psoc_hw.c     ****     }
 187:psoc_hw.c     ****     return 0u;
 188:psoc_hw.c     **** }
