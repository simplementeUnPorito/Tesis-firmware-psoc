 849:Generated_Source\PSoC5/ADC.c ****         #endif /* CY_PSOC3 */
 850:Generated_Source\PSoC5/ADC.c ****     }
 851:Generated_Source\PSoC5/ADC.c ****     else /*ADC_DEC_SAMP_KEY_HIGH */
 852:Generated_Source\PSoC5/ADC.c ****     {
