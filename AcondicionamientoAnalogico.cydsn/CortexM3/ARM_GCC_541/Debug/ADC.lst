1588:Generated_Source\PSoC5/ADC.c ****         {
1589:Generated_Source\PSoC5/ADC.c ****             /* Restart the ADC */
1590:Generated_Source\PSoC5/ADC.c ****             ADC_Start();
1591:Generated_Source\PSoC5/ADC.c **** 
