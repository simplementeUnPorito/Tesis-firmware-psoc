  10:crc.c         ****  * ========================================
  11:crc.c         **** */
  12:crc.c         **** #include "crc.h"
  13:crc.c         **** #include <stdint.h>
  14:crc.c         **** 
  15:crc.c         **** 
  16:crc.c         **** /**************************************************************************
  17:crc.c         **** //
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccxSufjk.s 			page 17


  18:crc.c         **** // crc16.c - generate a ccitt 16 bit cyclic redundancy check (crc)
  19:crc.c         **** //
  20:crc.c         **** //      The code in this module generates the crc for a block of data.
  21:crc.c         **** //
  22:crc.c         **** **************************************************************************/
  23:crc.c         **** 
  24:crc.c         **** /*
  25:crc.c         **** //                                16  12  5
  26:crc.c         **** // The CCITT CRC 16 polynomial is X + X + X + 1.
  27:crc.c         **** // In binary, this is the bit pattern 1 0001 0000 0010 0001, and in hex it
  28:crc.c         **** //  is 0x11021.
  29:crc.c         **** // A 17 bit register is simulated by testing the MSB before shifting
  30:crc.c         **** //  the data, which affords us the luxury of specifiy the polynomial as a
  31:crc.c         **** //  16 bit value, 0x1021.
  32:crc.c         **** // Due to the way in which we process the CRC, the bits of the polynomial
  33:crc.c         **** //  are stored in reverse order. This makes the polynomial 0x8408.
  34:crc.c         **** */
  35:crc.c         **** #define POLY 0x8408
  36:crc.c         **** 
  37:crc.c         **** /**************************************************************************
  38:crc.c         **** //
  39:crc.c         **** // crc16() - generate a 16 bit crc
  40:crc.c         **** //
  41:crc.c         **** //
  42:crc.c         **** // PURPOSE
  43:crc.c         **** //      This routine generates the 16 bit remainder of a block of
  44:crc.c         **** //      data using the ccitt polynomial generator.
  45:crc.c         **** //
  46:crc.c         **** // CALLING SEQUENCE
  47:crc.c         **** //      crc = crc16(data, len);
  48:crc.c         **** //
  49:crc.c         **** // PARAMETERS
  50:crc.c         **** //      data    <-- address of start of data block
  51:crc.c         **** //      len     <-- length of data block
  52:crc.c         **** //
  53:crc.c         **** // RETURNED VALUE
  54:crc.c         **** //      crc16 value. data is calcuated using the 16 bit ccitt polynomial.
  55:crc.c         **** //
  56:crc.c         **** // NOTES
  57:crc.c         **** //      The CRC is preset to all 1's to detect errors involving a loss
  58:crc.c         **** //        of leading zero's.
  59:crc.c         **** //      The CRC (a 16 bit value) is generated in LSB MSB order.
  60:crc.c         **** //      Two ways to verify the integrity of a received message
  61:crc.c         **** //        or block of data:
  62:crc.c         **** //        1) Calculate the crc on the data, and compare it to the crc
  63:crc.c         **** //           calculated previously. The location of the saved crc must be
  64:crc.c         **** //           known.
  65:crc.c         **** /         2) Append the calculated crc to the end of the data. Now calculate
  66:crc.c         **** //           the crc of the data and its crc. If the new crc equals the
  67:crc.c         **** //           value in "crc_ok", the data is valid.
  68:crc.c         **** //
  69:crc.c         **** // PSEUDO CODE:
  70:crc.c         **** //      initialize crc (-1)
  71:crc.c         **** //      DO WHILE count NE zero
  72:crc.c         **** //        DO FOR each bit in the data byte, from LSB to MSB
  73:crc.c         **** //          IF (LSB of crc) EOR (LSB of data)
  74:crc.c         **** //            crc := (crc / 2) EOR polynomial
