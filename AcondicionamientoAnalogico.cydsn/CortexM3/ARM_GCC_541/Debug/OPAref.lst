 118:Generated_Source\PSoC5/OPAref.c **** void OPAref_Stop(void) 
 119:Generated_Source\PSoC5/OPAref.c **** {
 120:Generated_Source\PSoC5/OPAref.c ****     /* Disable power to buffer in active mode template */
 121:Generated_Source\PSoC5/OPAref.c ****     OPAref_PM_ACT_CFG_REG &= (uint8)(~OPAref_ACT_PWR_EN);
