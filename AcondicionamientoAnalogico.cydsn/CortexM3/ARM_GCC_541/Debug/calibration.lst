 531:calibration.c **** static uint8 cal_servo_apply_measurement(uint8 stage_index, uint8 dac, int32 measured)
 532:calibration.c **** {
 533:calibration.c ****     const PsocCalStage *stage = &g_psoc_cal_stages[stage_index];
 534:calibration.c ****     const PsocCalServoTune *tune = &g_cal_servo_tune[stage_index];
 535:calibration.c ****     PsocCalResult *result = &g_psoc_cal_results[stage_index];
 536:calibration.c ****     int32 error = stage->target_counts - measured;
 537:calibration.c ****     int32 abs_error = abs_counts(error);
 538:calibration.c ****     int8 dir;
 539:calibration.c ****     uint8 step;
