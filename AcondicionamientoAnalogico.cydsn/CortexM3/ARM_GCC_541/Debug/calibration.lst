 263:calibration.c ****             cal_diag_point(g_cal_async.dac, g_cal_async.measured);
 264:calibration.c ****             g_cal_async.state = g_cal_async.after_measure;
 265:calibration.c ****             return 1u;
 266:calibration.c ****         }
 267:calibration.c ****         return 0u;
 268:calibration.c ****     }
 269:calibration.c **** 
