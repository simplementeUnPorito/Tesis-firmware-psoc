 100:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
 101:calibration.c **** {
 102:calibration.c ****     uint16 u;
 103:calibration.c ****     if (value > 32767L) { value = 32767L; }
 104:calibration.c ****     if (value < -32768L) { value = -32768L; }
 105:calibration.c ****     u = (uint16)(int16)value;
 106:calibration.c ****     cal_diag(event, (uint8)(u >> 8));
 107:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
 108:calibration.c **** }
 109:calibration.c **** 
 110:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
 111:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
 112:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
 113:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
 114:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
 115:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
 116:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
 117:calibration.c **** {
 118:calibration.c ****     uint32 u = (uint32)value;
