 113:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 114:calibration.c **** {
 115:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 116:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 117:calibration.c ****     if (dac < lo) { return lo; }
 118:calibration.c ****     if (dac > hi) { return hi; }
 119:calibration.c ****     return dac;
 120:calibration.c **** }
 121:calibration.c **** 
 122:calibration.c **** static uint8 cal_stage_center_dac(const PsocCalStage *stage)
 123:calibration.c **** {
