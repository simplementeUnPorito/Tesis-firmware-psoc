1771:calibration.c **** 
1772:calibration.c ****     /* anti-windup tipo clamping y zona muerta: dentro de deadband no se
1773:calibration.c ****      * acumula error para no perseguir pasos imposibles del VDAC. */
1774:calibration.c ****     if (can_integrate && stage_gain_x1000 != 0L && control_error != 0L) {
1775:calibration.c ****         g_cal_pi.integral = cal_servo_clip_integral(g_cal_pi.integral + control_error);
