 915:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
 916:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
 917:calibration.c **** {
 918:calibration.c ****     int64 half;
 919:calibration.c **** 
 920:calibration.c ****     if (den == 0LL) {
 921:calibration.c ****         den = 1LL;
 922:calibration.c ****     }
 923:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
 924:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
 925:calibration.c ****         return (num - half) / den;
 926:calibration.c ****     }
 927:calibration.c ****     return (num + half) / den;
 928:calibration.c **** }
 929:calibration.c **** 
 930:calibration.c **** static int32 cal_pi_clip_integral(int32 value)
 931:calibration.c **** {
 932:calibration.c ****     if (value > CAL_PI_INTEGRAL_LIMIT) { return CAL_PI_INTEGRAL_LIMIT; }
 933:calibration.c ****     if (value < -CAL_PI_INTEGRAL_LIMIT) { return -CAL_PI_INTEGRAL_LIMIT; }
 934:calibration.c ****     return value;
 935:calibration.c **** }
