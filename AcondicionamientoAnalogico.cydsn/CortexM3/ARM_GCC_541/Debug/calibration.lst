  13:calibration.c **** static PsocCalDiagHook g_cal_diag_hook = (PsocCalDiagHook)0;
  14:calibration.c **** 
  15:calibration.c **** void psoc_calibration_set_diag_hook(PsocCalDiagHook hook)
  16:calibration.c **** {
  17:calibration.c ****     g_cal_diag_hook = hook;
  18:calibration.c **** }
  19:calibration.c **** 
  20:calibration.c **** static void cal_diag(uint8 event, uint8 value)
  21:calibration.c **** {
  22:calibration.c ****     if (g_cal_diag_hook != (PsocCalDiagHook)0) {
  23:calibration.c ****         g_cal_diag_hook(event, value);
  24:calibration.c ****     }
  25:calibration.c **** }
  26:calibration.c **** 
  27:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
  28:calibration.c **** {
  29:calibration.c ****     uint16 u;
  30:calibration.c ****     if (value > 32767L) { value = 32767L; }
  31:calibration.c ****     if (value < -32768L) { value = -32768L; }
  32:calibration.c ****     u = (uint16)(int16)value;
  33:calibration.c ****     cal_diag(event, (uint8)(u >> 8));
  34:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
  35:calibration.c **** }
  36:calibration.c **** 
  37:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
  38:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
  39:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
  40:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
  41:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
  42:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
  43:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
  44:calibration.c **** {
  45:calibration.c ****     uint32 u = (uint32)value;
  46:calibration.c ****     cal_diag(event, (uint8)((u >> 24) & 0xFFu));
  47:calibration.c ****     cal_diag(event, (uint8)((u >> 16) & 0xFFu));
  48:calibration.c ****     cal_diag(event, (uint8)((u >> 8) & 0xFFu));
  49:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
  50:calibration.c **** }
  51:calibration.c **** 
  52:calibration.c **** static void cal_diag_point(uint8 dac, int32 measured)
  53:calibration.c **** {
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccjTfQj7.s 			page 442


  54:calibration.c ****     cal_diag(PSOC_EVT_CAL_STAGE_DAC, dac);
  55:calibration.c ****     cal_diag_i16(PSOC_EVT_CAL_STAGE_MEAS, measured);
  56:calibration.c ****     cal_diag_i32(PSOC_EVT_CAL_STAGE_MEAS32, measured);
  57:calibration.c **** }
  58:calibration.c **** 
  59:calibration.c **** static void cal_diag_realcheck_point(uint8 dac, int32 measured)
  60:calibration.c **** {
  61:calibration.c ****     cal_diag(PSOC_EVT_CAL_REALCHECK_DAC, dac);
  62:calibration.c ****     cal_diag_i32(PSOC_EVT_CAL_REALCHECK_MEAS32, measured);
  63:calibration.c **** }
  64:calibration.c **** 
  65:calibration.c **** static void cal_diag_measure_point(uint8 dac, int32 measured, uint8 realcheck)
  66:calibration.c **** {
  67:calibration.c ****     if (realcheck) {
  68:calibration.c ****         cal_diag_realcheck_point(dac, measured);
  69:calibration.c ****     } else {
  70:calibration.c ****         cal_diag_point(dac, measured);
  71:calibration.c ****     }
  72:calibration.c **** }
