 241:calibration.c **** /* ============================================================
 242:calibration.c ****  * BISECCION (legacy, comentada a pedido del usuario): GEO y HAMMER calibran
 243:calibration.c ****  * ahora exclusivamente vía el controlador PI (cal_pi_*, mas abajo). Todo lo
 244:calibration.c ****  * que sigue marcado "#if 0" es la biseccion vieja — se conserva como
 245:calibration.c ****  * referencia, no se borró, pero no compila. Ver calibration_tables.h,
 246:calibration.c ****  * bloque "Controlador PI de calibracion", para la ley de control activa.
 247:calibration.c ****  * ============================================================ */
 248:calibration.c **** #if CAL_ALGO_BISECTION_ENABLE
 249:calibration.c **** /* Reduce las cuentas crudas del ADC a una escala comparable con los codigos
 250:calibration.c ****  * del VDAC8. El ADC ve un span simplificado de 0..5V (signed +-2.5V alrededor
 251:calibration.c ****  * de VDDA/2), mientras el VDAC usa 0..4.080V; por eso al shift de 18->8 bits
 252:calibration.c ****  * se le aplica la correccion de spans 5000/4080. */
 253:calibration.c **** #define CAL_DAC_SCALE_SHIFT 10
 254:calibration.c **** #define CAL_ADC_SPAN_MV    5000L
 255:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
 256:calibration.c **** 
 257:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
