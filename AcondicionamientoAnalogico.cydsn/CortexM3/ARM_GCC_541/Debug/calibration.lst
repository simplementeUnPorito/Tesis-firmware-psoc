 127:calibration.c **** static uint8 cal_stage_probe_dac(const PsocCalStage *stage)
 128:calibration.c **** {
 129:calibration.c ****     uint8 center = cal_stage_center_dac(stage);
 130:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 131:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 132:calibration.c **** 
 133:calibration.c ****     if (stage->direction >= 0) {
 134:calibration.c ****         if ((uint16)center + (uint16)CAL_PROBE_STEP <= hi) {
 135:calibration.c ****             return (uint8)(center + CAL_PROBE_STEP);
 136:calibration.c ****         }
 137:calibration.c ****         if (center > lo) {
 138:calibration.c ****             uint8 down = (center > CAL_PROBE_STEP) ? (uint8)(center - CAL_PROBE_STEP) : lo;
 139:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 140:calibration.c ****         }
 141:calibration.c ****     } else {
 142:calibration.c ****         if (center > lo) {
 143:calibration.c ****             uint8 down = (center > CAL_PROBE_STEP) ? (uint8)(center - CAL_PROBE_STEP) : lo;
 144:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 145:calibration.c ****         }
 146:calibration.c ****         if ((uint16)center + (uint16)CAL_PROBE_STEP <= hi) {
 147:calibration.c ****             return (uint8)(center + CAL_PROBE_STEP);
 148:calibration.c ****         }
 149:calibration.c ****     }
 150:calibration.c **** 
 151:calibration.c ****     return (center < hi) ? hi : lo;
 152:calibration.c **** }
