 853:calibration.c **** /* ============================================================
 854:calibration.c ****  * Controlador PI de calibracion: unico algoritmo activo. Puerto directo de
 855:calibration.c ****  * Subsystem_step() en
 856:calibration.c ****  * src/matlab/Simulaciones Controladores/Desacople/Subsystem_grt_rtw/Subsystem.c
 857:calibration.c ****  * -- ESE es el diseño de referencia, no una variacion: misma ley PI
 858:calibration.c ****  * posicional, sin paso de "refine"/promediado al cerrar la etapa. Toda
 859:calibration.c ****  * la suavizacion viene del FIR de hardware (Filter, FIR_calibration.h) leido
 860:calibration.c ****  * via DMA_Filter_RAM -- nunca un promedio de software.
 861:calibration.c ****  *
 862:calibration.c ****  * Superficie de ajuste por etapa, A PROPOSITO reducida a esto y nada mas
 863:calibration.c ****  * (ver calibration_tables_{geo,hammer}_*.h): Kp (num/div), Ki (num/div),
 864:calibration.c ****  * ganancia absoluta VDAC->medida y samples para lock (M muestras en la misma
 865:calibration.c ****  * celda de error cuantizado). target_mv y adelanto_mv son aparte (planteo del
 866:calibration.c ****  * problema, no ganancias del algoritmo).
 867:calibration.c ****  *
 868:calibration.c ****  * Reutiliza g_cal_async.busy/done/ok/stage_index/start_ticks (watchdog) y
 869:calibration.c ****  * cal_async_complete/cal_async_abort_watchdog tal cual: para el resto del
 870:calibration.c ****  * firmware (EEPROM, diagnostico UART, ESP/web) mantiene la misma API externa.
 871:calibration.c ****  * ============================================================ */
 872:calibration.c **** 
 873:calibration.c **** typedef enum {
 874:calibration.c ****     CAL_PI_STAGE_BEGIN = 0u,
 875:calibration.c ****     CAL_PI_SETTLE,
