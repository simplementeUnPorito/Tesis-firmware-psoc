 337:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 338:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 339:calibration.c ****     if (dac < lo) { return lo; }
 340:calibration.c ****     if (dac > hi) { return hi; }
 341:calibration.c ****     return dac;
