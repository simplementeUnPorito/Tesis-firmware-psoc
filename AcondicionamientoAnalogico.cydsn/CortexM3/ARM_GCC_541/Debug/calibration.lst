  64:calibration_tables.h **** #define CAL_TARGET_GEO_LP_COUNTS 0L
  65:calibration_tables.h **** #endif
  66:calibration_tables.h **** 
  67:calibration_tables.h **** #define CAL_AVG_N      32u
  68:calibration_tables.h **** #define CAL_MAX_ITER   12u
  69:calibration_tables.h **** #define CAL_TOL_COUNTS 250L
  70:calibration_tables.h **** 
  71:calibration_tables.h **** /* Punto de partida obligatorio de la busqueda binaria: 0x9C = 156 ->
  72:calibration_tables.h ****  * 156 * 16mV (VDAC8 1x) = 2.496V =~ 2.5V (centro de rango / "tierra
  73:calibration_tables.h ****  * virtual" del front-end analogico). */
  74:calibration_tables.h **** #define CAL_DAC_INIT   0x9Cu
  75:calibration_tables.h **** 
  76:calibration_tables.h **** /* Primer paso (antes de la busqueda binaria) para detectar empiricamente si
  77:calibration_tables.h ****  * la medida crece o decrece con el codigo DAC. */
  78:calibration_tables.h **** #define CAL_PROBE_STEP 32u
  79:calibration_tables.h **** 
  80:calibration_tables.h **** /* "Estabilizacion": stable_avg() repite avg_counts() hasta que dos ventanas
  81:calibration_tables.h ****  * consecutivas difieran <= CAL_SETTLE_TOL_COUNTS (ruido de cuantizacion),
  82:calibration_tables.h ****  * o hasta CAL_SETTLE_MAX_WINDOWS intentos (usa la ultima ventana). */
  83:calibration_tables.h **** #define CAL_SETTLE_MAX_WINDOWS 10u
  84:calibration_tables.h **** #define CAL_SETTLE_TOL_COUNTS  100L
  85:calibration_tables.h **** 
