 293:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 294:calibration.c **** {
 295:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 296:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 297:calibration.c ****     if (dac < lo) { return lo; }
 298:calibration.c ****     if (dac > hi) { return hi; }
 299:calibration.c ****     return dac;
 300:calibration.c **** }
 301:calibration.c **** 
 302:calibration.c **** static uint8 cal_stage_center_dac(const PsocCalStage *stage)
 303:calibration.c **** {
 304:calibration.c ****     return cal_stage_clamp_dac(stage, stage->dac_center);
 305:calibration.c **** }
