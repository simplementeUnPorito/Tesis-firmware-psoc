1147:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1148:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
1149:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
1150:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
1151:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
1152:calibration.c **** static void cal_async_abort_watchdog(void)
1153:calibration.c **** {
1154:calibration.c ****     uint8 i;
1155:calibration.c ****     uint8 preserve_results =
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccGrLkYO.s 			page 566


1156:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1157:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1158:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1159:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1160:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1161:calibration.c **** 
1162:calibration.c ****     if (!preserve_results) {
1163:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1164:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1165:calibration.c ****             g_psoc_cal_stages[i].write(center);
1166:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1167:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1168:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1169:calibration.c ****         }
1170:calibration.c ****     }
1171:calibration.c ****     g_cal_async.ok = 0u;
1172:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1173:calibration.c **** 
1174:calibration.c ****     cal_async_complete();
1175:calibration.c **** }
