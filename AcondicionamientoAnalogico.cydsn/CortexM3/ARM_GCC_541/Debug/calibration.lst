 280:calibration.c ****  * bloque "Controlador PI de calibracion", para la ley de control activa.
 281:calibration.c ****  * ============================================================ */
 282:calibration.c **** #if CAL_ALGO_BISECTION_ENABLE
 283:calibration.c **** /* Reduce las cuentas crudas del ADC a una escala comparable con los codigos
 284:calibration.c ****  * del VDAC8. El ADC ve un span simplificado de 0..5V (signed +-2.5V alrededor
 285:calibration.c ****  * de VDDA/2), mientras el VDAC usa 0..4.080V; por eso al shift de 18->8 bits
 286:calibration.c ****  * se le aplica la correccion de spans 5000/4080. */
 287:calibration.c **** #define CAL_DAC_SCALE_SHIFT 10
 288:calibration.c **** #define CAL_ADC_SPAN_MV    5000L
 289:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
 290:calibration.c **** 
 291:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
 292:calibration.c **** {
 293:calibration.c ****     if (value >= 0L) {
 294:calibration.c ****         return (value + (divisor / 2L)) / divisor;
 295:calibration.c ****     }
 296:calibration.c ****     return -(((-value) + (divisor / 2L)) / divisor);
 297:calibration.c **** }
 298:calibration.c **** 
 299:calibration.c **** static int32 cal_scale_counts(int32 value)
 300:calibration.c **** {
 301:calibration.c ****     int32 shifted = value >> CAL_DAC_SCALE_SHIFT;
 302:calibration.c ****     return cal_div_round_signed(shifted * CAL_ADC_SPAN_MV, CAL_VDAC_SPAN_MV);
 303:calibration.c **** }
 304:calibration.c **** 
 305:calibration.c **** /* Ver CAL_OPERATING_RANGE_COUNTS (calibration_tables.h): +-0.5V absolutos.
 306:calibration.c ****  * Una medicion mas alla de esto deja al operacional fuera de rango
 307:calibration.c ****  * operativo, sin importar si "ok" hubiera dado 1. */
 308:calibration.c **** static uint8 cal_measured_out_of_range(int32 measured)
 309:calibration.c **** {
 310:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) > cal_scale_counts(CAL_OPERATING_RANGE_COUNTS)) 
 311:calibration.c **** }
 312:calibration.c **** 
 313:calibration.c **** static uint8 cal_stage_saturated(const PsocCalStage *stage, int32 measured)
 314:calibration.c **** {
 315:calibration.c ****     if (stage->sat_counts <= 0L) {
 316:calibration.c ****         return 0u;
 317:calibration.c ****     }
 318:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) >= cal_scale_counts(stage->sat_counts)) ? 1u : 0
 319:calibration.c **** }
 320:calibration.c **** #endif /* #if 0 -- biseccion legacy */
