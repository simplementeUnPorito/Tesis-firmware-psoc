1427:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1428:calibration.c ****  * Compartido con el PI (psoc_calibration_service_async la llama antes de
1429:calibration.c ****  * ramificar). Las etapas ya finalizadas (indices < stage_index) conservan su
1430:calibration.c ****  * mejor valor encontrado; la etapa en curso y las que faltan se fuerzan al
1431:calibration.c ****  * centro nominal de cada etapa. La condicion preserve_results es reliquia de
1432:calibration.c ****  * la biseccion (estados de verify/realcheck que el PI nunca setea) -- queda
1433:calibration.c ****  * inerte pero no rompe nada, no afecta el comportamiento. */
1434:calibration.c **** static void cal_async_abort_watchdog(void)
1435:calibration.c **** {
