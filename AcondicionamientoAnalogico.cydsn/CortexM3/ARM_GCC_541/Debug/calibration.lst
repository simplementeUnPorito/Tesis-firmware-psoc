1620:calibration.c **** static int32 cal_pi_error_bucket(int32 error_dac, int32 deadband_dac)
1621:calibration.c **** {
1622:calibration.c ****     int32 abs_error;
1623:calibration.c ****     int32 span;
1624:calibration.c ****     int32 bucket;
1625:calibration.c **** 
1626:calibration.c ****     span = (deadband_dac <= 0L) ? 1L : deadband_dac;
1627:calibration.c ****     abs_error = abs_counts(error_dac);
1628:calibration.c ****     if (abs_error <= span) {
1629:calibration.c ****         return 0L;
1630:calibration.c ****     }
1631:calibration.c ****     bucket = 1L + ((abs_error - span - 1L) / span);
1632:calibration.c ****     return (error_dac < 0L) ? -bucket : bucket;
1633:calibration.c **** }
