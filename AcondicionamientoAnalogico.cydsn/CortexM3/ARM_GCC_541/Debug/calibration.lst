 988:calibration.c **** 
 989:calibration.c **** static int32 cal_pi_deadband_dac_codes(uint8 stage_index)
 990:calibration.c **** {
 991:calibration.c ****     int32 gain_x1000 = cal_pi_stage_gain_x1000(stage_index);
 992:calibration.c ****     int64 num;
 993:calibration.c ****     int64 den;
 994:calibration.c ****     int32 deadband;
 995:calibration.c **** 
 996:calibration.c ****     if (gain_x1000 < 0L) {
 997:calibration.c ****         gain_x1000 = -gain_x1000;
 998:calibration.c ****     }
 999:calibration.c ****     num = (int64)gain_x1000 * (int64)CAL_PI_DEADBAND_MARGIN_NUM;
1000:calibration.c ****     den = 1000LL * (int64)CAL_PI_DEADBAND_MARGIN_DEN;
1001:calibration.c ****     deadband = (int32)((num + den - 1LL) / den);
1002:calibration.c ****     if (deadband < CAL_PI_DEADBAND_MIN_DAC_CODES) {
1003:calibration.c ****         deadband = CAL_PI_DEADBAND_MIN_DAC_CODES;
1004:calibration.c ****     }
1005:calibration.c ****     return deadband;
1006:calibration.c **** }
