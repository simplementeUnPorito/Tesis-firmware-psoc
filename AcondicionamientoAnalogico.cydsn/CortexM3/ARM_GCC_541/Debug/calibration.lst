1442:calibration.c ****             g_psoc_cal_stages[i].write(center);
1443:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1444:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1445:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1446:calibration.c ****         }
1447:calibration.c ****     }
1448:calibration.c ****     g_cal_async.ok = 0u;
1449:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
