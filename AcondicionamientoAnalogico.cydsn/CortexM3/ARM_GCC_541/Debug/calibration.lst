1771:calibration.c **** static uint8 cal_pi_settle_service(void)
1772:calibration.c **** {
1773:calibration.c ****     int32 sample;
1774:calibration.c **** 
1775:calibration.c ****     if (!psoc_adc_take_isr_filtered_sample(&sample)) {
1776:calibration.c ****         g_cal_pi.empty_polls++;
1777:calibration.c ****         if (g_cal_pi.empty_polls >= CAL_ASYNC_EMPTY_POLL_LIMIT) {
1778:calibration.c ****             return cal_pi_finish_stage(0u);
1779:calibration.c ****         }
1780:calibration.c ****         return 0u;
1781:calibration.c ****     }
1782:calibration.c **** 
1783:calibration.c ****     g_cal_pi.empty_polls = 0UL;
1784:calibration.c ****     g_cal_pi.last_fir_output = psoc_adc_counts_right_aligned(sample);
1785:calibration.c **** 
1786:calibration.c ****     if (g_cal_pi.settle_remaining > 0u) {
1787:calibration.c ****         g_cal_pi.settle_remaining--;
1788:calibration.c ****     }
1789:calibration.c ****     if (g_cal_pi.settle_remaining == 0u) {
