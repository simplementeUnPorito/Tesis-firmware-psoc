 141:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
 142:calibration.c **** {
 143:calibration.c ****     uint16 u;
 144:calibration.c ****     if (value > 32767L) { value = 32767L; }
 145:calibration.c ****     if (value < -32768L) { value = -32768L; }
 146:calibration.c ****     u = (uint16)(int16)value;
 147:calibration.c ****     cal_diag(event, (uint8)(u >> 8));
 148:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
 149:calibration.c **** }
 150:calibration.c **** 
 151:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
 152:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
 153:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
 154:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
 155:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
 156:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
 157:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
 158:calibration.c **** {
 159:calibration.c ****     uint32 u = (uint32)value;
 160:calibration.c ****     cal_diag(event, (uint8)((u >> 24) & 0xFFu));
 161:calibration.c ****     cal_diag(event, (uint8)((u >> 16) & 0xFFu));
 162:calibration.c ****     cal_diag(event, (uint8)((u >> 8) & 0xFFu));
 163:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
 164:calibration.c **** }
