   8:calibration.c **** /* Wrapper para distinguir que algoritmo esta vivo en este archivo: el PI
   9:calibration.c ****  * (cal_pi_*, mas abajo) es el UNICO activo por default. Estas dos macros
  10:calibration.c ****  * son los unicos toggles -- todo lo que dice "#if CAL_ALGO_BISECTION_ENABLE"
  11:calibration.c ****  * o "#if CAL_ALGO_SERVO_ENABLE" es codigo legacy conservado como referencia,
  12:calibration.c ****  * nunca leido por el PI ni mezclado con sus parametros (ver
  13:calibration.c ****  * calibration_tables_{geo,hammer}_*.h, que separan lo mismo en sus propios
  14:calibration.c ****  * archivos). Poner cualquiera en 1 para reactivar esa ruta -- el codigo esta
  15:calibration.c ****  * intacto, no hay que reescribir nada. */
  16:calibration.c **** #ifndef CAL_ALGO_BISECTION_ENABLE
  17:calibration.c **** #define CAL_ALGO_BISECTION_ENABLE 0
  18:calibration.c **** #endif
  19:calibration.c **** #ifndef CAL_ALGO_SERVO_ENABLE
  20:calibration.c **** #define CAL_ALGO_SERVO_ENABLE 0
  21:calibration.c **** #endif
  22:calibration.c **** 
  23:calibration.c **** /* El lote HW (PSOC_ADC_LOTE_SAMPLES, psoc_adc.h) debe equivaler exactamente
  24:calibration.c ****  * a una ventana de calibración GEO (CAL_AVG_N_GEO_*) — async_measure_service
  25:calibration.c ****  * trata cada lote como una ventana ya sumada. Si alguna vez divergen, mejor
  26:calibration.c ****  * fallar el build que misconvergir en silencio. */
  27:calibration.c **** #if (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_PGA) || \
  28:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_BP) || \
  29:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_ADDER) || \
  30:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_LP)
  31:calibration.c **** #error "PSOC_ADC_LOTE_SAMPLES (psoc_adc.h) debe ser igual a CAL_AVG_N_GEO_* (calibration_tables_geo
  32:calibration.c **** #endif
  33:calibration.c **** 
  34:calibration.c **** /* Canal AMux_ADC del capacitor de filtrado (100nF a Vss, pin AMuxCapacitor en
  35:calibration.c ****  * TopDesign). AMux_ADC esta configurado en "All Modes" (AMux_ADC_ATMOSTONE=0,
  36:calibration.c ****  * ver AMux_ADC.h), es decir que el HARDWARE no impide tener varios canales
  37:calibration.c ****  * conectados a la vez -- la exclusion mutua entre canales de SEÑAL la tiene
  38:calibration.c ****  * que garantizar el software. psoc_amux_select_exclusive() es el unico punto
  39:calibration.c ****  * de entrada que toca AMux_ADC_Connect/Disconnect para que esa garantia viva
  40:calibration.c ****  * en un solo lugar: nunca conecta un canal nuevo sin desconectar antes el
  41:calibration.c ****  * anterior, asi que dos canales de señal jamas quedan en paralelo
  42:calibration.c ****  * (cortocircuito). El capacitor se trackea aparte y se puede dejar conectado
  43:calibration.c ****  * en paralelo a cualquier canal de señal a propósito -- durante la medición
  44:calibration.c ****  * de una etapa de calibración ayuda a filtrar ruido chico; durante
  45:calibration.c ****  * captura/idle se desconecta para no cargar la señal en vivo con capacitancia
  46:calibration.c ****  * extra.
  47:calibration.c ****  * El capacitor solo se conecta si el AMux tiene un canal extra despues de
