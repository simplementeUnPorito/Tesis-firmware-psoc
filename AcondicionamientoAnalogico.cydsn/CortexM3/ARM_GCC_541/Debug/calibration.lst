 872:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
 873:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
 874:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
 875:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
 876:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
 877:calibration.c **** static void cal_async_abort_watchdog(void)
 878:calibration.c **** {
 879:calibration.c ****     uint8 i;
 880:calibration.c ****     uint8 verify_phase = (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
 881:calibration.c ****                            g_cal_async.state == CAL_ASYNC_EVAL_VERIFY) ? 1u : 0u;
 882:calibration.c **** 
 883:calibration.c ****     if (!verify_phase) {
 884:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
 885:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
 886:calibration.c ****             g_psoc_cal_stages[i].write(center);
 887:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
 888:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
 889:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
 890:calibration.c ****         }
 891:calibration.c ****     }
 892:calibration.c ****     g_cal_async.ok = 0u;
 893:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
 894:calibration.c **** 
