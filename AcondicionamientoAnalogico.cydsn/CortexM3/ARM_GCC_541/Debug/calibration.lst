 717:calibration.c **** uint8 psoc_calibration_servo_service(void)
 718:calibration.c **** {
 719:calibration.c ****     if (!g_cal_servo.enabled || g_cal_async.busy) {
 720:calibration.c ****         return 0u;
 721:calibration.c ****     }
 722:calibration.c **** 
 723:calibration.c ****     if (g_cal_servo.state == CAL_SERVO_IDLE) {
 724:calibration.c ****         uint32 now = psoc_now_ticks();
 725:calibration.c ****         if ((int32)(now - g_cal_servo.next_due_ticks) >= 0) {
 726:calibration.c ****             cal_servo_measure_begin(g_cal_servo.stage_index);
 727:calibration.c ****         }
 728:calibration.c ****         return 0u;
 729:calibration.c ****     }
 730:calibration.c **** 
 731:calibration.c ****     return cal_servo_measure_service();
 732:calibration.c **** }
