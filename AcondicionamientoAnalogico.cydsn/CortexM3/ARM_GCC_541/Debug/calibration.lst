 138:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
 139:calibration.c **** {
 140:calibration.c ****     uint16 u;
 141:calibration.c ****     if (value > 32767L) { value = 32767L; }
 142:calibration.c ****     if (value < -32768L) { value = -32768L; }
 143:calibration.c ****     u = (uint16)(int16)value;
 144:calibration.c ****     cal_diag(event, (uint8)(u >> 8));
 145:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
 146:calibration.c **** }
 147:calibration.c **** 
 148:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
 149:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
 150:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
 151:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccc90pfu.s 			page 312


 152:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
 153:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
 154:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
 155:calibration.c **** {
 156:calibration.c ****     uint32 u = (uint32)value;
 157:calibration.c ****     cal_diag(event, (uint8)((u >> 24) & 0xFFu));
 158:calibration.c ****     cal_diag(event, (uint8)((u >> 16) & 0xFFu));
 159:calibration.c ****     cal_diag(event, (uint8)((u >> 8) & 0xFFu));
 160:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
 161:calibration.c **** }
 162:calibration.c **** 
 163:calibration.c **** static int32 abs_counts(int32 value)
 164:calibration.c **** {
 165:calibration.c ****     return (value < 0) ? -value : value;
 166:calibration.c **** }
