 834:calibration.c **** /* Aborta la calibracion por timeout global. Las etapas ya finalizadas se
 835:calibration.c ****  * conservan; la etapa en curso y las pendientes vuelven al adelanto nominal. */
 836:calibration.c **** static void cal_async_abort_watchdog(void)
 837:calibration.c **** {
 838:calibration.c ****     uint8 i;
 839:calibration.c **** 
 840:calibration.c ****     for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
 841:calibration.c ****         uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
 842:calibration.c ****         g_psoc_cal_stages[i].write(center);
 843:calibration.c ****         g_psoc_cal_results[i].final_dac = center;
 844:calibration.c ****         g_psoc_cal_results[i].final_measured = 0L;
 845:calibration.c ****         g_psoc_cal_results[i].ok = 0u;
 846:calibration.c ****     }
 847:calibration.c ****     g_cal_async.ok = 0u;
 848:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
 849:calibration.c **** 
 850:calibration.c ****     cal_async_complete();
 851:calibration.c **** }
