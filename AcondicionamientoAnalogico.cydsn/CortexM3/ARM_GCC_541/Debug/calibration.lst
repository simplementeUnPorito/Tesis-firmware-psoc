1741:calibration.c ****     g_cal_pi.last_dac_target = 0u;
1742:calibration.c ****     g_cal_pi.last_fir_output = 0L;
1743:calibration.c ****     g_cal_pi.empty_polls = 0UL;
1744:calibration.c ****     g_cal_pi.settle_remaining = (uint16)CAL_PI_FIR_SETTLE_SAMPLES;
