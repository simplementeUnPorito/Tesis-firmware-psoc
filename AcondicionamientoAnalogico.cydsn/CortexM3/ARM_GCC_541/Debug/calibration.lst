 577:calibration.c ****             control = error;
 578:calibration.c ****         }
 579:calibration.c **** 
 580:calibration.c ****         assume_increasing = g_cal_servo.have_slope[stage_index]
 581:calibration.c ****             ? g_cal_servo.increasing[stage_index]
