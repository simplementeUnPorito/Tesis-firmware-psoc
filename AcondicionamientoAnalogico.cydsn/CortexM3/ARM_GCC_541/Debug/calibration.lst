   1:calibration_tables.h **** #ifndef CALIBRATION_TABLES_H
   2:calibration_tables.h **** #define CALIBRATION_TABLES_H
   3:calibration_tables.h **** 
   4:calibration_tables.h **** #include "calibration.h"
   5:calibration_tables.h **** 
   6:calibration_tables.h **** /* Agregador de calibracion activo.
   7:calibration_tables.h ****  *
   8:calibration_tables.h ****  * La calibracion vigente es PI-only: el PI lee el DC desde el Filter de
   9:calibration_tables.h ****  * hardware cargado con FIR_calibration.h, y al cerrar cada etapa puede probar
  10:calibration_tables.h ****  * un unico LSB de VDAC para quedarse con el lado que mejore el error. Los
  11:calibration_tables.h ****  * parametros ajustables viven por etapa en:
  12:calibration_tables.h ****  *   - calibration_tables_geo_pga.h
  13:calibration_tables.h ****  *   - calibration_tables_geo_bp.h
  14:calibration_tables.h ****  *   - calibration_tables_geo_adder.h
  15:calibration_tables.h ****  *   - calibration_tables_geo_lp.h
  16:calibration_tables.h ****  *   - calibration_tables_hammer_pga.h
  17:calibration_tables.h ****  *   - calibration_tables_hammer_lp.h
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccA1fl8Q.s 			page 340


  18:calibration_tables.h ****  *
  19:calibration_tables.h ****  * La busqueda binaria historica se saco de los headers activos; queda guardada
  20:calibration_tables.h ****  * en calibration_tables_legacy_bisection.h, sin incluirse desde aca. */
  21:calibration_tables.h **** 
  22:calibration_tables.h **** #ifndef CAL_TARGET_1V_COUNTS
  23:calibration_tables.h **** #define CAL_TARGET_1V_COUNTS 52429L
  24:calibration_tables.h **** #endif
  25:calibration_tables.h **** 
  26:calibration_tables.h **** #ifndef CAL_TARGET_1V5_COUNTS
  27:calibration_tables.h **** #define CAL_TARGET_1V5_COUNTS 78644L
  28:calibration_tables.h **** #endif
  29:calibration_tables.h **** 
  30:calibration_tables.h **** /* Escalas fisicas usadas por el PI activo. El ADC se compara en el mismo
  31:calibration_tables.h ****  * dominio que el VDAC: ADC 0..5V, 18 bits; VDAC8 0..4.080V, 8 bits. */
  32:calibration_tables.h **** #ifndef CAL_ADC_SPAN_MV
  33:calibration_tables.h **** #define CAL_ADC_SPAN_MV 5000L
  34:calibration_tables.h **** #endif
  35:calibration_tables.h **** 
  36:calibration_tables.h **** #ifndef CAL_ADC_FULL_SCALE_COUNTS
  37:calibration_tables.h **** #define CAL_ADC_FULL_SCALE_COUNTS 262144L
  38:calibration_tables.h **** #endif
  39:calibration_tables.h **** 
  40:calibration_tables.h **** #ifndef CAL_VDAC_SPAN_MV
  41:calibration_tables.h **** #define CAL_VDAC_SPAN_MV 4080L
  42:calibration_tables.h **** #endif
  43:calibration_tables.h **** 
  44:calibration_tables.h **** #ifndef CAL_VDAC_CODE_MAX
  45:calibration_tables.h **** #define CAL_VDAC_CODE_MAX 255L
  46:calibration_tables.h **** #endif
  47:calibration_tables.h **** 
  48:calibration_tables.h **** #ifndef CAL_VDAC8_MV_PER_LSB
  49:calibration_tables.h **** #define CAL_VDAC8_MV_PER_LSB 16L
  50:calibration_tables.h **** #endif
  51:calibration_tables.h **** 
  52:calibration_tables.h **** /* Definir esta macro (o pasarla por flag de compilador) fuerza Delta_i=1 en
  53:calibration_tables.h ****  * todas las etapas, saltandose el margen de banda muerta de abajo. Uso: test
  54:calibration_tables.h ****  * A1 de la revision (distinguir banda-muerta vs velocidad de convergencia).
  55:calibration_tables.h ****  * Dejar comentado en builds normales. */
  56:calibration_tables.h **** /* #define CAL_PI_FORCE_MIN_DEADBAND */
