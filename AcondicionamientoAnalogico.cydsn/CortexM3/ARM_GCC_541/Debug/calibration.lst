  82:calibration_tables.h **** #define CAL_PI_DEADBAND_MARGIN_NUM 6L
  83:calibration_tables.h **** #endif
  84:calibration_tables.h **** 
  85:calibration_tables.h **** #ifndef CAL_PI_DEADBAND_MARGIN_DEN
