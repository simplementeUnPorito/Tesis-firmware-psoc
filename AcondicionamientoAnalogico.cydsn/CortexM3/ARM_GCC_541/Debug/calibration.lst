  97:calibration_tables.h **** /* Parametros POR ETAPA HAMMER (target, adelanto/rango de busqueda, PI,
  98:calibration_tables.h ****  * asentamiento) viven en headers independientes, uno por VDAC -- mismo
  99:calibration_tables.h ****  * patron que los headers GEO de mas abajo:
 100:calibration_tables.h ****  *   - calibration_tables_hammer_pga.h
 101:calibration_tables.h ****  *   - calibration_tables_hammer_lp.h
 102:calibration_tables.h ****  * Incluidos aca arriba (no junto a los de GEO) porque el bloque HAMMER de
 103:calibration_tables.h ****  * abajo en este archivo todavia los referencia para armar g_psoc_cal_stages. */
 104:calibration_tables.h **** #include "calibration_tables_hammer_pga.h"
 105:calibration_tables.h **** #include "calibration_tables_hammer_lp.h"
 106:calibration_tables.h **** 
 107:calibration_tables.h **** /* Rango operativo absoluto: ADC_CFG1_COUNTS_PER_VOLT=52429 (ver HANDOFF
 108:calibration_tables.h ****  * §4/§13), entonces 0.5V =~ 26214 counts. Se conserva como alarma de salud:
 109:calibration_tables.h ****  * si una etapa queda fuera de esto, el log lo muestra como no OK, pero no se
 110:calibration_tables.h ****  * abandona la cascada ni se vuelve al default. Distinto de
 111:calibration_tables.h ****  * CAL_SAT_COUNTS_GEO_* (por etapa, en cada header) que es el umbral de riel
 112:calibration_tables.h ****  * real. */
 113:calibration_tables.h **** #define CAL_OPERATING_RANGE_COUNTS 26214L
 114:calibration_tables.h **** 
 115:calibration_tables.h **** /* Tamaño del buffer circular de sumas-de-ventana usado por
 116:calibration_tables.h ****  * async_measure_service (calibration.c) para el promedio deslizante. Debe
 117:calibration_tables.h ****  * ser >= el window_count mas grande entre TODAS las etapas/fases (hoy:
 118:calibration_tables.h ****  * CAL_REALCHECK_AVG_WINDOW_COUNT_GEO_* = 64). Una sola instancia porque las
 119:calibration_tables.h ****  * etapas se procesan secuencialmente. */
 120:calibration_tables.h **** #define CAL_AVG_WINDOW_MAX 64u
 121:calibration_tables.h **** 
 122:calibration_tables.h **** /* Descartes por asentamiento calculados desde el sample rate real del ADC.
 123:calibration_tables.h ****  * CAL_SETTLE_FACTOR esta en calibration.h. Con factor 3x y
 124:calibration_tables.h ****  * ADC_DEFAULT_SRATE=3000:
 125:calibration_tables.h ****  *   PGA 220ms -> 1980 muestras, BP 100us -> 1, Adder 200us -> 2,
 126:calibration_tables.h ****  *   LP 6ms -> 54. */
 127:calibration_tables.h **** #ifndef ADC_DEFAULT_SRATE
 128:calibration_tables.h **** #define ADC_DEFAULT_SRATE 3000u
 129:calibration_tables.h **** #endif
 130:calibration_tables.h **** 
 131:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_US(us) \
 132:calibration_tables.h ****     ((uint16)((((uint32)(us) * (uint32)ADC_DEFAULT_SRATE * (uint32)CAL_SETTLE_FACTOR) + \
 133:calibration_tables.h ****                ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL) - 1UL) / \
 134:calibration_tables.h ****               ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL)))
 135:calibration_tables.h **** 
 136:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_MS(ms) \
 137:calibration_tables.h ****     CAL_SETTLE_SAMPLES_FROM_US(((uint32)(ms) * 1000UL))
 138:calibration_tables.h **** 
 139:calibration_tables.h **** /* Punto de partida obligatorio de la busqueda binaria: 0x9C = 156 ->
 140:calibration_tables.h ****  * 156 * 16mV (VDAC8 1x) = 2.496V =~ 2.5V (centro de rango / "tierra
 141:calibration_tables.h ****  * virtual" del front-end analogico). Las etapas GEO ya usan el literal
 142:calibration_tables.h ****  * 0x9Cu directamente en sus headers; estas quedan para el bloque HAMMER. */
 143:calibration_tables.h **** #define CAL_DAC_INIT   0x9Cu
 144:calibration_tables.h **** #define CAL_DAC_CENTER CAL_DAC_INIT
 145:calibration_tables.h **** #define CAL_DAC_MAX_CHANGE_HAMMER 255u
 146:calibration_tables.h **** 
 147:calibration_tables.h **** /* En GEO no cortar en la primera etapa: la etapa siguiente puede compensar
 148:calibration_tables.h ****  * parte del residual, y necesitamos ver el diagnostico completo de las cuatro
 149:calibration_tables.h ****  * etapas aunque una quede fuera de tolerancia. */
 150:calibration_tables.h **** #define CAL_FAIL_FAST_ON_STAGE_FAIL 0u
 151:calibration_tables.h **** 
 152:calibration_tables.h **** /* El adelanto (feedforward) y el rango de busqueda de HAMMER ya NO viven
 153:calibration_tables.h ****  * aca -- son individuales por etapa, ver CAL_ADELANTO_HAMMER_PGA_MV /
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccOScYe6.s 			page 258


 154:calibration_tables.h ****  * CAL_DAC_CENTER_HAMMER_PGA / CAL_DAC_MAX_CHANGE_HAMMER_PGA (y su _LP) en
 155:calibration_tables.h ****  * calibration_tables_hammer_pga.h / _lp.h, incluidos mas arriba. */
 156:calibration_tables.h **** 
 157:calibration_tables.h **** #define CAL_BEST_CANDIDATE_COUNT 4u
 158:calibration_tables.h **** #define CAL_VISIT_HISTORY_COUNT  8u
 159:calibration_tables.h **** 
 160:calibration_tables.h **** /* 10 ms/tick. La fase realcheck puede sumar decenas de segundos, asi que el
 161:calibration_tables.h ****  * watchdog PSoC queda en 400 s y el timeout del ESP debe ser mayor. */
 162:calibration_tables.h **** #define CAL_WATCHDOG_TICKS 40000UL
 163:calibration_tables.h **** 
 164:calibration_tables.h **** /* ============================================================
 165:calibration_tables.h ****  * Servo lento de mantenimiento en IDLE (CAL_SERVO_ENABLE_DEFAULT=0).
 166:calibration_tables.h ****  * No reemplaza al comando manual/boot de calibracion; corrige deriva de a
 167:calibration_tables.h ****  * poco, por turnos. Estas son las constantes del LOOP en si (timing/limites,
 168:calibration_tables.h ****  * no dependen de la etapa); las ganancias PI por etapa GEO viven en cada
 169:calibration_tables.h ****  * calibration_tables_geo_*.h. */
 170:calibration_tables.h **** #ifndef CAL_SERVO_ENABLE_DEFAULT
 171:calibration_tables.h **** #define CAL_SERVO_ENABLE_DEFAULT 0u
 172:calibration_tables.h **** #endif
 173:calibration_tables.h **** 
 174:calibration_tables.h **** #define CAL_SERVO_WORSE_HYST_COUNTS      250L
 175:calibration_tables.h **** #define CAL_SERVO_INTEGRAL_LIMIT      419424L
 176:calibration_tables.h **** #define CAL_SERVO_AVG_N                   32u
 177:calibration_tables.h **** #define CAL_SERVO_SETTLE_MAX_WINDOWS       8u
 178:calibration_tables.h **** #define CAL_SERVO_SETTLE_TOL_COUNTS       50L
 179:calibration_tables.h **** #define CAL_SERVO_PERIOD_TICKS            25u
 180:calibration_tables.h **** 
 181:calibration_tables.h **** /* Defaults compartidos solo por el bloque HAMMER (las etapas GEO ya tienen
 182:calibration_tables.h ****  * sus propios CAL_SERVO_DEADBAND/FINE_STEP/RECOVERY_STEP_GEO_* literales). */
 183:calibration_tables.h **** #define CAL_SERVO_DEADBAND_COUNTS       5000L
 184:calibration_tables.h **** #define CAL_SERVO_FINE_STEP                1u
 185:calibration_tables.h **** #define CAL_SERVO_RECOVERY_STEP            1u
 186:calibration_tables.h **** 
 187:calibration_tables.h **** /* ============================================================
 188:calibration_tables.h ****  * BLOQUE HAMMER: hoy es el front-end activo (ver nota arriba). Usa un solo
 189:calibration_tables.h ****  * juego de parametros de biseccion (anti-saturacion/promediado/realcheck)
 190:calibration_tables.h ****  * compartido entre sus 3 etapas, con la fase realcheck deshabilitada
 191:calibration_tables.h ****  * (CAL_REALCHECK_ENABLE_HAMMER=0) — esa parte queda como código histórico,
 192:calibration_tables.h ****  * reemplazada en la práctica por el controlador PI de mas abajo
 193:calibration_tables.h ****  * (CAL_PI_*_HAMMER_*), que es el que corre hoy para HAMMER
 194:calibration_tables.h ****  * (psoc_calibration_service_async, ver calibration.c).
 195:calibration_tables.h ****  * ============================================================ */
 196:calibration_tables.h **** #define CAL_AVG_N      32u
 197:calibration_tables.h **** #define CAL_MAX_ITER   16u
 198:calibration_tables.h **** /* HAMMER se esta cerrando con lectura directa del ADC crudo (sin el capacitor
 199:calibration_tables.h ****  * de AMux, porque con capacitor la ruta queda saturada/congelada en banco).
 200:calibration_tables.h ****  * El ruido observado por ESP ronda decenas de mV, asi que 250 counts (~5 mV)
 201:calibration_tables.h ****  * hacia fallar etapas ya centradas. 6000 counts son ~114 mV con
 202:calibration_tables.h ****  * CAL_TARGET_1V_COUNTS=52429 counts/V. */
 203:calibration_tables.h **** /* CAL_TOL_COUNTS/DEADBAND/PROBE_STEP/SETTLE_SAMPLES/SAT_COUNTS por etapa HAMMER
 204:calibration_tables.h ****  * (antes globales aca) ya viven en calibration_tables_hammer_pga.h / _lp.h,
 205:calibration_tables.h ****  * incluidos mas arriba -- CAL_TOL_COUNTS_HAMMER_PGA, CAL_TOL_COUNTS_HAMMER_LP,
 206:calibration_tables.h ****  * etc. Lo que queda aca es la configuracion de promediado/realcheck de la
 207:calibration_tables.h ****  * biseccion vieja (compartida, sin uso por el PI -- ver #if 0 en
 208:calibration_tables.h ****  * calibration.c). */
 209:calibration_tables.h **** 
