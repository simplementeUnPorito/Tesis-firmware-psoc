1126:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1127:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
1128:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
1129:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
1130:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
1131:calibration.c **** static void cal_async_abort_watchdog(void)
1132:calibration.c **** {
1133:calibration.c ****     uint8 i;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccqaUDpg.s 			page 569


1134:calibration.c ****     uint8 preserve_results =
1135:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1136:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1137:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1138:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1139:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1140:calibration.c **** 
1141:calibration.c ****     if (!preserve_results) {
1142:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1143:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1144:calibration.c ****             g_psoc_cal_stages[i].write(center);
1145:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1146:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1147:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1148:calibration.c ****         }
1149:calibration.c ****     }
1150:calibration.c ****     g_cal_async.ok = 0u;
1151:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1152:calibration.c **** 
1153:calibration.c ****     cal_async_complete();
1154:calibration.c **** }
