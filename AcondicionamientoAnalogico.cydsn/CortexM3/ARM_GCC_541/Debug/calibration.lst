1757:calibration.c **** 
1758:calibration.c ****     /* El PI no promedia/EMA en software: extrae el DC con el FIR de hardware
1759:calibration.c ****      * (Canal A del Filter, coeficientes de FIR_calibration.h cargados en
1760:calibration.c ****      * cal_pi_start) -- ADC -> Filter_STAGEA -> DMA_Filter_RAM, leido muestra
1761:calibration.c ****      * a muestra en cal_pi_run_service. */
1762:calibration.c ****     dma_route_select(1u);
