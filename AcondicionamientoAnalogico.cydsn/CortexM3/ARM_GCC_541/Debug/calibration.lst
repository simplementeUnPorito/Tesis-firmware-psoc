  53:calibration.c ****             AMux_ADC_Connect(CAL_AMUX_CAP_CHANNEL);
  54:calibration.c ****             g_amux_cap_connected = 1u;
  55:calibration.c ****         }
  56:calibration.c ****     } else if (g_amux_cap_connected) {
  57:calibration.c ****         AMux_ADC_Disconnect(CAL_AMUX_CAP_CHANNEL);
  58:calibration.c ****         g_amux_cap_connected = 0u;
  59:calibration.c ****     }
  60:calibration.c **** }
