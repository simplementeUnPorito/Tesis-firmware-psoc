 260:calibration.c **** /* Watchdog global expresado como ticks legacy de 10 ms para mantener la escala
 261:calibration.c ****  * de configuracion anterior; en runtime lo ejecuta Timer_3 como one-shot. */
 262:calibration.c **** #ifndef CAL_WATCHDOG_TICKS
 263:calibration.c **** #define CAL_WATCHDOG_TICKS 40000UL
 264:calibration.c **** #endif
 265:calibration.c **** 
 266:calibration.c **** /* Periodo de telemetria de progreso (ticks legacy de 10 ms => ~500 ms). */
 267:calibration.c **** #define CAL_PROGRESS_PERIOD_TICKS 50UL
