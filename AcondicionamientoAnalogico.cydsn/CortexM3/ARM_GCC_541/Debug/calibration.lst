 236:calibration_tables.h **** 
 237:calibration_tables.h **** /* ============================================================
 238:calibration_tables.h ****  * Controlador PI de calibracion: UNICO algoritmo activo, GEO y HAMMER por
 239:calibration_tables.h ****  * igual. Usa el FIR de hardware como unica fuente de suavizado (nunca
 240:calibration_tables.h ****  * promediado de software). La biseccion vieja y el servo lento
 241:calibration_tables.h ****  * (calibration.c, CAL_ALGO_BISECTION_ENABLE) quedaron comentados a pedido
 242:calibration_tables.h ****  * del usuario, no se borraron.
 243:calibration_tables.h ****  *
 244:calibration_tables.h ****  * Ley de control por muestra (a 3kHz, sobre fir_output = salida del Filter
 245:calibration_tables.h ****  * de hardware vía DMA_Filter_RAM, ver cal_pi_run_service en calibration.c):
 246:calibration_tables.h ****  *   error_counts = target_counts - fir_output
 247:calibration_tables.h ****  *   error_dac    = error_counts reescalado a ADC 18b 0..5V vs DAC 8b 0..4.080V
 248:calibration_tables.h ****  *   effort       = adelanto + direction*(P(error_dac/gain) + I(error_dac/gain))
 249:calibration_tables.h ****  *   integral    += error_dac (solo fuera de deadband y sin saturacion)
 250:calibration_tables.h ****  *   dac    = clamp(effort), se escribe siempre
 251:calibration_tables.h ****  * dac_center hace de feedforward/adelanto: el PI solo compensa el residuo.
 252:calibration_tables.h ****  *
 253:calibration_tables.h ****  * Deadband = ceil(ganancia_absoluta * CAL_PI_DEADBAND_MARGIN_NUM /
 254:calibration_tables.h ****  * CAL_PI_DEADBAND_MARGIN_DEN) codigos DAC, con minimo
 255:calibration_tables.h ****  * CAL_PI_DEADBAND_MIN_DAC_CODES. Para HAMMER_PGA la ganancia es dinamica:
 256:calibration_tables.h ****  * abs(PGA_GAIN - 1) porque el VDAC entra por el terminal negativo. El lock
 257:calibration_tables.h ****  * cierra la etapa si durante lock_samples (= M) el error queda en la misma
 258:calibration_tables.h ****  * celda cuantizada; bucket 0 significa "dentro de deadband".
 259:calibration_tables.h ****  *
 260:calibration_tables.h ****  * Superficie de ajuste por etapa, a proposito limitada a esto (y nada mas):
 261:calibration_tables.h ****  * Kp (num/div), Ki (num/div), ganancia_x1000 y samples para lock. Sin
 262:calibration_tables.h ****  * tolerancia aparte, sin lsb_counts aparte, sin paso de refine/verify
 263:calibration_tables.h ****  * promediado al cerrar la etapa.
 264:calibration_tables.h ****  * ============================================================ */
 265:calibration_tables.h **** #define CAL_PI_LOCK_N_MAX 128u   /* capacidad del buffer; lock_samples (por etapa) puede ser <= est
 266:calibration_tables.h **** 
