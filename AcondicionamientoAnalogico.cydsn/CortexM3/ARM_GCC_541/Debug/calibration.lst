1764:calibration.c ****         g_cal_pi.lock_idx = 0u;
1765:calibration.c ****     }
1766:calibration.c ****     if (g_cal_pi.lock_count < CAL_PI_LOCK_N) {
1767:calibration.c ****         g_cal_pi.lock_count++;
1768:calibration.c ****     }
1769:calibration.c **** 
1770:calibration.c ****     if (g_cal_pi.lock_count >= CAL_PI_LOCK_N) {
1771:calibration.c ****         int32 span_lo = g_cal_pi.lock_buf[0];
1772:calibration.c ****         int32 span_hi = g_cal_pi.lock_buf[0];
1773:calibration.c ****         int32 one_lsb_counts = (cfg->lsb_counts <= 0L) ? 1L : cfg->lsb_counts;
1774:calibration.c **** 
1775:calibration.c ****         for (i = 1u; i < CAL_PI_LOCK_N; i++) {
1776:calibration.c ****             if (g_cal_pi.lock_buf[i] < span_lo) { span_lo = g_cal_pi.lock_buf[i]; }
1777:calibration.c ****             if (g_cal_pi.lock_buf[i] > span_hi) { span_hi = g_cal_pi.lock_buf[i]; }
1778:calibration.c ****         }
1779:calibration.c **** 
1780:calibration.c ****         if ((span_hi - span_lo) <= (one_lsb_counts + one_lsb_counts / 10L) &&
1781:calibration.c ****             abs_counts(error) <= stage->tolerance_counts) {
1782:calibration.c ****             return cal_pi_finish_stage(1u);
1783:calibration.c ****         }
