 5494              		.file 1 "calibration.c"
   1:calibration.c **** #include "calibration.h"
   2:calibration.c **** #include "calibration_tables.h"
   3:calibration.c **** #include "psoc_adc.h"
   4:calibration.c **** 
   5:calibration.c **** /* El lote HW (PSOC_ADC_LOTE_SAMPLES, psoc_adc.h) debe equivaler exactamente
   6:calibration.c ****  * a una ventana de calibración GEO (CAL_AVG_N_GEO_*) — async_measure_service
   7:calibration.c ****  * trata cada lote como una ventana ya sumada. Si alguna vez divergen, mejor
   8:calibration.c ****  * fallar el build que misconvergir en silencio. */
   9:calibration.c **** #if (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_PGA) || \
  10:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_BP) || \
  11:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_ADDER) || \
  12:calibration.c ****     (PSOC_ADC_LOTE_SAMPLES != CAL_AVG_N_GEO_LP)
  13:calibration.c **** #error "PSOC_ADC_LOTE_SAMPLES (psoc_adc.h) debe ser igual a CAL_AVG_N_GEO_* (calibration_tables_geo
  14:calibration.c **** #endif
  15:calibration.c **** 
  16:calibration.c **** #ifndef CAL_AMUX_ADC_START
  17:calibration.c **** #define CAL_AMUX_ADC_START() AMux_ADC_Start()
  18:calibration.c **** #endif
  19:calibration.c **** 
  20:calibration.c **** #ifndef CAL_AMUX_ADC_SELECT
  21:calibration.c **** #define CAL_AMUX_ADC_SELECT(channel) AMux_ADC_Select(channel)
  22:calibration.c **** #endif
  23:calibration.c **** 
  24:calibration.c **** static PsocCalDiagHook g_cal_diag_hook = (PsocCalDiagHook)0;
  25:calibration.c **** 
  26:calibration.c **** void psoc_calibration_set_diag_hook(PsocCalDiagHook hook)
  27:calibration.c **** {
  28:calibration.c ****     g_cal_diag_hook = hook;
  29:calibration.c **** }
  30:calibration.c **** 
  31:calibration.c **** static void cal_diag(uint8 event, uint8 value)
  32:calibration.c **** {
  33:calibration.c ****     if (g_cal_diag_hook != (PsocCalDiagHook)0) {
  34:calibration.c ****         g_cal_diag_hook(event, value);
  35:calibration.c ****     }
  36:calibration.c **** }
  37:calibration.c **** 
  38:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
  39:calibration.c **** {
  40:calibration.c ****     uint16 u;
  41:calibration.c ****     if (value > 32767L) { value = 32767L; }
  42:calibration.c ****     if (value < -32768L) { value = -32768L; }
  43:calibration.c ****     u = (uint16)(int16)value;
  44:calibration.c ****     cal_diag(event, (uint8)(u >> 8));
  45:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
  46:calibration.c **** }
  47:calibration.c **** 
  48:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
  49:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
  50:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
  51:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
  52:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
  53:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
  54:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
  55:calibration.c **** {
  56:calibration.c ****     uint32 u = (uint32)value;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccGrLkYO.s 			page 437


  57:calibration.c ****     cal_diag(event, (uint8)((u >> 24) & 0xFFu));
  58:calibration.c ****     cal_diag(event, (uint8)((u >> 16) & 0xFFu));
  59:calibration.c ****     cal_diag(event, (uint8)((u >> 8) & 0xFFu));
  60:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
  61:calibration.c **** }
  62:calibration.c **** 
  63:calibration.c **** static void cal_diag_point(uint8 dac, int32 measured)
  64:calibration.c **** {
  65:calibration.c ****     cal_diag(PSOC_EVT_CAL_STAGE_DAC, dac);
  66:calibration.c ****     cal_diag_i16(PSOC_EVT_CAL_STAGE_MEAS, measured);
  67:calibration.c ****     cal_diag_i32(PSOC_EVT_CAL_STAGE_MEAS32, measured);
  68:calibration.c **** }
  69:calibration.c **** 
  70:calibration.c **** static void cal_diag_realcheck_point(uint8 dac, int32 measured)
  71:calibration.c **** {
  72:calibration.c ****     cal_diag(PSOC_EVT_CAL_REALCHECK_DAC, dac);
