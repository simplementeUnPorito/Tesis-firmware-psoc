 381:calibration.c ****             g_cal_async.candidate_abs_error[worst_i] = abs_error;
 382:calibration.c ****             g_cal_async.candidate_saturated[worst_i] = saturated;
 383:calibration.c ****         }
 384:calibration.c ****     }
 385:calibration.c **** }
