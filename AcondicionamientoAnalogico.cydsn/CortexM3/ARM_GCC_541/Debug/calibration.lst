  52:calibration.c **** #define CAL_AMUX_SIGNAL_CHANNEL_COUNT 4u
  53:calibration.c **** #else
  54:calibration.c **** #define CAL_AMUX_SIGNAL_CHANNEL_COUNT 2u
  55:calibration.c **** #endif
  56:calibration.c **** 
  57:calibration.c **** #ifndef CAL_AMUX_HAS_CAP_CHANNEL
  58:calibration.c **** #if (AMux_ADC_CHANNELS > CAL_AMUX_SIGNAL_CHANNEL_COUNT)
