 556:calibration.c ****                      CAL_SERVO_WORSE_HYST_COUNTS) &&
 557:calibration.c ****         g_cal_servo.last_dir[stage_index] != 0) {
 558:calibration.c ****         uint8 restore_dac = g_cal_servo.last_dac[stage_index];
 559:calibration.c ****         cal_stage_write_result(stage_index, restore_dac);
 560:calibration.c ****         result->final_measured = g_cal_servo.last_measured[stage_index];
