 353:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 354:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 355:calibration.c **** 
 356:calibration.c ****     if (stage->direction >= 0) {
 357:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 358:calibration.c ****             return (uint8)(center + stage->probe_step);
 359:calibration.c ****         }
 360:calibration.c ****         if (center > lo) {
 361:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 362:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 363:calibration.c ****         }
 364:calibration.c ****     } else {
 365:calibration.c ****         if (center > lo) {
