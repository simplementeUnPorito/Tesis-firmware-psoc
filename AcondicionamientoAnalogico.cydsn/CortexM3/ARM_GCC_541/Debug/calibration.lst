  74:calibration.c **** static int32 abs_counts(int32 value)
  75:calibration.c **** {
  76:calibration.c ****     return (value < 0) ? -value : value;
  77:calibration.c **** }
  78:calibration.c **** 
  79:calibration.c **** /* Reduce las cuentas crudas del ADC a una escala comparable con los codigos
  80:calibration.c ****  * del VDAC8. El ADC ve un span simplificado de 0..5V (signed +-2.5V alrededor
  81:calibration.c ****  * de VDDA/2), mientras el VDAC usa 0..4.080V; por eso al shift de 18->8 bits
  82:calibration.c ****  * se le aplica la correccion de spans 5000/4080. */
  83:calibration.c **** #define CAL_DAC_SCALE_SHIFT 10
  84:calibration.c **** #define CAL_ADC_SPAN_MV    5000L
  85:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
  86:calibration.c **** 
  87:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
  88:calibration.c **** {
  89:calibration.c ****     if (value >= 0L) {
  90:calibration.c ****         return (value + (divisor / 2L)) / divisor;
  91:calibration.c ****     }
  92:calibration.c ****     return -(((-value) + (divisor / 2L)) / divisor);
  93:calibration.c **** }
  94:calibration.c **** 
  95:calibration.c **** static int32 cal_scale_counts(int32 value)
  96:calibration.c **** {
  97:calibration.c ****     int32 shifted = value >> CAL_DAC_SCALE_SHIFT;
  98:calibration.c ****     return cal_div_round_signed(shifted * CAL_ADC_SPAN_MV, CAL_VDAC_SPAN_MV);
  99:calibration.c **** }
 100:calibration.c **** 
 101:calibration.c **** /* Ver CAL_OPERATING_RANGE_COUNTS (calibration_tables.h): +-0.5V absolutos.
 102:calibration.c ****  * Una medicion mas alla de esto deja al operacional fuera de rango
 103:calibration.c ****  * operativo, sin importar si "ok" hubiera dado 1. */
 104:calibration.c **** static uint8 cal_measured_out_of_range(int32 measured)
 105:calibration.c **** {
 106:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) > cal_scale_counts(CAL_OPERATING_RANGE_COUNTS)) 
 107:calibration.c **** }
 108:calibration.c **** 
 109:calibration.c **** static uint8 cal_stage_saturated(const PsocCalStage *stage, int32 measured)
 110:calibration.c **** {
 111:calibration.c ****     if (stage->sat_counts <= 0L) {
 112:calibration.c ****         return 0u;
 113:calibration.c ****     }
ARM GAS  C:\Users\elias\AppData\Local\Temp\cct51h4B.s 			page 443


 114:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) >= cal_scale_counts(stage->sat_counts)) ? 1u : 0
 115:calibration.c **** }
 116:calibration.c **** 
 117:calibration.c **** static uint8 cal_stage_min_dac(const PsocCalStage *stage)
 118:calibration.c **** {
 119:calibration.c ****     return (stage->dac_center > stage->dac_max_change)
 120:calibration.c ****         ? (uint8)(stage->dac_center - stage->dac_max_change)
 121:calibration.c ****         : 0u;
 122:calibration.c **** }
 123:calibration.c **** 
 124:calibration.c **** static uint8 cal_stage_max_dac(const PsocCalStage *stage)
 125:calibration.c **** {
 126:calibration.c ****     uint16 max_dac = (uint16)stage->dac_center + (uint16)stage->dac_max_change;
 127:calibration.c ****     return (max_dac > 255u) ? 255u : (uint8)max_dac;
 128:calibration.c **** }
 129:calibration.c **** 
 130:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 131:calibration.c **** {
 132:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 133:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 134:calibration.c ****     if (dac < lo) { return lo; }
 135:calibration.c ****     if (dac > hi) { return hi; }
 136:calibration.c ****     return dac;
 137:calibration.c **** }
 138:calibration.c **** 
 139:calibration.c **** static uint8 cal_stage_center_dac(const PsocCalStage *stage)
 140:calibration.c **** {
 141:calibration.c ****     return cal_stage_clamp_dac(stage, stage->dac_center);
 142:calibration.c **** }
 143:calibration.c **** 
 144:calibration.c **** static uint8 cal_stage_probe_dac(const PsocCalStage *stage)
 145:calibration.c **** {
 146:calibration.c ****     uint8 center = cal_stage_center_dac(stage);
 147:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 148:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 149:calibration.c **** 
 150:calibration.c ****     if (stage->direction >= 0) {
 151:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 152:calibration.c ****             return (uint8)(center + stage->probe_step);
 153:calibration.c ****         }
 154:calibration.c ****         if (center > lo) {
 155:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 156:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 157:calibration.c ****         }
 158:calibration.c ****     } else {
 159:calibration.c ****         if (center > lo) {
 160:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 161:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 162:calibration.c ****         }
 163:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 164:calibration.c ****             return (uint8)(center + stage->probe_step);
 165:calibration.c ****         }
 166:calibration.c ****     }
 167:calibration.c **** 
 168:calibration.c ****     return (center < hi) ? hi : lo;
 169:calibration.c **** }
