 520:calibration.c **** static uint8 cal_servo_apply_measurement(uint8 stage_index, uint8 dac, int32 measured)
 521:calibration.c **** {
 522:calibration.c ****     const PsocCalStage *stage = &g_psoc_cal_stages[stage_index];
 523:calibration.c ****     const PsocCalServoTune *tune = &g_cal_servo_tune[stage_index];
 524:calibration.c ****     PsocCalResult *result = &g_psoc_cal_results[stage_index];
