1437:calibration.c ****     uint8 preserve_results =
1438:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1439:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1440:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1441:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1442:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1443:calibration.c **** 
1444:calibration.c ****     if (!preserve_results) {
1445:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1446:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1447:calibration.c ****             g_psoc_cal_stages[i].write(center);
1448:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1449:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1450:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1451:calibration.c ****         }
1452:calibration.c ****     }
1453:calibration.c ****     g_cal_async.ok = 0u;
1454:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1455:calibration.c **** 
1456:calibration.c ****     cal_async_complete();
1457:calibration.c **** }
