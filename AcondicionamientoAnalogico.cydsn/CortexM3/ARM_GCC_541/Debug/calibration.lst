1785:calibration.c **** 
1786:calibration.c ****     if (g_cal_pi.samples_taken >= cfg->max_samples) {
1787:calibration.c ****         return cal_pi_finish_stage((abs_counts(error) <= stage->tolerance_counts) ? 1u : 0u);
