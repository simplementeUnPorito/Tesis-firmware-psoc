  44:calibration.c **** 
  45:calibration.c **** /* Igual que cal_diag_i16 pero sin clamping: manda los 32 bits crudos de
  46:calibration.c ****  * "measured" (cum_avg interno) en 4 bytes MSB-first con el mismo evento.
  47:calibration.c ****  * cal_diag_i16 satura a +-32767 para la telemetria historica; ese clamping
  48:calibration.c ****  * hace que cualquier |measured|>32767 se vea identico (siempre 32767 o
  49:calibration.c ****  * -32768) y oculta si el mejor punto quedo "apenas" o "muy" fuera de
  50:calibration.c ****  * CAL_OPERATING_RANGE_COUNTS (ver HANDOFF_CALIBRATION.md). */
  51:calibration.c **** static void cal_diag_i32(uint8 event, int32 value)
  52:calibration.c **** {
  53:calibration.c ****     uint32 u = (uint32)value;
  54:calibration.c ****     cal_diag(event, (uint8)((u >> 24) & 0xFFu));
  55:calibration.c ****     cal_diag(event, (uint8)((u >> 16) & 0xFFu));
  56:calibration.c ****     cal_diag(event, (uint8)((u >> 8) & 0xFFu));
  57:calibration.c ****     cal_diag(event, (uint8)(u & 0xFFu));
  58:calibration.c **** }
