 980:calibration.c **** static int32 cal_pi_stage_gain_x1000(uint8 stage_index)
 981:calibration.c **** {
 982:calibration.c ****     if (stage_index == 0u) {
 983:calibration.c ****         int32 pga_gain = (int32)psoc_hw_pga_gain_x1000();
 984:calibration.c ****         return 1000L - pga_gain;
 985:calibration.c ****     }
