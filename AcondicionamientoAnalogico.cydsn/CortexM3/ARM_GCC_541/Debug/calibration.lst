   1:calibration_tables.h **** #ifndef CALIBRATION_TABLES_H
   2:calibration_tables.h **** #define CALIBRATION_TABLES_H
   3:calibration_tables.h **** 
   4:calibration_tables.h **** #include "calibration.h"
   5:calibration_tables.h **** 
   6:calibration_tables.h **** /* Agregador de calibracion activo.
   7:calibration_tables.h ****  *
   8:calibration_tables.h ****  * La calibracion vigente es PI-only: el PI lee el DC desde el Filter de
   9:calibration_tables.h ****  * hardware cargado con FIR_calibration.h, y al cerrar cada etapa puede probar
  10:calibration_tables.h ****  * un unico LSB de VDAC para quedarse con el lado que mejore el error. Los
  11:calibration_tables.h ****  * parametros ajustables viven por etapa en:
  12:calibration_tables.h ****  *   - calibration_tables_geo_pga.h
  13:calibration_tables.h ****  *   - calibration_tables_geo_bp.h
  14:calibration_tables.h ****  *   - calibration_tables_geo_adder.h
ARM GAS  C:\Users\elias\AppData\Local\Temp\cczSJ83a.s 			page 340


  15:calibration_tables.h ****  *   - calibration_tables_geo_lp.h
  16:calibration_tables.h ****  *   - calibration_tables_hammer_pga.h
  17:calibration_tables.h ****  *   - calibration_tables_hammer_lp.h
  18:calibration_tables.h ****  *
  19:calibration_tables.h ****  * La busqueda binaria historica se saco de los headers activos; queda guardada
  20:calibration_tables.h ****  * en calibration_tables_legacy_bisection.h, sin incluirse desde aca. */
  21:calibration_tables.h **** 
  22:calibration_tables.h **** #ifndef CAL_TARGET_1V_COUNTS
  23:calibration_tables.h **** #define CAL_TARGET_1V_COUNTS 52429L
  24:calibration_tables.h **** #endif
  25:calibration_tables.h **** 
  26:calibration_tables.h **** #ifndef CAL_TARGET_1V5_COUNTS
