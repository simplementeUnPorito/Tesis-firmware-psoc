  28:calibration_tables.h **** #endif
  29:calibration_tables.h **** 
  30:calibration_tables.h **** /* Escalas fisicas usadas por el PI activo. El ADC se compara en el mismo
  31:calibration_tables.h ****  * dominio que el VDAC: ADC 0..5V, 18 bits; VDAC8 0..4.080V, 8 bits. */
