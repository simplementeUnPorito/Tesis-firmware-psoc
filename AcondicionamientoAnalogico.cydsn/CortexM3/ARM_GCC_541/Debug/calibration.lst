 966:calibration.c **** }
 967:calibration.c **** 
 968:calibration.c **** static int32 cal_pi_deadband_dac_codes(uint8 stage_index)
 969:calibration.c **** {
 970:calibration.c ****     int32 gain_x1000 = cal_pi_stage_gain_x1000(stage_index);
 971:calibration.c ****     int64 num;
 972:calibration.c ****     int64 den;
 973:calibration.c ****     int32 deadband;
 974:calibration.c **** 
 975:calibration.c ****     if (gain_x1000 < 0L) {
 976:calibration.c ****         gain_x1000 = -gain_x1000;
 977:calibration.c ****     }
 978:calibration.c ****     num = (int64)gain_x1000 * (int64)CAL_PI_DEADBAND_MARGIN_NUM;
 979:calibration.c ****     den = 1000LL * (int64)CAL_PI_DEADBAND_MARGIN_DEN;
 980:calibration.c ****     deadband = (int32)((num + den - 1LL) / den);
 981:calibration.c ****     if (deadband < CAL_PI_DEADBAND_MIN_DAC_CODES) {
 982:calibration.c ****         deadband = CAL_PI_DEADBAND_MIN_DAC_CODES;
 983:calibration.c ****     }
 984:calibration.c ****     return deadband;
 985:calibration.c **** }
