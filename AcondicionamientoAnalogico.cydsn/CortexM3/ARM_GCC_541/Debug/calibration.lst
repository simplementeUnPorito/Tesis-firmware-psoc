 180:calibration.c **** static int32 cal_adc_read_direct_counts(void)
 181:calibration.c **** {
 182:calibration.c ****     int32 sample;
 183:calibration.c ****     uint16 guard;
 184:calibration.c ****     uint8 ready = 0u;
 185:calibration.c **** 
 186:calibration.c ****     ADC_StopConvert();
 187:calibration.c ****     ADC_StartConvert();
 188:calibration.c ****     for (guard = 0u; guard < (uint16)CAL_ADC_DIRECT_WAIT_POLLS; guard++) {
 189:calibration.c ****         if (ADC_IsEndConversion(ADC_RETURN_STATUS)) {
 190:calibration.c ****             ready = 1u;
 191:calibration.c ****             break;
 192:calibration.c ****         }
 193:calibration.c ****     }
 194:calibration.c ****     if (!ready) {
 195:calibration.c ****         ADC_StopConvert();
 196:calibration.c ****         return 0L;
 197:calibration.c ****     }
 198:calibration.c ****     sample = ADC_GetResult32();
 199:calibration.c ****     ADC_StopConvert();
 200:calibration.c **** 
 201:calibration.c ****     return psoc_adc_counts_right_aligned(sample);
 202:calibration.c **** }
