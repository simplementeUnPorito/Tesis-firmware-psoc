 111:calibration.c **** /* Selección de canal para operación normal/idle (canal de captura): sin
 112:calibration.c ****  * capacitor, exclusiva contra cualquier otro canal de señal. */
 113:calibration.c **** #ifndef CAL_AMUX_ADC_SELECT
 114:calibration.c **** #define CAL_AMUX_ADC_SELECT(channel) psoc_amux_select_exclusive((channel), 0u)
 115:calibration.c **** #endif
 116:calibration.c **** 
 117:calibration.c **** /* Selección de canal para MEDIR una etapa durante calibración: agrega el
 118:calibration.c ****  * capacitor de filtrado (AMux_ADC_CHANNELS-1) en paralelo al canal de la
 119:calibration.c ****  * etapa, pedido por el usuario para atenuar ruido chico durante la medición. */
 120:calibration.c **** #ifndef CAL_AMUX_ADC_SELECT_STAGE
 121:calibration.c **** #define CAL_AMUX_ADC_SELECT_STAGE(channel) psoc_amux_select_exclusive((channel), 1u)
 122:calibration.c **** #endif
