   9:calibration_tables.h **** 
  10:calibration_tables.h **** /* AMux_IN canal 1 = referencia/tierra virtual de 2.5 V. Durante calibracion
  11:calibration_tables.h ****  * la entrada se fuerza ahi para que cada etapa quede centrada tambien en 2.5 V. */
  12:calibration_tables.h **** #ifndef CAL_INPUT_REF_CHANNEL
  13:calibration_tables.h **** #define CAL_INPUT_REF_CHANNEL 1u
  14:calibration_tables.h **** #endif
  15:calibration_tables.h **** 
  16:calibration_tables.h **** #ifndef CAL_INPUT_GROUND_CHANNEL
  17:calibration_tables.h **** #define CAL_INPUT_GROUND_CHANNEL CAL_INPUT_REF_CHANNEL
  18:calibration_tables.h **** #endif
  19:calibration_tables.h **** 
  20:calibration_tables.h **** #ifndef CAL_AMUX_SETTLE_MS
  21:calibration_tables.h **** #define CAL_AMUX_SETTLE_MS 5u
  22:calibration_tables.h **** #endif
  23:calibration_tables.h **** 
  24:calibration_tables.h **** #ifndef CAL_DAC_SETTLE_MS
  25:calibration_tables.h **** #define CAL_DAC_SETTLE_MS 5u
  26:calibration_tables.h **** #endif
  27:calibration_tables.h **** 
  28:calibration_tables.h **** #ifndef CAL_TARGET_1V_COUNTS
  29:calibration_tables.h **** #define CAL_TARGET_1V_COUNTS 52429L
  30:calibration_tables.h **** #endif
  31:calibration_tables.h **** 
  32:calibration_tables.h **** #ifndef CAL_TARGET_1V5_COUNTS
  33:calibration_tables.h **** #define CAL_TARGET_1V5_COUNTS 78644L
  34:calibration_tables.h **** #endif
  35:calibration_tables.h **** 
  36:calibration_tables.h **** #ifndef CAL_TARGET_HAMMER_IN_COUNTS
  37:calibration_tables.h **** #define CAL_TARGET_HAMMER_IN_COUNTS CAL_TARGET_1V_COUNTS
  38:calibration_tables.h **** #endif
  39:calibration_tables.h **** 
  40:calibration_tables.h **** #ifndef CAL_TARGET_HAMMER_PGA_COUNTS
  41:calibration_tables.h **** #define CAL_TARGET_HAMMER_PGA_COUNTS CAL_TARGET_1V5_COUNTS
  42:calibration_tables.h **** #endif
  43:calibration_tables.h **** 
  44:calibration_tables.h **** #ifndef CAL_TARGET_HAMMER_LP_COUNTS
  45:calibration_tables.h **** #define CAL_TARGET_HAMMER_LP_COUNTS CAL_TARGET_1V5_COUNTS
  46:calibration_tables.h **** #endif
  47:calibration_tables.h **** 
  48:calibration_tables.h **** /* ADC_CFG1 es diferencial signed de 18 bits (0 = 0V diferencial). En modo
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc4mwVLj.s 			page 161


  49:calibration_tables.h ****  * GEO cada etapa debe quedar con su salida DC igualada a AMux_IN=1
  50:calibration_tables.h ****  * (referencia/tierra virtual de 2.5 V), es decir lectura diferencial = 0 counts. */
  51:calibration_tables.h **** #ifndef CAL_TARGET_GEO_PGA_COUNTS
  52:calibration_tables.h **** #define CAL_TARGET_GEO_PGA_COUNTS 0L
  53:calibration_tables.h **** #endif
  54:calibration_tables.h **** 
  55:calibration_tables.h **** #ifndef CAL_TARGET_GEO_BP_COUNTS
  56:calibration_tables.h **** #define CAL_TARGET_GEO_BP_COUNTS 0L
  57:calibration_tables.h **** #endif
  58:calibration_tables.h **** 
  59:calibration_tables.h **** #ifndef CAL_TARGET_GEO_ADDER_COUNTS
  60:calibration_tables.h **** #define CAL_TARGET_GEO_ADDER_COUNTS 0L
  61:calibration_tables.h **** #endif
  62:calibration_tables.h **** 
  63:calibration_tables.h **** #ifndef CAL_TARGET_GEO_LP_COUNTS
  64:calibration_tables.h **** #define CAL_TARGET_GEO_LP_COUNTS 0L
  65:calibration_tables.h **** #endif
  66:calibration_tables.h **** 
  67:calibration_tables.h **** #define CAL_AVG_N      32u
  68:calibration_tables.h **** #define CAL_MAX_ITER   12u
  69:calibration_tables.h **** #define CAL_TOL_COUNTS 250L
  70:calibration_tables.h **** 
  71:calibration_tables.h **** #define CAL_TOL_COUNTS_GEO_PGA   250L
  72:calibration_tables.h **** #define CAL_TOL_COUNTS_GEO_BP    250L
  73:calibration_tables.h **** #define CAL_TOL_COUNTS_GEO_ADDER 250L
  74:calibration_tables.h **** #define CAL_TOL_COUNTS_GEO_LP    250L
  75:calibration_tables.h **** 
  76:calibration_tables.h **** /* Rango operativo absoluto: ADC_CFG1_COUNTS_PER_VOLT=52429 (ver HANDOFF
  77:calibration_tables.h ****  * §4/§13), entonces 0.5V =~ 26214 counts. Una etapa cuya mejor medicion
  78:calibration_tables.h ****  * (best_measured) quede mas lejos de 0 que esto NO se deja calibrada con ese
  79:calibration_tables.h ****  * DAC aunque "ok" hubiera sido 1: se prefiere volver a CAL_DAC_INIT
  80:calibration_tables.h ****  * (~2.5V, sin calibrar pero en rango) a dejar el operacional fuera de rango
  81:calibration_tables.h ****  * (riesgo de saturacion en cascada). Prioridad maxima: la ultima etapa
  82:calibration_tables.h ****  * (GEO_LP, la que alimenta al canal de captura del ADC) SIEMPRE debe quedar
  83:calibration_tables.h ****  * dentro de este rango, o la captura es inutil (ver PSOC_EVT_CAL_LP_BAD). */
  84:calibration_tables.h **** #define CAL_OPERATING_RANGE_COUNTS 26214L
  85:calibration_tables.h **** 
  86:calibration_tables.h **** /* Espera en muestras ADC descartadas despues de tocar cada VDAC. CFG1 corre a
  87:calibration_tables.h ****  * ~3 kSPS, asi que 300 muestras son aproximadamente 100 ms. Los nodos mas
  88:calibration_tables.h ****  * abajo en la cascada esperan mas porque ven el asentamiento acumulado. */
  89:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_GEO_PGA   3000u
  90:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_GEO_BP   15000u
  91:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_GEO_ADDER 8000u
  92:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_GEO_LP    6000u
  93:calibration_tables.h **** 
  94:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_GEO_PGA    5000u
  95:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_GEO_BP    24000u
  96:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_GEO_ADDER 12000u
  97:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_GEO_LP     9000u
  98:calibration_tables.h **** 
  99:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_HAMMER_IN   180u
 100:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_HAMMER_PGA  600u
 101:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_HAMMER_LP   900u
 102:calibration_tables.h **** 
 103:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_HAMMER_IN   300u
 104:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_HAMMER_PGA  900u
 105:calibration_tables.h **** #define CAL_VERIFY_SAMPLES_HAMMER_LP  1200u
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc4mwVLj.s 			page 162


 106:calibration_tables.h **** 
 107:calibration_tables.h **** /* Punto de partida obligatorio de la busqueda binaria: 0x9C = 156 ->
 108:calibration_tables.h ****  * 156 * 16mV (VDAC8 1x) = 2.496V =~ 2.5V (centro de rango / "tierra
 109:calibration_tables.h ****  * virtual" del front-end analogico). */
 110:calibration_tables.h **** #define CAL_DAC_INIT   0x9Cu
 111:calibration_tables.h **** 
 112:calibration_tables.h **** /* Primer paso (antes de la busqueda binaria) para detectar empiricamente si
 113:calibration_tables.h ****  * la medida crece o decrece con el codigo DAC. */
 114:calibration_tables.h **** #define CAL_PROBE_STEP 32u
 115:calibration_tables.h **** 
 116:calibration_tables.h **** /* La maquina de estados no bloqueante descarta settle_samples y luego sigue
 117:calibration_tables.h ****  * promediando ACUMULATIVAMENTE (ver async_measure_service en calibration.c)
 118:calibration_tables.h ****  * hasta que el promedio acumulado deje de moverse mas de
 119:calibration_tables.h ****  * CAL_SETTLE_TOL_COUNTS de una ventana a la siguiente, o hasta
 120:calibration_tables.h ****  * CAL_SETTLE_MAX_WINDOWS como limite de seguridad. CAL_SETTLE_TOL_COUNTS=10
 121:calibration_tables.h ****  * (~+-10 counts, pedido del usuario 2026-06-14) es estricto porque se compara
 122:calibration_tables.h ****  * contra el promedio ACUMULADO (cada vez mas estable), no contra una ventana
 123:calibration_tables.h ****  * sola. CAL_SETTLE_MAX_WINDOWS=40 (vs 10 antes) => hasta 40*32=1280 muestras
 124:calibration_tables.h ****  * por punto (~426 ms a ~3 kSPS); con ~60 puntos medidos en una corrida
 125:calibration_tables.h ****  * completa eso agrega ~19 s en el peor caso, muy por debajo de
 126:calibration_tables.h ****  * CAL_WATCHDOG_TICKS=200 s. */
 127:calibration_tables.h **** #define CAL_SETTLE_MAX_WINDOWS 40u
 128:calibration_tables.h **** #define CAL_SETTLE_TOL_COUNTS  10L
 129:calibration_tables.h **** 
 130:calibration_tables.h **** #if PSOC_HW_CLASS == PSOC_HW_GEO
