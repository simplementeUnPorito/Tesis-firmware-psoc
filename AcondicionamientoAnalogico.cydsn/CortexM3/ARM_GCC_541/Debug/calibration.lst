1720:calibration.c ****     } else if (effort > (int32)dac_hi) {
1721:calibration.c ****         dac_desired = dac_hi;
1722:calibration.c ****     } else {
1723:calibration.c ****         dac_desired = (uint8)effort;
1724:calibration.c ****         can_integrate = 1u;
1725:calibration.c ****     }
