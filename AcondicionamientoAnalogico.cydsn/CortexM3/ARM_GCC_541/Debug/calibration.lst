 368:calibration.c ****         }
 369:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 370:calibration.c ****             return (uint8)(center + stage->probe_step);
 371:calibration.c ****         }
 372:calibration.c ****     }
 373:calibration.c **** 
 374:calibration.c ****     return (center < hi) ? hi : lo;
 375:calibration.c **** }
