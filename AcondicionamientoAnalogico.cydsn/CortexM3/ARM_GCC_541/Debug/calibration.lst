 345:calibration.c ****                 g_cal_async.candidate_abs_error[i] = abs_error;
 346:calibration.c ****                 g_cal_async.candidate_saturated[i] = saturated;
 347:calibration.c ****             }
 348:calibration.c ****             return;
 349:calibration.c ****         }
 350:calibration.c ****     }
 351:calibration.c **** 
 352:calibration.c ****     if (g_cal_async.candidate_count < CAL_BEST_CANDIDATE_COUNT) {
 353:calibration.c ****         i = g_cal_async.candidate_count;
 354:calibration.c ****         g_cal_async.candidate_count++;
 355:calibration.c ****         g_cal_async.candidate_dac[i] = dac;
 356:calibration.c ****         g_cal_async.candidate_measured[i] = measured;
 357:calibration.c ****         g_cal_async.candidate_abs_error[i] = abs_error;
 358:calibration.c ****         g_cal_async.candidate_saturated[i] = saturated;
 359:calibration.c ****         return;
 360:calibration.c ****     }
 361:calibration.c **** 
 362:calibration.c ****     for (i = 0u; i < CAL_BEST_CANDIDATE_COUNT; i++) {
 363:calibration.c ****         int32 score = g_cal_async.candidate_abs_error[i];
 364:calibration.c ****         if (g_cal_async.candidate_saturated[i]) {
 365:calibration.c ****             score += 0x10000000L;
 366:calibration.c ****         }
 367:calibration.c ****         if (score > worst_score) {
 368:calibration.c ****             worst_score = score;
 369:calibration.c ****             worst_i = i;
 370:calibration.c ****         }
 371:calibration.c ****     }
 372:calibration.c **** 
 373:calibration.c ****     {
 374:calibration.c ****         int32 new_score = abs_error;
