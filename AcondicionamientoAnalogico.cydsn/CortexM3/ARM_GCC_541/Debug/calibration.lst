 383:calibration.c **** static uint16 cal_servo_settle_samples(uint8 stage_index)
 384:calibration.c **** {
 385:calibration.c **** #if PSOC_HW_CLASS == PSOC_HW_GEO
 386:calibration.c ****     switch (stage_index) {
 387:calibration.c ****         case 0u: return CAL_SERVO_SETTLE_SAMPLES_GEO_PGA;
 388:calibration.c ****         case 1u: return CAL_SERVO_SETTLE_SAMPLES_GEO_BP;
 389:calibration.c ****         case 2u: return CAL_SERVO_SETTLE_SAMPLES_GEO_ADDER;
 390:calibration.c ****         default: return CAL_SERVO_SETTLE_SAMPLES_GEO_LP;
 391:calibration.c ****     }
 392:calibration.c **** #else
 393:calibration.c ****     switch (stage_index) {
 394:calibration.c ****         case 0u: return CAL_SERVO_SETTLE_SAMPLES_HAMMER_IN;
 395:calibration.c ****         case 1u: return CAL_SERVO_SETTLE_SAMPLES_HAMMER_PGA;
 396:calibration.c ****         default: return CAL_SERVO_SETTLE_SAMPLES_HAMMER_LP;
 397:calibration.c ****     }
 398:calibration.c **** #endif
 399:calibration.c **** }
