 848:calibration.c **** /* Aborta la calibracion por timeout global. Las etapas ya finalizadas se
 849:calibration.c ****  * conservan; la etapa en curso y las pendientes vuelven al adelanto nominal. */
 850:calibration.c **** static void cal_async_abort_watchdog(void)
 851:calibration.c **** {
 852:calibration.c ****     uint8 i;
 853:calibration.c **** 
 854:calibration.c ****     for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
 855:calibration.c ****         uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
 856:calibration.c ****         g_psoc_cal_stages[i].write(center);
 857:calibration.c ****         g_psoc_cal_results[i].final_dac = center;
 858:calibration.c ****         g_psoc_cal_results[i].final_measured = 0L;
 859:calibration.c ****         g_psoc_cal_results[i].ok = 0u;
 860:calibration.c ****     }
 861:calibration.c ****     g_cal_async.ok = 0u;
 862:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
 863:calibration.c **** 
 864:calibration.c ****     cal_async_complete();
 865:calibration.c **** }
