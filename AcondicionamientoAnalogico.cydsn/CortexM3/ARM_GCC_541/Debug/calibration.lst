 241:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 242:calibration.c **** {
 243:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 244:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 245:calibration.c ****     if (dac < lo) { return lo; }
 246:calibration.c ****     if (dac > hi) { return hi; }
 247:calibration.c ****     return dac;
 248:calibration.c **** }
