 937:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
 938:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
 939:calibration.c **** {
 940:calibration.c ****     int64 half;
 941:calibration.c **** 
 942:calibration.c ****     if (den == 0LL) {
 943:calibration.c ****         den = 1LL;
 944:calibration.c ****     }
 945:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
 946:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
 947:calibration.c ****         return (num - half) / den;
 948:calibration.c ****     }
 949:calibration.c ****     return (num + half) / den;
