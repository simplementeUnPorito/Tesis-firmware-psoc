 993:calibration.c ****     num = (int64)gain_x1000 * (int64)CAL_PI_DEADBAND_MARGIN_NUM;
 994:calibration.c ****     den = 1000LL * (int64)CAL_PI_DEADBAND_MARGIN_DEN;
 995:calibration.c ****     deadband = (int32)((num + den - 1LL) / den);
 996:calibration.c ****     if (deadband < CAL_PI_DEADBAND_MIN_DAC_CODES) {
 997:calibration.c ****         deadband = CAL_PI_DEADBAND_MIN_DAC_CODES;
 998:calibration.c ****     }
