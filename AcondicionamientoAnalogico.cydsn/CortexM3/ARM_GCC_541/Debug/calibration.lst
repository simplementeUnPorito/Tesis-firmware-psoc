 930:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
 931:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
 932:calibration.c **** {
 933:calibration.c ****     int64 half;
 934:calibration.c **** 
 935:calibration.c ****     if (den == 0LL) {
 936:calibration.c ****         den = 1LL;
 937:calibration.c ****     }
 938:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
 939:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
 940:calibration.c ****         return (num - half) / den;
 941:calibration.c ****     }
 942:calibration.c ****     return (num + half) / den;
 943:calibration.c **** }
 944:calibration.c **** 
 945:calibration.c **** static int32 cal_pi_clip_integral(int32 value)
 946:calibration.c **** {
 947:calibration.c ****     if (value > CAL_PI_INTEGRAL_LIMIT) { return CAL_PI_INTEGRAL_LIMIT; }
 948:calibration.c ****     if (value < -CAL_PI_INTEGRAL_LIMIT) { return -CAL_PI_INTEGRAL_LIMIT; }
 949:calibration.c ****     return value;
 950:calibration.c **** }
