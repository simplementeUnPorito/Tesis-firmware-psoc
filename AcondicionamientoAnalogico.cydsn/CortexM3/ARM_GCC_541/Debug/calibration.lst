1750:calibration.c ****     }
1751:calibration.c **** 
1752:calibration.c ****     g_cal_pi.dac_current = dac_target;
1753:calibration.c ****     stage->write(g_cal_pi.dac_current);
1754:calibration.c **** 
1755:calibration.c ****     /* Detector de lock (puerto de detect_lock(err,lsb,N,reset), ver
1756:calibration.c ****      * comentario junto a CAL_PI_LOCK_N en calibration_tables.h): ventana
1757:calibration.c ****      * deslizante de fir_output: lockea cuando su span (max-min) cae dentro
1758:calibration.c ****      * de ~1.1 LSB de DAC expresado en counts ADC. Lockear cierra la etapa
1759:calibration.c ****      * de una — no hace falta des-lock porque la cascada nunca se queda
1760:calibration.c ****      * dando vueltas en ese estado. */
