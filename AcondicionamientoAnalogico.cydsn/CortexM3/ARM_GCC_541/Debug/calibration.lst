  11:calibration.c **** 
  12:calibration.c **** /* Canal AMux_ADC del capacitor de filtrado (100nF a Vss, pin AMuxCapacitor en
  13:calibration.c ****  * TopDesign). AMux_ADC esta configurado en "All Modes" (AMux_ADC_ATMOSTONE=0,
  14:calibration.c ****  * ver AMux_ADC.h), es decir que el HARDWARE no impide tener varios canales
  15:calibration.c ****  * conectados a la vez -- la exclusion mutua entre canales de SEÑAL la tiene
  16:calibration.c ****  * que garantizar el software. psoc_amux_select_exclusive() es el unico punto
  17:calibration.c ****  * de entrada que toca AMux_ADC_Connect/Disconnect para que esa garantia viva
  18:calibration.c ****  * en un solo lugar: nunca conecta un canal nuevo sin desconectar antes el
  19:calibration.c ****  * anterior, asi que dos canales de señal jamas quedan en paralelo
  20:calibration.c ****  * (cortocircuito). El capacitor se trackea aparte y se puede dejar conectado
  21:calibration.c ****  * en paralelo a cualquier canal de señal a propósito -- durante la medición
  22:calibration.c ****  * de una etapa de calibración ayuda a filtrar ruido chico; durante
  23:calibration.c ****  * captura/idle se desconecta para no cargar la señal en vivo con capacitancia
  24:calibration.c ****  * extra.
  25:calibration.c ****  * El capacitor solo se conecta si el AMux tiene un canal extra despues de
  26:calibration.c ****  * las señales reales. En HAMMER actual AMux_ADC tiene solo dos señales
  27:calibration.c ****  * (PGA/LP); tratar el ultimo canal como capacitor mezclaba la etapa LP con
  28:calibration.c ****  * la PGA durante calibracion. */
  29:calibration.c **** #if PSOC_HW_CLASS == PSOC_HW_GEO
  30:calibration.c **** #define CAL_AMUX_SIGNAL_CHANNEL_COUNT 4u
  31:calibration.c **** #else
  32:calibration.c **** #define CAL_AMUX_SIGNAL_CHANNEL_COUNT 2u
  33:calibration.c **** #endif
  34:calibration.c **** 
  35:calibration.c **** #ifndef CAL_AMUX_HAS_CAP_CHANNEL
  36:calibration.c **** #if (AMux_ADC_CHANNELS > CAL_AMUX_SIGNAL_CHANNEL_COUNT)
  37:calibration.c **** #define CAL_AMUX_HAS_CAP_CHANNEL 1u
  38:calibration.c **** #else
  39:calibration.c **** #define CAL_AMUX_HAS_CAP_CHANNEL 0u
  40:calibration.c **** #endif
  41:calibration.c **** #endif
  42:calibration.c **** 
  43:calibration.c **** #ifndef CAL_AMUX_CAP_CHANNEL
  44:calibration.c **** #define CAL_AMUX_CAP_CHANNEL ((uint8)(AMux_ADC_CHANNELS - 1u))
  45:calibration.c **** #endif
  46:calibration.c **** 
  47:calibration.c **** #ifndef CAL_AMUX_CAP_CLEANUP_MS
  48:calibration.c **** #define CAL_AMUX_CAP_CLEANUP_MS 2u
  49:calibration.c **** #endif
  50:calibration.c **** 
  51:calibration.c **** static uint8 g_amux_active_channel = AMux_ADC_NULL_CHANNEL; /* uno de 0..3, o NULL */
  52:calibration.c **** static uint8 g_amux_cap_connected  = 0u;
  53:calibration.c **** 
ARM GAS  C:\Users\elias\AppData\Local\Temp\cchaJSaa.s 			page 338


  54:calibration.c **** static void psoc_amux_select_exclusive(uint8 channel, uint8 with_cap)
  55:calibration.c **** {
  56:calibration.c ****     if (g_amux_active_channel != AMux_ADC_NULL_CHANNEL &&
  57:calibration.c ****         g_amux_active_channel != channel) {
  58:calibration.c ****         AMux_ADC_Disconnect(g_amux_active_channel);
  59:calibration.c ****         g_amux_active_channel = AMux_ADC_NULL_CHANNEL;
  60:calibration.c ****     }
  61:calibration.c ****     if (g_amux_active_channel != channel) {
  62:calibration.c ****         AMux_ADC_Connect(channel);
  63:calibration.c ****         g_amux_active_channel = channel;
  64:calibration.c ****     }
  65:calibration.c **** 
  66:calibration.c ****     if (with_cap && CAL_AMUX_HAS_CAP_CHANNEL) {
  67:calibration.c ****         if (!g_amux_cap_connected) {
  68:calibration.c ****             AMux_ADC_Connect(CAL_AMUX_CAP_CHANNEL);
  69:calibration.c ****             g_amux_cap_connected = 1u;
  70:calibration.c ****         }
  71:calibration.c ****     } else if (g_amux_cap_connected) {
  72:calibration.c ****         AMux_ADC_Disconnect(CAL_AMUX_CAP_CHANNEL);
  73:calibration.c ****         g_amux_cap_connected = 0u;
  74:calibration.c ****     }
  75:calibration.c **** }
  76:calibration.c **** 
  77:calibration.c **** static void psoc_amux_start(void)
  78:calibration.c **** {
  79:calibration.c ****     AMux_ADC_Start();   /* desconecta TODO (0..4), estado inicial conocido */
  80:calibration.c ****     g_amux_active_channel = AMux_ADC_NULL_CHANNEL;
  81:calibration.c ****     g_amux_cap_connected = 0u;
  82:calibration.c **** }
  83:calibration.c **** 
  84:calibration.c **** static void psoc_amux_disconnect_capacitor(void)
  85:calibration.c **** {
  86:calibration.c **** #if CAL_AMUX_HAS_CAP_CHANNEL
  87:calibration.c ****     AMux_ADC_Disconnect(CAL_AMUX_CAP_CHANNEL);
  88:calibration.c **** #endif
  89:calibration.c ****     g_amux_cap_connected = 0u;
  90:calibration.c **** }
  91:calibration.c **** 
  92:calibration.c **** static void psoc_amux_capacitor_cleanup(void)
  93:calibration.c **** {
  94:calibration.c **** #if CAL_AMUX_HAS_CAP_CHANNEL
  95:calibration.c ****     if (g_amux_active_channel != AMux_ADC_NULL_CHANNEL) {
  96:calibration.c ****         AMux_ADC_Disconnect(g_amux_active_channel);
  97:calibration.c ****         g_amux_active_channel = AMux_ADC_NULL_CHANNEL;
  98:calibration.c ****     }
  99:calibration.c ****     if (!g_amux_cap_connected) {
 100:calibration.c ****         AMux_ADC_Connect(CAL_AMUX_CAP_CHANNEL);
 101:calibration.c ****         g_amux_cap_connected = 1u;
 102:calibration.c ****     }
 103:calibration.c ****     CyDelay(CAL_AMUX_CAP_CLEANUP_MS);
 104:calibration.c **** #endif
 105:calibration.c **** }
