1511:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
1512:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
1513:calibration.c **** {
1514:calibration.c ****     int64 half;
1515:calibration.c **** 
1516:calibration.c ****     if (den == 0LL) {
1517:calibration.c ****         den = 1LL;
1518:calibration.c ****     }
1519:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
