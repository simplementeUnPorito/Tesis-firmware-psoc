 346:calibration.c ****                 g_cal_async.candidate_saturated[i] = saturated;
 347:calibration.c ****             }
 348:calibration.c ****             return;
 349:calibration.c ****         }
 350:calibration.c ****     }
 351:calibration.c **** 
