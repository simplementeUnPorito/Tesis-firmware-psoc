  37:calibration.c **** static uint8 g_amux_cap_connected  = 0u;
  38:calibration.c **** 
  39:calibration.c **** static void psoc_amux_select_exclusive(uint8 channel, uint8 with_cap)
  40:calibration.c **** {
  41:calibration.c ****     if (g_amux_active_channel != AMux_ADC_NULL_CHANNEL &&
  42:calibration.c ****         g_amux_active_channel != channel) {
  43:calibration.c ****         AMux_ADC_Disconnect(g_amux_active_channel);
  44:calibration.c ****         g_amux_active_channel = AMux_ADC_NULL_CHANNEL;
  45:calibration.c ****     }
  46:calibration.c ****     if (g_amux_active_channel != channel) {
  47:calibration.c ****         AMux_ADC_Connect(channel);
  48:calibration.c ****         g_amux_active_channel = channel;
  49:calibration.c ****     }
  50:calibration.c **** 
