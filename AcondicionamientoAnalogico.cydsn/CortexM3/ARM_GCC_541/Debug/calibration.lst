  87:calibration_tables.h **** #endif
  88:calibration_tables.h **** 
  89:calibration_tables.h **** #ifndef CAL_PI_DEADBAND_MIN_DAC_CODES
  90:calibration_tables.h **** #define CAL_PI_DEADBAND_MIN_DAC_CODES 1L
  91:calibration_tables.h **** #endif
  92:calibration_tables.h **** 
  93:calibration_tables.h **** #ifndef CAL_PI_MAX_DAC_STEP_PER_SAMPLE
  94:calibration_tables.h **** #define CAL_PI_MAX_DAC_STEP_PER_SAMPLE 1u
  95:calibration_tables.h **** #endif
  96:calibration_tables.h **** 
  97:calibration_tables.h **** #ifndef CAL_PI_INTEGRAL_LIMIT
  98:calibration_tables.h **** #define CAL_PI_INTEGRAL_LIMIT 8000000L
  99:calibration_tables.h **** #endif
 100:calibration_tables.h **** 
 101:calibration_tables.h **** /* Parametros POR ETAPA HAMMER (target, adelanto/rango de busqueda, PI,
 102:calibration_tables.h ****  * asentamiento) viven en headers independientes, uno por VDAC -- mismo
 103:calibration_tables.h ****  * patron que los headers GEO de mas abajo:
 104:calibration_tables.h ****  *   - calibration_tables_hammer_pga.h
 105:calibration_tables.h ****  *   - calibration_tables_hammer_lp.h
 106:calibration_tables.h ****  * Incluidos aca arriba (no junto a los de GEO) porque el bloque HAMMER de
 107:calibration_tables.h ****  * abajo en este archivo todavia los referencia para armar g_psoc_cal_stages. */
 108:calibration_tables.h **** #include "calibration_tables_hammer_pga.h"
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccpIGmbW.s 			page 292


 109:calibration_tables.h **** #include "calibration_tables_hammer_lp.h"
 110:calibration_tables.h **** 
 111:calibration_tables.h **** /* Rango operativo absoluto: ADC_CFG1_COUNTS_PER_VOLT=52429 (ver HANDOFF
 112:calibration_tables.h ****  * §4/§13), entonces 0.5V =~ 26214 counts. Se conserva como alarma de salud:
 113:calibration_tables.h ****  * si una etapa queda fuera de esto, el log lo muestra como no OK, pero no se
 114:calibration_tables.h ****  * abandona la cascada ni se vuelve al default. Distinto de
 115:calibration_tables.h ****  * CAL_SAT_COUNTS_GEO_* (por etapa, en cada header) que es el umbral de riel
 116:calibration_tables.h ****  * real. */
 117:calibration_tables.h **** #define CAL_OPERATING_RANGE_COUNTS 26214L
 118:calibration_tables.h **** 
 119:calibration_tables.h **** /* Tamaño del buffer circular de sumas-de-ventana usado por
 120:calibration_tables.h ****  * async_measure_service (calibration.c) para el promedio deslizante. Debe
 121:calibration_tables.h ****  * ser >= el window_count mas grande entre TODAS las etapas/fases (hoy:
 122:calibration_tables.h ****  * CAL_REALCHECK_AVG_WINDOW_COUNT_GEO_* = 64). Una sola instancia porque las
 123:calibration_tables.h ****  * etapas se procesan secuencialmente. */
 124:calibration_tables.h **** #define CAL_AVG_WINDOW_MAX 64u
 125:calibration_tables.h **** 
 126:calibration_tables.h **** /* Descartes por asentamiento calculados desde el sample rate real del ADC.
 127:calibration_tables.h ****  * CAL_SETTLE_FACTOR esta en calibration.h. Con factor 3x y
 128:calibration_tables.h ****  * ADC_DEFAULT_SRATE=3000:
 129:calibration_tables.h ****  *   PGA 220ms -> 1980 muestras, BP 100us -> 1, Adder 200us -> 2,
 130:calibration_tables.h ****  *   LP 6ms -> 54. */
 131:calibration_tables.h **** #ifndef ADC_DEFAULT_SRATE
 132:calibration_tables.h **** #define ADC_DEFAULT_SRATE 3000u
 133:calibration_tables.h **** #endif
 134:calibration_tables.h **** 
 135:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_US(us) \
 136:calibration_tables.h ****     ((uint16)((((uint32)(us) * (uint32)ADC_DEFAULT_SRATE * (uint32)CAL_SETTLE_FACTOR) + \
 137:calibration_tables.h ****                ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL) - 1UL) / \
 138:calibration_tables.h ****               ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL)))
