 228:calibration.c **** static uint8 cal_stage_min_dac(const PsocCalStage *stage)
 229:calibration.c **** {
 230:calibration.c ****     return (stage->dac_center > stage->dac_max_change)
 231:calibration.c ****         ? (uint8)(stage->dac_center - stage->dac_max_change)
 232:calibration.c ****         : 0u;
 233:calibration.c **** }
 234:calibration.c **** 
 235:calibration.c **** static uint8 cal_stage_max_dac(const PsocCalStage *stage)
 236:calibration.c **** {
 237:calibration.c ****     uint16 max_dac = (uint16)stage->dac_center + (uint16)stage->dac_max_change;
 238:calibration.c ****     return (max_dac > 255u) ? 255u : (uint8)max_dac;
 239:calibration.c **** }
 240:calibration.c **** 
 241:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 242:calibration.c **** {
 243:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 244:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 245:calibration.c ****     if (dac < lo) { return lo; }
 246:calibration.c ****     if (dac > hi) { return hi; }
 247:calibration.c ****     return dac;
 248:calibration.c **** }
 249:calibration.c **** 
 250:calibration.c **** static uint8 cal_stage_center_dac(const PsocCalStage *stage)
 251:calibration.c **** {
