 307:calibration.c **** #if CAL_ALGO_BISECTION_ENABLE /* biseccion legacy -- ver nota mas arriba */
 308:calibration.c **** static uint8 cal_stage_probe_dac(const PsocCalStage *stage)
 309:calibration.c **** {
 310:calibration.c ****     uint8 center = cal_stage_center_dac(stage);
 311:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 312:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 313:calibration.c **** 
 314:calibration.c ****     if (stage->direction >= 0) {
 315:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 316:calibration.c ****             return (uint8)(center + stage->probe_step);
 317:calibration.c ****         }
 318:calibration.c ****         if (center > lo) {
 319:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 320:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 321:calibration.c ****         }
 322:calibration.c ****     } else {
 323:calibration.c ****         if (center > lo) {
 324:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 325:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 326:calibration.c ****         }
 327:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 328:calibration.c ****             return (uint8)(center + stage->probe_step);
 329:calibration.c ****         }
 330:calibration.c ****     }
 331:calibration.c **** 
 332:calibration.c ****     return (center < hi) ? hi : lo;
 333:calibration.c **** }
 334:calibration.c **** #endif /* #if 0 -- biseccion legacy */
