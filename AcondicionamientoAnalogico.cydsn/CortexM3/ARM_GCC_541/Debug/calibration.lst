 236:calibration.c ****  * que sigue marcado "#if 0" es la biseccion vieja — se conserva como
 237:calibration.c ****  * referencia, no se borró, pero no compila. Ver calibration_tables.h,
 238:calibration.c ****  * bloque "Controlador PI de calibracion", para la ley de control activa.
 239:calibration.c ****  * ============================================================ */
 240:calibration.c **** #if CAL_ALGO_BISECTION_ENABLE
 241:calibration.c **** /* Reduce las cuentas crudas del ADC a una escala comparable con los codigos
 242:calibration.c ****  * del VDAC8. El ADC ve un span simplificado de 0..5V (signed +-2.5V alrededor
 243:calibration.c ****  * de VDDA/2), mientras el VDAC usa 0..4.080V; por eso al shift de 18->8 bits
 244:calibration.c ****  * se le aplica la correccion de spans 5000/4080. */
 245:calibration.c **** #define CAL_DAC_SCALE_SHIFT 10
 246:calibration.c **** #define CAL_ADC_SPAN_MV    5000L
 247:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
 248:calibration.c **** 
 249:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
 250:calibration.c **** {
 251:calibration.c ****     if (value >= 0L) {
 252:calibration.c ****         return (value + (divisor / 2L)) / divisor;
 253:calibration.c ****     }
 254:calibration.c ****     return -(((-value) + (divisor / 2L)) / divisor);
 255:calibration.c **** }
 256:calibration.c **** 
 257:calibration.c **** static int32 cal_scale_counts(int32 value)
 258:calibration.c **** {
 259:calibration.c ****     int32 shifted = value >> CAL_DAC_SCALE_SHIFT;
 260:calibration.c ****     return cal_div_round_signed(shifted * CAL_ADC_SPAN_MV, CAL_VDAC_SPAN_MV);
 261:calibration.c **** }
 262:calibration.c **** 
 263:calibration.c **** /* Ver CAL_OPERATING_RANGE_COUNTS (calibration_tables.h): +-0.5V absolutos.
 264:calibration.c ****  * Una medicion mas alla de esto deja al operacional fuera de rango
 265:calibration.c ****  * operativo, sin importar si "ok" hubiera dado 1. */
 266:calibration.c **** static uint8 cal_measured_out_of_range(int32 measured)
 267:calibration.c **** {
 268:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) > cal_scale_counts(CAL_OPERATING_RANGE_COUNTS)) 
 269:calibration.c **** }
 270:calibration.c **** 
 271:calibration.c **** static uint8 cal_stage_saturated(const PsocCalStage *stage, int32 measured)
 272:calibration.c **** {
 273:calibration.c ****     if (stage->sat_counts <= 0L) {
 274:calibration.c ****         return 0u;
 275:calibration.c ****     }
 276:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) >= cal_scale_counts(stage->sat_counts)) ? 1u : 0
 277:calibration.c **** }
 278:calibration.c **** #endif /* #if 0 -- biseccion legacy */
