1498:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
1499:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
1500:calibration.c **** {
1501:calibration.c ****     int64 half;
1502:calibration.c **** 
1503:calibration.c ****     if (den == 0LL) {
1504:calibration.c ****         den = 1LL;
1505:calibration.c ****     }
1506:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
1507:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
1508:calibration.c ****         return (num - half) / den;
1509:calibration.c ****     }
1510:calibration.c ****     return (num + half) / den;
1511:calibration.c **** }
