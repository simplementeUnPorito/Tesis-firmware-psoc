 559:calibration.c ****         g_cal_servo.have_last[stage_index] = 1u;
 560:calibration.c ****         g_cal_servo.last_dac[stage_index] = dac;
 561:calibration.c ****         g_cal_servo.last_measured[stage_index] = measured;
 562:calibration.c ****         return 1u;
 563:calibration.c ****     }
 564:calibration.c **** 
 565:calibration.c ****     if (g_cal_servo.trial_active[stage_index] &&
 566:calibration.c ****         abs_error > (g_cal_servo.prev_abs_error[stage_index] +
 567:calibration.c ****                      CAL_SERVO_WORSE_HYST_COUNTS) &&
