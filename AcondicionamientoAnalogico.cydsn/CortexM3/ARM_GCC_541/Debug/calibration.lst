 232:calibration_tables.h **** 
 233:calibration_tables.h **** /* CAL_SERVO_*_HAMMER_PGA/_LP (servo lento, legado sin uso) y CAL_PI_KP/KI/
 234:calibration_tables.h ****  * LSB_COUNTS/MAX_SAMPLES_HAMMER_PGA/_LP (ganancias del PI activo) ya viven
