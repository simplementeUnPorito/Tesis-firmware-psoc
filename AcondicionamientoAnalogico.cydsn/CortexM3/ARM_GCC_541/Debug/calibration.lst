  48:calibration_tables.h **** /* ADC_CFG1 es diferencial signed de 18 bits (0 = 0V diferencial). En modo
  49:calibration_tables.h ****  * GEO cada etapa debe quedar con su salida DC igualada a AMux_IN=1
  50:calibration_tables.h ****  * (referencia/tierra virtual de 2.5 V), es decir lectura diferencial = 0 counts. */
  51:calibration_tables.h **** #ifndef CAL_TARGET_GEO_PGA_COUNTS
  52:calibration_tables.h **** #define CAL_TARGET_GEO_PGA_COUNTS 0L
  53:calibration_tables.h **** #endif
