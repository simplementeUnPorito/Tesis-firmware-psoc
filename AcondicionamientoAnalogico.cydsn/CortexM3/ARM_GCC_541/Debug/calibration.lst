1730:calibration.c ****     deadband_dac = cal_pi_deadband_dac_codes(g_cal_async.stage_index);
1731:calibration.c ****     cal_diag_i32(PSOC_EVT_CAL_PI_GAIN32, stage_gain_x1000);
1732:calibration.c ****     cal_diag(PSOC_EVT_CAL_PI_DEADBAND,
1733:calibration.c ****              (deadband_dac > 255L) ? 255u : (uint8)deadband_dac);
1734:calibration.c **** 
1735:calibration.c ****     g_cal_pi.integral = 0L;
1736:calibration.c ****     g_cal_pi.samples_taken = 0u;
1737:calibration.c ****     g_cal_pi.stable_count = 0u;
1738:calibration.c ****     g_cal_pi.have_last_error = 0u;
1739:calibration.c ****     g_cal_pi.last_error_dac = 0L;
