  90:calibration.c **** }
  91:calibration.c **** 
  92:calibration.c **** /* Ver CAL_OPERATING_RANGE_COUNTS (calibration_tables.h): +-0.5V absolutos.
  93:calibration.c ****  * Una medicion mas alla de esto deja al operacional fuera de rango
  94:calibration.c ****  * operativo, sin importar si "ok" hubiera dado 1. */
  95:calibration.c **** static uint8 cal_measured_out_of_range(int32 measured)
  96:calibration.c **** {
