1705:calibration.c ****      * CAL_DIRECTION_HAMMER_PGA/CAL_DIRECTION_GEO_PGA en calibration_tables.h).
1706:calibration.c ****      * La accion es incremental sobre el DAC actual: si el error ya quedo
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccFUmtKb.s 			page 345


1707:calibration.c ****      * cerca de cero, el lazo conserva el punto encontrado en vez de volver al
1708:calibration.c ****      * feedforward/centro nominal de la etapa. */
1709:calibration.c ****     effort = (int32)g_cal_pi.dac_current
1710:calibration.c ****            + (int32)stage->direction *
1711:calibration.c ****              ( (error * cfg->kp_num) / ((cfg->kp_div == 0L) ? 1L : cfg->kp_div)
1712:calibration.c ****              + (g_cal_pi.integral * cfg->ki_num) / ((cfg->ki_div == 0L) ? 1L : cfg->ki_div) );
1713:calibration.c **** 
