1728:calibration.c ****     if (dac_desired > g_cal_pi.dac_current) {
1729:calibration.c ****         limited_dac = (uint16)g_cal_pi.dac_current + (uint16)max_step;
1730:calibration.c ****         dac_target = ((uint16)dac_desired < limited_dac) ? dac_desired : (uint8)limited_dac;
1731:calibration.c ****     } else if (dac_desired < g_cal_pi.dac_current) {
