 573:calibration.c ****                       stage->tolerance_counts) ? 1u : 0u;
 574:calibration.c ****         g_cal_servo.integral[stage_index] = 0L;
 575:calibration.c ****         g_cal_servo.trial_active[stage_index] = 0u;
 576:calibration.c ****         cal_diag(PSOC_EVT_CAL_LOOP, restore_dac);
 577:calibration.c ****         return 1u;
 578:calibration.c ****     } else {
 579:calibration.c ****         int32 control;
 580:calibration.c ****         uint8 assume_increasing;
