 217:calibration.c ****     uint8 i;
 218:calibration.c **** 
 219:calibration.c ****     for (i = 0u; i < 3u; i++) {
 220:calibration.c ****         stage->write(sweep_dac[i]);
 221:calibration.c ****         CyDelay(CAL_DIAG_SWEEP_SETTLE_MS);
 222:calibration.c ****         cal_diag(PSOC_EVT_CAL_SWEEP_DAC, sweep_dac[i]);
 223:calibration.c ****         cal_diag_i32(PSOC_EVT_CAL_SWEEP_MEAS32, cal_adc_read_direct_counts());
 224:calibration.c ****     }
 225:calibration.c **** }
