1110:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1111:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
1112:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
1113:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
1114:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
1115:calibration.c **** static void cal_async_abort_watchdog(void)
1116:calibration.c **** {
1117:calibration.c ****     uint8 i;
1118:calibration.c ****     uint8 preserve_results =
1119:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1120:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1121:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1122:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1123:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1124:calibration.c **** 
1125:calibration.c ****     if (!preserve_results) {
ARM GAS  C:\Users\elias\AppData\Local\Temp\cct51h4B.s 			page 560


1126:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1127:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1128:calibration.c ****             g_psoc_cal_stages[i].write(center);
1129:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1130:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1131:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1132:calibration.c ****         }
1133:calibration.c ****     }
1134:calibration.c ****     g_cal_async.ok = 0u;
1135:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1136:calibration.c **** 
1137:calibration.c ****     cal_async_complete();
1138:calibration.c **** }
