 547:calibration.c ****         g_cal_servo.trial_active[stage_index] = 0u;
 548:calibration.c ****         g_cal_servo.have_last[stage_index] = 1u;
 549:calibration.c ****         g_cal_servo.last_dac[stage_index] = dac;
 550:calibration.c ****         g_cal_servo.last_measured[stage_index] = measured;
 551:calibration.c ****         return 1u;
 552:calibration.c ****     }
 553:calibration.c **** 
 554:calibration.c ****     if (g_cal_servo.trial_active[stage_index] &&
