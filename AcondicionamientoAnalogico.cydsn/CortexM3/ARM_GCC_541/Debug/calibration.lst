 612:calibration.c **** static uint8 cal_servo_measure_service(void)
 613:calibration.c **** {
 614:calibration.c ****     int32 sample;
 615:calibration.c ****     int32 cum_avg;
 616:calibration.c ****     uint8 stage_index = g_cal_servo.stage_index;
 617:calibration.c **** 
 618:calibration.c ****     if (!psoc_adc_take_isr_sample(&sample)) {
 619:calibration.c ****         g_cal_servo.empty_polls++;
 620:calibration.c ****         if (g_cal_servo.empty_polls >= CAL_ASYNC_EMPTY_POLL_LIMIT) {
 621:calibration.c ****             g_cal_servo.state = CAL_SERVO_IDLE;
 622:calibration.c ****             psoc_calibration_restore_capture_path();
 623:calibration.c ****             return 1u;
 624:calibration.c ****         }
 625:calibration.c ****         return 0u;
 626:calibration.c ****     }
 627:calibration.c **** 
 628:calibration.c ****     g_cal_servo.empty_polls = 0UL;
 629:calibration.c ****     if (g_cal_servo.discard_count > 0u) {
 630:calibration.c ****         g_cal_servo.discard_count--;
 631:calibration.c ****         return 0u;
 632:calibration.c ****     }
 633:calibration.c **** 
 634:calibration.c ****     g_cal_servo.acc += sample;
 635:calibration.c ****     g_cal_servo.avg_count++;
 636:calibration.c ****     if (g_cal_servo.avg_count < CAL_SERVO_AVG_N) {
 637:calibration.c ****         return 0u;
 638:calibration.c ****     }
 639:calibration.c **** 
 640:calibration.c ****     g_cal_servo.cum_sum += g_cal_servo.acc;
 641:calibration.c ****     g_cal_servo.cum_count += (int32)CAL_SERVO_AVG_N;
 642:calibration.c ****     g_cal_servo.acc = 0L;
 643:calibration.c ****     g_cal_servo.avg_count = 0u;
 644:calibration.c **** 
 645:calibration.c ****     cum_avg = g_cal_servo.cum_sum / g_cal_servo.cum_count;
 646:calibration.c ****     if (g_cal_servo.have_prev_avg &&
 647:calibration.c ****         abs_counts(cum_avg - g_cal_servo.prev_avg) <= CAL_SERVO_SETTLE_TOL_COUNTS) {
 648:calibration.c ****         uint8 locked;
 649:calibration.c ****         cal_diag(PSOC_EVT_CAL_STAGE_DAC, g_cal_servo.dac);
 650:calibration.c ****         cal_diag_i16(PSOC_EVT_CAL_STAGE_MEAS, cum_avg);
 651:calibration.c ****         cal_diag_i32(PSOC_EVT_CAL_STAGE_MEAS32, cum_avg);
 652:calibration.c ****         locked = cal_servo_apply_measurement(stage_index, g_cal_servo.dac, cum_avg);
 653:calibration.c ****         psoc_calibration_restore_capture_path();
 654:calibration.c ****         if (locked) {
 655:calibration.c ****             g_cal_servo.stage_index = (uint8)((stage_index + 1u) % PSOC_CAL_STAGE_COUNT);
 656:calibration.c ****         }
 657:calibration.c ****         g_cal_servo.next_due_ticks = psoc_now_ticks() + CAL_SERVO_PERIOD_TICKS;
 658:calibration.c ****         g_cal_servo.state = CAL_SERVO_IDLE;
 659:calibration.c ****         return 1u;
 660:calibration.c ****     }
