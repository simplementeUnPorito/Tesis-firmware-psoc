   1:calibration_tables.h **** #ifndef CALIBRATION_TABLES_H
   2:calibration_tables.h **** #define CALIBRATION_TABLES_H
   3:calibration_tables.h **** 
   4:calibration_tables.h **** #include "calibration.h"
   5:calibration_tables.h **** 
   6:calibration_tables.h **** /* ============================================================
   7:calibration_tables.h ****  * Este archivo es el AGREGADOR de la configuracion de calibracion.
   8:calibration_tables.h ****  * Los parametros POR ETAPA GEO (target, rango de busqueda, promediado
   9:calibration_tables.h ****  * de biseccion/verify, saturacion, fase realcheck y ganancias del
  10:calibration_tables.h ****  * servo PI) viven en headers independientes, uno por VDAC:
  11:calibration_tables.h ****  *   - calibration_tables_geo_pga.h
  12:calibration_tables.h ****  *   - calibration_tables_geo_bp.h
  13:calibration_tables.h ****  *   - calibration_tables_geo_adder.h
  14:calibration_tables.h ****  *   - calibration_tables_geo_lp.h
  15:calibration_tables.h ****  * Cada uno es 100% autocontenido (sin alias a constantes compartidas) para
  16:calibration_tables.h ****  * poder afinarlos por separado con el osciloscopio. Lo que queda aca son
  17:calibration_tables.h ****  * los parametros realmente GLOBALES (canales AMux, "banda buena" operativa,
  18:calibration_tables.h ****  * limites de buffers internos) y el bloque HAMMER (PSOC_HW_CLASS lo selecciona
  19:calibration_tables.h ****  * cuando el TopDesign trae el componente PGA — confirmado vía
  20:calibration_tables.h ****  * codegentemp/generated_files.txt: hoy es el front-end HAMMER el que está
  21:calibration_tables.h ****  * colocado, no PGAgain/GEO; PGAgain.c/.h en Generated_Source son huérfanos).
  22:calibration_tables.h ****  * ============================================================ */
  23:calibration_tables.h **** 
  24:calibration_tables.h **** /* Guia global:
  25:calibration_tables.h ****  * CAL_AMUX_SETTLE_MS / CAL_DAC_SETTLE_MS: defaults legacy de espera fija.
  26:calibration_tables.h ****  *   La calibracion GEO actual usa principalmente *_SETTLE_SAMPLES_* por etapa.
  27:calibration_tables.h ****  * CAL_TARGET_1V_COUNTS / CAL_TARGET_1V5_COUNTS: objetivos auxiliares del
  28:calibration_tables.h ****  *   bloque HAMMER, en cuentas ADC.
  29:calibration_tables.h ****  * CAL_OPERATING_RANGE_COUNTS: banda buena absoluta. Si GEO_LP termina dentro
  30:calibration_tables.h ****  *   de este rango, la calibracion final se considera usable para la GUI.
  31:calibration_tables.h ****  * CAL_AVG_WINDOW_MAX: limite del buffer interno de promediado; debe ser >= al
  32:calibration_tables.h ****  *   mayor *_AVG_WINDOW_COUNT_* usado.
  33:calibration_tables.h ****  * CAL_DAC_INIT / CAL_DAC_CENTER: centro nominal del VDAC, 0x9C ~= 2.5 V.
  34:calibration_tables.h ****  * CAL_FAIL_FAST_ON_STAGE_FAIL: en GEO queda 0 para completar todas las etapas
  35:calibration_tables.h ****  *   y obtener logs aunque una etapa no cierre perfecto.
  36:calibration_tables.h ****  * CAL_BEST_CANDIDATE_COUNT: cuantos mejores puntos guarda la biseccion.
  37:calibration_tables.h ****  * CAL_VISIT_HISTORY_COUNT: memoria de DACs visitados para evitar loops.
  38:calibration_tables.h ****  * CAL_WATCHDOG_TICKS: timeout global de la calibracion; tick = 10 ms.
  39:calibration_tables.h ****  * CAL_SERVO_ENABLE_DEFAULT: habilita el servo lento en IDLE; hoy 0.
  40:calibration_tables.h ****  * CAL_SERVO_* globales: timing/limites del servo, no de la corrida manual.
  41:calibration_tables.h ****  * Bloque HAMMER: no es usado por el hardware GEO actual; queda compilable. */
  42:calibration_tables.h **** 
  43:calibration_tables.h **** #ifndef CAL_AMUX_SETTLE_MS
  44:calibration_tables.h **** #define CAL_AMUX_SETTLE_MS 5u
  45:calibration_tables.h **** #endif
  46:calibration_tables.h **** 
  47:calibration_tables.h **** #ifndef CAL_DAC_SETTLE_MS
  48:calibration_tables.h **** #define CAL_DAC_SETTLE_MS 5u
  49:calibration_tables.h **** #endif
  50:calibration_tables.h **** 
  51:calibration_tables.h **** #ifndef CAL_TARGET_1V_COUNTS
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccpIGmbW.s 			page 291


  52:calibration_tables.h **** #define CAL_TARGET_1V_COUNTS 52429L
  53:calibration_tables.h **** #endif
  54:calibration_tables.h **** 
  55:calibration_tables.h **** #ifndef CAL_TARGET_1V5_COUNTS
  56:calibration_tables.h **** #define CAL_TARGET_1V5_COUNTS 78644L
  57:calibration_tables.h **** #endif
  58:calibration_tables.h **** 
  59:calibration_tables.h **** /* Escalas fisicas usadas por el PI activo. El ADC se compara en el mismo
  60:calibration_tables.h ****  * dominio que el VDAC: ADC 0..5V, 18 bits; VDAC8 0..4.080V, 8 bits. */
  61:calibration_tables.h **** #ifndef CAL_ADC_SPAN_MV
  62:calibration_tables.h **** #define CAL_ADC_SPAN_MV 5000L
  63:calibration_tables.h **** #endif
  64:calibration_tables.h **** 
