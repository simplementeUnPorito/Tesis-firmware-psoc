 100:calibration.c **** static uint8 cal_stage_min_dac(const PsocCalStage *stage)
 101:calibration.c **** {
 102:calibration.c ****     return (stage->dac_center > stage->dac_max_change)
 103:calibration.c ****         ? (uint8)(stage->dac_center - stage->dac_max_change)
 104:calibration.c ****         : 0u;
 105:calibration.c **** }
 106:calibration.c **** 
 107:calibration.c **** static uint8 cal_stage_max_dac(const PsocCalStage *stage)
 108:calibration.c **** {
 109:calibration.c ****     uint16 max_dac = (uint16)stage->dac_center + (uint16)stage->dac_max_change;
 110:calibration.c ****     return (max_dac > 255u) ? 255u : (uint8)max_dac;
 111:calibration.c **** }
