  93:calibration_tables.h **** 
  94:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_US(us) \
  95:calibration_tables.h ****     ((uint16)((((uint32)(us) * (uint32)ADC_DEFAULT_SRATE * (uint32)CAL_SETTLE_FACTOR) + \
  96:calibration_tables.h ****                ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL) - 1UL) / \
