 227:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
 228:calibration.c **** 
 229:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
 230:calibration.c **** {
 231:calibration.c ****     if (value >= 0L) {
 232:calibration.c ****         return (value + (divisor / 2L)) / divisor;
 233:calibration.c ****     }
 234:calibration.c ****     return -(((-value) + (divisor / 2L)) / divisor);
 235:calibration.c **** }
 236:calibration.c **** 
 237:calibration.c **** static int32 cal_scale_counts(int32 value)
 238:calibration.c **** {
 239:calibration.c ****     int32 shifted = value >> CAL_DAC_SCALE_SHIFT;
 240:calibration.c ****     return cal_div_round_signed(shifted * CAL_ADC_SPAN_MV, CAL_VDAC_SPAN_MV);
 241:calibration.c **** }
