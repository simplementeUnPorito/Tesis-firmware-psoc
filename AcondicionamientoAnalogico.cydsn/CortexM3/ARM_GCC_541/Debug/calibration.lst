1008:calibration.c **** static int32 cal_pi_error_bucket(int32 error_dac, int32 deadband_dac)
1009:calibration.c **** {
1010:calibration.c ****     int32 abs_error;
1011:calibration.c ****     int32 span;
1012:calibration.c ****     int32 bucket;
1013:calibration.c **** 
1014:calibration.c ****     span = (deadband_dac <= 0L) ? 1L : deadband_dac;
1015:calibration.c ****     abs_error = abs_counts(error_dac);
1016:calibration.c ****     if (abs_error <= span) {
1017:calibration.c ****         return 0L;
1018:calibration.c ****     }
1019:calibration.c ****     bucket = 1L + ((abs_error - span - 1L) / span);
1020:calibration.c ****     return (error_dac < 0L) ? -bucket : bucket;
1021:calibration.c **** }
