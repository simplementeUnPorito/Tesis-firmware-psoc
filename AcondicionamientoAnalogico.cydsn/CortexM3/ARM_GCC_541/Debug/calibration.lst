1547:calibration.c **** 
1548:calibration.c **** static int32 cal_pi_control_gain_x1000(uint8 stage_index)
1549:calibration.c **** {
1550:calibration.c ****     int32 gain = cal_pi_stage_gain_x1000(stage_index);
1551:calibration.c ****     return (gain <= 0L) ? 1000L : gain;
1552:calibration.c **** }
1553:calibration.c **** 
1554:calibration.c **** static int32 cal_pi_deadband_dac_codes(uint8 stage_index)
1555:calibration.c **** {
1556:calibration.c ****     int32 gain_x1000 = cal_pi_stage_gain_x1000(stage_index);
1557:calibration.c ****     int64 num;
1558:calibration.c ****     int64 den;
1559:calibration.c ****     int32 deadband;
1560:calibration.c **** 
1561:calibration.c ****     if (gain_x1000 < 0L) {
1562:calibration.c ****         gain_x1000 = -gain_x1000;
1563:calibration.c ****     }
1564:calibration.c ****     num = (int64)gain_x1000 * (int64)CAL_PI_DEADBAND_MARGIN_NUM;
1565:calibration.c ****     den = 1000LL * (int64)CAL_PI_DEADBAND_MARGIN_DEN;
1566:calibration.c ****     deadband = (int32)((num + den - 1LL) / den);
1567:calibration.c ****     if (deadband < CAL_PI_DEADBAND_MIN_DAC_CODES) {
1568:calibration.c ****         deadband = CAL_PI_DEADBAND_MIN_DAC_CODES;
1569:calibration.c ****     }
1570:calibration.c ****     return deadband;
1571:calibration.c **** }
1572:calibration.c **** 
1573:calibration.c **** static int32 cal_pi_error_bucket(int32 error_dac, int32 deadband_dac)
1574:calibration.c **** {
1575:calibration.c ****     int32 abs_error;
1576:calibration.c ****     int32 span;
1577:calibration.c ****     int32 bucket;
1578:calibration.c **** 
1579:calibration.c ****     span = (deadband_dac <= 0L) ? 1L : deadband_dac;
1580:calibration.c ****     abs_error = abs_counts(error_dac);
1581:calibration.c ****     if (abs_error <= span) {
1582:calibration.c ****         return 0L;
1583:calibration.c ****     }
1584:calibration.c ****     bucket = 1L + ((abs_error - span - 1L) / span);
1585:calibration.c ****     return (error_dac < 0L) ? -bucket : bucket;
1586:calibration.c **** }
1587:calibration.c **** 
1588:calibration.c **** static int32 cal_pi_gain_scaled_term(int32 value, int32 num, int32 div, int32 gain_x1000)
1589:calibration.c **** {
1590:calibration.c ****     if (div == 0L) {
1591:calibration.c ****         div = 1L;
1592:calibration.c ****     }
1593:calibration.c ****     if (gain_x1000 <= 0L) {
1594:calibration.c ****         gain_x1000 = 1000L;
1595:calibration.c ****     }
1596:calibration.c ****     return cal_round_div_i64((int64)value * (int64)num * 1000LL,
1597:calibration.c ****                              (int64)div * (int64)gain_x1000);
1598:calibration.c **** }
