  70:calibration_tables.h **** /* Rango operativo absoluto: ADC_CFG1_COUNTS_PER_VOLT=52429 (ver HANDOFF
  71:calibration_tables.h ****  * §4/§13), entonces 0.5V =~ 26214 counts. Se conserva como alarma de salud:
  72:calibration_tables.h ****  * si una etapa queda fuera de esto, el log lo muestra como no OK, pero no se
  73:calibration_tables.h ****  * abandona la cascada ni se vuelve al default. Distinto de
  74:calibration_tables.h ****  * CAL_SAT_COUNTS_GEO_* (por etapa, en cada header) que es el umbral de riel
  75:calibration_tables.h ****  * real. */
  76:calibration_tables.h **** #define CAL_OPERATING_RANGE_COUNTS 26214L
  77:calibration_tables.h **** 
  78:calibration_tables.h **** /* Tamaño del buffer circular de sumas-de-ventana usado por
  79:calibration_tables.h ****  * async_measure_service (calibration.c) para el promedio deslizante. Debe
  80:calibration_tables.h ****  * ser >= el window_count mas grande entre TODAS las etapas/fases (hoy:
  81:calibration_tables.h ****  * CAL_REALCHECK_AVG_WINDOW_COUNT_GEO_* = 64). Una sola instancia porque las
  82:calibration_tables.h ****  * etapas se procesan secuencialmente. */
  83:calibration_tables.h **** #define CAL_AVG_WINDOW_MAX 64u
  84:calibration_tables.h **** 
  85:calibration_tables.h **** /* Descartes por asentamiento calculados desde el sample rate real del ADC.
  86:calibration_tables.h ****  * CAL_SETTLE_FACTOR esta en calibration.h. Con factor 3x y
  87:calibration_tables.h ****  * ADC_DEFAULT_SRATE=3000:
  88:calibration_tables.h ****  *   PGA 220ms -> 1980 muestras, BP 100us -> 1, Adder 200us -> 2,
  89:calibration_tables.h ****  *   LP 6ms -> 54. */
  90:calibration_tables.h **** #ifndef ADC_DEFAULT_SRATE
  91:calibration_tables.h **** #define ADC_DEFAULT_SRATE 3000u
  92:calibration_tables.h **** #endif
  93:calibration_tables.h **** 
  94:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_US(us) \
  95:calibration_tables.h ****     ((uint16)((((uint32)(us) * (uint32)ADC_DEFAULT_SRATE * (uint32)CAL_SETTLE_FACTOR) + \
  96:calibration_tables.h ****                ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL) - 1UL) / \
  97:calibration_tables.h ****               ((uint32)CAL_SETTLE_FACTOR_DEN * 1000000UL)))
  98:calibration_tables.h **** 
  99:calibration_tables.h **** #define CAL_SETTLE_SAMPLES_FROM_MS(ms) \
 100:calibration_tables.h ****     CAL_SETTLE_SAMPLES_FROM_US(((uint32)(ms) * 1000UL))
