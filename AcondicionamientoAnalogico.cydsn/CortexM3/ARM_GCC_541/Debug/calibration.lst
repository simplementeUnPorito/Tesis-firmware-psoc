 757:calibration.c **** /* Mide promediando ACUMULATIVAMENTE: cada ventana de avg_n muestras se suma
 758:calibration.c ****  * al total (cum_sum/cum_count) en vez de descartarse, y "measured" es siempre
 759:calibration.c ****  * ese promedio acumulado de baja-ruido (nunca el de una sola ventana). Se
 760:calibration.c ****  * sigue acumulando hasta que el promedio acumulado deje de moverse mas de
 761:calibration.c ****  * CAL_SETTLE_TOL_COUNTS de una ventana a la siguiente, o hasta
 762:calibration.c ****  * CAL_SETTLE_MAX_WINDOWS como limite de seguridad -- en ese caso tambien se
 763:calibration.c ****  * devuelve el promedio acumulado (no la ultima ventana), que ya es mucho mas
 764:calibration.c ****  * estable que una ventana sola. Esto evita que el ruido de una sola medicion
 765:calibration.c ****  * "convenza" a la busqueda binaria de que un punto es mejor de lo que es
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccymbz3j.s 			page 372


 766:calibration.c ****  * (corregido 2026-06-14, ver HANDOFF: la busqueda terminaba sobre-ajustando
 767:calibration.c ****  * al ruido y saturando GEO_LP). */
 768:calibration.c **** static uint8 async_measure_service(void)
 769:calibration.c **** {
 770:calibration.c ****     int32 sample;
 771:calibration.c ****     int32 cum_avg;
 772:calibration.c ****     const PsocCalStage *stage = &g_psoc_cal_stages[g_cal_async.stage_index];
 773:calibration.c **** 
 774:calibration.c ****     if (!psoc_adc_take_isr_sample(&sample)) {
 775:calibration.c ****         g_cal_async.empty_polls++;
 776:calibration.c ****         if (g_cal_async.empty_polls >= CAL_ASYNC_EMPTY_POLL_LIMIT) {
 777:calibration.c ****             g_cal_async.measured = 0x7FFFL;
 778:calibration.c ****             cal_diag_point(g_cal_async.dac, g_cal_async.measured);
 779:calibration.c ****             g_cal_async.state = g_cal_async.after_measure;
 780:calibration.c ****             return 1u;
 781:calibration.c ****         }
 782:calibration.c ****         return 0u;
 783:calibration.c ****     }
 784:calibration.c **** 
 785:calibration.c ****     g_cal_async.empty_polls = 0UL;
 786:calibration.c ****     if (g_cal_async.discard_count > 0u) {
 787:calibration.c ****         g_cal_async.discard_count--;
 788:calibration.c ****         return 0u;
 789:calibration.c ****     }
 790:calibration.c **** 
 791:calibration.c ****     g_cal_async.acc += sample;
 792:calibration.c ****     g_cal_async.avg_count++;
 793:calibration.c ****     if (g_cal_async.avg_count < stage->avg_n) {
 794:calibration.c ****         return 0u;
 795:calibration.c ****     }
 796:calibration.c **** 
 797:calibration.c ****     g_cal_async.cum_sum += g_cal_async.acc;
 798:calibration.c ****     g_cal_async.cum_count += (int32)stage->avg_n;
 799:calibration.c ****     g_cal_async.acc = 0L;
 800:calibration.c ****     g_cal_async.avg_count = 0u;
 801:calibration.c **** 
 802:calibration.c ****     cum_avg = g_cal_async.cum_sum / g_cal_async.cum_count;
 803:calibration.c ****     g_cal_async.measured = cum_avg;
 804:calibration.c **** 
 805:calibration.c ****     if (g_cal_async.have_prev_avg &&
 806:calibration.c ****         (abs_counts(cum_avg - g_cal_async.prev_avg) <= CAL_SETTLE_TOL_COUNTS)) {
 807:calibration.c ****         cal_diag_point(g_cal_async.dac, g_cal_async.measured);
 808:calibration.c ****         g_cal_async.state = g_cal_async.after_measure;
 809:calibration.c ****         return 1u;
 810:calibration.c ****     }
 811:calibration.c **** 
 812:calibration.c ****     g_cal_async.prev_avg = cum_avg;
 813:calibration.c ****     g_cal_async.have_prev_avg = 1u;
 814:calibration.c ****     g_cal_async.settle_windows++;
 815:calibration.c ****     if (g_cal_async.settle_windows >= CAL_SETTLE_MAX_WINDOWS) {
 816:calibration.c ****         cal_diag_point(g_cal_async.dac, g_cal_async.measured);
 817:calibration.c ****         g_cal_async.state = g_cal_async.after_measure;
 818:calibration.c ****         return 1u;
 819:calibration.c ****     }
 820:calibration.c **** 
 821:calibration.c ****     return 0u;
 822:calibration.c **** }
