  35:calibration.c **** static void cal_diag_i16(uint8 event, int32 value)
  36:calibration.c **** {
  37:calibration.c ****     uint16 u;
  38:calibration.c ****     if (value > 32767L) { value = 32767L; }
  39:calibration.c ****     if (value < -32768L) { value = -32768L; }
