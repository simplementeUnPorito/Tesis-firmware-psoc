 401:calibration.c **** static uint8 cal_stage_current_dac(uint8 stage_index)
 402:calibration.c **** {
 403:calibration.c ****     if (stage_index >= g_psoc_cal_result_count) {
 404:calibration.c ****         return cal_stage_center_dac(&g_psoc_cal_stages[stage_index]);
 405:calibration.c ****     }
 406:calibration.c ****     return cal_stage_clamp_dac(&g_psoc_cal_stages[stage_index],
 407:calibration.c ****                                g_psoc_cal_results[stage_index].final_dac);
 408:calibration.c **** }
 409:calibration.c **** 
 410:calibration.c **** static void cal_stage_write_result(uint8 stage_index, uint8 dac)
 411:calibration.c **** {
 412:calibration.c ****     if (stage_index < PSOC_CAL_STAGE_COUNT) {
 413:calibration.c ****         uint8 clamped = cal_stage_clamp_dac(&g_psoc_cal_stages[stage_index], dac);
 414:calibration.c ****         g_psoc_cal_stages[stage_index].write(clamped);
 415:calibration.c ****         g_psoc_cal_results[stage_index].final_dac = clamped;
 416:calibration.c ****         if (g_psoc_cal_result_count < PSOC_CAL_STAGE_COUNT) {
 417:calibration.c ****             g_psoc_cal_result_count = PSOC_CAL_STAGE_COUNT;
 418:calibration.c ****         }
 419:calibration.c ****     }
 420:calibration.c **** }
