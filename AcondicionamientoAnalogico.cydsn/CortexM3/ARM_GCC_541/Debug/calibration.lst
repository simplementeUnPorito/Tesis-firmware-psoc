1548:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
1549:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
1550:calibration.c **** {
1551:calibration.c ****     int64 half;
1552:calibration.c **** 
1553:calibration.c ****     if (den == 0LL) {
1554:calibration.c ****         den = 1LL;
1555:calibration.c ****     }
1556:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
1557:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
1558:calibration.c ****         return (num - half) / den;
1559:calibration.c ****     }
1560:calibration.c ****     return (num + half) / den;
1561:calibration.c **** }
