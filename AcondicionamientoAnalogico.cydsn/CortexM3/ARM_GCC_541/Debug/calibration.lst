 936:calibration.c **** /* Division entera con redondeo al mas cercano (no truncado hacia 0). */
 937:calibration.c **** static int32 cal_round_div_i64(int64 num, int64 den)
 938:calibration.c **** {
 939:calibration.c ****     int64 half;
 940:calibration.c **** 
 941:calibration.c ****     if (den == 0LL) {
 942:calibration.c ****         den = 1LL;
 943:calibration.c ****     }
 944:calibration.c ****     half = (den < 0LL) ? -den / 2LL : den / 2LL;
 945:calibration.c ****     if ((num < 0LL) != (den < 0LL)) {
 946:calibration.c ****         return (num - half) / den;
 947:calibration.c ****     }
 948:calibration.c ****     return (num + half) / den;
 949:calibration.c **** }
 950:calibration.c **** 
 951:calibration.c **** static int32 cal_pi_clip_integral(int32 value)
 952:calibration.c **** {
 953:calibration.c ****     if (value > CAL_PI_INTEGRAL_LIMIT) { return CAL_PI_INTEGRAL_LIMIT; }
 954:calibration.c ****     if (value < -CAL_PI_INTEGRAL_LIMIT) { return -CAL_PI_INTEGRAL_LIMIT; }
