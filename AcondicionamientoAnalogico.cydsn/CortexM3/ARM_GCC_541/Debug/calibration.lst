1002:calibration.c **** static int32 cal_pi_error_bucket(int32 error_dac, int32 deadband_dac)
1003:calibration.c **** {
1004:calibration.c ****     int32 abs_error;
1005:calibration.c ****     int32 span;
1006:calibration.c ****     int32 bucket;
1007:calibration.c **** 
1008:calibration.c ****     span = (deadband_dac <= 0L) ? 1L : deadband_dac;
1009:calibration.c ****     abs_error = abs_counts(error_dac);
1010:calibration.c ****     if (abs_error <= span) {
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccO3kM92.s 			page 366


1011:calibration.c ****         return 0L;
1012:calibration.c ****     }
1013:calibration.c ****     bucket = 1L + ((abs_error - span - 1L) / span);
1014:calibration.c ****     return (error_dac < 0L) ? -bucket : bucket;
1015:calibration.c **** }
