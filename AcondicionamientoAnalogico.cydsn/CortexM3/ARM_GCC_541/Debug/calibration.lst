 516:calibration.c ****             ((measured > g_cal_servo.last_measured[stage_index]) ==
 517:calibration.c ****              (dac > g_cal_servo.last_dac[stage_index])) ? 1u : 0u;
 518:calibration.c ****         g_cal_servo.increasing[stage_index] = slope_increasing;
