 989:calibration.c **** static int32 cal_pi_deadband_dac_codes(uint8 stage_index)
 990:calibration.c **** {
 991:calibration.c ****     int32 gain_x1000 = cal_pi_stage_gain_x1000(stage_index);
 992:calibration.c ****     int64 num;
