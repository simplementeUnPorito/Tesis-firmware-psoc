1817:calibration.c **** static void cal_pi_start(void)
1818:calibration.c **** {
1819:calibration.c ****     /* Carga el FIR pensado para calibracion (suavizado, distinto del de
1820:calibration.c ****      * adquisicion) en el Filter de hardware -- se restaura el de
1821:calibration.c ****      * adquisicion en cal_async_complete() al cerrar la corrida. */
