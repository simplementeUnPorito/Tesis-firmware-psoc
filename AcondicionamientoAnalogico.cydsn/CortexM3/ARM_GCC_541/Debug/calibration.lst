 107:calibration_tables.h **** /* Punto de partida obligatorio de la busqueda binaria: 0x9C = 156 ->
 108:calibration_tables.h ****  * 156 * 16mV (VDAC8 1x) = 2.496V =~ 2.5V (centro de rango / "tierra
 109:calibration_tables.h ****  * virtual" del front-end analogico). */
 110:calibration_tables.h **** #define CAL_DAC_INIT   0x9Cu
 111:calibration_tables.h **** 
 112:calibration_tables.h **** /* Cada etapa busca alrededor de su codigo VDAC esperado, no sobre todo el
 113:calibration_tables.h ****  * rango. Asi esto escala a otros front-ends: se ajusta CENTER/MAX_CHANGE por
 114:calibration_tables.h ****  * operacional y la maquina de estados calcula center +- max_change. */
 115:calibration_tables.h **** #define CAL_DAC_CENTER CAL_DAC_INIT
 116:calibration_tables.h **** #define CAL_DAC_MAX_CHANGE_GEO 64u
 117:calibration_tables.h **** #define CAL_DAC_MAX_CHANGE_HAMMER 255u
 118:calibration_tables.h **** 
 119:calibration_tables.h **** /* Si una etapa no entra al rango operativo, no tiene sentido seguir con las
 120:calibration_tables.h ****  * posteriores porque el front-end es una cascada. Deja logueado el mejor punto
 121:calibration_tables.h ****  * de la etapa fallida y termina con CAL_DONE=0. */
 122:calibration_tables.h **** #define CAL_FAIL_FAST_ON_STAGE_FAIL 1u
