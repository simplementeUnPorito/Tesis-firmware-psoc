  67:calibration.c **** #endif
  68:calibration.c **** 
  69:calibration.c **** static uint8 g_amux_active_channel = AMux_ADC_NULL_CHANNEL; /* uno de 0..3, o NULL */
  70:calibration.c **** static uint8 g_amux_cap_connected  = 0u;
  71:calibration.c **** 
  72:calibration.c **** static void psoc_amux_select_exclusive(uint8 channel, uint8 with_cap)
  73:calibration.c **** {
  74:calibration.c ****     if (g_amux_active_channel != AMux_ADC_NULL_CHANNEL &&
  75:calibration.c ****         g_amux_active_channel != channel) {
  76:calibration.c ****         AMux_ADC_Disconnect(g_amux_active_channel);
  77:calibration.c ****         g_amux_active_channel = AMux_ADC_NULL_CHANNEL;
  78:calibration.c ****     }
  79:calibration.c ****     if (g_amux_active_channel != channel) {
  80:calibration.c ****         AMux_ADC_Connect(channel);
  81:calibration.c ****         g_amux_active_channel = channel;
  82:calibration.c ****     }
  83:calibration.c **** 
  84:calibration.c ****     if (with_cap && CAL_AMUX_HAS_CAP_CHANNEL) {
  85:calibration.c ****         if (!g_amux_cap_connected) {
  86:calibration.c ****             AMux_ADC_Connect(CAL_AMUX_CAP_CHANNEL);
  87:calibration.c ****             g_amux_cap_connected = 1u;
  88:calibration.c ****         }
  89:calibration.c ****     } else if (g_amux_cap_connected) {
  90:calibration.c ****         AMux_ADC_Disconnect(CAL_AMUX_CAP_CHANNEL);
  91:calibration.c ****         g_amux_cap_connected = 0u;
  92:calibration.c ****     }
  93:calibration.c **** }
