 916:calibration.c ****     } else {
 917:calibration.c ****         g_cal_async.window_sum -= g_cal_async.window_buf[g_cal_async.window_pos];
 918:calibration.c ****         g_cal_async.window_buf[g_cal_async.window_pos] = g_cal_async.acc;
 919:calibration.c ****         g_cal_async.window_sum += g_cal_async.acc;
