  89:calibration.c **** 
  90:calibration.c **** /* Reduce las cuentas crudas del ADC a una escala comparable con los codigos
  91:calibration.c ****  * del VDAC8. El ADC ve un span simplificado de 0..5V (signed +-2.5V alrededor
  92:calibration.c ****  * de VDDA/2), mientras el VDAC usa 0..4.080V; por eso al shift de 18->8 bits
  93:calibration.c ****  * se le aplica la correccion de spans 5000/4080. */
  94:calibration.c **** #define CAL_DAC_SCALE_SHIFT 10
  95:calibration.c **** #define CAL_ADC_SPAN_MV    5000L
  96:calibration.c **** #define CAL_VDAC_SPAN_MV   4080L
  97:calibration.c **** 
  98:calibration.c **** static int32 cal_div_round_signed(int32 value, int32 divisor)
  99:calibration.c **** {
 100:calibration.c ****     if (value >= 0L) {
 101:calibration.c ****         return (value + (divisor / 2L)) / divisor;
 102:calibration.c ****     }
 103:calibration.c ****     return -(((-value) + (divisor / 2L)) / divisor);
 104:calibration.c **** }
 105:calibration.c **** 
 106:calibration.c **** static int32 cal_scale_counts(int32 value)
 107:calibration.c **** {
 108:calibration.c ****     int32 shifted = value >> CAL_DAC_SCALE_SHIFT;
 109:calibration.c ****     return cal_div_round_signed(shifted * CAL_ADC_SPAN_MV, CAL_VDAC_SPAN_MV);
 110:calibration.c **** }
 111:calibration.c **** 
 112:calibration.c **** /* Ver CAL_OPERATING_RANGE_COUNTS (calibration_tables.h): +-0.5V absolutos.
 113:calibration.c ****  * Una medicion mas alla de esto deja al operacional fuera de rango
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccGrLkYO.s 			page 438


 114:calibration.c ****  * operativo, sin importar si "ok" hubiera dado 1. */
 115:calibration.c **** static uint8 cal_measured_out_of_range(int32 measured)
 116:calibration.c **** {
 117:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) > cal_scale_counts(CAL_OPERATING_RANGE_COUNTS)) 
 118:calibration.c **** }
 119:calibration.c **** 
 120:calibration.c **** static uint8 cal_stage_saturated(const PsocCalStage *stage, int32 measured)
 121:calibration.c **** {
 122:calibration.c ****     if (stage->sat_counts <= 0L) {
 123:calibration.c ****         return 0u;
 124:calibration.c ****     }
 125:calibration.c ****     return (abs_counts(cal_scale_counts(measured)) >= cal_scale_counts(stage->sat_counts)) ? 1u : 0
 126:calibration.c **** }
 127:calibration.c **** 
 128:calibration.c **** static uint8 cal_stage_min_dac(const PsocCalStage *stage)
 129:calibration.c **** {
 130:calibration.c ****     return (stage->dac_center > stage->dac_max_change)
 131:calibration.c ****         ? (uint8)(stage->dac_center - stage->dac_max_change)
 132:calibration.c ****         : 0u;
 133:calibration.c **** }
 134:calibration.c **** 
 135:calibration.c **** static uint8 cal_stage_max_dac(const PsocCalStage *stage)
 136:calibration.c **** {
 137:calibration.c ****     uint16 max_dac = (uint16)stage->dac_center + (uint16)stage->dac_max_change;
 138:calibration.c ****     return (max_dac > 255u) ? 255u : (uint8)max_dac;
 139:calibration.c **** }
 140:calibration.c **** 
 141:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 142:calibration.c **** {
 143:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 144:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 145:calibration.c ****     if (dac < lo) { return lo; }
 146:calibration.c ****     if (dac > hi) { return hi; }
 147:calibration.c ****     return dac;
 148:calibration.c **** }
 149:calibration.c **** 
 150:calibration.c **** static uint8 cal_stage_center_dac(const PsocCalStage *stage)
 151:calibration.c **** {
 152:calibration.c ****     return cal_stage_clamp_dac(stage, stage->dac_center);
 153:calibration.c **** }
 154:calibration.c **** 
 155:calibration.c **** static uint8 cal_stage_probe_dac(const PsocCalStage *stage)
 156:calibration.c **** {
 157:calibration.c ****     uint8 center = cal_stage_center_dac(stage);
 158:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 159:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
 160:calibration.c **** 
 161:calibration.c ****     if (stage->direction >= 0) {
 162:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 163:calibration.c ****             return (uint8)(center + stage->probe_step);
 164:calibration.c ****         }
 165:calibration.c ****         if (center > lo) {
 166:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 167:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 168:calibration.c ****         }
 169:calibration.c ****     } else {
 170:calibration.c ****         if (center > lo) {
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccGrLkYO.s 			page 439


 171:calibration.c ****             uint8 down = (center > stage->probe_step) ? (uint8)(center - stage->probe_step) : lo;
 172:calibration.c ****             return cal_stage_clamp_dac(stage, down);
 173:calibration.c ****         }
 174:calibration.c ****         if ((uint16)center + (uint16)stage->probe_step <= hi) {
 175:calibration.c ****             return (uint8)(center + stage->probe_step);
 176:calibration.c ****         }
 177:calibration.c ****     }
 178:calibration.c **** 
 179:calibration.c ****     return (center < hi) ? hi : lo;
 180:calibration.c **** }
