 348:calibration.c **** 
 349:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
 350:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
 351:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
 352:calibration.c ****  * se fuerzan a CAL_DAC_INIT (punto medio, no saturado). Durante la
 353:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
 354:calibration.c **** static void cal_async_abort_watchdog(void)
 355:calibration.c **** {
 356:calibration.c ****     uint8 i;
 357:calibration.c ****     uint8 verify_phase = (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
 358:calibration.c ****                            g_cal_async.state == CAL_ASYNC_EVAL_VERIFY) ? 1u : 0u;
 359:calibration.c **** 
 360:calibration.c ****     if (!verify_phase) {
 361:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
 362:calibration.c ****             g_psoc_cal_stages[i].write(CAL_DAC_INIT);
 363:calibration.c ****             g_psoc_cal_results[i].final_dac = CAL_DAC_INIT;
 364:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
 365:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
 366:calibration.c ****         }
 367:calibration.c ****     }
 368:calibration.c ****     g_cal_async.ok = 0u;
 369:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
 370:calibration.c **** 
 371:calibration.c ****     ADC_Stop();
 372:calibration.c ****     psoc_calibration_restore_capture_path();
 373:calibration.c **** #if defined(SYNC_IN_INTSTAT)
 374:calibration.c ****     (void)SYNC_IN_ClearInterrupt();
 375:calibration.c **** #endif
 376:calibration.c ****     isr_SyncIn_ClearPending();
 377:calibration.c ****     isr_SyncIn_Enable();
 378:calibration.c ****     g_cal_async.busy = 0u;
 379:calibration.c ****     g_cal_async.done = 1u;
 380:calibration.c ****     g_cal_async.state = CAL_ASYNC_DONE;
 381:calibration.c **** }
 382:calibration.c **** 
