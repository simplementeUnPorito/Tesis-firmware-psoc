 417:calibration.c ****         uint8 clamped = cal_stage_clamp_dac(&g_psoc_cal_stages[stage_index], dac);
 418:calibration.c ****         g_psoc_cal_stages[stage_index].write(clamped);
 419:calibration.c ****         g_psoc_cal_results[stage_index].final_dac = clamped;
 420:calibration.c ****         if (g_psoc_cal_result_count < PSOC_CAL_STAGE_COUNT) {
 421:calibration.c ****             g_psoc_cal_result_count = PSOC_CAL_STAGE_COUNT;
