 865:calibration.c **** /* Mide con una ventana deslizante de peso constante: cada ventana de avg_n
 866:calibration.c ****  * muestras entra a un buffer circular de window_count sumas. El promedio se
 867:calibration.c ****  * calcula sobre las ultimas avg_n*window_count muestras; solo se considera
 868:calibration.c ****  * estable cuando ese promedio varia poco durante stable_streak comparaciones
 869:calibration.c ****  * consecutivas, con el buffer ya lleno. */
 870:calibration.c **** static uint8 async_measure_service(void)
 871:calibration.c **** {
 872:calibration.c ****     int32 sample;
 873:calibration.c ****     int32 sliding_avg;
 874:calibration.c ****     const PsocCalAvgCfg *cfg = g_cal_async.avg_cfg;
 875:calibration.c ****     uint8 avg_n = cal_avg_cfg_avg_n(cfg);
 876:calibration.c ****     uint8 window_count = cal_avg_cfg_window_count(cfg);
 877:calibration.c ****     uint16 max_samples = cal_avg_cfg_max_samples(cfg);
 878:calibration.c **** 
 879:calibration.c ****     if (!psoc_adc_take_isr_sample(&sample)) {
 880:calibration.c ****         g_cal_async.empty_polls++;
 881:calibration.c ****         if (g_cal_async.empty_polls >= CAL_ASYNC_EMPTY_POLL_LIMIT) {
 882:calibration.c ****             g_cal_async.measured = 0x7FFFL;
 883:calibration.c ****             cal_diag_measure_point(g_cal_async.dac, g_cal_async.measured,
 884:calibration.c ****                                    g_cal_async.realcheck_diag);
 885:calibration.c ****             g_cal_async.state = g_cal_async.after_measure;
 886:calibration.c ****             return 1u;
 887:calibration.c ****         }
 888:calibration.c ****         return 0u;
 889:calibration.c ****     }
 890:calibration.c **** 
 891:calibration.c ****     g_cal_async.empty_polls = 0UL;
 892:calibration.c ****     if (g_cal_async.discard_count > 0u) {
 893:calibration.c ****         g_cal_async.discard_count--;
 894:calibration.c ****         return 0u;
 895:calibration.c ****     }
 896:calibration.c **** 
 897:calibration.c ****     g_cal_async.acc += sample;
 898:calibration.c ****     g_cal_async.avg_count++;
 899:calibration.c ****     if (g_cal_async.avg_count < avg_n) {
 900:calibration.c ****         return 0u;
 901:calibration.c ****     }
 902:calibration.c **** 
 903:calibration.c ****     if (g_cal_async.window_filled_count < window_count) {
 904:calibration.c ****         g_cal_async.window_buf[g_cal_async.window_pos] = g_cal_async.acc;
 905:calibration.c ****         g_cal_async.window_sum += g_cal_async.acc;
 906:calibration.c ****         g_cal_async.window_filled_count++;
 907:calibration.c ****     } else {
 908:calibration.c ****         g_cal_async.window_sum -= g_cal_async.window_buf[g_cal_async.window_pos];
 909:calibration.c ****         g_cal_async.window_buf[g_cal_async.window_pos] = g_cal_async.acc;
 910:calibration.c ****         g_cal_async.window_sum += g_cal_async.acc;
 911:calibration.c ****     }
 912:calibration.c ****     g_cal_async.window_pos++;
 913:calibration.c ****     if (g_cal_async.window_pos >= window_count) {
 914:calibration.c ****         g_cal_async.window_pos = 0u;
 915:calibration.c ****     }
 916:calibration.c ****     g_cal_async.total_samples =
 917:calibration.c ****         (uint16)(g_cal_async.total_samples + (uint16)avg_n);
 918:calibration.c ****     g_cal_async.acc = 0L;
 919:calibration.c ****     g_cal_async.avg_count = 0u;
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc2ANTdN.s 			page 434


 920:calibration.c **** 
 921:calibration.c ****     sliding_avg = g_cal_async.window_sum /
 922:calibration.c ****         ((int32)avg_n * (int32)g_cal_async.window_filled_count);
 923:calibration.c ****     g_cal_async.measured = sliding_avg;
 924:calibration.c **** 
 925:calibration.c ****     if (g_cal_async.window_filled_count >= window_count) {
 926:calibration.c ****         if (g_cal_async.have_prev_avg &&
 927:calibration.c ****             abs_counts(sliding_avg - g_cal_async.prev_avg) <=
 928:calibration.c ****                 cfg->settle_tol_counts) {
 929:calibration.c ****             g_cal_async.stable_streak_count++;
 930:calibration.c ****         } else {
 931:calibration.c ****             g_cal_async.stable_streak_count = 0u;
 932:calibration.c ****         }
 933:calibration.c **** 
 934:calibration.c ****         if (g_cal_async.stable_streak_count >=
 935:calibration.c ****             cal_avg_cfg_stable_streak(cfg)) {
 936:calibration.c ****             cal_diag_measure_point(g_cal_async.dac, g_cal_async.measured,
 937:calibration.c ****                                    g_cal_async.realcheck_diag);
