1736:calibration.c ****          * (PGA_GAIN-1). No hay autoridad fisica para corregir, asi que no se
1737:calibration.c ****          * debe perseguir el error hasta saturar el DAC. */
1738:calibration.c ****         effort = (int32)dac_sample;
1739:calibration.c ****     } else if (control_error == 0L) {
