 528:calibration.c **** static void cal_servo_measure_begin(uint8 stage_index)
 529:calibration.c **** {
 530:calibration.c ****     const PsocCalStage *stage = &g_psoc_cal_stages[stage_index];
 531:calibration.c **** 
 532:calibration.c ****     g_cal_servo.stage_index = stage_index;
 533:calibration.c ****     g_cal_servo.dac = cal_stage_current_dac(stage_index);
 534:calibration.c ****     g_cal_servo.acc = 0L;
 535:calibration.c ****     g_cal_servo.cum_sum = 0L;
 536:calibration.c ****     g_cal_servo.cum_count = 0L;
 537:calibration.c ****     g_cal_servo.prev_avg = 0L;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccymbz3j.s 			page 368


 538:calibration.c ****     g_cal_servo.avg_count = 0u;
 539:calibration.c ****     g_cal_servo.discard_count = cal_servo_settle_samples(stage_index);
 540:calibration.c ****     g_cal_servo.settle_windows = 0u;
 541:calibration.c ****     g_cal_servo.have_prev_avg = 0u;
 542:calibration.c ****     g_cal_servo.empty_polls = 0UL;
 543:calibration.c **** 
 544:calibration.c ****     ADC_Stop();
 545:calibration.c ****     cal_amux_in_select(CAL_INPUT_REF_CHANNEL);
 546:calibration.c ****     CAL_AMUX_ADC_SELECT(stage->adc_channel);
 547:calibration.c ****     ADC_Start();
 548:calibration.c ****     isr_DelSig_ClearPending();
 549:calibration.c ****     psoc_adc_clear_isr_sample();
 550:calibration.c ****     ADC_StartConvert();
 551:calibration.c ****     cal_diag(PSOC_EVT_SERVO_STAGE, stage_index);
 552:calibration.c ****     g_cal_servo.state = CAL_SERVO_MEASURE;
 553:calibration.c **** }
 554:calibration.c **** 
 555:calibration.c **** static uint8 cal_servo_measure_service(void)
 556:calibration.c **** {
 557:calibration.c ****     int32 sample;
 558:calibration.c ****     int32 cum_avg;
 559:calibration.c ****     uint8 stage_index = g_cal_servo.stage_index;
 560:calibration.c **** 
 561:calibration.c ****     if (!psoc_adc_take_isr_sample(&sample)) {
 562:calibration.c ****         g_cal_servo.empty_polls++;
 563:calibration.c ****         if (g_cal_servo.empty_polls >= CAL_ASYNC_EMPTY_POLL_LIMIT) {
 564:calibration.c ****             g_cal_servo.state = CAL_SERVO_IDLE;
 565:calibration.c ****             psoc_calibration_restore_capture_path();
 566:calibration.c ****             return 1u;
 567:calibration.c ****         }
 568:calibration.c ****         return 0u;
 569:calibration.c ****     }
 570:calibration.c **** 
 571:calibration.c ****     g_cal_servo.empty_polls = 0UL;
 572:calibration.c ****     if (g_cal_servo.discard_count > 0u) {
 573:calibration.c ****         g_cal_servo.discard_count--;
 574:calibration.c ****         return 0u;
 575:calibration.c ****     }
 576:calibration.c **** 
 577:calibration.c ****     g_cal_servo.acc += sample;
 578:calibration.c ****     g_cal_servo.avg_count++;
 579:calibration.c ****     if (g_cal_servo.avg_count < CAL_SERVO_AVG_N) {
 580:calibration.c ****         return 0u;
 581:calibration.c ****     }
 582:calibration.c **** 
 583:calibration.c ****     g_cal_servo.cum_sum += g_cal_servo.acc;
 584:calibration.c ****     g_cal_servo.cum_count += (int32)CAL_SERVO_AVG_N;
 585:calibration.c ****     g_cal_servo.acc = 0L;
 586:calibration.c ****     g_cal_servo.avg_count = 0u;
 587:calibration.c **** 
 588:calibration.c ****     cum_avg = g_cal_servo.cum_sum / g_cal_servo.cum_count;
 589:calibration.c ****     if (g_cal_servo.have_prev_avg &&
 590:calibration.c ****         abs_counts(cum_avg - g_cal_servo.prev_avg) <= CAL_SERVO_SETTLE_TOL_COUNTS) {
 591:calibration.c ****         uint8 locked;
 592:calibration.c ****         cal_diag(PSOC_EVT_CAL_STAGE_DAC, g_cal_servo.dac);
 593:calibration.c ****         cal_diag_i16(PSOC_EVT_CAL_STAGE_MEAS, cum_avg);
 594:calibration.c ****         cal_diag_i32(PSOC_EVT_CAL_STAGE_MEAS32, cum_avg);
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccymbz3j.s 			page 369


 595:calibration.c ****         locked = cal_servo_apply_measurement(stage_index, g_cal_servo.dac, cum_avg);
 596:calibration.c ****         psoc_calibration_restore_capture_path();
 597:calibration.c ****         if (locked) {
 598:calibration.c ****             g_cal_servo.stage_index = (uint8)((stage_index + 1u) % PSOC_CAL_STAGE_COUNT);
 599:calibration.c ****         }
 600:calibration.c ****         g_cal_servo.next_due_ticks = psoc_now_ticks() + CAL_SERVO_PERIOD_TICKS;
 601:calibration.c ****         g_cal_servo.state = CAL_SERVO_IDLE;
