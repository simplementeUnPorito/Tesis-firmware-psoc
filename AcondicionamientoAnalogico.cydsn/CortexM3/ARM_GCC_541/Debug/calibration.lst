1118:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1119:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
1120:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
1121:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
1122:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
1123:calibration.c **** static void cal_async_abort_watchdog(void)
1124:calibration.c **** {
1125:calibration.c ****     uint8 i;
1126:calibration.c ****     uint8 preserve_results =
1127:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1128:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1129:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1130:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1131:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1132:calibration.c **** 
1133:calibration.c ****     if (!preserve_results) {
1134:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1135:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1136:calibration.c ****             g_psoc_cal_stages[i].write(center);
1137:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1138:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1139:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1140:calibration.c ****         }
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccanHmkm.s 			page 561


1141:calibration.c ****     }
1142:calibration.c ****     g_cal_async.ok = 0u;
1143:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1144:calibration.c **** 
1145:calibration.c ****     cal_async_complete();
1146:calibration.c **** }
1147:calibration.c **** 
