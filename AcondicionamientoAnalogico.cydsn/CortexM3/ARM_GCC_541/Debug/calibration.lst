1101:calibration.c **** /* Aborta la calibracion por timeout (CAL_WATCHDOG_TICKS sin terminar).
1102:calibration.c ****  * Las etapas ya finalizadas (indices < stage_index durante la busqueda)
1103:calibration.c ****  * conservan su mejor valor encontrado; la etapa en curso y las que faltan
1104:calibration.c ****  * se fuerzan al centro nominal de cada etapa. Durante la
1105:calibration.c ****  * verificacion (todas las etapas ya calibradas) no se toca ningun DAC. */
1106:calibration.c **** static void cal_async_abort_watchdog(void)
1107:calibration.c **** {
1108:calibration.c ****     uint8 i;
1109:calibration.c ****     uint8 preserve_results =
1110:calibration.c ****         (g_cal_async.state == CAL_ASYNC_VERIFY_BEGIN ||
1111:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_VERIFY ||
1112:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_SWITCH ||
1113:calibration.c ****          g_cal_async.state == CAL_ASYNC_REALCHECK_BEGIN ||
1114:calibration.c ****          g_cal_async.state == CAL_ASYNC_EVAL_REALCHECK) ? 1u : 0u;
1115:calibration.c **** 
1116:calibration.c ****     if (!preserve_results) {
1117:calibration.c ****         for (i = g_cal_async.stage_index; i < PSOC_CAL_STAGE_COUNT; i++) {
1118:calibration.c ****             uint8 center = cal_stage_center_dac(&g_psoc_cal_stages[i]);
1119:calibration.c ****             g_psoc_cal_stages[i].write(center);
1120:calibration.c ****             g_psoc_cal_results[i].final_dac = center;
1121:calibration.c ****             g_psoc_cal_results[i].final_measured = 0L;
1122:calibration.c ****             g_psoc_cal_results[i].ok = 0u;
1123:calibration.c ****         }
1124:calibration.c ****     }
1125:calibration.c ****     g_cal_async.ok = 0u;
1126:calibration.c ****     cal_diag(PSOC_EVT_CAL_WATCHDOG, g_cal_async.stage_index);
1127:calibration.c **** 
1128:calibration.c ****     cal_async_complete();
1129:calibration.c **** }
