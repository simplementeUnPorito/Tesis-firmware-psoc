 280:calibration.c **** static uint8 cal_stage_min_dac(const PsocCalStage *stage)
 281:calibration.c **** {
 282:calibration.c ****     return (stage->dac_center > stage->dac_max_change)
 283:calibration.c ****         ? (uint8)(stage->dac_center - stage->dac_max_change)
 284:calibration.c ****         : 0u;
 285:calibration.c **** }
 286:calibration.c **** 
 287:calibration.c **** static uint8 cal_stage_max_dac(const PsocCalStage *stage)
 288:calibration.c **** {
 289:calibration.c ****     uint16 max_dac = (uint16)stage->dac_center + (uint16)stage->dac_max_change;
 290:calibration.c ****     return (max_dac > 255u) ? 255u : (uint8)max_dac;
 291:calibration.c **** }
 292:calibration.c **** 
