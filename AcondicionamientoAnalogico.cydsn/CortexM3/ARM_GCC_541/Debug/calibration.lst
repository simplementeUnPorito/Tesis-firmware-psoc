 301:calibration.c **** static uint8 cal_stage_clamp_dac(const PsocCalStage *stage, uint8 dac)
 302:calibration.c **** {
 303:calibration.c ****     uint8 lo = cal_stage_min_dac(stage);
 304:calibration.c ****     uint8 hi = cal_stage_max_dac(stage);
