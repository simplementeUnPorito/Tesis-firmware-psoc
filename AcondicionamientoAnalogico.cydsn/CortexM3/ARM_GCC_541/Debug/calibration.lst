 886:calibration.c ****     uint16 lock_samples;    /* M muestras en la misma celda de error */
 887:calibration.c ****     uint16 settle_samples;  /* espera inicial del FIR al cambiar AMux/VDAC */
 888:calibration.c ****     uint16 timeout_samples; /* techo de muestras de PI para esta etapa */
