1043:calibration.c **** static uint8 cal_stage_value_in_tolerance(uint8 stage_index, int32 measured)
1044:calibration.c **** {
1045:calibration.c ****     const PsocCalStage *stage = &g_psoc_cal_stages[stage_index];
1046:calibration.c ****     int32 control_sample = cal_pi_compare_counts(measured);
