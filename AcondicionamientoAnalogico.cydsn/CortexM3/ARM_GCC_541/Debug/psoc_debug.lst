  10:psoc_debug.c  **** void psoc_debug_print(const char *msg)
  11:psoc_debug.c  **** {
  12:psoc_debug.c  ****     PC_PutString(msg);
  13:psoc_debug.c  **** }
  14:psoc_debug.c  **** 
  15:psoc_debug.c  **** /* Conversion manual a decimal, sin sprintf/stdio: este proyecto no tiene
  16:psoc_debug.c  ****  * syscalls (_sbrk/_write) provistos, asi que cualquier camino de stdio que
  17:psoc_debug.c  ****  * toque el heap (incluso sprintf con un buffer local) falla el link con
  18:psoc_debug.c  ****  * "undefined reference to '_sbrk'". */
  19:psoc_debug.c  **** static uint8 u32_to_dec(uint32 value, char *out)
  20:psoc_debug.c  **** {
  21:psoc_debug.c  ****     char tmp[10];
  22:psoc_debug.c  ****     uint8 n = 0u;
  23:psoc_debug.c  ****     uint8 i;
  24:psoc_debug.c  ****     if (value == 0UL) {
  25:psoc_debug.c  ****         out[0] = '0';
  26:psoc_debug.c  ****         return 1u;
  27:psoc_debug.c  ****     }
  28:psoc_debug.c  ****     while (value > 0UL && n < (uint8)sizeof(tmp)) {
  29:psoc_debug.c  ****         tmp[n] = (char)('0' + (value % 10UL));
  30:psoc_debug.c  ****         value /= 10UL;
  31:psoc_debug.c  ****         n++;
  32:psoc_debug.c  ****     }
  33:psoc_debug.c  ****     for (i = 0u; i < n; i++) {
  34:psoc_debug.c  ****         out[i] = tmp[n - 1u - i];
  35:psoc_debug.c  ****     }
  36:psoc_debug.c  ****     return n;
  37:psoc_debug.c  **** }
  38:psoc_debug.c  **** 
  39:psoc_debug.c  **** static const char HEX_DIGITS[16] = "0123456789ABCDEF";
  40:psoc_debug.c  **** 
  41:psoc_debug.c  **** void psoc_debug_print_u32(const char *prefix, uint32 value)
  42:psoc_debug.c  **** {
  43:psoc_debug.c  ****     char buf[16];
  44:psoc_debug.c  ****     uint8 n = u32_to_dec(value, buf);
  45:psoc_debug.c  ****     PC_PutString(prefix);
  46:psoc_debug.c  ****     buf[n] = '\0';
  47:psoc_debug.c  ****     PC_PutString(buf);
  48:psoc_debug.c  ****     PC_PutString("\r\n");
  49:psoc_debug.c  **** }
  50:psoc_debug.c  **** 
  51:psoc_debug.c  **** void psoc_debug_print_i32(const char *prefix, int32 value)
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc8aljV9.s 			page 16


  52:psoc_debug.c  **** {
  53:psoc_debug.c  ****     char buf[16];
  54:psoc_debug.c  ****     uint8 n;
  55:psoc_debug.c  ****     uint32 magnitude;
  56:psoc_debug.c  ****     PC_PutString(prefix);
  57:psoc_debug.c  ****     if (value < 0) {
  58:psoc_debug.c  ****         PC_PutChar('-');
  59:psoc_debug.c  ****         magnitude = (uint32)(-value);
  60:psoc_debug.c  ****     } else {
  61:psoc_debug.c  ****         magnitude = (uint32)value;
  62:psoc_debug.c  ****     }
  63:psoc_debug.c  ****     n = u32_to_dec(magnitude, buf);
  64:psoc_debug.c  ****     buf[n] = '\0';
  65:psoc_debug.c  ****     PC_PutString(buf);
  66:psoc_debug.c  ****     PC_PutString("\r\n");
  67:psoc_debug.c  **** }
  68:psoc_debug.c  **** 
  69:psoc_debug.c  **** void psoc_debug_print_evt(uint8 event, uint8 value, uint8 state)
  70:psoc_debug.c  **** {
  71:psoc_debug.c  ****     char hex[3];
  72:psoc_debug.c  ****     char dec[4];
  73:psoc_debug.c  ****     uint8 n;
  74:psoc_debug.c  **** 
  75:psoc_debug.c  ****     hex[0] = HEX_DIGITS[(event >> 4) & 0x0Fu];
  76:psoc_debug.c  ****     hex[1] = HEX_DIGITS[event & 0x0Fu];
  77:psoc_debug.c  ****     hex[2] = '\0';
  78:psoc_debug.c  **** 
  79:psoc_debug.c  ****     PC_PutString("EVT=0x");
  80:psoc_debug.c  ****     PC_PutString(hex);
  81:psoc_debug.c  ****     PC_PutString(" val=");
  82:psoc_debug.c  ****     n = u32_to_dec(value, dec);
  83:psoc_debug.c  ****     dec[n] = '\0';
  84:psoc_debug.c  ****     PC_PutString(dec);
  85:psoc_debug.c  ****     PC_PutString(" state=");
  86:psoc_debug.c  ****     n = u32_to_dec(state, dec);
  87:psoc_debug.c  ****     dec[n] = '\0';
  88:psoc_debug.c  ****     PC_PutString(dec);
  89:psoc_debug.c  ****     PC_PutString("\r\n");
  90:psoc_debug.c  **** }
