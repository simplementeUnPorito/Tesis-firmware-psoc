 117:Generated_Source\PSoC5/OPAlp.c **** *******************************************************************************/
 118:Generated_Source\PSoC5/OPAlp.c **** void OPAlp_Stop(void) 
 119:Generated_Source\PSoC5/OPAlp.c **** {
 120:Generated_Source\PSoC5/OPAlp.c ****     /* Disable power to buffer in active mode template */
 121:Generated_Source\PSoC5/OPAlp.c ****     OPAlp_PM_ACT_CFG_REG &= (uint8)(~OPAlp_ACT_PWR_EN);
 122:Generated_Source\PSoC5/OPAlp.c **** 
 123:Generated_Source\PSoC5/OPAlp.c ****     /* Disable power to buffer in alternative active mode template */
 124:Generated_Source\PSoC5/OPAlp.c ****     OPAlp_PM_STBY_CFG_REG &= (uint8)(~OPAlp_STBY_PWR_EN);
 125:Generated_Source\PSoC5/OPAlp.c ****     
 126:Generated_Source\PSoC5/OPAlp.c ****     /* Disable negative charge pumps for ANIF only if all ABuf is turned OFF */
 127:Generated_Source\PSoC5/OPAlp.c ****     if(OPAlp_PM_ACT_CFG_REG == 0u)
 128:Generated_Source\PSoC5/OPAlp.c ****     {
 129:Generated_Source\PSoC5/OPAlp.c ****         OPAlp_PUMP_CR1_REG &= (uint8)(~(OPAlp_PUMP_CR1_CLKSEL | OPAlp_PUMP_CR1_FORCE));
 130:Generated_Source\PSoC5/OPAlp.c ****     }
 131:Generated_Source\PSoC5/OPAlp.c **** }
