\Timer:TimerUDB:status_tc\ <= ((\Timer:TimerUDB:run_mode\ and \Timer:TimerUDB:per_zero\));

\Timer:TimerUDB:runmode_enable\\D\ <= ((not \Timer:TimerUDB:per_zero\ and not \Timer:TimerUDB:trig_disable\ and \Timer:TimerUDB:control_7\)
