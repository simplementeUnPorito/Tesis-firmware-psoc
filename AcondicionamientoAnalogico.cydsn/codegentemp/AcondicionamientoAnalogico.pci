# AcondicionamientoAnalogico
# 2026-06-14 18:11:07Z

# IO_0@[IOP=(1)][IoId=(0)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 0
# IO_1@[IOP=(1)][IoId=(1)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 1
# IO_3@[IOP=(1)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 3
# IO_6@[IOP=(2)][IoId=(6)] is reserved: AnalogTrackJump
dont_use_io iocell 2 6
set_io "Tx_1(0)" iocell 1 5
set_io "SYNC_IN(0)" iocell 12 6
set_io "LED(0)" iocell 2 1
set_io "Rx_1(0)" iocell 1 2
set_io "AMux_1(0)" iocell 15 5
set_io "AMux_0(0)" iocell 15 3
set_io "Vref(0)" iocell 0 0
set_io "LPo(0)" iocell 3 7
set_io "LPm(0)" iocell 3 2
set_io "ADDERm(0)" iocell 3 4
set_io "BPm(0)" iocell 0 3
set_io "ADDERo(0)" iocell 3 6
set_io "BPo(0)" iocell 0 1
set_io "SEo(0)" iocell 0 7
set_io "INn(0)" iocell 0 5
set_io "INp(0)" iocell 0 4
set_io "Vshield(0)" iocell 1 4
set_location "\PGAshield:SC\" sccell -1 -1 3
set_location "\VDAC_ref_LP:viDAC8\" vidaccell -1 -1 3
set_location "\VDAC_ref_BP:viDAC8\" vidaccell -1 -1 0
set_location "\LPF_2:cy_psoc3_lpf_1\" lpfcell -1 -1 1
set_location "\OPAref:ABuf\" abufcell -1 -1 2
set_location "\VDAC_ref_PGA:viDAC8\" vidaccell -1 -1 2
set_location "\LPF_1:cy_psoc3_lpf_1\" lpfcell -1 -1 0
set_location "\PGAgain:SC\" sccell -1 -1 0
set_location "\OPAadder:ABuf\" abufcell -1 -1 1
set_location "\OPAlp:ABuf\" abufcell -1 -1 3
set_location "\VDAC_Ref_Adder:viDAC8\" vidaccell -1 -1 1
set_location "\OPAbp:ABuf\" abufcell -1 -1 0
set_location "\ADC:DSM\" dsmodcell -1 -1 0
set_location "\PGAn:SC\" sccell -1 -1 1
set_location "\PGAp:SC\" sccell -1 -1 2
