# AcondicionamientoAnalogico
# 2026-07-02 03:53:22Z

# IO_0@[IOP=(1)][IoId=(0)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 0
# IO_1@[IOP=(1)][IoId=(1)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 1
# IO_3@[IOP=(1)][IoId=(3)] is reserved: SWDDebugEnabled
dont_use_io iocell 1 3
# IO_2@[IOP=(3)][IoId=(2)] is reserved: AnalogTrackJump
dont_use_io iocell 3 2
set_io "Button(0)" iocell 2 2
set_io "LED(0)" iocell 2 1
set_io "SYNC_IN(0)" iocell 12 2
set_io "Tx_1(0)" iocell 1 2
set_io "Rx_1(0)" iocell 1 5
set_io "AMux_Capacitor(0)" iocell 0 4
set_io "ref1V(0)" iocell 3 6
set_io "LPo(0)" iocell 0 0
set_io "LPm(0)" iocell 0 5
set_io "\ADC:Bypass_P03(0)\" iocell 0 3
set_io "PGAo(0)" iocell 3 5
set_io "PGAin(0)" iocell 3 4
set_location "\Opa_ref_1V:ABuf\" abufcell -1 -1 1
set_location "\Opa_ref_PGA:ABuf\" abufcell -1 -1 3
set_location "\VDAC_LP:viDAC8\" vidaccell -1 -1 0
set_location "\Opa_LP:ABuf\" abufcell -1 -1 2
set_location "\LPF_ADC:cy_psoc3_lpf_1\" lpfcell -1 -1 1
set_location "\ADC:DSM\" dsmodcell -1 -1 0
set_location "\PGA:SC\" sccell -1 -1 1
set_location "\VDAC_PGA:viDAC8\" vidaccell -1 -1 1
set_io "Dedicated_Output" iocell 3 7
