    <CYPRESSTAG name="Macrocell listing" icon="FILE_RPT_EQUATION">

    ------------------------------------------------------------
    Macrocell listing
    ------------------------------------------------------------

    MacroCell: Name=\SignalController:MODULE_6:g1:a0:gx:u0:eq_5_split\, Mode=(Combinatorial)
        Total # of inputs        : 12
        Total # of product terms : 8
            Clock Enable: True
        Main Equation            : 8 pterms
        (
              \SignalController:batch_limit_reg_5\ * 
              !\SignalController:batch_count_reg_5\
            + \SignalController:batch_limit_reg_4\ * 
              !\SignalController:batch_count_reg_4\
            + \SignalController:batch_limit_reg_3\ * 
              !\SignalController:batch_count_reg_3\
            + \SignalController:batch_limit_reg_2\ * 
              !\SignalController:batch_count_reg_2\
            + !\SignalController:batch_limit_reg_1\ * 
              \SignalController:batch_count_reg_1\
            + \SignalController:batch_limit_reg_1\ * 
              !\SignalController:batch_count_reg_1\
            + !\SignalController:batch_limit_reg_0\ * 
              \SignalController:batch_count_reg_0\
            + \SignalController:batch_limit_reg_0\ * 
              !\SignalController:batch_count_reg_0\
        );
        Output = \SignalController:MODULE_6:g1:a0:gx:u0:eq_5_split\ (fanout=1)

    MacroCell: Name=Net_4758, Mode=(Combinatorial)
        Total # of inputs        : 1
        Total # of product terms : 1
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              !\UART:BUART:txn\
        );
        Output = Net_4758 (fanout=1)

    MacroCell: Name=\UART:BUART:counter_load_not\, Mode=(Combinatorial)
        Total # of inputs        : 4
        Total # of product terms : 2
            Clock Enable: True
        Main Equation            : 2 pterms
        !(
              !\UART:BUART:tx_state_1\ * !\UART:BUART:tx_state_0\ * 
