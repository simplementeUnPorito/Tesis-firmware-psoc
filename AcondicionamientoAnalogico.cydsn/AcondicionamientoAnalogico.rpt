    MacroCell: Name=\EdgeDetect:last\, Mode=(D-Register)
        Total # of inputs        : 1
        Total # of product terms : 1
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: True
        Main Equation            : 1 pterm
        (
              Net_2338
        );
        Output = \EdgeDetect:last\ (fanout=1)

    MacroCell: Name=\Timer:TimerUDB:run_mode\, Mode=(D-Register)
        Total # of inputs        : 1
        Total # of product terms : 1
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: PosEdge(ClockBlock_100k__SYNC_OUT)
        Main Equation            : 1 pterm
        (
              \Timer:TimerUDB:control_7\
        );
        Output = \Timer:TimerUDB:run_mode\ (fanout=4)

    MacroCell: Name=Net_2277, Mode=(D-Register)
        Total # of inputs        : 2
        Total # of product terms : 1
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: PosEdge(ClockBlock_100k__SYNC_OUT)
        Main Equation            : 1 pterm
        (
              \Timer:TimerUDB:run_mode\ * \Timer:TimerUDB:per_zero\
        );
        Output = Net_2277 (fanout=1)

    MacroCell: Name=\Timer:TimerUDB:timer_enable\, Mode=(D-Register)
        Total # of inputs        : 5
        Total # of product terms : 3
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: PosEdge(ClockBlock_100k__SYNC_OUT)
        Main Equation            : 3 pterms
        (
              \Timer:TimerUDB:control_7\ * !\Timer:TimerUDB:timer_enable\ * 
              !\Timer:TimerUDB:trig_disable\
            + \Timer:TimerUDB:control_7\ * !\Timer:TimerUDB:run_mode\ * 
              !\Timer:TimerUDB:trig_disable\
            + \Timer:TimerUDB:control_7\ * !\Timer:TimerUDB:per_zero\ * 
              !\Timer:TimerUDB:trig_disable\
        );
        Output = \Timer:TimerUDB:timer_enable\ (fanout=6)

    MacroCell: Name=\Timer:TimerUDB:trig_disable\, Mode=(T-Register)
        Total # of inputs        : 4
        Total # of product terms : 1
        List of special equations: 
            Clock  = (ClockBlock_BUS_CLK) => Global
            Clock Enable: PosEdge(ClockBlock_100k__SYNC_OUT)
        Main Equation            : 1 pterm
        (
              \Timer:TimerUDB:timer_enable\ * \Timer:TimerUDB:run_mode\ * 
              \Timer:TimerUDB:per_zero\ * !\Timer:TimerUDB:trig_disable\
        );
        Output = \Timer:TimerUDB:trig_disable\ (fanout=2)

    MacroCell: Name=\UART:BUART:txn\, Mode=(D-Register)
        Total # of inputs        : 7
        Total # of product terms : 5
        List of special equations: 
            Clock  = (\UART:Net_9\) => Global
            Clock Enable: True
        Main Equation            : 5 pterms
        (
              \UART:BUART:txn\ * \UART:BUART:tx_state_1\ * 
              !\UART:BUART:tx_bitclk\
            + \UART:BUART:txn\ * \UART:BUART:tx_state_2\
