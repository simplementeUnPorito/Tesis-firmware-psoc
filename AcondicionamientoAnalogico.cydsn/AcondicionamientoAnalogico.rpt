              !\SignalController:stop_pulse\ * 
              !\SignalController:clear_flags_pulse\ * 
              \SignalController:batch_count_reg_0\
            + Net_6869_1 * !Net_6869_0 * Net_5672_6 * 
              !\SignalController:stop_pulse\ * 
              !\SignalController:clear_flags_pulse\ * 
              !\SignalController:sample_done_rise\ * 
              \SignalController:batch_count_reg_0\
            + Net_6869_1 * !Net_6869_0 * Net_5672_6 * 
              !\SignalController:stop_pulse\ * 
              !\SignalController:clear_flags_pulse\ * 
              !\SignalController:sample_will_close_batch\ * 
              \SignalController:batch_count_reg_0\
            + Net_6869_1 * !Net_6869_0 * Net_5672_6 * 
              !\SignalController:stop_pulse\ * 
              !\SignalController:clear_flags_pulse\ * 
              \SignalController:batch_will_finish_capture\ * 
              \SignalController:batch_count_reg_0\
            + Net_6869_1 * Net_6869_0 * Net_5672_6 * 
              !\SignalController:arm_pulse\ * 
              !\SignalController:start_now_pulse\ * 
              !\SignalController:stop_pulse\ * 
              !\SignalController:clear_flags_pulse\ * 
              \SignalController:batch_count_reg_0\
        );
        Output = \SignalController:batch_count_reg_0\ (fanout=10)

    MacroCell: Name=Net_25, Mode=(D-Register)
        Total # of inputs        : 4
        Total # of product terms : 2
        List of special equations: 
            Clock  = (\SPI:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 2 pterms
        (
              Net_25 * \SPI:BSPIM:state_1\ * \SPI:BSPIM:state_0\
            + !\SPI:BSPIM:state_2\ * \SPI:BSPIM:state_1\ * 
              \SPI:BSPIM:state_0\
