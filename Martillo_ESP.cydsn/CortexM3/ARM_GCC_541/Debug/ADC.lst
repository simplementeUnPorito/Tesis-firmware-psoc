 810:Generated_Source\PSoC5/ADC.c **** int32 ADC_GetResult32(void) 
 811:Generated_Source\PSoC5/ADC.c **** {
 812:Generated_Source\PSoC5/ADC.c ****     uint32 result;
 813:Generated_Source\PSoC5/ADC.c ****     uint8 coherency;
