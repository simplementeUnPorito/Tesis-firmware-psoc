   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Martillo piezoeléctrico, transporte UART hacia ESP esclavo.
   3:main.c        **** *
   4:main.c        **** * Lógica idéntica a DiferencialToSingleEnded__ESP. Solo cambian los nombres
   5:main.c        **** * de los componentes del TopDesign:
   6:main.c        **** *   PGAgain  → PGA          (ganancia señal,     cmd 0xA6)
   7:main.c        **** *   PGAvdac  → PGA_ref      (ganancia referencia, cmd 0xA9)
   8:main.c        **** *   VDAC     → VDAC         (tensión DC,          cmd 0xAA)
   9:main.c        **** *   ADC      → ADC          (Delta-Sigma 16-bit)
  10:main.c        **** *   LPF_1/2  → LPF_ADC / LPF_ref
  11:main.c        **** *   OPAref   → Opa_ref
  12:main.c        **** *
  13:main.c        **** * Protocolo UART idéntico al proyecto geófono:
  14:main.c        **** *   TX: [0xAB][30][seq_lo][seq_hi] + 30×3 bytes RAW LE + [crc XOR]  (95 bytes)
  15:main.c        **** *   RX: [0xAB][cmd][param][cmd^param]
  16:main.c        **** *       0xA5 ping  0xA6 PGA  0xA9 PGA_ref  0xAA VDAC
  17:main.c        **** *       0xB1 arm   0xB4 start-now   0xB3 debug ramp
  18:main.c        **** *       0xA3 set N (16-bit, 5-byte frame)
  19:main.c        **** *******************************************************************************/
  20:main.c        **** 
  21:main.c        **** #include "project.h"
  22:main.c        **** 
  23:main.c        **** /* -------------------------------------------------------------------------- */
  24:main.c        **** #define VDAC_INIT_VALUE    0x94u
  25:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — watchdog UART       */
  26:main.c        **** 
  27:main.c        **** #define BATCH_SAMPLES      30u
  28:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  29:main.c        **** 
  30:main.c        **** #define PSOC_IDLE          0u
  31:main.c        **** #define PSOC_ARMED         1u
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccsKVcEc.s 			page 2


