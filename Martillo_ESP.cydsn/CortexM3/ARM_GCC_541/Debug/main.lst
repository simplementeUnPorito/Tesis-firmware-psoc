 124:main.c        ****         g_rx_watch_ticks++;
 125:main.c        ****         if (g_rx_watch_ticks >= RX_WATCHDOG_TICKS) {
 126:main.c        ****             g_rx_watch_ticks = 0u;
 127:main.c        ****             watchdog_rx = 1u;
