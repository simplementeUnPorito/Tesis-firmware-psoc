 128:main.c        ****         }
 129:main.c        ****     } else {
 130:main.c        ****         g_rx_watch_ticks = 0u;
 131:main.c        ****     }
 132:main.c        ****     Timer_Stop();
 133:main.c        ****     Timer_WritePeriod(TIMEOUT_COUNTS);
 134:main.c        ****     Timer_Start();
 135:main.c        **** }
 136:main.c        **** 
 137:main.c        **** /* ISR flanco SYNC_IN — componente "isr_SyncIn" en TopDesign */
 138:main.c        **** CY_ISR(isr_SyncIn)
 139:main.c        **** {
 140:main.c        ****     uint8 saved;
 141:main.c        ****     if (SYNC_IN_Read())
 142:main.c        ****     {
 143:main.c        ****         if (g_state == PSOC_ARMED)
 144:main.c        ****         {
 145:main.c        ****             saved = CyEnterCriticalSection();
 146:main.c        ****             g_batch_fill   = 0u;
 147:main.c        ****             g_batch_ready  = 0u;
 148:main.c        ****             g_batches_sent = 0u;
 149:main.c        ****             g_dbg_cnt      = 0u;
 150:main.c        ****             g_state        = PSOC_SAMPLING;
 151:main.c        ****             CyExitCriticalSection(saved);
 152:main.c        ****             ADC_StartConvert();
 153:main.c        ****         }
 154:main.c        ****     }
 155:main.c        ****     else
 156:main.c        ****     {
 157:main.c        ****         ADC_StopConvert();
 158:main.c        ****         saved = CyEnterCriticalSection();
 159:main.c        ****         g_batch_fill  = 0u;
 160:main.c        ****         g_batch_ready = 0u;
 161:main.c        ****         g_state       = PSOC_IDLE;
 162:main.c        ****         CyExitCriticalSection(saved);
 163:main.c        ****     }
 164:main.c        **** }
