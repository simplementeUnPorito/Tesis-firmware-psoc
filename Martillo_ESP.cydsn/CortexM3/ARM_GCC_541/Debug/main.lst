 105:main.c        **** CY_ISR(isr_DelSigReady)
 106:main.c        **** {
 107:main.c        ****     g_adc_raw = adc_counts_right_aligned(ADC_GetResult32());
 108:main.c        **** 
 109:main.c        ****     if (g_state == PSOC_SAMPLING && g_batch_ready == 0u &&
 110:main.c        ****         g_batch_fill < BATCH_SAMPLES)
 111:main.c        ****     {
 112:main.c        ****         g_batch_raw[g_batch_fill] = g_adc_raw;
 113:main.c        ****         g_batch_fill++;
 114:main.c        ****         if (g_batch_fill >= BATCH_SAMPLES)
 115:main.c        ****             g_batch_ready = 1u;
 116:main.c        ****     }
 117:main.c        **** }
 118:main.c        **** 
 119:main.c        **** /* ISR Timer — watchdog UART; componente "isr_Timer" en TopDesign */
 120:main.c        **** CY_ISR(isr_Timer)
 121:main.c        **** {
 122:main.c        ****     Timer_ReadStatusRegister();
