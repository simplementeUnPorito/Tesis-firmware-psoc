    \Timer:TimerUDB:run_mode\:macrocell
        GENERIC MAP(
            eqn_main => "(main_0)",
            regmode => 1,
            clk_inv => '0',
            clken_mode => 1)
        PORT MAP(
            q => \Timer:TimerUDB:run_mode\,
            clock_0 => ClockBlock_BUS_CLK,
            main_0 => \Timer:TimerUDB:control_7\);

    Net_2277:macrocell
        GENERIC MAP(
            eqn_main => "(main_0 * main_1)",
            regmode => 1,
            clk_inv => '0',
            clken_mode => 1)
        PORT MAP(
            q => Net_2277,
            clock_0 => ClockBlock_BUS_CLK,
            main_0 => \Timer:TimerUDB:run_mode\,
            main_1 => \Timer:TimerUDB:per_zero\);

    \Timer:TimerUDB:timer_enable\:macrocell
        GENERIC MAP(
            eqn_main => "(main_0 * !main_1 * !main_4) + (main_0 * !main_2 * !main_4) + (main_0 * !main_3 * !main_4)",
            regmode => 1,
            clk_inv => '0',
            clken_mode => 1)
        PORT MAP(
            q => \Timer:TimerUDB:timer_enable\,
            clock_0 => ClockBlock_BUS_CLK,
            main_0 => \Timer:TimerUDB:control_7\,
            main_1 => \Timer:TimerUDB:timer_enable\,
            main_2 => \Timer:TimerUDB:run_mode\,
            main_3 => \Timer:TimerUDB:per_zero\,
            main_4 => \Timer:TimerUDB:trig_disable\);

    \Timer:TimerUDB:trig_disable\:macrocell
        GENERIC MAP(
            eqn_main => "(main_0 * main_1 * main_2 * !main_3)",
            regmode => 2,
            clk_inv => '0',
            clken_mode => 1)
        PORT MAP(
            q => \Timer:TimerUDB:trig_disable\,
            clock_0 => ClockBlock_BUS_CLK,
            main_0 => \Timer:TimerUDB:timer_enable\,
            main_1 => \Timer:TimerUDB:run_mode\,
            main_2 => \Timer:TimerUDB:per_zero\,
            main_3 => \Timer:TimerUDB:trig_disable\);

