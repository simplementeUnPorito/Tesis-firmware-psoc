 193:main.c        ****             watchdog_rx = 1u;
 194:main.c        ****         }
 195:main.c        ****     } else {
 196:main.c        ****         g_rx_watch_ticks = 0u;
 197:main.c        ****     }
 198:main.c        **** 
 199:main.c        ****     Timer_Stop();
 200:main.c        ****     Timer_WritePeriod(TIMEOUT_COUNTS);
 201:main.c        ****     Timer_Start();
 202:main.c        **** }
