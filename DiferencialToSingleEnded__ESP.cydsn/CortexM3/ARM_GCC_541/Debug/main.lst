   1:main.c        **** /*******************************************************************************
   2:main.c        **** * main.c — Geofono single-ended, transporte por UART hacia el ESP esclavo.
   3:main.c        **** *
   4:main.c        **** * Cadena: MATLAB → maestro → esclavo (ESP-NOW) → PSoC (UART).
   5:main.c        **** * El PSoC muestrea N lotes de 30 muestras RAW (sin Filter) y los envía en
   6:main.c        **** * tiempo real al ESP esclavo por UART. El arranque del muestreo es por el pin
   7:main.c        **** * digital SYNC_IN (lo maneja el ESP esclavo).
   8:main.c        **** *
   9:main.c        **** * ────────────────────────────────�
  10:main.c        **** *  REQUISITOS EN PSOC CREATOR (TopDesign.cysch / .cydwr) — PENDIENTE (usuario):
  11:main.c        **** *    1. RENOMBRAR el componente UART  "UART_PC"  ->  "UART".
  12:main.c        **** *    2. QUITAR el componente "Filter" (FIR) y su ISR "isr_Filter".
  13:main.c        **** *    3. QUITAR el componente "SPI Slave (SPIS_1)" y el pin "DATA_READY".
  14:main.c        **** *    4. CONSERVAR el pin digital input "SYNC_IN" con interrupt
  15:main.c        **** *       "Rising and Falling edges" e ISR "isr_SyncIn".
  16:main.c        **** *    5. CABLEAR la UART al ESP esclavo:
  17:main.c        **** *         UART.TX (PSoC)  ->  RX del ESP esclavo
  18:main.c        **** *         UART.RX (PSoC)  <-  TX del ESP esclavo
  19:main.c        **** *       Baud actual: 115200 (debe coincidir con PSOC_UART_BAUD del firmware del
  20:main.c        **** *       esclavo). El batch es de 95 bytes a ~34 lotes/s.
  21:main.c        **** *       Configurar TX Buffer Size >= 96 y RX Buffer Size >= 16 (modo Interrupt)
  22:main.c        **** *       para que UART_PutArray no bloquee y no se pierdan muestras entre lotes.
  23:main.c        **** *    6. CONSERVAR: ADC (DelSig), VDAC, PGAgain, PGAvdac, OPA*, LPF_1/2, Timer,
  24:main.c        **** *       LED, isr_DelSig, isr_Timer.
  25:main.c        **** * ────────────────────────────────�
  26:main.c        **** *
  27:main.c        **** * TX UART (al ESP) — frame de datos RAW (95 bytes):
  28:main.c        **** *   [0xAB][n=30][seq_lo][seq_hi] + 30×3 bytes (raw LE: b0,b1,b2) + [crc XOR]
  29:main.c        **** *
  30:main.c        **** * El muestreo SIEMPRE arranca por el flanco de subida del pin SYNC_IN (lo
  31:main.c        **** * levanta el ESP esclavo, tanto en START normal como en "Ver"). La UART solo
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccqeavVC.s 			page 2


  32:main.c        **** * lleva N, VDAC, configuración y las muestras del ADC.
  33:main.c        **** *
  34:main.c        **** * RX UART (del ESP) — comandos con checksum XOR:
  35:main.c        **** *   1 parámetro : [0xAB][cmd][param][cmd^param]
  36:main.c        **** *       0xA5 status/probe (responde ping)        0xA6 set PGAgain (0-8)
  37:main.c        **** *       0xA9 set PGAvdac (0-8)                   0xAA set VDAC (0-255)
  38:main.c        **** *       0xB1 pre-start/arm (espera flanco SYNC)  0xB3 debug PSoC rampa (0/1)
  39:main.c        **** *       0xB4 start-now ADC real (solo diagnostico; Ver usa flanco SYNC)
  40:main.c        **** *       0xC1 pong del ESP (respuesta al ping de deteccion)
  41:main.c        **** *   2 parámetros: [0xAB][0xA3][n_lo][n_hi][0xA3^n_lo^n_hi]
  42:main.c        **** *       0xA3 set N (lotes, 16 bits)
  43:main.c        **** *
  44:main.c        **** * Detección mutua PSoC ↔ ESP:
  45:main.c        **** *   PSoC → ESP : [0xAB][0xC0][0x00][0xC0]  (ping)
  46:main.c        **** *   ESP  → PSoC: [0xAB][0xC1][0x00][0xC1]  (pong)
  47:main.c        **** *   PSoC → ESP : [0xAB][0xC2][cmd][val][0xC2^cmd^val] (config ACK)
  48:main.c        **** *   PSoC queda buscando al ESP mientras sigue procesando UART y batches.
  49:main.c        **** *******************************************************************************/
  50:main.c        **** 
  51:main.c        **** #include "project.h"
  52:main.c        **** 
  53:main.c        **** /* -------------------------------------------------------------------------- */
  54:main.c        **** #define VDAC_INIT_VALUE    0x94u
  55:main.c        **** #define TIMER_TICK_MS      10u
  56:main.c        **** #define TIMEOUT_COUNTS     240000u    /* 10 ms @ 24 MHz — tick de sistema     */
  57:main.c        **** 
  58:main.c        **** #define BATCH_SAMPLES      30u
  59:main.c        **** #define FRAME_BYTES        (4u + BATCH_SAMPLES * 3u + 1u)   /* 95 */
  60:main.c        **** 
  61:main.c        **** /* Estados del PSoC */
  62:main.c        **** #define PSOC_IDLE          0u
  63:main.c        **** #define PSOC_ARMED         1u
  64:main.c        **** #define PSOC_SAMPLING      2u
  65:main.c        **** 
  66:main.c        **** /* Ping / pong de detección mutua con el ESP */
  67:main.c        **** #define PSOC_CMD_PING      0xC0u   /* PSoC → ESP: ¿estás ahí?           */
  68:main.c        **** #define PSOC_CMD_PONG      0xC1u   /* ESP  → PSoC: confirmación          */
  69:main.c        **** #define PSOC_CMD_CFG_ACK   0xC2u   /* PSoC -> ESP: config aplicada       */
  70:main.c        **** 
  71:main.c        **** /* Período de ping en el loop de arranque (ms) */
  72:main.c        **** #define PING_PERIOD_MS     700u
  73:main.c        **** #define PING_OFF_MS        100u    /* LED apagado al final de cada ciclo */
  74:main.c        **** #define IDLE_PING_MS       1000u
  75:main.c        **** 
  76:main.c        **** /* LED operacional: ventana de "comunicando" expresada en ticks del Timer. */
  77:main.c        **** #define COMM_WINDOW_MS     500u
  78:main.c        **** #define COMM_BLINK_MS       50u
  79:main.c        **** 
  80:main.c        **** #define MS_TO_TICKS(ms)       (((ms) + TIMER_TICK_MS - 1u) / TIMER_TICK_MS)
  81:main.c        **** #define PING_PERIOD_TICKS     MS_TO_TICKS(PING_PERIOD_MS)
  82:main.c        **** #define PING_OFF_TICKS        MS_TO_TICKS(PING_OFF_MS)
  83:main.c        **** #define IDLE_PING_TICKS       MS_TO_TICKS(IDLE_PING_MS)
  84:main.c        **** #define COMM_WINDOW_TICKS     MS_TO_TICKS(COMM_WINDOW_MS)
  85:main.c        **** #define COMM_BLINK_TICKS      MS_TO_TICKS(COMM_BLINK_MS)
  86:main.c        **** #define CONNECT_BLINK_TICKS   MS_TO_TICKS(80u)
  87:main.c        **** 
  88:main.c        **** /* -------------------------------------------------------------------------- */
