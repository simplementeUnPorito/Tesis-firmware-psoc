 129:main.c        **** };
 130:main.c        **** 
 131:main.c        **** static void uart_send_ping(void)
 132:main.c        **** {
 133:main.c        ****     UART_PutArray(g_ping_frame, (uint8)sizeof(g_ping_frame));
 134:main.c        **** }
 135:main.c        **** 
 136:main.c        **** static void uart_send_cfg_ack(uint8 cmd, uint8 val)
 137:main.c        **** {
 138:main.c        ****     uint8 frame[5u];
 139:main.c        ****     frame[0] = 0xABu;
 140:main.c        ****     frame[1] = PSOC_CMD_CFG_ACK;
 141:main.c        ****     frame[2] = cmd;
 142:main.c        ****     frame[3] = val;
 143:main.c        ****     frame[4] = (uint8)(PSOC_CMD_CFG_ACK ^ cmd ^ val);
 144:main.c        ****     UART_PutArray(frame, (uint8)sizeof(frame));
 145:main.c        **** }
