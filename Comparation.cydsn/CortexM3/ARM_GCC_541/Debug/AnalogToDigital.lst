   1:AnalogToDigital.c **** /* AnalogToDigital.c
   2:AnalogToDigital.c ****  * ADC_DelSig + DFB Filter pipeline implementation — THESIS PERMANENT
   3:AnalogToDigital.c ****  *
   4:AnalogToDigital.c ****  * DMA chain layout:
   5:AnalogToDigital.c ****  *  Chain A (ADC -> Filter STAGEA, 3 bytes, hardware trigger ADC EOC)
   6:AnalogToDigital.c ****  *  Chain B (ADC -> g_raw_delsig, 3 bytes, triggered by Chain A TERMOUT)
   7:AnalogToDigital.c ****  *  Chain C (Filter HOLDA -> g_filtered, 3 bytes, hardware trigger Filter DMA_Req_A)
   8:AnalogToDigital.c ****  *           TERMOUT on Chain C fires isr_DMA_Filter → sets g_sample_ready
   9:AnalogToDigital.c ****  */
  10:AnalogToDigital.c **** 
