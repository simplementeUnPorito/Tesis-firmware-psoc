  52:Communication.c **** /* ---- RX command parser state machine ------------------------------------- */
  53:Communication.c **** 
  54:Communication.c **** typedef enum {
  55:Communication.c ****     RX_WAIT_MARKER = 0,
  56:Communication.c ****     RX_WAIT_CMD,
  57:Communication.c ****     RX_WAIT_LEN,
ARM GAS  C:\Users\elias\AppData\Local\Temp\cceKkOti.s 			page 4


  58:Communication.c ****     RX_WAIT_LEN2,     /* second length byte for VDAC_LOAD only */
  59:Communication.c ****     RX_WAIT_PAYLOAD
  60:Communication.c **** } RxState_t;
  61:Communication.c **** 
  62:Communication.c **** static RxState_t s_rx_state    = RX_WAIT_MARKER;
  63:Communication.c **** static uint8     s_rx_cmd      = 0u;
  64:Communication.c **** static uint8     s_rx_len_hi   = 0u;   /* VDAC_LOAD: high byte of 16-bit length */
  65:Communication.c **** static uint8     s_rx_buf[TB_VDAC_MAX_LEN];
  66:Communication.c **** static uint16    s_rx_count    = 0u;
  67:Communication.c **** static uint16    s_rx_expected = 0u;
  68:Communication.c **** 
  69:Communication.c **** static void ProcessCommand(uint8 cmd, const uint8 *payload, uint16 len)
  70:Communication.c **** {
  71:Communication.c ****     uint8 dbg_pld[2];
  72:Communication.c **** 
  73:Communication.c ****     dbg_pld[0] = cmd;
  74:Communication.c ****     Debug_Send(DBG_EVT_CMD_RX, dbg_pld, 1u);
  75:Communication.c **** 
  76:Communication.c ****     switch (cmd)
  77:Communication.c ****     {
  78:Communication.c ****         case COMM_CMD_START:
  79:Communication.c ****             s_streaming = 1u;
  80:Communication.c ****             Debug_Send(DBG_EVT_STREAM_ON, (void *)0u, 0u);
  81:Communication.c ****             break;
  82:Communication.c **** 
  83:Communication.c ****         case COMM_CMD_STOP:
  84:Communication.c ****             s_streaming = 0u;
  85:Communication.c ****             Debug_Send(DBG_EVT_STREAM_OFF, (void *)0u, 0u);
  86:Communication.c ****             break;
  87:Communication.c **** 
  88:Communication.c ****         case COMM_CMD_SET_MUX_IN:
  89:Communication.c ****             if (len >= 1u) { TestBench_SetInput(payload[0]); }
  90:Communication.c ****             break;
  91:Communication.c **** 
  92:Communication.c ****         case COMM_CMD_SET_MUX_OUT:
  93:Communication.c ****             if (len >= 1u) { TestBench_SetOutput(payload[0]); }
  94:Communication.c ****             break;
  95:Communication.c **** 
  96:Communication.c ****         case COMM_CMD_SET_ADC:
  97:Communication.c ****             /* payload: [cfg:1-4][buf_gain:1/2/4/8] */
  98:Communication.c ****             if (len >= 2u)
  99:Communication.c ****             {
 100:Communication.c ****                 uint8 cfg      = payload[0];
 101:Communication.c ****                 uint8 buf_gain = payload[1];
 102:Communication.c ****                 AnalogToDigital_SetADC(cfg, buf_gain);
 103:Communication.c ****                 dbg_pld[0] = g_adc_cfg;
 104:Communication.c ****                 dbg_pld[1] = g_adc_buf_gain;
 105:Communication.c ****                 Debug_Send(DBG_EVT_ADC_CHG, dbg_pld, 2u);
 106:Communication.c ****             }
 107:Communication.c ****             break;
 108:Communication.c **** 
 109:Communication.c ****         case COMM_CMD_VDAC_LOAD:
 110:Communication.c ****             /* payload is raw data; len == sequence length */
 111:Communication.c ****             if (len > 0u && len <= TB_VDAC_MAX_LEN)
 112:Communication.c ****             {
 113:Communication.c ****                 TestBench_SetVdacSeq(payload, len);
 114:Communication.c ****                 dbg_pld[0] = (uint8)(len >> 8u);
ARM GAS  C:\Users\elias\AppData\Local\Temp\cceKkOti.s 			page 5


 115:Communication.c ****                 dbg_pld[1] = (uint8)(len & 0xFFu);
 116:Communication.c ****                 Debug_Send(DBG_EVT_VDAC_LOADED, dbg_pld, 2u);
 117:Communication.c ****             }
 118:Communication.c ****             break;
 119:Communication.c **** 
 120:Communication.c ****         case COMM_CMD_SET_DEBUG:
 121:Communication.c ****             if (len >= 1u) { Debug_SetEnabled(payload[0]); }
 122:Communication.c ****             break;
 123:Communication.c **** 
 124:Communication.c ****         case COMM_CMD_SET_DBG_CH:
 125:Communication.c ****             if (len >= 1u) { Debug_SetChannel(payload[0]); }
 126:Communication.c ****             break;
 127:Communication.c **** 
 128:Communication.c ****         case COMM_CMD_GET_STATE:
 129:Communication.c ****             /* State packet sent unconditionally after switch */
 130:Communication.c ****             break;
 131:Communication.c **** 
 132:Communication.c ****         default:
 133:Communication.c ****             break;
 134:Communication.c ****     }
 135:Communication.c **** 
 136:Communication.c ****     /* Always confirm current state so Python syncs its UI */
 137:Communication.c ****     Communication_SendState();
 138:Communication.c **** }
 139:Communication.c **** 
 140:Communication.c **** static void ParseRxByte(uint8 b)
 141:Communication.c **** {
 142:Communication.c ****     switch (s_rx_state)
 143:Communication.c ****     {
 144:Communication.c ****         case RX_WAIT_MARKER:
 145:Communication.c ****             if (b == COMM_CMD_MARKER) { s_rx_state = RX_WAIT_CMD; }
 146:Communication.c ****             break;
 147:Communication.c **** 
 148:Communication.c ****         case RX_WAIT_CMD:
 149:Communication.c ****             s_rx_cmd   = b;
 150:Communication.c ****             s_rx_state = RX_WAIT_LEN;
 151:Communication.c ****             break;
 152:Communication.c **** 
 153:Communication.c ****         case RX_WAIT_LEN:
 154:Communication.c ****             if (s_rx_cmd == COMM_CMD_VDAC_LOAD)
 155:Communication.c ****             {
 156:Communication.c ****                 /* Special: next 2 bytes are the 16-bit sequence length */
 157:Communication.c ****                 s_rx_len_hi = b;
 158:Communication.c ****                 s_rx_state  = RX_WAIT_LEN2;
 159:Communication.c ****             }
 160:Communication.c ****             else if (b == 0u)
 161:Communication.c ****             {
 162:Communication.c ****                 ProcessCommand(s_rx_cmd, s_rx_buf, 0u);
 163:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;
 164:Communication.c ****             }
 165:Communication.c ****             else
 166:Communication.c ****             {
 167:Communication.c ****                 s_rx_expected = (uint16)b;
 168:Communication.c ****                 s_rx_count    = 0u;
 169:Communication.c ****                 s_rx_state    = RX_WAIT_PAYLOAD;
 170:Communication.c ****             }
 171:Communication.c ****             break;
ARM GAS  C:\Users\elias\AppData\Local\Temp\cceKkOti.s 			page 6


 172:Communication.c **** 
 173:Communication.c ****         case RX_WAIT_LEN2:
 174:Communication.c ****             s_rx_expected = ((uint16)s_rx_len_hi << 8u) | (uint16)b;
 175:Communication.c ****             s_rx_count    = 0u;
 176:Communication.c ****             if (s_rx_expected == 0u)
 177:Communication.c ****             {
 178:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;   /* empty VDAC_LOAD: ignore */
 179:Communication.c ****             }
 180:Communication.c ****             else
 181:Communication.c ****             {
 182:Communication.c ****                 s_rx_state = RX_WAIT_PAYLOAD;
 183:Communication.c ****             }
 184:Communication.c ****             break;
 185:Communication.c **** 
 186:Communication.c ****         case RX_WAIT_PAYLOAD:
 187:Communication.c ****             if (s_rx_count < sizeof(s_rx_buf))
 188:Communication.c ****             {
 189:Communication.c ****                 s_rx_buf[s_rx_count] = b;
 190:Communication.c ****             }
 191:Communication.c ****             s_rx_count++;
 192:Communication.c ****             if (s_rx_count >= s_rx_expected)
 193:Communication.c ****             {
 194:Communication.c ****                 ProcessCommand(s_rx_cmd, s_rx_buf, s_rx_count);
 195:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;
 196:Communication.c ****             }
 197:Communication.c ****             break;
 198:Communication.c ****     }
 199:Communication.c **** }
