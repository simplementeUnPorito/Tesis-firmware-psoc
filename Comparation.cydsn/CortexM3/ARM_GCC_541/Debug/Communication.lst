 247:Communication.c **** 
 248:Communication.c **** void Communication_Task(void)
 249:Communication.c **** {
 250:Communication.c ****     uint8 i;
 251:Communication.c **** 
 252:Communication.c ****     /* Run all transport tasks */
 253:Communication.c ****     for (i = 0u; i < s_transport_count; i++)
 254:Communication.c ****     {
 255:Communication.c ****         if (s_transports[i]->task != (void *)0u)
 256:Communication.c ****         {
 257:Communication.c ****             s_transports[i]->task();
 258:Communication.c ****         }
 259:Communication.c ****     }
 260:Communication.c **** 
 261:Communication.c ****     /* UART_PC RX — transparent command parsing (responds via UART) */
 262:Communication.c ****     while (TransportUART_RxAvailable())
 263:Communication.c ****     {
 264:Communication.c ****         uint8 b = TransportUART_RxRead();
 265:Communication.c ****         s_last_iface = IFACE_UART;
 266:Communication.c ****         ParseRxByte(b);
 267:Communication.c ****     }
 268:Communication.c **** 
 269:Communication.c ****     /* USB CDC RX — command parsing (responds via USB) */
 270:Communication.c ****     if (USBFS_GetConfiguration() != 0u && USBFS_DataIsReady())
 271:Communication.c ****     {
 272:Communication.c ****         uint8  rxBuf[64u];
 273:Communication.c ****         uint16 rxLen = USBFS_GetAll(rxBuf);
 274:Communication.c ****         uint16 i2;
 275:Communication.c ****         s_last_iface = IFACE_USB;
 276:Communication.c ****         for (i2 = 0u; i2 < rxLen; i2++) { ParseRxByte(rxBuf[i2]); }
 277:Communication.c ****     }
 278:Communication.c **** }
