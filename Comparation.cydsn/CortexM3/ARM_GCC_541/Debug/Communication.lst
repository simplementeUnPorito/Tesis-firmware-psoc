  25:Communication.c **** 
  26:Communication.c **** void Communication_RegisterTransport(Transport_t *t)
  27:Communication.c **** {
  28:Communication.c ****     if (s_transport_count < COMM_MAX_TRANSPORTS)
  29:Communication.c ****     {
  30:Communication.c ****         s_transports[s_transport_count++] = t;
  31:Communication.c ****     }
