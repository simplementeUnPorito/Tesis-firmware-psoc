  57:Communication.c **** /* ---- RX command parser state machine ------------------------------------- */
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccQXfsUy.s 			page 4


  58:Communication.c **** 
  59:Communication.c **** typedef enum {
  60:Communication.c ****     RX_WAIT_MARKER = 0,
  61:Communication.c ****     RX_WAIT_CMD,
  62:Communication.c ****     RX_WAIT_LEN,
  63:Communication.c ****     RX_WAIT_LEN2,     /* second length byte for VDAC_LOAD only */
  64:Communication.c ****     RX_WAIT_PAYLOAD
  65:Communication.c **** } RxState_t;
  66:Communication.c **** 
  67:Communication.c **** static RxState_t s_rx_state    = RX_WAIT_MARKER;
  68:Communication.c **** static uint8     s_rx_cmd      = 0u;
  69:Communication.c **** static uint8     s_rx_len_hi   = 0u;   /* VDAC_LOAD: high byte of 16-bit length */
  70:Communication.c **** static uint8     s_rx_buf[TB_VDAC_MAX_LEN];
  71:Communication.c **** static uint16    s_rx_count    = 0u;
  72:Communication.c **** static uint16    s_rx_expected = 0u;
  73:Communication.c **** 
  74:Communication.c **** static void ProcessCommand(uint8 cmd, const uint8 *payload, uint16 len)
  75:Communication.c **** {
  76:Communication.c ****     uint8 dbg_pld[2];
  77:Communication.c **** 
  78:Communication.c ****     dbg_pld[0] = cmd;
  79:Communication.c ****     Debug_Send(DBG_EVT_CMD_RX, dbg_pld, 1u);
  80:Communication.c **** 
  81:Communication.c ****     switch (cmd)
  82:Communication.c ****     {
  83:Communication.c ****         case COMM_CMD_START:
  84:Communication.c ****             s_streaming = 1u;
  85:Communication.c ****             Debug_Send(DBG_EVT_STREAM_ON, (void *)0u, 0u);
  86:Communication.c ****             break;
  87:Communication.c **** 
  88:Communication.c ****         case COMM_CMD_STOP:
  89:Communication.c ****             s_streaming = 0u;
  90:Communication.c ****             Debug_Send(DBG_EVT_STREAM_OFF, (void *)0u, 0u);
  91:Communication.c ****             break;
  92:Communication.c **** 
  93:Communication.c ****         case COMM_CMD_SET_MUX_IN:
  94:Communication.c ****             if (len >= 1u) { TestBench_SetInput(payload[0]); }
  95:Communication.c ****             break;
  96:Communication.c **** 
  97:Communication.c ****         case COMM_CMD_SET_MUX_OUT:
  98:Communication.c ****             if (len >= 1u) { TestBench_SetOutput(payload[0]); }
  99:Communication.c ****             break;
 100:Communication.c **** 
 101:Communication.c ****         case COMM_CMD_SET_ADC:
 102:Communication.c ****             /* payload: [cfg:1-4][buf_gain:1/2/4/8] */
 103:Communication.c ****             if (len >= 2u)
 104:Communication.c ****             {
 105:Communication.c ****                 uint8 cfg      = payload[0];
 106:Communication.c ****                 uint8 buf_gain = payload[1];
 107:Communication.c ****                 AnalogToDigital_SetADC(cfg, buf_gain);
 108:Communication.c ****                 dbg_pld[0] = g_adc_cfg;
 109:Communication.c ****                 dbg_pld[1] = g_adc_buf_gain;
 110:Communication.c ****                 Debug_Send(DBG_EVT_ADC_CHG, dbg_pld, 2u);
 111:Communication.c ****             }
 112:Communication.c ****             break;
 113:Communication.c **** 
 114:Communication.c ****         case COMM_CMD_VDAC_LOAD:
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccQXfsUy.s 			page 5


 115:Communication.c ****             /* payload is raw data; len == sequence length */
 116:Communication.c ****             if (len > 0u && len <= TB_VDAC_MAX_LEN)
 117:Communication.c ****             {
 118:Communication.c ****                 TestBench_SetVdacSeq(payload, len);
 119:Communication.c ****                 dbg_pld[0] = (uint8)(len >> 8u);
 120:Communication.c ****                 dbg_pld[1] = (uint8)(len & 0xFFu);
 121:Communication.c ****                 Debug_Send(DBG_EVT_VDAC_LOADED, dbg_pld, 2u);
 122:Communication.c ****             }
 123:Communication.c ****             break;
 124:Communication.c **** 
 125:Communication.c ****         case COMM_CMD_SET_DEBUG:
 126:Communication.c ****             if (len >= 1u) { Debug_SetEnabled(payload[0]); }
 127:Communication.c ****             break;
 128:Communication.c **** 
 129:Communication.c ****         case COMM_CMD_SET_DBG_CH:
 130:Communication.c ****             if (len >= 1u) { Debug_SetChannel(payload[0]); }
 131:Communication.c ****             break;
 132:Communication.c **** 
 133:Communication.c ****         case COMM_CMD_GET_STATE:
 134:Communication.c ****             /* State packet sent unconditionally after switch */
 135:Communication.c ****             break;
 136:Communication.c **** 
 137:Communication.c ****         case COMM_CMD_LOAD_FIR:
 138:Communication.c ****             /* payload: [c0_lo][c0_hi][c1_lo][c1_hi]... (Q1.15 LE int16 pairs)
 139:Communication.c ****              * len must be even and represent at least 1 coefficient.
 140:Communication.c ****              * Max: ATD_FIR_MAX_TAPS * 2 = 510 bytes. */
 141:Communication.c ****             if (len >= 2u && (len & 1u) == 0u)
 142:Communication.c ****             {
 143:Communication.c ****                 uint8 n_taps = (uint8)(len >> 1u);
 144:Communication.c ****                 /* Guard: clamp to ATD_FIR_MAX_TAPS (255) */
 145:Communication.c ****                 if (n_taps > ATD_FIR_MAX_TAPS) { n_taps = ATD_FIR_MAX_TAPS; }
 146:Communication.c ****                 AnalogToDigital_FIR_Load((const int16 *)payload, n_taps);
 147:Communication.c ****                 dbg_pld[0] = n_taps;
 148:Communication.c ****                 Debug_Send(DBG_EVT_FIR_LOADED, dbg_pld, 1u);
 149:Communication.c ****             }
 150:Communication.c ****             break;
 151:Communication.c **** 
 152:Communication.c ****         case COMM_CMD_FIR_CLEAR:
 153:Communication.c ****             AnalogToDigital_FIR_Clear();
 154:Communication.c ****             Debug_Send(DBG_EVT_FIR_CLEAR, (void *)0u, 0u);
 155:Communication.c ****             break;
 156:Communication.c **** 
 157:Communication.c ****         default:
 158:Communication.c ****             break;
 159:Communication.c ****     }
 160:Communication.c **** 
 161:Communication.c ****     /* Always confirm current state so Python syncs its UI */
 162:Communication.c ****     Communication_SendState();
 163:Communication.c **** }
 164:Communication.c **** 
 165:Communication.c **** static void ParseRxByte(uint8 b)
 166:Communication.c **** {
 167:Communication.c ****     switch (s_rx_state)
 168:Communication.c ****     {
 169:Communication.c ****         case RX_WAIT_MARKER:
 170:Communication.c ****             if (b == COMM_CMD_MARKER) { s_rx_state = RX_WAIT_CMD; }
 171:Communication.c ****             break;
ARM GAS  C:\Users\elias\AppData\Local\Temp\ccQXfsUy.s 			page 6


 172:Communication.c **** 
 173:Communication.c ****         case RX_WAIT_CMD:
 174:Communication.c ****             s_rx_cmd   = b;
 175:Communication.c ****             s_rx_state = RX_WAIT_LEN;
 176:Communication.c ****             break;
 177:Communication.c **** 
 178:Communication.c ****         case RX_WAIT_LEN:
 179:Communication.c ****             if (s_rx_cmd == COMM_CMD_VDAC_LOAD || s_rx_cmd == COMM_CMD_LOAD_FIR)
 180:Communication.c ****             {
 181:Communication.c ****                 /* Special: next 2 bytes are the 16-bit payload length */
 182:Communication.c ****                 s_rx_len_hi = b;
 183:Communication.c ****                 s_rx_state  = RX_WAIT_LEN2;
 184:Communication.c ****             }
 185:Communication.c ****             else if (b == 0u)
 186:Communication.c ****             {
 187:Communication.c ****                 ProcessCommand(s_rx_cmd, s_rx_buf, 0u);
 188:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;
 189:Communication.c ****             }
 190:Communication.c ****             else
 191:Communication.c ****             {
 192:Communication.c ****                 s_rx_expected = (uint16)b;
 193:Communication.c ****                 s_rx_count    = 0u;
 194:Communication.c ****                 s_rx_state    = RX_WAIT_PAYLOAD;
 195:Communication.c ****             }
 196:Communication.c ****             break;
 197:Communication.c **** 
 198:Communication.c ****         case RX_WAIT_LEN2:
 199:Communication.c ****             s_rx_expected = ((uint16)s_rx_len_hi << 8u) | (uint16)b;
 200:Communication.c ****             s_rx_count    = 0u;
 201:Communication.c ****             if (s_rx_expected == 0u)
 202:Communication.c ****             {
 203:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;   /* empty VDAC_LOAD: ignore */
 204:Communication.c ****             }
 205:Communication.c ****             else
 206:Communication.c ****             {
 207:Communication.c ****                 s_rx_state = RX_WAIT_PAYLOAD;
 208:Communication.c ****             }
 209:Communication.c ****             break;
 210:Communication.c **** 
 211:Communication.c ****         case RX_WAIT_PAYLOAD:
 212:Communication.c ****             if (s_rx_count < sizeof(s_rx_buf))
 213:Communication.c ****             {
 214:Communication.c ****                 s_rx_buf[s_rx_count] = b;
 215:Communication.c ****             }
 216:Communication.c ****             s_rx_count++;
 217:Communication.c ****             if (s_rx_count >= s_rx_expected)
 218:Communication.c ****             {
 219:Communication.c ****                 ProcessCommand(s_rx_cmd, s_rx_buf, s_rx_count);
 220:Communication.c ****                 s_rx_state = RX_WAIT_MARKER;
 221:Communication.c ****             }
 222:Communication.c ****             break;
 223:Communication.c ****     }
 224:Communication.c **** }
