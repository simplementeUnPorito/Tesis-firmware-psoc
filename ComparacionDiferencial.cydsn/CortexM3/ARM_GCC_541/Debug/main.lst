  51:main.c        **** {
  52:main.c        ****     uint32 raw = Filter_Read24(Filter_CHANNEL_A);
  53:main.c        ****     g_flt = (raw & 0x800000u) ? (int32)(raw | 0xFF000000u) : (int32)raw;
  54:main.c        ****     g_filter_ready = 1u;
  55:main.c        **** }
