  57:main.c        **** /* ── Filtro FIR Notch software (buffer circular) ───────────────
  58:main.c        **** static int32 fir_notch(int32 input)
  59:main.c        **** {
  60:main.c        ****     static int32  fir_buf[FILTER_ORDER + 1];
  61:main.c        ****     static uint16 fir_head = 0u;
  62:main.c        ****     double acc = 0.0;
  63:main.c        ****     uint16 i, idx;
  64:main.c        **** 
  65:main.c        ****     fir_buf[fir_head] = input;
  66:main.c        ****     idx = fir_head;
  67:main.c        ****     for (i = 0u; i <= (uint16)FILTER_ORDER; i++)
  68:main.c        ****     {
  69:main.c        ****         acc += (double)fir_buf[idx] * filter_coeffs[i];
ARM GAS  C:\Users\elias\AppData\Local\Temp\cc8xKmj4.s 			page 4


  70:main.c        ****         idx = (idx == 0u) ? (uint16)FILTER_ORDER : (idx - 1u);
  71:main.c        ****     }
  72:main.c        ****     fir_head = (fir_head >= (uint16)FILTER_ORDER) ? 0u : (fir_head + 1u);
  73:main.c        ****     return (int32)acc;
  74:main.c        **** }
